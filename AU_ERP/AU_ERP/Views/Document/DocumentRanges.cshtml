@model List<AU_ERP.Models.DocumentRange>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Document Ranges";
    ViewBag.Title = "Document Ranges";
    var docTypes = (List<SelectListItem>)ViewBag.DocumentTypes ?? new List<SelectListItem>();
    var safeModel = Model ?? new List<AU_ERP.Models.DocumentRange>();
    var existingTypesJson = System.Text.Json.JsonSerializer.Serialize(safeModel.Where(r => r.DocumentTypeID.HasValue).Select(r => r.DocumentTypeID.Value).Distinct());
}

<div class="sap-window" id="app">
    <form id="docRangeForm" method="post" action="@Url.Action("DocumentRanges", "Document")">
        @Html.AntiForgeryToken()
        <div class="au-validation-summary" style="display:none;" role="alert"></div>

        <div class="sap-toolbar">
            <div class="d-flex">
                <button type="button" id="btnEdit" class="btn btn-sap" onclick="setMode(true)">Edit</button>
                <button type="button" id="btnNew" class="btn btn-sap" onclick="addNewRow()" disabled>New Entries</button>
                <button type="button" id="btnSave" class="btn btn-sap" onclick="handleSave()" disabled>Save</button>
                <button type="button" id="btnDelete" class="btn btn-sap text-danger" onclick="handleDelete()" disabled>Delete</button>
            </div>
        </div>

        <div class="table-container">
            <table class="table-sap">
                <thead>
                    <tr>
                        <th style="width: 35px;">Sel</th>
                        <th style="width: 250px;">Document Type</th>
                        <th>From Range</th>
                        <th>To Range</th>
                        <th>Last issued #</th>
                    </tr>
                </thead>
                <tbody id="gridBody">
                    @for (int i = 0; i < safeModel.Count; i++)
                    {
                        <tr>
                            <td class="col-sel" onclick="selectRow(this)">
                                <input type="hidden" name="ranges[@i].RangeID" value="@safeModel[i].RangeID" class="row-id" />
                            </td>
                            <td>
                                <select name="ranges[@i].DocumentTypeID" class="sap-input" disabled data-required="true">
                                    <option value="">Select Type</option>
                                    @foreach (var opt in docTypes)
                                    {
                                        if (opt.Value == safeModel[i].DocumentTypeID?.ToString())
                                        {
                                            <option value="@opt.Value" selected>@opt.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Value">@opt.Text</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input name="ranges[@i].FromNumber" class="sap-input sap-range-input" value="@safeModel[i].FromNumber" readonly maxlength="10" data-required="true" /></td>
                            <td><input name="ranges[@i].ToNumber" class="sap-input sap-range-input" value="@safeModel[i].ToNumber" readonly maxlength="10" data-required="true" /></td>
                            <td><input name="ranges[@i].LastIssuedNumber" class="sap-input sap-always-readonly" value="@safeModel[i].LastIssuedNumber" readonly /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    :root {
        --sap-bg: #e5ebf1;
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
        --sap-focus: #fff9c4;
    }
    .sap-window { background: white; border: 1px solid var(--sap-border); display: flex; flex-direction: column; min-height: 500px; }
    .sap-toolbar { padding: 12px; border-bottom: 2px solid var(--sap-border); background: #fff; display: flex; justify-content: flex-end; align-items: center; }
    .btn-sap { border-radius: 2px; font-size: 12px; border: 1px solid #bbb; margin-left: 5px; padding: 4px 10px; background: linear-gradient(to bottom, #fdfdfd, #eee); cursor: pointer; }
    .btn-sap:disabled { opacity: 0.4; }
    .table-container { overflow-y: auto; flex-grow: 1; }
    .table-sap { width: 100%; border-collapse: collapse; }
    .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; }
    .table-sap td { border: 1px solid #ccc; padding: 0; height: 32px; }
    .sap-input { width: 100%; height: 100%; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    .edit-mode .sap-input:not([readonly]):not([disabled]) { background: #fff; }
    .edit-mode .sap-input:not([readonly]):not([disabled]):focus { background: var(--sap-focus); outline: 1px solid orange; }
    .sap-always-readonly { background: var(--sap-readonly) !important; }
    .col-sel { width: 35px; background: #f0f0f0; cursor: pointer; }
    .row-selected { background-color: var(--sap-selected) !important; }
    .row-selected td { background-color: var(--sap-selected) !important; }
    .row-selected .sap-input { background-color: transparent !important; }
    .row-validation-error td { background-color: #fce4e4 !important; }
    .row-validation-error .sap-input { background-color: transparent !important; }
    .row-validation-error .sap-input[data-required].sap-invalid,
    .row-validation-error select[data-required].sap-invalid { outline: 2px solid #c62828 !important; background: #fff0f0 !important; }
</style>

<script>
    let isEditMode = false;
    let selectedRow = null;
    let rowCount = @safeModel.Count;

    function setMode(edit) {
        isEditMode = edit;
        document.getElementById('app').classList.toggle('edit-mode', edit);
        document.querySelectorAll('.sap-input').forEach(input => {
            if (input.classList.contains('sap-always-readonly')) return;
            if (input.tagName === 'SELECT') input.disabled = !edit;
            else input.readOnly = !edit;
        });
        document.getElementById('btnEdit').disabled = edit;
        document.getElementById('btnNew').disabled = !edit;
        document.getElementById('btnSave').disabled = !edit;
        var f = document.getElementById('docRangeForm');
        if (f && typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(f);
    }

    function enforceDigitLimit(input) {
        input.addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
        });
    }
    document.querySelectorAll('.sap-range-input').forEach(enforceDigitLimit);

    /** LastIssuedNumeric = last suffix granted; clearing + From/To edit resets floor (normalized on save to From − 1). */
    function wireDocRangeFromToCurrent(tr) {
        if (!tr || tr.dataset.docRangeFromSync === '1') return;
        var fromInp = tr.querySelector('[name$=".FromNumber"]');
        var toInp = tr.querySelector('[name$=".ToNumber"]');
        var curInp = tr.querySelector('[name$=".LastIssuedNumber"]');
        if (!fromInp || !toInp || !curInp) return;
        tr.dataset.docRangeFromSync = '1';
        function resetCurrent() { curInp.value = ''; }
        fromInp.addEventListener('input', resetCurrent);
        fromInp.addEventListener('change', resetCurrent);
        toInp.addEventListener('input', resetCurrent);
        toInp.addEventListener('change', resetCurrent);
    }

    document.querySelectorAll('#gridBody tr').forEach(wireDocRangeFromToCurrent);

    function addNewRow() {
        const body = document.getElementById('gridBody');
        const tr = document.createElement('tr');
        let opts = '<option value="">Select Type</option>';
        @foreach (var item in docTypes)
        {
            @:opts += '<option value="@item.Value">@item.Text</option>';
        }

        tr.innerHTML = `
            <td class="col-sel" onclick="selectRow(this)">
                <input type="hidden" name="ranges[${rowCount}].RangeID" value="0" class="row-id" />
            </td>
            <td><select name="ranges[${rowCount}].DocumentTypeID" class="sap-input" data-required="true">${opts}</select></td>
            <td><input name="ranges[${rowCount}].FromNumber" class="sap-input sap-range-input" maxlength="10" data-required="true"></td>
            <td><input name="ranges[${rowCount}].ToNumber" class="sap-input sap-range-input" maxlength="10" data-required="true"></td>
            <td><input name="ranges[${rowCount}].LastIssuedNumber" class="sap-input sap-always-readonly" value="" readonly title="Numeric suffix floor before first issue = From − 1; updated when documents are issued."></td>`;
        body.appendChild(tr);
        rowCount++;

        tr.querySelectorAll('.sap-range-input').forEach(enforceDigitLimit);
        wireDocRangeFromToCurrent(tr);
        tr.querySelector('select.sap-input')?.focus();
    }

    function selectRow(cell) {
        if (!isEditMode) return;
        if (selectedRow) selectedRow.classList.remove('row-selected');
        selectedRow = cell.parentElement;
        selectedRow.classList.add('row-selected');
        document.getElementById('btnDelete').disabled = false;
    }

    function collectInvalidDocRangeRows() {
        var bad = [];
        document.querySelectorAll('#gridBody tr').forEach(tr => {
            tr.querySelectorAll('[data-required]').forEach(inp => {
                var val = inp.value ? inp.value.trim() : '';
                if (!val) bad.push(inp);
            });
        });
        return bad;
    }

    var existingTypeSet = new Set(@Html.Raw(existingTypesJson));

    function checkDuplicateTypes() {
        var dupes = [];
        document.querySelectorAll('#gridBody tr').forEach(tr => {
            var rid = tr.querySelector('.row-id');
            var isNew = !rid || !rid.value || rid.value === '0';
            if (!isNew) return;
            var sel = tr.querySelector('select[name$=".DocumentTypeID"]');
            var typeId = sel ? parseInt(sel.value) : 0;
            if (typeId && existingTypeSet.has(typeId)) {
                var opt = sel.options[sel.selectedIndex];
                dupes.push(opt ? opt.text : typeId);
            }
        });
        return dupes;
    }

    function submitSave() {
        var form = document.getElementById('docRangeForm');
        document.querySelectorAll('.sap-input, select').forEach(i => { i.disabled = false; i.readOnly = false; });
        var fd = new FormData(form);
        fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (data.success) { location.reload(); }
                else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], data.message || 'Save failed');
                else alert(data.message || 'Save failed');
            })
            .catch(() => {
                if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], 'Request failed');
                else alert('Request failed');
            });
    }

    function handleSave() {
        var form = document.getElementById('docRangeForm');
        if (typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(form);
        var bad = collectInvalidDocRangeRows();
        if (bad.length) {
            if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, bad);
            return;
        }
        var dupes = checkDuplicateTypes();
        if (dupes.length > 0) {
            var msg = 'A range for the following type(s) already exists:\n' + dupes.join(', ') + '\n\nDo you still want to save?';
            if (typeof window.materialShowDeleteConfirmModalThen === 'function')
                window.materialShowDeleteConfirmModalThen(msg, submitSave);
            else if (confirm(msg)) submitSave();
        } else {
            submitSave();
        }
    }

    function handleDelete() {
        if (!selectedRow) return;
        const rangeId = selectedRow.querySelector('.row-id')?.value;
        function doDelete() {
            if (rangeId && rangeId !== '0') {
                fetch('@Url.Action("DeleteDocumentRange", "Document")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(rangeId)
                })
                .then(r => r.json())
                .then(response => {
                    if (response.success) {
                        selectedRow.remove(); selectedRow = null;
                        document.getElementById('btnDelete').disabled = true;
                        reIndex();
                    } else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(document.getElementById('docRangeForm'), [], response.message || 'Delete failed');
                    else alert(response.message || 'Delete failed');
                })
                .catch(() => {
                    if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(document.getElementById('docRangeForm'), [], 'Delete request failed');
                    else alert('Delete request failed');
                });
            } else {
                selectedRow.remove(); selectedRow = null;
                document.getElementById('btnDelete').disabled = true;
                reIndex();
            }
        }
        if (typeof window.materialShowDeleteConfirmModalThen === 'function')
            window.materialShowDeleteConfirmModalThen('Do you want to delete this Document Range?', doDelete);
        else if (confirm('Delete this entry?')) doDelete();
    }

    function reIndex() {
        const rows = document.querySelectorAll('#gridBody tr');
        rows.forEach((row, idx) => {
            row.querySelectorAll('[name]').forEach(el => {
                const name = el.name;
                var m = /^ranges\[(\d+)\]\.(.+)$/.exec(name);
                if (m) el.name = 'ranges[' + idx + '].' + m[2];
            });
        });
        rowCount = rows.length;
    }
</script>
