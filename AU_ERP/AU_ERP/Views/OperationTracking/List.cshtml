@model AU_ERP.Models.OperationTrackingListVm
@using AU_ERP.Models
@{
    ViewData["Title"] = "Operation Tracking";
    var listPlantId = Model.PlantId ?? "";
    ViewBag.ListPlantId = listPlantId;
    ViewBag.PlantFilterFormId = "otlListFilterForm";
    ViewBag.PlantHiddenInputId = "otlListPlant";
    ViewBag.PlantFilterModalId = "otlPlantFilterModal";
    ViewBag.PlantFilterModalPlantId = "otlModPlant";
    string OverallBadgeClass(string? label) => (label ?? "") switch
    {
        "Completed" => "otl-badge otl-done",
        "In progress" => "otl-badge otl-run",
        "On hold" => "otl-badge otl-hold",
        "Released" => "otl-badge otl-rel",
        "Planned" => "otl-badge otl-muted",
        "Pending" => "otl-badge otl-muted",
        _ => "otl-badge otl-muted"
    };
}

@section Styles {
    <style>
        .otl-page { color: var(--text, #32363a); max-width: 1200px; }
        .otl-hero { margin-bottom: 1.35rem; }
        .otl-hero h1 { font-size: 1.45rem; font-weight: 700; color: var(--dark, #354a5e); margin: 0 0 .35rem 0; letter-spacing: -0.02em; }
        .otl-hero p { margin: 0; color: var(--subtle, #6a7c8e); font-size: .92rem; max-width: 40rem; line-height: 1.45; }
        .otl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr)); gap: 1rem; }
        .otl-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: 1.05rem 1.15rem; box-shadow: var(--sh, 0 2px 8px rgba(0,0,0,.12)); border-top: 3px solid var(--blue, #0070f2); transition: box-shadow .15s, border-color .15s; }
        .otl-card:hover { box-shadow: var(--shl, 0 4px 20px rgba(0,0,0,.18)); border-color: #aaa; }
        .otl-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; margin-bottom: .65rem; }
        .otl-po { font-size: 1.05rem; font-weight: 700; color: var(--dark, #354a5e); }
        .otl-badge { display: inline-block; padding: .18rem .5rem; border-radius: 999px; font-size: .72rem; font-weight: 600; white-space: nowrap; }
        .otl-rel { background: #cff4fc; color: #055160; }
        .otl-run { background: #fff3cd; color: #664d03; }
        .otl-hold { background: #fde8d4; color: #7a4a12; }
        .otl-done { background: #d1e7dd; color: #0f5132; }
        .otl-muted { background: #eee; color: #555; }
        .otl-item { font-size: .82rem; color: #444; line-height: 1.35; margin-bottom: .65rem; min-height: 2.4rem; }
        .otl-meta { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem .75rem; font-size: .78rem; color: #666; margin-bottom: .85rem; }
        .otl-meta span { color: #999; display: block; font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
        .otl-progress { height: .35rem; background: #e8ecec; border-radius: 999px; overflow: hidden; margin-bottom: .75rem; }
        .otl-progress-fill { height: 100%; background: linear-gradient(90deg, var(--blue, #0070f2), var(--accent, #0053b3)); border-radius: 999px; min-width: 2px; transition: width .25s ease; }
        .otl-actions { display: flex; flex-wrap: wrap; gap: .45rem; }
        .otl-actions .btn { font-size: .78rem; padding: .32rem .65rem; border-radius: .35rem; }
        .otl-empty { text-align: center; padding: 2.5rem 1rem; color: var(--subtle, #6a7c8e); background: var(--bg, #f5f6f7); border-radius: 4px; border: 1px dashed var(--border, #d9d9d9); }
    </style>
}

<div class="otl-page">
    <div class="otl-hero">
        <h1>Operation tracking</h1>
        <p>Monitor and open production orders that have released routings and stage progress.</p>
    </div>

    <partial name="_OperationalPlantFilter" />

    <form id="otlListFilterForm" method="get" asp-controller="OperationTracking" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#otlPlantFilterModal">Plant filter</button>
        <a class="btn btn-sm btn-link text-secondary" asp-action="Index">Clear filters</a>
    </form>

    @if (Model.Orders.Count == 0)
    {
        <div class="otl-empty">
            <p class="mb-2 fw-semibold text-dark">No orders in tracking</p>
            <p class="small mb-0">Complete Reservation Issue for a planned production order to create stages here.</p>
        </div>
    }
    else
    {
        <div class="otl-grid">
            @foreach (var o in Model.Orders)
            {
                var pct = o.StagesTotal > 0 ? (int)Math.Round(100.0 * o.StagesCompleted / o.StagesTotal) : 0;
                var uom = string.IsNullOrWhiteSpace(o.UomCode) ? "" : o.UomCode;
                var canOpenGr = o.StagesTotal > 0 && o.StagesCompleted == o.StagesTotal && !o.GoodsReceiptPosted;
                var grDisabledTitle = o.GoodsReceiptPosted
                    ? "Quality inspection has already been posted for this order."
                    : (o.StagesTotal == 0 || o.StagesCompleted < o.StagesTotal
                        ? "Complete all operation stages on this order before posting quality inspection."
                        : "");
                <article class="otl-card">
                    <div class="otl-card-top">
                        <div class="otl-po">PO-@o.ProductionNumber</div>
                        <span class="@OverallBadgeClass(o.OverallStatusLabel)">@o.OverallStatusLabel</span>
                    </div>
                    <div class="otl-item">@(string.IsNullOrWhiteSpace(o.FinishedItemLabel) ? "—" : o.FinishedItemLabel)</div>
                    <div class="otl-meta">
                        <div><span>Target</span>@UiNumberFormat.D2(o.TargetQuantity) @uom</div>
                        <div><span>Stages</span>@o.StagesCompleted / @o.StagesTotal · @o.OverallStatusLabel</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(o.ActiveStageTitle))
                    {
                        <div class="small text-muted mb-2"><i class="bi bi-play-circle text-primary"></i> Active: <strong class="text-dark">@o.ActiveStageTitle</strong></div>
                    }
                    <div class="otl-progress" title="@o.StagesCompleted of @o.StagesTotal stages complete"><div class="otl-progress-fill" style="width:@(pct)%"></div></div>
                    <div class="otl-actions">
                        <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-productionOrderId="@o.ProductionOrderId">View tracking</a>
                        @if (canOpenGr)
                        {
                            <form asp-controller="GoodReceipt" asp-action="CreateOrOpen" asp-route-productionOrderId="@o.ProductionOrderId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-box-seam me-1"></i>Quality inspection
                                </button>
                            </form>
                        }
                        else if (o.GoodsReceiptPosted)
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled
                                    title="Quality inspection has already been posted for this order.">
                                <i class="bi bi-check2-circle me-1"></i>Quality inspection posted
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-success btn-sm"
                                    disabled
                                    title="@grDisabledTitle">
                                <i class="bi bi-box-seam me-1"></i>Quality inspection
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>


