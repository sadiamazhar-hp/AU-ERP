@model List<AU_ERP.Models.Charge>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Charges";
    ViewBag.Title = "Charges";
    var safeModel = Model ?? new List<AU_ERP.Models.Charge>();
    var tNum = AU_ERP.Models.Charge.TypeNumeric;
    var tPct = AU_ERP.Models.Charge.TypePercentage;
    var sAdd = AU_ERP.Models.Charge.SignAdd;
    var sSub = AU_ERP.Models.Charge.SignSubtract;
}

@if (TempData["ChargeMessage"] is string ok)
{
    <div class="alert alert-success py-2 small mb-2" role="status">@ok</div>
}
@if (TempData["ChargeError"] is string err)
{
    <div class="alert alert-danger py-2 small mb-2" role="status">@err</div>
}

<div class="sap-window" id="app">
    <form id="chargesForm" method="post" action="@Url.Action("Index", "Charges")">
        @Html.AntiForgeryToken()
        <div class="au-validation-summary" id="chargesValSummary" style="display:none;" role="alert"></div>

        <div class="sap-toolbar">
            <div class="d-flex">
                <button type="button" id="btnEdit" class="btn btn-sap" onclick="setMode(true)">Edit</button>
                <button type="button" id="btnNew" class="btn btn-sap" onclick="addNewRow()" disabled>New Entries</button>
                <button type="button" id="btnSave" class="btn btn-sap" onclick="handleSave()" disabled>Save</button>
                <button type="button" id="btnDelete" class="btn btn-sap text-danger" onclick="handleDelete()" disabled>Delete</button>
            </div>
        </div>

        <div class="table-container">
            <table class="table-sap">
                <thead>
                    <tr>
                        <th style="width: 35px;">Sel</th>
                        <th style="width: 120px;">Symbol</th>
                        <th>Description</th>
                        <th style="width: 120px;">Type</th>
                        <th style="width: 120px;">Effect</th>
                    </tr>
                </thead>
                <tbody id="gridBody">
                    @for (int i = 0; i < safeModel.Count; i++)
                    {
                        <tr>
                            <td class="col-sel" onclick="selectRow(this)">
                                <input type="hidden" name="[@i].Id" value="@safeModel[i].Id" class="row-id" />
                            </td>
                            <td>
                                <input name="[@i].Symbol" class="sap-input" value="@safeModel[i].Symbol" readonly maxlength="32" data-required="true" />
                            </td>
                            <td>
                                <input name="[@i].Description" class="sap-input" value="@safeModel[i].Description" readonly maxlength="500" data-required="true" />
                            </td>
                            <td>
                                <select name="[@i].ValueType" class="sap-input sap-select" data-required="true" disabled>
                                    @if (safeModel[i].ValueType == tNum)
                                    {
                                        <option value="@tNum" selected>Numeric</option>
                                        <option value="@tPct">Percentage</option>
                                    }
                                    else
                                    {
                                        <option value="@tNum">Numeric</option>
                                        <option value="@tPct" selected>Percentage</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select name="[@i].Sign" class="sap-input sap-select" data-required="true" disabled>
                                    @if (safeModel[i].Sign == sAdd)
                                    {
                                        <option value="@sAdd" selected>Add</option>
                                        <option value="@sSub">Subtract</option>
                                    }
                                    else
                                    {
                                        <option value="@sAdd">Add</option>
                                        <option value="@sSub" selected>Subtract</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    :root {
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
        --sap-focus: #fff9c4;
    }
    .sap-window { background: white; border: 1px solid var(--sap-border); display: flex; flex-direction: column; min-height: 420px; }
    .sap-toolbar { padding: 12px; border-bottom: 2px solid var(--sap-border); background: #fff; display: flex; justify-content: flex-end; align-items: center; }
    .btn-sap { border-radius: 2px; font-size: 12px; border: 1px solid #bbb; margin-right: 5px; background: #fdfdfd; cursor: pointer; }
    .btn-sap:disabled { opacity: 0.4; cursor: default; }
    .table-container { overflow-y: auto; flex-grow: 1; }
    .table-sap { width: 100%; border-collapse: collapse; }
    .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; text-align: left; }
    .table-sap td { border: 1px solid #ccc; padding: 0; height: 30px; }
    .sap-input { width: 100%; height: 100%; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    select.sap-input.sap-select { cursor: default; }
    .edit-mode .sap-input:not([readonly]):not([disabled]) { background: #fff; }
    .edit-mode select.sap-input.sap-select:not([disabled]) { background: #fff; cursor: pointer; }
    .edit-mode .sap-input:focus { background: var(--sap-focus); outline: 1px solid orange; }
    .col-sel { width: 35px; background: #f0f0f0; cursor: pointer; }
    .row-selected { background-color: var(--sap-selected) !important; }
    .row-selected .sap-input { background-color: transparent !important; }
</style>
<script>
    const tNum = "@tNum", tPct = "@tPct", sAdd = "@sAdd", sSub = "@sSub";
    let isEditMode = false;
    let selectedRow = null;
    let rowCount = @(safeModel.Count);

    function setSelectsEnabled(edit) {
        document.querySelectorAll('select.sap-select').forEach(function (sel) {
            sel.disabled = !edit;
        });
    }

    function setMode(edit) {
        isEditMode = edit;
        document.getElementById('app').classList.toggle('edit-mode', edit);
        document.querySelectorAll('.sap-input:not(.sap-select)').forEach(function (input) {
            input.readOnly = !edit;
        });
        setSelectsEnabled(edit);
        document.getElementById('btnEdit').disabled = edit;
        document.getElementById('btnNew').disabled = !edit;
        document.getElementById('btnSave').disabled = !edit;
        var f = document.getElementById('chargesForm');
        if (f && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(f);
    }

    function typeOptionsHtml(selectedNum) {
        const selNum = selectedNum ? ' selected' : '';
        const selPct = !selectedNum ? ' selected' : '';
        return '<option value="' + tNum + '"' + selNum + '>Numeric</option><option value="' + tPct + '"' + selPct + '>Percentage</option>';
    }
    function signOptionsHtml(selectedAdd) {
        const selA = selectedAdd ? ' selected' : '';
        const selS = !selectedAdd ? ' selected' : '';
        return '<option value="' + sAdd + '"' + selA + '>Add</option><option value="' + sSub + '"' + selS + '>Subtract</option>';
    }

    function addNewRow() {
        const body = document.getElementById('gridBody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="col-sel" onclick="selectRow(this)">
                <input type="hidden" name="[${rowCount}].Id" value="0" class="row-id" />
            </td>
            <td><input name="[${rowCount}].Symbol" class="sap-input" maxlength="32" data-required="true" /></td>
            <td><input name="[${rowCount}].Description" class="sap-input" maxlength="500" data-required="true" /></td>
            <td><select name="[${rowCount}].ValueType" class="sap-input sap-select" data-required="true">${typeOptionsHtml(false)}</select></td>
            <td><select name="[${rowCount}].Sign" class="sap-input sap-select" data-required="true">${signOptionsHtml(false)}</select></td>`;
        body.appendChild(tr);
        rowCount++;
        if (isEditMode) {
            tr.querySelectorAll('select.sap-select').forEach(s => s.disabled = false);
        } else {
            tr.querySelectorAll('select.sap-select').forEach(s => s.disabled = true);
        }
        tr.querySelector('input[data-required]').focus();
    }

    function selectRow(cell) {
        if (!isEditMode) return;
        if (selectedRow) selectedRow.classList.remove('row-selected');
        selectedRow = cell.parentElement;
        selectedRow.classList.add('row-selected');
        document.getElementById('btnDelete').disabled = false;
    }

    function collectInvalidRows() {
        const bad = [];
        document.querySelectorAll('#gridBody tr').forEach(function (tr) {
            tr.querySelectorAll('.sap-input[data-required]').forEach(function (inp) {
                if (inp.tagName === 'SELECT') {
                    if (!inp.value) bad.push(inp);
                } else if (!inp.value.trim()) {
                    bad.push(inp);
                }
            });
        });
        return bad;
    }

    function handleSave() {
        const form = document.getElementById('chargesForm');
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(form);
        const bad = collectInvalidRows();
        if (bad.length) {
            if (typeof window.auShowInlineValidation === "function") window.auShowInlineValidation(form, bad);
            return;
        }
        document.querySelectorAll('.sap-input').forEach(i => { if (i.readOnly !== undefined) i.readOnly = false; });
        document.querySelectorAll('select.sap-select').forEach(s => { s.disabled = false; });
        const fd = new FormData(form);
        fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (data.success) { location.reload(); }
                else if (typeof window.auShowInlineValidation === "function") window.auShowInlineValidation(form, [], data.message || 'Save failed');
                else alert(data.message || 'Save failed');
            })
            .catch(() => {
                if (typeof window.auShowInlineValidation === "function") window.auShowInlineValidation(form, [], 'Request failed');
                else alert('Request failed');
            });
    }

    function handleDelete() {
        if (!selectedRow) return;
        const idInput = selectedRow.querySelector('.row-id');
        const id = idInput ? idInput.value : '';
        function doDelete() {
            if (id && id !== '0') {
                fetch('@Url.Action("DeleteCharge", "Charges")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(id)
                })
                .then(r => r.json())
                .then(response => {
                    if (response.success) {
                        selectedRow.remove(); selectedRow = null;
                        document.getElementById('btnDelete').disabled = true;
                        reIndexAllRows();
                        if (typeof window.materialShowSuccessModal === 'function')
                            window.materialShowSuccessModal(response.message || 'Deleted !');
                    } else if (typeof window.auShowInlineValidation === "function")
                        window.auShowInlineValidation(document.getElementById('chargesForm'), [], response.message || 'Delete failed');
                    else alert(response.message || 'Delete failed');
                })
                .catch(() => {
                    if (typeof window.auShowInlineValidation === "function")
                        window.auShowInlineValidation(document.getElementById('chargesForm'), [], 'Delete request failed');
                    else alert('Delete request failed');
                });
            } else {
                selectedRow.remove(); selectedRow = null; reIndexAllRows();
            }
        }
        if (typeof window.materialShowDeleteConfirmModalThen === 'function')
            window.materialShowDeleteConfirmModalThen('Do you want to delete this charge?', doDelete);
        else if (confirm('Delete this entry?')) doDelete();
    }

    function reIndexAllRows() {
        const rows = document.querySelectorAll('#gridBody tr');
        rows.forEach((row, index) => {
            row.querySelectorAll('[name]').forEach(el => {
                const name = el.name;
                if (name.includes('.')) {
                    const property = name.split('.').slice(1).join('.');
                    el.name = `[${index}].${property}`;
                }
            });
        });
        rowCount = rows.length;
    }

    (function init() {
        setSelectsEnabled(false);
    })();
</script>
