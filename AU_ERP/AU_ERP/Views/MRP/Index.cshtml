@{
    ViewData["Title"] = "MRP";
}

@section Styles {
    <style>
        .mrp-page { color: var(--text, #32363a); }
        .mrp-hero { margin-bottom: 1rem; }
        .mrp-hero h1 { font-size: 1.35rem; font-weight: 600; color: var(--dark, #354a5e); margin: 0 0 .25rem 0; }
        .mrp-hero p { margin: 0; color: var(--subtle, #6a7c8e); font-size: .9rem; }
        .mrp-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: 1rem 1.1rem; margin-bottom: 1rem; box-shadow: var(--sh, 0 2px 8px rgba(0,0,0,.12)); }
    </style>
}

<div class="mrp-page">
    <div class="mrp-hero">
        <h1>Material Requirements Planning</h1>
        <p>Select date range, add multiple FERT lines, auto-fill demand quantity/UOM from Sales Orders, then run MRP.</p>
    </div>

    <div class="mrp-card">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-3">
                <label class="form-label small">From date</label>
                <input type="date" id="mrpFromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">To date</label>
                <input type="date" id="mrpToDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary mt-4" id="mrpAddLine">Add line</button>
                <button type="button" class="btn btn-sm btn-primary mt-4" id="mrpRunMultiBtn">Run Multi MRP</button>
                <button type="button" class="btn btn-sm btn-success mt-4" id="mrpCreatePoBtn" style="display:none;">Create Production Order</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead>
                    <tr>
                        <th style="width:34%;">Material</th>
                        <th style="width:18%;">Quantity (auto)</th>
                        <th style="width:18%;">UOM (auto)</th>
                        <th style="width:20%;">Status</th>
                        <th style="width:10%;"></th>
                    </tr>
                </thead>
                <tbody id="mrpLinesBody"></tbody>
            </table>
        </div>
        <div class="small mt-2" id="mrpMsg"></div>
    </div>

    <div class="mrp-card" id="mrpResultsCard" style="display:none;">
        <h2 class="h6 mb-3">MRP BOM Results (per material)</h2>
        <div id="mrpResultsBody"></div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const demandUrl = "@Url.Action("DemandForMaterial", "MRP")";
    const fertUrl = "@Url.Action("FertMaterials", "MRP")";
    const runMultiUrl = "@Url.Action("RunMulti", "MRP")";
    const createPoUrl = "@Url.Action("CreateFromMrpMulti", "ProductionOrder")";
    const poIndexUrl = "@Url.Action("Index", "ProductionOrder")";

    const linesBody = document.getElementById("mrpLinesBody");
    const fromEl = document.getElementById("mrpFromDate");
    const toEl = document.getElementById("mrpToDate");
    const msgEl = document.getElementById("mrpMsg");
    const createPoBtn = document.getElementById("mrpCreatePoBtn");
    const resultsCard = document.getElementById("mrpResultsCard");
    const resultsBody = document.getElementById("mrpResultsBody");

    let fertItems = [];
    let lastMulti = null;

    function setMsg(msg, ok) {
        msgEl.className = "small mt-2 " + (ok ? "text-success" : "text-danger");
        msgEl.textContent = msg || "";
    }

    function fmtQty(v) {
        const n = Number(v);
        return isNaN(n) ? "" : n.toFixed(4).replace(/\.?0+$/, "");
    }

    function buildLineRow() {
        const tr = document.createElement("tr");
        tr.innerHTML =
            '<td><select class="form-select form-select-sm mrp-line-mat"><option value="">-- Select material --</option></select></td>' +
            '<td><input type="number" class="form-control form-control-sm mrp-line-qty" step="0.0001" readonly></td>' +
            '<td><input type="text" class="form-control form-control-sm mrp-line-uom" readonly><input type="hidden" class="mrp-line-uom-id"></td>' +
            '<td><span class="small text-muted mrp-line-status">Waiting</span></td>' +
            '<td><button type="button" class="btn btn-sm btn-outline-danger mrp-del-line">×</button></td>';
        const sel = tr.querySelector(".mrp-line-mat");
        fertItems.forEach(function (m) {
            const opt = document.createElement("option");
            opt.value = m.materialNumber || m.MaterialNumber || "";
            const desc = m.description || m.Description || "";
            opt.textContent = opt.value + (desc ? (" — " + desc) : "");
            sel.appendChild(opt);
        });
        return tr;
    }

    function readLinePayload(tr) {
        const materialNumber = (tr.querySelector(".mrp-line-mat").value || "").trim();
        const quantity = parseFloat(tr.querySelector(".mrp-line-qty").value || "0") || 0;
        const uomId = parseInt(tr.querySelector(".mrp-line-uom-id").value || "0", 10) || 0;
        return { materialNumber, quantity, uomId };
    }

    function setLineStatus(tr, text, ok) {
        const el = tr.querySelector(".mrp-line-status");
        el.textContent = text;
        el.className = "small mrp-line-status " + (ok ? "text-success" : "text-danger");
    }

    function renderMultiResults(res) {
        const lines = (res && (res.lines || res.Lines)) ? (res.lines || res.Lines) : [];
        resultsBody.innerHTML = "";
        if (!lines.length) {
            resultsCard.style.display = "none";
            return;
        }
        lines.forEach(function (ln, idx) {
            const result = ln.result || ln.Result || {};
            const rows = result.rows || result.Rows || [];
            const mat = ln.materialNumber || ln.MaterialNumber || "";
            const qty = ln.quantity != null ? ln.quantity : ln.Quantity;
            const ok = !!result.success;
            const allSat = !!(result.allSatisfied || result.AllSatisfied);

            let html = '<div class="mb-3 p-2 border rounded">';
            html += '<div class="fw-semibold mb-1">' + (idx + 1) + '. ' + mat + ' (Qty: ' + fmtQty(qty) + ')</div>';
            html += '<div class="small ' + (ok ? (allSat ? 'text-success' : 'text-warning') : 'text-danger') + ' mb-2">'
                + ((result.message || result.Message || (ok ? 'MRP completed.' : 'MRP failed.')))
                + '</div>';
            if (!rows.length) {
                html += '<div class="small text-muted">No BOM rows returned.</div>';
            } else {
                html += '<div class="table-responsive"><table class="table table-sm table-bordered mb-0">';
                html += '<thead><tr><th>Component</th><th>Type</th><th>Required</th><th>Stock</th><th>Status</th></tr></thead><tbody>';
                rows.forEach(function (r) {
                    const cMat = r.materialNumber || r.MaterialNumber || "";
                    const cType = r.materialTypeCode || r.MaterialTypeCode || "";
                    const req = r.requiredQty != null ? r.requiredQty : r.RequiredQty;
                    const stock = r.onHandQty != null ? r.onHandQty : r.OnHandQty;
                    const uom = r.requiredUomCode || r.RequiredUomCode || "";
                    const short = !!(r.shortage || r.Shortage);
                    html += '<tr' + (short ? ' class="table-danger"' : '') + '>';
                    html += '<td>' + cMat + '</td>';
                    html += '<td>' + cType + '</td>';
                    html += '<td>' + fmtQty(req) + ' ' + uom + '</td>';
                    html += '<td>' + fmtQty(stock) + ' ' + uom + '</td>';
                    html += '<td>' + (short ? 'Short' : 'OK') + '</td>';
                    html += '</tr>';
                });
                html += '</tbody></table></div>';
            }
            html += '</div>';
            resultsBody.insertAdjacentHTML("beforeend", html);
        });
        resultsCard.style.display = "";
    }

    function fetchDemandForLine(tr) {
        const materialNumber = (tr.querySelector(".mrp-line-mat").value || "").trim();
        const from = (fromEl.value || "").trim();
        const to = (toEl.value || "").trim();
        const qtyEl = tr.querySelector(".mrp-line-qty");
        const uomEl = tr.querySelector(".mrp-line-uom");
        const uomIdEl = tr.querySelector(".mrp-line-uom-id");

        qtyEl.value = "";
        uomEl.value = "";
        uomIdEl.value = "";
        if (!materialNumber) { setLineStatus(tr, "Select material", false); return; }
        if (!from || !to) { setLineStatus(tr, "Select from/to date", false); return; }

        setLineStatus(tr, "Loading demand...", true);
        fetch(demandUrl + "?materialNumber=" + encodeURIComponent(materialNumber) + "&from=" + encodeURIComponent(from) + "&to=" + encodeURIComponent(to))
            .then(r => r.json())
            .then(res => {
                if (!res || !res.success) {
                    setLineStatus(tr, (res && res.message) || "Demand failed", false);
                    return;
                }
                const qty = Number(res.qtyBase || 0);
                qtyEl.value = fmtQty(qty);
                uomEl.value = (res.baseUomCode || "");
                uomIdEl.value = String(res.baseUomId || 0);
                setLineStatus(tr, qty > 0 ? "Demand loaded" : "No demand in range", qty > 0);
            })
            .catch(() => setLineStatus(tr, "Demand failed", false));
    }

    function collectRunLines() {
        const out = [];
        linesBody.querySelectorAll("tr").forEach(function (tr) {
            const p = readLinePayload(tr);
            if (!p.materialNumber) return;
            if (!(p.quantity > 0) || !(p.uomId > 0)) return;
            out.push({
                materialNumber: p.materialNumber,
                quantity: p.quantity,
                uomId: p.uomId
            });
        });
        return out;
    }

    function addLine() {
        linesBody.appendChild(buildLineRow());
    }

    document.getElementById("mrpAddLine").addEventListener("click", addLine);
    linesBody.addEventListener("change", function (e) {
        const tr = e.target.closest("tr");
        if (!tr) return;
        if (e.target.classList.contains("mrp-line-mat")) fetchDemandForLine(tr);
    });
    linesBody.addEventListener("click", function (e) {
        const btn = e.target.closest(".mrp-del-line");
        if (!btn) return;
        btn.closest("tr")?.remove();
    });
    fromEl.addEventListener("change", function () { linesBody.querySelectorAll("tr").forEach(fetchDemandForLine); });
    toEl.addEventListener("change", function () { linesBody.querySelectorAll("tr").forEach(fetchDemandForLine); });

    document.getElementById("mrpRunMultiBtn").addEventListener("click", function () {
        const lines = collectRunLines();
        if (!fromEl.value || !toEl.value) { setMsg("From date and To date are required.", false); return; }
        if (!lines.length) { setMsg("Add at least one valid line (material with demand).", false); return; }
        fetch(runMultiUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ lines: lines })
        }).then(r => r.json()).then(res => {
            renderMultiResults(res);
            if (!res || !res.success) {
                setMsg((res && res.message) || "Multi MRP failed.", false);
                createPoBtn.style.display = "none";
                return;
            }
            lastMulti = res;
            const allOk = !!(res.allSatisfied || res.AllSatisfied);
            setMsg((res.message || "MRP completed.") + (allOk ? " All lines satisfied." : " Some lines have shortages/errors."), allOk);
            createPoBtn.style.display = allOk ? "" : "none";
        }).catch(() => {
            resultsCard.style.display = "none";
            setMsg("Request failed.", false);
            createPoBtn.style.display = "none";
        });
    });

    createPoBtn.addEventListener("click", function () {
        if (!lastMulti) return;
        const src = (lastMulti.lines || lastMulti.Lines || []).filter(function (x) {
            const r = x.result || x.Result || {};
            return !!r.success && !!r.allSatisfied;
        });
        if (!src.length) { setMsg("No eligible lines to create Production Order.", false); return; }
        const payload = {
            plannedStartDate: fromEl.value,
            plannedEndDate: toEl.value,
            priority: "Medium",
            remarks: "Created from MRP multi demand range",
            lines: src.map(function (x, i) {
                return {
                    lineNo: i + 1,
                    materialNumber: x.materialNumber || x.MaterialNumber || "",
                    materialDescription: x.description || x.Description || "",
                    plannedQuantity: x.quantity || x.Quantity || 0,
                    uomId: x.uomId || x.UomId || 0
                };
            })
        };
        fetch(createPoUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        }).then(r => r.json()).then(res => {
            if (res && res.success) {
                window.location.href = poIndexUrl;
                return;
            }
            setMsg((res && res.message) || "Could not create Production Order.", false);
        }).catch(() => setMsg("Request failed.", false));
    });

    fetch(fertUrl).then(r => r.json()).then(res => {
        fertItems = (res && res.success && (res.data || res.Data)) ? (res.data || res.Data) : [];
        addLine();
    }).catch(() => {
        setMsg("Could not load FERT materials.", false);
    });
})();
</script>
}
