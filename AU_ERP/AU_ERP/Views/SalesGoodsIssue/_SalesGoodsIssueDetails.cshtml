@model AU_ERP.Models.SalesGoodsIssueDocument

<div class="mb-2">
    <div><strong>GI Number:</strong> @Model.DocumentNumber</div>
    <div><strong>Date:</strong> @Model.DocumentDate.ToString("dd-MMM-yyyy")</div>
    <div><strong>Status:</strong> @Model.Status</div>
    <div><strong>Dispatch:</strong> @Model.DispatchStatus@if (Model.DispatchSentAt is DateTime sds){<text> (sent @sds.ToString("dd-MMM-yyyy HH:mm"))</text>}</div>
    <div><strong>Sales Order:</strong> @(Model.SalesOrder?.SalesOrderNumber ?? ("SO-" + Model.SalesOrderId))</div>
    <div><strong>Customer:</strong> @(Model.SalesOrder?.CustomerName ?? "—")</div>
</div>

@if (Model.Lines == null || !Model.Lines.Any())
{
    <div class="text-secondary">No lines found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>Material Number</th>
                    <th>Description</th>
                    <th>Grade</th>
                    <th class="text-end">Required</th>
                    <th class="text-end">Issued</th>
                    <th class="text-end">Remaining</th>
                    <th>UOM</th>
                    <th>Batch</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var l in Model.Lines.OrderBy(x => x.Id))
            {
                <tr>
                    <td>@l.MaterialNumber</td>
                    <td>@l.MaterialDescription</td>
                    <td>@(string.IsNullOrWhiteSpace(l.SalesPriceGrade) ? "A" : l.SalesPriceGrade)</td>
                    <td class="text-end">@l.RequiredQty.ToString("0.####")</td>
                    <td class="text-end">@l.IssuedQty.ToString("0.####")</td>
                    <td class="text-end">@l.RemainingQty.ToString("0.####")</td>
                    <td>@(l.RequiredUom?.Code ?? "—")</td>
                    <td>@(l.BatchSummary ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
