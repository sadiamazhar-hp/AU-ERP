@using AU_ERP.Models.ViewModels
@model AU_ERP.Models.ViewModels.InvoiceIndexVm
@using System.Globalization
@using System.Text.Json
@using AU_ERP.Models
@using AU_ERP.Controllers
@{
    ViewData["Title"] = "Invoice";
    string FmtMoney(decimal v) => v.ToString("N2", CultureInfo.CurrentCulture);
    var payPrefillUrl = Url.Action("PaymentPrefill", "Invoice") ?? "";
    var payCreateUrl = Url.Action("CreatePayment", "Invoice") ?? "";
    var plants = ViewBag.Plants as List<PlantsSample> ?? new List<PlantsSample>();
    var missingPlantAssignment = ViewBag.MissingPlantAssignment as bool? == true;
    var isSinglePlantLocked = ViewBag.IsSinglePlantLocked as bool? == true;
    var lockedPlantId = ViewBag.LockedPlantId as string ?? "";
    var filterPlantId = Model.FilterPlantId ?? "";
    PlantsSample? InvPlantNameRow(string pid) =>
        plants.FirstOrDefault(p => string.Equals(p.PlantID, pid, StringComparison.OrdinalIgnoreCase));
}

@section Styles {
    <style>
        .inv-page { color: var(--text, #32363a); }
        .inv-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-bottom: 1.25rem; }
        @@media (max-width: 1100px) { .inv-stats { grid-template-columns: repeat(2, 1fr) !important; } }
        @@media (max-width: 900px) { .inv-stats { grid-template-columns: 1fr !important; } }
        .inv-stat-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: .85rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,.08); border-top: 3px solid var(--blue, #0070f2); }
        .inv-stat-card.inv-stat-overdue { border-top-color: #c62828; }
        .inv-stat-card.inv-stat-collected { border-top-color: #2e7d32; }
        .inv-stat-card.inv-stat-rip { border-top-color: #ef6c00; }
        .inv-stat-label { font-size: .72rem; font-weight: 600; letter-spacing: .04em; color: #6a7c8e; text-transform: uppercase; }
        .inv-stat-val { font-size: 1.35rem; font-weight: 600; color: #354a5e; margin-top: .2rem; }
        .inv-stat-sub { font-size: .8rem; color: #6a7c8e; margin-top: .15rem; }
        .inv-table-card { background: #fff; border: 1px solid #d9d9d9; border-radius: 4px; padding: 1rem 1.1rem; }
        .inv-table-wrap { overflow-x: auto; }
        .inv-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
        .inv-table thead th { background: #354a5e; color: #fff; font-weight: 500; padding: .55rem .65rem; text-align: left; white-space: nowrap; }
        .inv-table tbody td { border: 1px solid #ddd; padding: .45rem .6rem; vertical-align: middle; }
        .inv-table tbody tr:nth-child(even) { background: #fafafa; }
    </style>
}

<div class="inv-page">
    @if (TempData["InvoiceError"] is string ie && !string.IsNullOrWhiteSpace(ie))
    {
        <div class="alert alert-danger py-2 mb-3" role="alert">@ie</div>
    }
    @if (TempData["InvoiceMessage"] is string im && !string.IsNullOrWhiteSpace(im))
    {
        <div class="alert alert-success py-2 mb-3" role="status">@im</div>
    }
    @if (TempData["RoError"] is string roe && !string.IsNullOrWhiteSpace(roe))
    {
        <div class="alert alert-danger py-2 mb-3" role="alert">@roe</div>
    }
    @if (TempData["RoMessage"] is string rom && !string.IsNullOrWhiteSpace(rom))
    {
        <div class="alert alert-success py-2 mb-3" role="status">@rom</div>
    }
    @if (missingPlantAssignment)
    {
        <div class="alert alert-warning py-2 small mb-3" role="status">
            You have no plant assigned to your profile. Ask an administrator to edit your user and select at least one plant for the Sales or Store department.
        </div>
    }
    <h1 class="h4 mb-3">Invoice</h1>

    <div class="inv-table-card mb-3">
        <h2 class="h6 mb-3">Filters</h2>
        <form asp-action="Index" method="get" class="row g-2 gy-3 align-items-end">
            <div class="col-12 col-md-4 col-lg-3">
                <label class="form-label mb-1 small text-secondary">Search</label>
                <input type="search" name="q" value="@Model.SearchQuery" class="form-control form-control-sm" maxlength="160" autocomplete="off" placeholder="Invoice no., DC no., dealer ID or name…" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label mb-1 small text-secondary">Status</label>
                <select name="status" class="form-select form-select-sm" id="invStatusFilter">
                    @{
                        var cur = Model.StatusFilter ?? "";
                    }
                    @if (string.IsNullOrEmpty(cur))
                    {
                        <option value="" selected="selected">All</option>
                    }
                    else
                    {
                        <option value="">All</option>
                    }
                    @if (string.Equals(cur, InvoiceController.InvoiceIndexStatusFilterOpen, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@InvoiceController.InvoiceIndexStatusFilterOpen" selected="selected">Open (not overdue)</option>
                    }
                    else
                    {
                        <option value="@InvoiceController.InvoiceIndexStatusFilterOpen">Open (not overdue)</option>
                    }
                    @if (string.Equals(cur, InvoiceController.InvoiceIndexStatusFilterOverdue, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@InvoiceController.InvoiceIndexStatusFilterOverdue" selected="selected">Open — overdue</option>
                    }
                    else
                    {
                        <option value="@InvoiceController.InvoiceIndexStatusFilterOverdue">Open — overdue</option>
                    }
                    @if (string.Equals(cur, SalesInvoice.StatusCollected, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@SalesInvoice.StatusCollected" selected="selected">@SalesInvoice.StatusCollected</option>
                    }
                    else
                    {
                        <option value="@SalesInvoice.StatusCollected">@SalesInvoice.StatusCollected</option>
                    }
                    @if (string.Equals(cur, SalesInvoice.StatusReturnInProcess, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@SalesInvoice.StatusReturnInProcess" selected="selected">@SalesInvoice.StatusReturnInProcess</option>
                    }
                    else
                    {
                        <option value="@SalesInvoice.StatusReturnInProcess">@SalesInvoice.StatusReturnInProcess</option>
                    }
                    @if (string.Equals(cur, SalesInvoice.StatusReturned, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@SalesInvoice.StatusReturned" selected="selected">@SalesInvoice.StatusReturned</option>
                    }
                    else
                    {
                        <option value="@SalesInvoice.StatusReturned">@SalesInvoice.StatusReturned</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label mb-1 small text-secondary">Plant</label>
                @if (isSinglePlantLocked && !string.IsNullOrWhiteSpace(lockedPlantId))
                {
                    var lockPn = InvPlantNameRow(lockedPlantId.Trim());
                    <input type="hidden" name="plantId" value="@lockedPlantId.Trim()" />
                    <input type="text" class="form-control form-control-sm bg-light" readonly value="@(lockPn?.PlantName ?? lockedPlantId)" title="Assigned plant" />
                }
                else if (!missingPlantAssignment)
                {
                    <select name="plantId" class="form-select form-select-sm" id="invPlantFilter">
                        <option value="">All assigned</option>
                        @foreach (var p in plants)
                        {
                            if (string.Equals(p.PlantID, filterPlantId, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@p.PlantID" selected="selected">@p.PlantName</option>
                            }
                            else
                            {
                                <option value="@p.PlantID">@p.PlantName</option>
                            }
                        }
                    </select>
                }
                else
                {
                    <input type="text" class="form-control form-control-sm bg-light" readonly value="—" title="No plants assigned" />
                }
            </div>
            <div class="col-6 col-md-2 col-lg-2">
                <label class="form-label mb-1 small text-secondary">Doc. date from</label>
                <input type="date" name="docFrom" class="form-control form-control-sm" value="@(Model.DocumentDateFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
            </div>
            <div class="col-6 col-md-2 col-lg-2">
                <label class="form-label mb-1 small text-secondary">Doc. date to</label>
                <input type="date" name="docTo" class="form-control form-control-sm" value="@(Model.DocumentDateTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
            </div>
            <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>

    <div class="inv-stats" style="grid-template-columns: repeat(4, 1fr);">
        <div class="inv-stat-card">
            <div class="inv-stat-label">Open</div>
            <div class="inv-stat-val">@FmtMoney(Model.OpenAmount)</div>
            <div class="inv-stat-sub">@Model.OpenCount.ToString("N0", CultureInfo.CurrentCulture) document(s)</div>
        </div>
        <div class="inv-stat-card inv-stat-overdue">
            <div class="inv-stat-label">Overdue</div>
            <div class="inv-stat-val">@FmtMoney(Model.OverdueAmount)</div>
            <div class="inv-stat-sub">@Model.OverdueCount.ToString("N0", CultureInfo.CurrentCulture) document(s)</div>
        </div>
        <div class="inv-stat-card inv-stat-collected">
            <div class="inv-stat-label">Collected</div>
            <div class="inv-stat-val">@FmtMoney(Model.CollectedAmount)</div>
            <div class="inv-stat-sub">@Model.CollectedCount.ToString("N0", CultureInfo.CurrentCulture) document(s)</div>
        </div>
        <div class="inv-stat-card inv-stat-rip">
            <div class="inv-stat-label">Return in process</div>
            <div class="inv-stat-val">@FmtMoney(Model.ReturnInProcessAmount)</div>
            <div class="inv-stat-sub">@Model.ReturnInProcessCount.ToString("N0", CultureInfo.CurrentCulture) document(s)</div>
        </div>
    </div>

    <div class="inv-table-card">
        <h2 class="h6 mb-3">Invoices (@Model.Invoices.Count)</h2>
        <div class="inv-table-wrap">
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>Document No.</th>
                        <th>Date</th>
                        <th>Due date</th>
                        <th>Dealer</th>
                        <th>DC No.</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">Grand total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Invoices.Count == 0)
                    {
                        var anyFilter =
                            Model.DocumentDateFrom != null ||
                            Model.DocumentDateTo != null ||
                            !string.IsNullOrEmpty(Model.SearchQuery) ||
                            !string.IsNullOrEmpty(Model.StatusFilter) ||
                            !string.IsNullOrEmpty(Model.FilterPlantId);
                        var emptyMsg = anyFilter ? "No invoices match the current filters." : "No invoices yet. Invoices are created when you save a delivery challan.";
                        <tr><td colspan="9" class="text-secondary">@emptyMsg</td></tr>
                    }
                    else
                    {
                        foreach (var inv in Model.Invoices)
                        {
                            var dealer = inv.DealerDisplayName ?? inv.DealerBusinessPartnerId ?? "—";
                            var isReturned = string.Equals(inv.Status, SalesInvoice.StatusReturned, StringComparison.OrdinalIgnoreCase);
                            var isRip = string.Equals(inv.Status, SalesInvoice.StatusReturnInProcess, StringComparison.OrdinalIgnoreCase);
                            Model.QiByInvoiceId.TryGetValue(inv.Id, out var qiNav);
                            Model.ReturnOrdersByInvoiceId.TryGetValue(inv.Id, out var rs);
                            var roList = rs ?? new List<InvoiceReturnOrderSummaryVm>();
                            var hasRo = roList.Count > 0;
                            var focusReturnOrderId = hasRo ? roList[0].Id : (int?)null;
                            Model.CreditMemoReturnOrderIdByInvoiceId.TryGetValue(inv.Id, out var creditMemoRoId);
                            <tr>
                                <td><a asp-action="Details" asp-route-id="@inv.Id"><strong>@inv.DocumentNumber</strong></a></td>
                                <td>@inv.DocumentDate.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture)</td>
                                <td>@inv.DueDate.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture)</td>
                                <td>@dealer</td>
                                <td>@inv.DcNumber</td>
                                <td class="text-end">@FmtMoney(inv.Subtotal)</td>
                                <td class="text-end"><strong>@FmtMoney(inv.GrandTotal)</strong></td>
                                <td>@inv.Status</td>
                                <td class="inv-actions-cell">
                                    @if (string.Equals(inv.Status, SalesInvoice.StatusOpen, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="invOpenPayModal(@inv.Id)">Pay</button>
                                    }
                                    @if (isReturned)
                                    {
                                        @if (hasRo)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary inv-btn-view-return"
                                                    data-inv-invoice-id="@inv.Id.ToString(CultureInfo.InvariantCulture)"
                                                    data-inv-doc="@inv.DocumentNumber"
                                                    data-inv-ro-focus-id="@focusReturnOrderId?.ToString(CultureInfo.InvariantCulture)">View return</button>
                                        }
                                        @if (qiNav != null && !qiNav.IsPending)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info inv-btn-view-qi-completed"
                                                    data-inv-qi-id="@qiNav.QiId.ToString(CultureInfo.InvariantCulture)"
                                                    data-inv-qi-doc="">View QI</button>
                                        }
                                        @if (creditMemoRoId > 0)
                                        {
                                            <a class="btn btn-sm btn-outline-success"
                                               asp-controller="CreditMemo"
                                               asp-action="Index"
                                               asp-route-openRo="@creditMemoRoId.ToString(CultureInfo.InvariantCulture)">Credit memo</a>
                                        }
                                    }
                                    else if (isRip || (qiNav?.IsPending ?? false))
                                    {
                                        @if (qiNav != null)
                                        {
                                            <a class="btn btn-sm btn-primary" asp-controller="ReorderQualityInspection" asp-action="Details" asp-route-id="@qiNav.QiId">QI</a>
                                        }
                                        @if (hasRo)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary inv-btn-view-return"
                                                    data-inv-invoice-id="@inv.Id.ToString(CultureInfo.InvariantCulture)"
                                                    data-inv-doc="@inv.DocumentNumber"
                                                    data-inv-ro-focus-id="@focusReturnOrderId?.ToString(CultureInfo.InvariantCulture)">View return</button>
                                        }
                                    }
                                    else if (hasRo)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary inv-btn-view-return"
                                                data-inv-invoice-id="@inv.Id.ToString(CultureInfo.InvariantCulture)"
                                                data-inv-doc="@inv.DocumentNumber"
                                                data-inv-ro-focus-id="@focusReturnOrderId?.ToString(CultureInfo.InvariantCulture)">View return</button>
                                    }
                                    else if (!string.Equals(inv.Status, SalesInvoice.StatusCollected, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="ReturnOrder" asp-action="Create" asp-route-invoiceId="@inv.Id">Return</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    window.invPayPrefillUrl = @Html.Raw(JsonSerializer.Serialize(payPrefillUrl));
    window.invPayCreateUrl = @Html.Raw(JsonSerializer.Serialize(payCreateUrl));
</script>
<partial name="_PaymentModal" />
<partial name="_InvoiceQiReturnModals" />
