@* Shared payment modal; parent page must define payPrefillUrl and payCreateUrl (serialized URLs). *@
<div class="modal fade" id="invPayModal" tabindex="-1" aria-labelledby="invPayModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="invPayModalTitle">Record payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="au-validation-summary mb-2 text-danger small" id="invPayModalError" style="display:none;" role="alert"></div>
                <form id="invPayForm" data-au-prevent-enter-submit>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="InvoiceId" id="invPayInvoiceId" value="" />
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="invPayDocDate">Payment document date</label>
                        <input type="date" class="form-control form-control-sm" name="DocumentDate" id="invPayDocDate" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Invoice no.</label>
                        <input type="text" class="form-control form-control-sm" id="invPayInvNo" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Dealer</label>
                        <input type="text" class="form-control form-control-sm" id="invPayDealer" readonly />
                        <input type="hidden" id="invPayDealerId" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Amount</label>
                        <input type="text" class="form-control form-control-sm" id="invPayAmount" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="invPayMethod">Payment method</label>
                        <select class="form-select form-select-sm" name="PaymentMethod" id="invPayMethod" required>
                            <option value="cash">Cash</option>
                            <option value="cheque">Cheque</option>
                            <option value="online">Online</option>
                        </select>
                    </div>
                    <div class="mb-0" id="invPayChequeWrap" style="display:none;">
                        <label class="form-label small mb-0" for="invPayCheque">Cheque number</label>
                        <input type="text" class="form-control form-control-sm" name="ChequeNumber" id="invPayCheque" maxlength="64" autocomplete="off" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="invPaySubmit">Save payment</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var payPrefillUrl = window.invPayPrefillUrl || '';
        var payCreateUrl = window.invPayCreateUrl || '';
        var modalEl = document.getElementById('invPayModal');
        var errEl = document.getElementById('invPayModalError');
        function ensureInvPayModalOnBody() {
            if (modalEl && modalEl.parentElement !== document.body) {
                document.body.appendChild(modalEl);
            }
        }
        ensureInvPayModalOnBody();
        if (modalEl) modalEl.addEventListener('show.bs.modal', ensureInvPayModalOnBody);
        function showErr(msg) {
            if (!errEl) return;
            errEl.textContent = msg || '';
            errEl.style.display = msg ? 'block' : 'none';
        }
        function wireChequeToggle() {
            var sel = document.getElementById('invPayMethod');
            var wrap = document.getElementById('invPayChequeWrap');
            var chq = document.getElementById('invPayCheque');
            if (!sel || !wrap) return;
            function sync() {
                var v = (sel.value || '').toLowerCase();
                wrap.style.display = v === 'cheque' ? 'block' : 'none';
                if (v !== 'cheque' && chq) chq.value = '';
            }
            sel.removeEventListener('change', sync);
            sel.addEventListener('change', sync);
            sync();
        }
        window.invOpenPayModal = function (invoiceId) {
            showErr('');
            if (!payPrefillUrl || !modalEl) return;
            var url = payPrefillUrl.indexOf('?') >= 0 ? payPrefillUrl + '&invoiceId=' + invoiceId : payPrefillUrl + '?invoiceId=' + invoiceId;
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.success) { showErr(d.message || 'Could not load payment form.'); return; }
                    document.getElementById('invPayInvoiceId').value = String(invoiceId);
                    document.getElementById('invPayDocDate').value = d.documentDate || '';
                    document.getElementById('invPayInvNo').value = d.invoiceNumber || '';
                    document.getElementById('invPayDealer').value = d.dealerName || '';
                    document.getElementById('invPayDealerId').value = d.dealerId || '';
                    document.getElementById('invPayAmount').value = typeof d.amount === 'number' ? d.amount.toFixed(2) : (d.amount || '');
                    var m = (d.suggestedPaymentMethod || 'cash').toLowerCase();
                    var sel = document.getElementById('invPayMethod');
                    if (sel) { sel.value = (m === 'cheque' || m === 'online' || m === 'cash') ? m : 'cash'; }
                    var chq = document.getElementById('invPayCheque');
                    if (chq) chq.value = '';
                    wireChequeToggle();
                    if (window.bootstrap && modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
                })
                .catch(function () { showErr('Request failed.'); });
        };
        document.getElementById('invPaySubmit') && document.getElementById('invPaySubmit').addEventListener('click', function () {
            showErr('');
            var form = document.getElementById('invPayForm');
            if (!form || !payCreateUrl) return;
            var method = (document.getElementById('invPayMethod') && document.getElementById('invPayMethod').value) || '';
            if (method === 'cheque') {
                var cq = (document.getElementById('invPayCheque') && document.getElementById('invPayCheque').value) || '';
                if (!cq.trim()) { showErr('Cheque number is required.'); return; }
            }
            var fd = new FormData(form);
            fd.set('PaymentMethod', method);
            fetch(payCreateUrl, {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        if (window.bootstrap && modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                        location.reload();
                    } else showErr(data.message || 'Save failed');
                })
                .catch(function () { showErr('Request failed.'); });
        });
    })();
</script>
