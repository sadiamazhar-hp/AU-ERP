@model List<AU_ERP.Models.WorkCenterMasterSample>
@{
    ViewData["Title"] = "Work Centres";
    var safeModel = Model ?? new List<AU_ERP.Models.WorkCenterMasterSample>();
    var wcTabList = string.Equals(ViewContext.HttpContext?.Request.Query["tab"].ToString(), "list", StringComparison.OrdinalIgnoreCase);
    var plants = ViewBag.Plants as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var wcUoms = ViewBag.UomList as List<AU_ERP.Models.UnitOfMeasurement> ?? new List<AU_ERP.Models.UnitOfMeasurement>();
}

<style>
    :root {
        --sap-bg: #e5ebf1;
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
    }

    .wc-module .table-sap { width: 100%; border-collapse: collapse; }
    .wc-module .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; }
    .wc-module .table-sap td { border: 1px solid #ccc; padding: 0; height: 32px; }
    .wc-module .sap-input { width: 100%; height: 100%; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    .wc-module .table-sap th.col-no, .wc-module .table-sap td.col-no { padding-left: 14px; padding-right: 8px; }
    .wc-module .table-sap td.col-action { padding: 4px 8px; vertical-align: middle; text-align: center; }

    .wc-module-tabstrip { border-bottom: 1px solid var(--sap-border); padding: 0 0.25rem; background: #fff; }
    .wc-module-tabstrip .nav-link { color: var(--au-primary-dark, #388087); font-weight: 500; border: 1px solid transparent; border-radius: 0.35rem 0.35rem 0 0; }
    .wc-module-tabstrip .nav-link:hover { border-color: rgba(56, 128, 135, 0.25); }
    .wc-module-tabstrip .nav-link.active { color: var(--au-black, #171717); background: #fff; border-color: var(--sap-border); border-bottom-color: #fff; margin-bottom: -1px; }
    .wc-module-tab-content { border: 1px solid var(--sap-border); border-top: none; background: #fff; }

    .wc-create-form .v2-frame { border: 1px solid #c4c4c4; border-radius: 4px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
    .wc-create-form .v2-frame legend { font-size: .8rem; font-weight: 600; color: #388087; width: auto; padding: 0 .35rem; float: none; margin-bottom: 0; }
    .wc-create-form .form-label { font-size: .82rem; font-weight: 500; color: #555; margin-bottom: .2rem; }
    .wc-create-form .mandatory-bar { display: inline-block; width: 3px; height: 14px; background: #b00; margin-right: 4px; vertical-align: middle; }
    .wc-create-form .btn-save-bottom { display: flex; justify-content: flex-end; padding: 0.75rem 1.25rem; border-top: 1px solid #c4c4c4; background: #f3f6f8; }
</style>

<div class="wc-module">
    <ul class="nav nav-tabs wc-module-tabstrip" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(wcTabList ? "" : "active")" id="wcTabCreateBtn" data-bs-toggle="tab" data-bs-target="#wcPaneCreate" type="button" role="tab" aria-selected="@(wcTabList ? "false" : "true")">Create</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(wcTabList ? "active" : "")" id="wcTabListBtn" data-bs-toggle="tab" data-bs-target="#wcPaneList" type="button" role="tab" aria-selected="@(wcTabList ? "true" : "false")">List</button>
        </li>
    </ul>

    <div class="tab-content wc-module-tab-content">
        <!-- ───── CREATE TAB ───── -->
        <div class="tab-pane fade p-2 p-md-3 @(wcTabList ? "" : "show active")" id="wcPaneCreate" role="tabpanel">
            <div class="wc-create-form">
                <div class="au-validation-summary mb-2" style="display:none;" role="alert"></div>
                <fieldset class="v2-frame">
                    <legend>General</legend>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label"><span class="mandatory-bar"></span> Work Centre Name</label>
                            <input type="text" id="wcCreateName" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><span class="mandatory-bar"></span> Plant</label>
                            <select id="wcCreatePlant" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (plants != null)
                                {
                                    foreach (var p in plants)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Description</label>
                            <input type="text" id="wcCreateDesc" class="form-control form-control-sm" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="v2-frame">
                    <legend>Capacity</legend>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Available Capacity</label>
                            <input type="number" id="wcCreateCapacity" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Utilization %</label>
                            <input type="number" id="wcCreateUtil" class="form-control form-control-sm" min="0" max="100" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="v2-frame">
                    <legend>Time Parameters</legend>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Setup Time</label>
                            <input type="number" id="wcCreateSetup" class="form-control form-control-sm" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Machine Time</label>
                            <input type="number" id="wcCreateMachine" class="form-control form-control-sm" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Labor Time</label>
                            <input type="number" id="wcCreateLabor" class="form-control form-control-sm" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">UoM</label>
                            <select id="wcCreateUomId" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @foreach (var u in wcUoms)
                                {
                                    <option value="@u.Id">@(u.Code ?? ("#" + u.Id))</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0 mt-2">One UOM applies to setup, machine, and labor times when entered.</p>
                </fieldset>

                <div class="btn-save-bottom">
                    <button type="button" class="btn btn-sm px-4" style="background:#6FB3B8;color:#fff;border:1px solid #388087;" onclick="wcResetForm()">Reset</button>
                    <button type="button" class="btn btn-sm px-4 ms-2" style="background:#388087;color:#fff;border:1px solid #388087;" onclick="wcSaveCreate()">Save</button>
                </div>
            </div>
        </div>

        <!-- ───── LIST TAB ───── -->
        <div class="tab-pane fade @(wcTabList ? "show active" : "")" id="wcPaneList" role="tabpanel">
            <div class="au-validation-summary px-3 pt-2" style="display:none;" role="alert"></div>
            <div class="p-2 px-3">
                <input type="search" class="form-control form-control-sm" id="wcListFilter" placeholder="Filter by name, plant, description…" style="max-width:22rem;" />
            </div>
            <div class="table-wrapper">
                <table class="table-sap" id="wcListTable">
                    <thead>
                        <tr>
                            <th class="col-no">No</th>
                            <th>Name</th>
                            <th>Plant</th>
                            <th>Description</th>
                            <th>Capacity</th>
                            <th>Util %</th>
                            <th style="width:72px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int wcIdx = 0; }
                        @foreach (var w in safeModel)
                        {
                            var plantName = w.Plant?.PlantName ?? "";
                            <tr data-wc-filter="@($"{w.ID} {w.WorkCenterName} {plantName} {w.Description}")" data-wc-id="@w.ID">
                                <td class="col-no">@(wcIdx + 1)</td>
                                <td><input class="sap-input" value="@w.WorkCenterName" readonly /></td>
                                <td><input class="sap-input" value="@plantName" readonly /></td>
                                <td><input class="sap-input" value="@w.Description" readonly /></td>
                                <td><input class="sap-input" value="@w.AvailableCapacity" readonly /></td>
                                <td><input class="sap-input" value="@(w.UtilizationPercentage != null ? w.UtilizationPercentage + "%" : "")" readonly /></td>
                                <td class="col-action">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false" aria-label="Actions">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li><button type="button" class="dropdown-item" data-wc-id="@w.ID" onclick="wcOpenEdit(this.getAttribute('data-wc-id'))">Edit</button></li>
                                            <li><button type="button" class="dropdown-item text-danger" data-wc-id="@w.ID" onclick="wcDeleteFromList(this.getAttribute('data-wc-id'))">Delete</button></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            wcIdx++;
                        }
                    </tbody>
                </table>
            </div>
            @if (safeModel.Count == 0)
            {
                <p class="text-secondary small mb-0 mt-2 px-3">No work centres yet. Use the Create tab to add one.</p>
            }
        </div>
    </div>
</div>

<!-- ───── EDIT MODAL ───── -->
<div class="modal fade" id="wcEditModal" tabindex="-1" aria-labelledby="wcEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content au-create-v2-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="wcEditModalLabel">Edit Work Centre</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="au-validation-summary mb-2" style="display:none;" role="alert"></div>
                <input type="hidden" id="wcEditID" />
                <fieldset class="v2-frame">
                    <legend>General</legend>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label"><span class="mandatory-bar" style="display:inline-block;width:3px;height:14px;background:#b00;margin-right:4px;vertical-align:middle;"></span> Work Centre Name</label>
                            <input type="text" id="wcEditName" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Plant</label>
                            <select id="wcEditPlant" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (plants != null)
                                {
                                    foreach (var p in plants)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Description</label>
                            <input type="text" id="wcEditDesc" class="form-control form-control-sm" />
                        </div>
                    </div>
                </fieldset>
                <fieldset class="v2-frame">
                    <legend>Capacity</legend>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Available Capacity</label>
                            <input type="number" id="wcEditCapacity" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Utilization %</label>
                            <input type="number" id="wcEditUtil" class="form-control form-control-sm" min="0" max="100" />
                        </div>
                    </div>
                </fieldset>
                <fieldset class="v2-frame">
                    <legend>Time Parameters</legend>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Setup Time</label>
                            <input type="number" id="wcEditSetup" class="form-control form-control-sm" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Machine Time</label>
                            <input type="number" id="wcEditMachine" class="form-control form-control-sm" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Labor Time</label>
                            <input type="number" id="wcEditLabor" class="form-control form-control-sm" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">UoM</label>
                            <select id="wcEditUomId" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @foreach (var u in wcUoms)
                                {
                                    <option value="@u.Id">@(u.Code ?? ("#" + u.Id))</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0 mt-2">One UOM applies to setup, machine, and labor times when entered.</p>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm px-4" style="background:#388087;color:#fff;border:1px solid #388087;" onclick="wcSaveEdit()">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function wcReloadToListTab() {
        var u = new URL(window.location.href);
        u.searchParams.set("tab", "list");
        window.location.assign(u.toString());
    }

    function wcCreateFormRoot() {
        return document.querySelector("#wcPaneCreate .wc-create-form");
    }

    function wcEditFormRoot() {
        return document.querySelector("#wcEditModal .modal-body");
    }

    function wcListPaneRoot() {
        return document.getElementById("wcPaneList");
    }

    function wcShowInline(root, invalidEls, message) {
        if (!root) root = wcCreateFormRoot() || document.querySelector(".wc-module");
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        if (typeof window.auShowInlineValidation === "function")
            window.auShowInlineValidation(root, invalidEls || [], message);
        else alert(message || "Following Fields are Required");
    }

    function wcTimeHasValue(inp) {
        if (!inp) return false;
        var v = (inp.value || "").trim();
        if (v === "") return false;
        return !isNaN(parseFloat(v));
    }

    function wcAnyTimeFilled(prefix) {
        return wcTimeHasValue(document.getElementById(prefix + "Setup"))
            || wcTimeHasValue(document.getElementById(prefix + "Machine"))
            || wcTimeHasValue(document.getElementById(prefix + "Labor"));
    }

    function wcValidateCreate() {
        var bad = [];
        var n = document.getElementById("wcCreateName");
        var p = document.getElementById("wcCreatePlant");
        if (!(n.value || "").trim()) bad.push(n);
        if (!(p.value || "").trim()) bad.push(p);
        if (wcAnyTimeFilled("wcCreate")) {
            var u = document.getElementById("wcCreateUomId");
            if (!u || !(u.value || "").trim()) bad.push(u);
        }
        return bad;
    }

    function wcValidateEdit() {
        var bad = [];
        var n = document.getElementById("wcEditName");
        if (!(n.value || "").trim()) bad.push(n);
        if (wcAnyTimeFilled("wcEdit")) {
            var u = document.getElementById("wcEditUomId");
            if (!u || !(u.value || "").trim()) bad.push(u);
        }
        return bad;
    }

    function wcResetForm() {
        var root = wcCreateFormRoot();
        if (root && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        document.getElementById("wcCreateName").value = "";
        document.getElementById("wcCreatePlant").value = "";
        document.getElementById("wcCreateDesc").value = "";
        document.getElementById("wcCreateCapacity").value = "";
        document.getElementById("wcCreateUtil").value = "";
        document.getElementById("wcCreateSetup").value = "";
        document.getElementById("wcCreateMachine").value = "";
        document.getElementById("wcCreateLabor").value = "";
        document.getElementById("wcCreateUomId").value = "";
    }

    function wcCollectCreate() {
        return {
            WorkCenterName: (document.getElementById("wcCreateName").value || "").trim(),
            PlantID: document.getElementById("wcCreatePlant").value || null,
            Description: (document.getElementById("wcCreateDesc").value || "").trim() || null,
            AvailableCapacity: parseInt(document.getElementById("wcCreateCapacity").value) || null,
            UtilizationPercentage: parseInt(document.getElementById("wcCreateUtil").value) || null,
            SetupTime: parseFloat(document.getElementById("wcCreateSetup").value) || null,
            MachineTime: parseFloat(document.getElementById("wcCreateMachine").value) || null,
            LaborTime: parseFloat(document.getElementById("wcCreateLabor").value) || null,
            UomId: (function () {
                var v = parseInt(document.getElementById("wcCreateUomId").value, 10);
                return isNaN(v) ? null : v;
            })()
        };
    }

    function wcSaveCreate() {
        var root = wcCreateFormRoot();
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        var bad = wcValidateCreate();
        if (bad.length) {
            wcShowInline(root, bad);
            return;
        }
        var data = wcCollectCreate();

        fetch('@Url.Action("Create", "WorkCentre")', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(res.message, function () { wcReloadToListTab(); });
                else { alert(res.message); wcReloadToListTab(); }
            } else {
                wcShowInline(root, [], res.message || "Save failed.");
            }
        })
        .catch(function () { wcShowInline(root, [], "Request failed."); });
    }

    function wcOpenEdit(id) {
        if (!id) return;
        fetch('@Url.Action("GetForEdit", "WorkCentre")?id=' + encodeURIComponent(id))
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res.success) { wcShowInline(wcListPaneRoot(), [], res.message || "Could not load."); return; }
                var editRoot = wcEditFormRoot();
                if (editRoot && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(editRoot);
                var d = res.data;
                document.getElementById("wcEditID").value = d.id || d.ID;
                document.getElementById("wcEditName").value = d.workCenterName || "";
                document.getElementById("wcEditPlant").value = d.plantID || "";
                document.getElementById("wcEditDesc").value = d.description || "";
                document.getElementById("wcEditCapacity").value = d.availableCapacity != null ? d.availableCapacity : "";
                document.getElementById("wcEditUtil").value = d.utilizationPercentage != null ? d.utilizationPercentage : "";
                document.getElementById("wcEditSetup").value = d.setupTime != null ? d.setupTime : "";
                document.getElementById("wcEditMachine").value = d.machineTime != null ? d.machineTime : "";
                document.getElementById("wcEditLabor").value = d.laborTime != null ? d.laborTime : "";
                var uid = d.uomId != null ? d.uomId : (d.UomId != null ? d.UomId : "");
                document.getElementById("wcEditUomId").value = uid !== "" && uid != null ? String(uid) : "";

                var modalEl = document.getElementById("wcEditModal");
                if (modalEl) {
                    if (modalEl.parentElement !== document.body)
                        document.body.appendChild(modalEl);
                    if (typeof bootstrap !== "undefined")
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            })
            .catch(function () { wcShowInline(wcListPaneRoot(), [], "Failed to load work centre."); });
    }

    function wcSaveEdit() {
        var root = wcEditFormRoot();
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        var id = parseInt(document.getElementById("wcEditID").value) || 0;
        if (!id) { wcShowInline(root, [], "Invalid ID."); return; }

        var bad = wcValidateEdit();
        if (bad.length) {
            wcShowInline(root, bad);
            return;
        }

        var name = (document.getElementById("wcEditName").value || "").trim();

        var payload = {
            ID: id,
            WorkCenterName: name,
            PlantID: document.getElementById("wcEditPlant").value || null,
            Description: (document.getElementById("wcEditDesc").value || "").trim() || null,
            AvailableCapacity: parseInt(document.getElementById("wcEditCapacity").value) || null,
            UtilizationPercentage: parseInt(document.getElementById("wcEditUtil").value) || null,
            SetupTime: parseFloat(document.getElementById("wcEditSetup").value) || null,
            MachineTime: parseFloat(document.getElementById("wcEditMachine").value) || null,
            LaborTime: parseFloat(document.getElementById("wcEditLabor").value) || null,
            UomId: (function () {
                var v = parseInt(document.getElementById("wcEditUomId").value, 10);
                return isNaN(v) ? null : v;
            })()
        };

        fetch('@Url.Action("Update", "WorkCentre")', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                var modalEl = document.getElementById("wcEditModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();

                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(res.message, function () { wcReloadToListTab(); });
                else { alert(res.message); wcReloadToListTab(); }
            } else {
                wcShowInline(root, [], res.message || "Update failed.");
            }
        })
        .catch(function () { wcShowInline(root, [], "Update request failed."); });
    }

    function wcDeleteFromList(id) {
        if (!id) return;
        function doDelete() {
            fetch('@Url.Action("Delete", "WorkCentre")?id=' + encodeURIComponent(id), { method: "POST" })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) {
                        if (typeof window.materialShowSuccessModalThen === "function")
                            window.materialShowSuccessModalThen(res.message, function () { wcReloadToListTab(); });
                        else { alert(res.message); wcReloadToListTab(); }
                    } else {
                        wcShowInline(wcListPaneRoot(), [], res.message || "Delete failed.");
                    }
                })
                .catch(function () { wcShowInline(wcListPaneRoot(), [], "Delete request failed."); });
        }
        if (typeof window.materialShowDeleteConfirmModalThen === "function")
            window.materialShowDeleteConfirmModalThen("Do you want to Delete this Work Centre?", doDelete);
        else if (confirm("Delete this work centre?"))
            doDelete();
    }

    (function () {
        var inp = document.getElementById("wcListFilter");
        if (!inp) return;
        inp.addEventListener("input", function () {
            var q = (inp.value || "").toLowerCase().trim();
            document.querySelectorAll("#wcListTable tbody tr").forEach(function (tr) {
                var hay = (tr.getAttribute("data-wc-filter") || "").toLowerCase();
                tr.style.display = !q || hay.indexOf(q) >= 0 ? "" : "none";
            });
        });
    })();
</script>
}
