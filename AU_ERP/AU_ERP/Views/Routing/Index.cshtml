@model List<AU_ERP.Models.RoutingHeadersSample>
@using System.Text.Json
@{
    ViewData["Title"] = "Routing";
    var safeModel = Model ?? new List<AU_ERP.Models.RoutingHeadersSample>();
    var rtTabList = string.Equals(ViewContext.HttpContext?.Request.Query["tab"].ToString(), "list", StringComparison.OrdinalIgnoreCase);
    var plants = ViewBag.Plants as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var workCentres = ViewBag.WorkCentres as List<AU_ERP.Models.WorkCenterMasterSample> ?? new List<AU_ERP.Models.WorkCenterMasterSample>();
    var rtWcJson = JsonSerializer.Serialize(workCentres.Select(w => new { id = w.ID, name = w.WorkCenterName ?? "", timeUom = w.TimeUom ?? "" }));
}

<style>
    :root {
        --sap-bg: #e5ebf1;
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
    }

    .rt-module .table-sap { width: 100%; border-collapse: collapse; }
    .rt-module .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; }
    .rt-module .table-sap td { border: 1px solid #ccc; padding: 0; height: 32px; }
    .rt-module .sap-input { width: 100%; height: 100%; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    .rt-module .table-sap th.col-no, .rt-module .table-sap td.col-no { padding-left: 14px; padding-right: 8px; }
    .rt-module .table-sap td.col-action { padding: 4px 8px; vertical-align: middle; text-align: center; }

    .rt-module-tabstrip { border-bottom: 1px solid var(--sap-border); padding: 0 0.25rem; background: #fff; }
    .rt-module-tabstrip .nav-link { color: var(--au-primary-dark, #388087); font-weight: 500; border: 1px solid transparent; border-radius: 0.35rem 0.35rem 0 0; }
    .rt-module-tabstrip .nav-link:hover { border-color: rgba(56, 128, 135, 0.25); }
    .rt-module-tabstrip .nav-link.active { color: var(--au-black, #171717); background: #fff; border-color: var(--sap-border); border-bottom-color: #fff; margin-bottom: -1px; }
    .rt-module-tab-content { border: 1px solid var(--sap-border); border-top: none; background: #fff; }

    .rt-create-form .v2-frame { border: 1px solid #c4c4c4; border-radius: 4px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
    .rt-create-form .v2-frame legend { font-size: .8rem; font-weight: 600; color: #388087; width: auto; padding: 0 .35rem; float: none; margin-bottom: 0; }
    .rt-create-form .form-label { font-size: .82rem; font-weight: 500; color: #555; margin-bottom: .2rem; }
    .rt-create-form .mandatory-bar { display: inline-block; width: 3px; height: 14px; background: #b00; margin-right: 4px; vertical-align: middle; }
    .rt-create-form .btn-save-bottom { display: flex; justify-content: flex-end; padding: 0.75rem 1.25rem; border-top: 1px solid #c4c4c4; background: #f3f6f8; }

    .rt-ops-table { width: 100%; border-collapse: collapse; margin-top: .5rem; }
    .rt-ops-table th { background: #dee6ef; border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; font-size: .82rem; }
    .rt-ops-table td { border: 1px solid #ccc; padding: 2px 4px; }
    .rt-ops-table .form-control-sm, .rt-ops-table .form-select-sm { border-radius: 2px; }

    .rt-op-section { border: 1px solid #c4c4c4; border-radius: 4px; padding: .75rem 1rem; margin-bottom: .75rem; background: #fafbfc; }
    .rt-ops-summary-cell { max-width: 28rem; vertical-align: top; }
    .rt-ops-summary-cell .rt-op-sum-line { font-size: .78rem; line-height: 1.35; margin-bottom: .2rem; }

    .rt-mat-picker { position: relative; }
    .rt-mat-picker-dropdown {
        display: none; position: absolute; left: 0; right: 0; top: 100%; z-index: 1055;
        max-height: 220px; overflow-y: auto; background: #fff; border: 1px solid var(--sap-border, #9fb2c5);
        border-radius: 0 0 4px 4px; box-shadow: 0 4px 12px rgba(0,0,0,.12); margin-top: 1px;
    }
    .rt-mat-picker-dropdown.show { display: block; }
    .rt-mat-picker-item { cursor: pointer; font-size: .8125rem; }
    .rt-mat-picker-empty { padding: 8px 10px; color: #666; font-size: .8rem; }
    .rt-mat-picker-item .rt-mat-code { font-weight: 600; }
</style>

<div class="rt-module">
    <ul class="nav nav-tabs rt-module-tabstrip" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(rtTabList ? "" : "active")" id="rtTabCreateBtn" data-bs-toggle="tab" data-bs-target="#rtPaneCreate" type="button" role="tab" aria-selected="@(rtTabList ? "false" : "true")">Create</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(rtTabList ? "active" : "")" id="rtTabListBtn" data-bs-toggle="tab" data-bs-target="#rtPaneList" type="button" role="tab" aria-selected="@(rtTabList ? "true" : "false")">List</button>
        </li>
    </ul>

    <div class="tab-content rt-module-tab-content">
        <div class="tab-pane fade p-2 p-md-3 @(rtTabList ? "" : "show active")" id="rtPaneCreate" role="tabpanel">
            <div class="rt-create-form">
                <div class="au-validation-summary mb-2" style="display:none;" role="alert"></div>
                <fieldset class="v2-frame">
                    <legend>Header</legend>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Title</label>
                            <input type="text" id="rtCreateTitle" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><span class="mandatory-bar"></span> Material</label>
                            <div class="rt-mat-picker" data-purpose="header">
                                <input type="text" class="form-control form-control-sm rt-mat-picker-search" id="rtCreateMaterialSearch" placeholder="Search material number or description…" autocomplete="off" />
                                <input type="hidden" id="rtCreateMaterial" value="" />
                                <div class="rt-mat-picker-dropdown" id="rtCreateMaterialDd"></div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><span class="mandatory-bar"></span> Plant</label>
                            <select id="rtCreatePlant" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (plants != null)
                                {
                                    foreach (var p in plants)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select id="rtCreateStatus" class="form-select form-select-sm">
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Valid From</label>
                            <input type="date" id="rtCreateValidFrom" class="form-control form-control-sm" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="v2-frame">
                    <legend>
                        Operations
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-3" onclick="rtAddOpSection('rtCreateOpsRoot')">+ Add</button>
                    </legend>
                    <p class="text-secondary small mb-2">Each operation has a title and a number of work-centre rows. Change the number to add or remove rows for that operation.</p>
                    <div id="rtCreateOpsRoot" class="rt-ops-sections-root"></div>
                </fieldset>

                <div class="btn-save-bottom">
                    <button type="button" class="btn btn-sm px-4" style="background:#6FB3B8;color:#fff;border:1px solid #388087;" onclick="rtResetForm()">Reset</button>
                    <button type="button" class="btn btn-sm px-4 ms-2" style="background:#388087;color:#fff;border:1px solid #388087;" onclick="rtSaveCreate()">Save</button>
                </div>
            </div>
        </div>

        <div class="tab-pane fade @(rtTabList ? "show active" : "")" id="rtPaneList" role="tabpanel">
            <div class="au-validation-summary px-3 pt-2" style="display:none;" role="alert"></div>
            <div class="p-2 px-3">
                <input type="search" class="form-control form-control-sm" id="rtListFilter" placeholder="Filter by material, plant, operation title…" style="max-width:22rem;" />
            </div>
            <div class="table-wrapper">
                <table class="table-sap" id="rtListTable">
                    <thead>
                        <tr>
                            <th class="col-no">No</th>
                            <th>Routing ID</th>
                            <th>Title</th>
                            <th>Material</th>
                            <th>Plant</th>
                            <th>Status</th>
                            <th>Valid From</th>
                            <th>Operations</th>
                            <th style="width:72px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rtIdx = 0; }
                        @foreach (var r in safeModel)
                        {
                            var matDesc = r.Material != null ? $"{r.MaterialNumber} - {r.Material.Description}" : (r.MaterialNumber ?? "");
                            var plantName = r.Plant?.PlantName ?? "";
                            var statusText = r.StatusID == 1 ? "Active" : "Inactive";
                            var ohEnum = r.OperationHeaders ?? Enumerable.Empty<RoutingOperationHeaderSample>();
                            var filterParts = new List<string> { $"{r.RoutingID}", r.Title ?? "", matDesc, plantName, statusText };
                            foreach (var oh in ohEnum.OrderBy(x => x.DisplayOrder))
                            {
                                filterParts.Add(oh.Title ?? "");
                                var wn = (oh.RoutingOperationsSamples ?? Enumerable.Empty<RoutingOperationsSample>())
                                    .OrderBy(o => o.OperationSequence).Select(o => o.WorkCenter?.WorkCenterName ?? "—");
                                foreach (var w in wn) { filterParts.Add(w); }
                            }
                            var rtFilter = string.Join(" ", filterParts.Where(s => !string.IsNullOrWhiteSpace(s)));
                            <tr data-rt-filter="@rtFilter" data-rt-id="@r.RoutingID">
                                <td class="col-no">@(rtIdx + 1)</td>
                                <td><input class="sap-input" value="@r.RoutingID" readonly /></td>
                                <td><input class="sap-input" value="@r.Title" readonly /></td>
                                <td><input class="sap-input" value="@matDesc" readonly /></td>
                                <td><input class="sap-input" value="@plantName" readonly /></td>
                                <td><input class="sap-input" value="@statusText" readonly /></td>
                                <td><input class="sap-input" value="@(r.ValidFrom.ToString("yyyy-MM-dd"))" readonly /></td>
                                <td class="rt-ops-summary-cell">
                                    @if (!ohEnum.Any())
                                    {
                                        <span class="text-secondary small">—</span>
                                    }
                                    else
                                    {
                                        foreach (var oh in ohEnum.OrderBy(x => x.DisplayOrder))
                                        {
                                            var wcs = string.Join(", ",
                                                (oh.RoutingOperationsSamples ?? Enumerable.Empty<RoutingOperationsSample>())
                                                .OrderBy(o => o.OperationSequence)
                                                .Select(o => o.WorkCenter?.WorkCenterName ?? "—"));
                                            <div class="rt-op-sum-line"><strong>@(oh.Title ?? "—")</strong>: @wcs</div>
                                        }
                                    }
                                </td>
                                <td class="col-action">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false" aria-label="Actions">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li><button type="button" class="dropdown-item" data-rt-id="@r.RoutingID" onclick="rtOpenEdit(this.getAttribute('data-rt-id'))">Edit</button></li>
                                            <li><button type="button" class="dropdown-item" data-rt-id="@r.RoutingID" onclick="rtOpenManageOps(this.getAttribute('data-rt-id'))">Manage operations</button></li>
                                            <li><button type="button" class="dropdown-item text-danger" data-rt-id="@r.RoutingID" onclick="rtDeleteFromList(this.getAttribute('data-rt-id'))">Delete</button></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            rtIdx++;
                        }
                    </tbody>
                </table>
            </div>
            @if (safeModel.Count == 0)
            {
                <p class="text-secondary small mb-0 mt-2 px-3">No routing records yet. Use the Create tab to add one.</p>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="rtEditModal" tabindex="-1" aria-labelledby="rtEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content au-create-v2-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="rtEditModalLabel">Edit Routing</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="au-validation-summary mb-2" style="display:none;" role="alert"></div>
                <input type="hidden" id="rtEditID" />
                <fieldset class="v2-frame">
                    <legend>Header</legend>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Title</label>
                            <input type="text" id="rtEditTitle" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><span class="mandatory-bar" style="display:inline-block;width:3px;height:14px;background:#b00;margin-right:4px;vertical-align:middle;"></span> Material</label>
                            <div class="rt-mat-picker" data-purpose="header">
                                <input type="text" class="form-control form-control-sm rt-mat-picker-search" id="rtEditMaterialSearch" placeholder="Search material number or description…" autocomplete="off" />
                                <input type="hidden" id="rtEditMaterial" value="" />
                                <div class="rt-mat-picker-dropdown" id="rtEditMaterialDd"></div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><span class="mandatory-bar" style="display:inline-block;width:3px;height:14px;background:#b00;margin-right:4px;vertical-align:middle;"></span> Plant</label>
                            <select id="rtEditPlant" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (plants != null)
                                {
                                    foreach (var p in plants)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select id="rtEditStatus" class="form-select form-select-sm">
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Valid From</label>
                            <input type="date" id="rtEditValidFrom" class="form-control form-control-sm" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="v2-frame">
                    <legend>
                        Operations
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-3" onclick="rtAddOpSection('rtEditOpsRoot')">+ Add</button>
                    </legend>
                    <p class="text-secondary small mb-2">Each operation has a title and a number of work-centre rows.</p>
                    <div id="rtEditOpsRoot" class="rt-ops-sections-root"></div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm px-4" style="background:#388087;color:#fff;border:1px solid #388087;" onclick="rtSaveEdit()">Update</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rtManageOpsModal" tabindex="-1" aria-labelledby="rtManageOpsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content au-create-v2-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="rtManageOpsModalLabel">Manage operations</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="au-validation-summary mb-2" style="display:none;" role="alert"></div>
                <input type="hidden" id="rtManageOpsRoutingId" />
                <fieldset class="v2-frame">
                    <legend>
                        Operations
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-3" onclick="rtAddOpSection('rtManageOpsRoot')">+ Add</button>
                    </legend>
                    <p class="text-secondary small mb-2">Edit operation titles and work-centre rows. Header fields are unchanged until you use Edit routing.</p>
                    <div id="rtManageOpsRoot" class="rt-ops-sections-root"></div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm px-4" style="background:#388087;color:#fff;border:1px solid #388087;" onclick="rtSaveManageOps()">Save operations</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function rtInitRoutingModals() {
        function ensureOnBody(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (el.parentElement !== document.body) {
                document.body.appendChild(el);
            }
        }
        function init() {
            ["rtEditModal", "rtManageOpsModal"].forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                el.addEventListener("show.bs.modal", function () {
                    ensureOnBody(id);
                });
                ensureOnBody(id);
            });
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();

    var rtAllWorkCentres = @Html.Raw(rtWcJson);

    function escRtAttr(s) {
        if (s == null || s === undefined) return "";
        return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
    }

    var rtSearchMaterialsUrl = '@Url.Action("SearchBomMaterials", "MasterDataLookup")';
    var rtMatPickerTimers = {};

    function rtCloseAllMatPickers() {
        document.querySelectorAll(".rt-mat-picker-dropdown.show").forEach(function (d) {
            d.classList.remove("show");
            d.innerHTML = "";
        });
    }

    document.addEventListener("mousedown", function (e) {
        if (e.target.closest(".rt-mat-picker-dropdown"))
            e.preventDefault();
        else if (!e.target.closest(".rt-mat-picker"))
            rtCloseAllMatPickers();
    });

    function rtMatPickerBuildUrl(q) {
        return rtSearchMaterialsUrl + "?purpose=" + encodeURIComponent("header") + "&q=" + encodeURIComponent(q || "");
    }

    function rtMatPickerFetch(searchInput) {
        var wrap = searchInput.closest(".rt-mat-picker");
        if (!wrap) return;
        var dd = wrap.querySelector(".rt-mat-picker-dropdown");
        if (!dd) return;
        fetch(rtMatPickerBuildUrl(searchInput.value))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || !data.success) {
                    dd.innerHTML = '<div class="rt-mat-picker-empty">Could not load materials.</div>';
                    dd.classList.add("show");
                    return;
                }
                var items = data.items || [];
                if (!items.length)
                    dd.innerHTML = '<div class="rt-mat-picker-empty">No matches</div>';
                else
                    dd.innerHTML = items.map(function (it) {
                        var uid = it.uomId != null && it.uomId !== undefined ? String(it.uomId) : "";
                        var bu = it.baseUom != null ? String(it.baseUom) : "";
                        return '<button type="button" class="rt-mat-picker-item list-group-item list-group-item-action py-1 px-2 text-start border-0 rounded-0" data-n="' + escRtAttr(it.n) + '" data-d="' + escRtAttr(it.d) + '" data-base-uom="' + escRtAttr(bu) + '" data-uom-id="' + escRtAttr(uid) + '">'
                            + '<span class="rt-mat-code">' + escRtAttr(it.n) + '</span>'
                            + ' <span class="text-muted small">— ' + escRtAttr(it.d) + "</span></button>";
                    }).join("");
                dd.classList.add("show");
            })
            .catch(function () {
                dd.innerHTML = '<div class="rt-mat-picker-empty">Request failed.</div>';
                dd.classList.add("show");
            });
    }

    function rtMatPickerScheduleSearch(inputEl) {
        var key = inputEl.id || "rtMat";
        clearTimeout(rtMatPickerTimers[key]);
        rtMatPickerTimers[key] = setTimeout(function () { rtMatPickerFetch(inputEl); }, 250);
    }

    document.addEventListener("focusin", function (e) {
        if (!e.target.classList || !e.target.classList.contains("rt-mat-picker-search")) return;
        rtMatPickerFetch(e.target);
    });

    document.addEventListener("input", function (e) {
        if (!e.target.classList || !e.target.classList.contains("rt-mat-picker-search")) return;
        rtMatPickerScheduleSearch(e.target);
    });

    document.addEventListener("click", function (e) {
        var btn = e.target.closest(".rt-mat-picker-item");
        if (!btn) return;
        e.preventDefault();
        var wrap = btn.closest(".rt-mat-picker");
        var dd = btn.closest(".rt-mat-picker-dropdown");
        var hidden = wrap.querySelector("input[type=hidden]");
        var search = wrap.querySelector(".rt-mat-picker-search");
        var n = btn.getAttribute("data-n") || "";
        var d = btn.getAttribute("data-d") || "";
        if (hidden) hidden.value = n;
        if (search) search.value = n ? (n + (d ? " — " + d : "")) : "";
        if (dd) {
            dd.classList.remove("show");
            dd.innerHTML = "";
        }
    });

    function rtBuildWcSelectHtml(selectedId) {
        var html = '<option value="">-- Select --</option>';
        (rtAllWorkCentres || []).forEach(function (wc) {
            var sel = (String(wc.id) === String(selectedId) || wc.id === selectedId) ? ' selected' : '';
            html += '<option value="' + wc.id + '"' + sel + '>' + escRtAttr(wc.name) + '</option>';
        });
        return html;
    }

    function rtBuildTimeUomSelectHtml(selectedValue) {
        var s = (selectedValue || "").trim();
        function opt(v, label) {
            var sel = (v === s) ? ' selected' : '';
            return '<option value="' + v + '"' + sel + '>' + label + '</option>';
        }
        return '<option value="">-- Select --</option>' + opt('Hr', 'Hr') + opt('Day', 'Day') + opt('Min', 'Min');
    }

    function rtFindWcMeta(idStr) {
        var n = parseInt(idStr, 10);
        if (isNaN(n)) return null;
        for (var i = 0; i < (rtAllWorkCentres || []).length; i++) {
            if (rtAllWorkCentres[i].id === n) return rtAllWorkCentres[i];
        }
        return null;
    }

    function rtSyncOpRowUomFromWc(tr) {
        if (!tr) return;
        var sel = tr.querySelector(".rt-op-wc");
        var uomSel = tr.querySelector(".rt-op-uom");
        if (!uomSel) return;
        var meta = sel ? rtFindWcMeta(sel.value) : null;
        if (meta && meta.timeUom != null && String(meta.timeUom).trim() !== "") {
            uomSel.value = String(meta.timeUom).trim();
        }
    }

    function rtAppendWcRow(tbody, data) {
        var pos = tbody.rows.length + 1;
        var opSeq = pos * 10;
        var tr = document.createElement("tr");
        var wcId = data ? (data.workCenterID || data.WorkCenterID || "") : "";
        var desc = data ? (data.description || data.Description || "") : "";
        var mt = data ? (data.machineTime != null ? data.machineTime : (data.MachineTime || "")) : "";
        var lt = data ? (data.laborTime != null ? data.laborTime : (data.LaborTime || "")) : "";
        var tu = data ? (data.timeUom || data.TimeUom || "") : "";
        if (data && (data.operationSequence || data.OperationSequence)) {
            opSeq = data.operationSequence || data.OperationSequence;
        }
        tr.innerHTML =
            '<td class="text-center"><span class="rt-op-seq">' + opSeq + '</span></td>' +
            '<td><select class="form-select form-select-sm rt-op-wc">' + rtBuildWcSelectHtml(wcId) + '</select></td>' +
            '<td><input type="text" class="form-control form-control-sm rt-op-desc" value="' + escRtAttr(desc) + '" /></td>' +
            '<td><input type="number" class="form-control form-control-sm rt-op-machine" step="0.01" value="' + escRtAttr(mt) + '" /></td>' +
            '<td><input type="number" class="form-control form-control-sm rt-op-labor" step="0.01" value="' + escRtAttr(lt) + '" /></td>' +
            '<td><select class="form-select form-select-sm rt-op-uom">' + rtBuildTimeUomSelectHtml(tu) + '</select></td>' +
            '<td><button type="button" class="btn btn-danger btn-sm" onclick="this.closest(\'tr\').remove()">X</button></td>';
        tbody.appendChild(tr);
        rtSyncOpRowUomFromWc(tr);
    }

    function rtSetWcRowCount(section, desired) {
        var tbody = section.querySelector(".rt-op-sec-wc-body");
        if (!tbody) return;
        var n = Math.max(1, Math.min(50, parseInt(desired, 10) || 1));
        var cur = tbody.rows.length;
        if (n < cur) {
            while (tbody.rows.length > n) {
                tbody.deleteRow(tbody.rows.length - 1);
            }
        } else {
            while (tbody.rows.length < n) {
                rtAppendWcRow(tbody, null);
            }
        }
        for (var i = 0; i < tbody.rows.length; i++) {
            var seqEl = tbody.rows[i].querySelector(".rt-op-seq");
            if (seqEl) seqEl.textContent = String((i + 1) * 10);
        }
    }

    function rtAddOpSection(rootId, headerData) {
        var root = document.getElementById(rootId);
        if (!root) return;
        var wrap = document.createElement("div");
        wrap.className = "rt-op-section";
        wrap.innerHTML =
            '<div class="row g-2 align-items-end mb-2">' +
            '<div class="col-md-5">' +
            '<label class="form-label">Operation title</label>' +
            '<input type="text" class="form-control form-control-sm rt-op-sec-title" />' +
            '</div>' +
            '<div class="col-md-3">' +
            '<label class="form-label">No. of work centres</label>' +
            '<input type="number" class="form-control form-control-sm rt-op-sec-count" min="1" max="50" value="1" />' +
            '</div>' +
            '<div class="col-md-3 ms-md-auto text-md-end">' +
            '<button type="button" class="btn btn-sm btn-outline-danger mt-3 mt-md-0">Remove operation</button>' +
            '</div>' +
            '</div>' +
            '<table class="rt-ops-table"><thead><tr>' +
            '<th style="width:60px;">Op No.</th><th style="width:200px;">Work Centre</th><th>Description</th>' +
            '<th style="width:110px;">Machine Time</th><th style="width:110px;">Labor Time</th><th style="width:90px;">UoM</th><th style="width:50px;"></th>' +
            '</tr></thead><tbody class="rt-op-sec-wc-body"></tbody></table>';
        root.appendChild(wrap);
        var exId = headerData && (headerData.operationHeaderId != null ? headerData.operationHeaderId : headerData.OperationHeaderId);
        if (exId != null && exId !== "" && !isNaN(parseInt(String(exId), 10)) && parseInt(String(exId), 10) > 0) {
            wrap.setAttribute("data-operation-header-id", String(parseInt(String(exId), 10)));
        }
        var rm = wrap.querySelector(".btn-outline-danger");
        if (rm) rm.addEventListener("click", function () { wrap.remove(); });
        var titleInp = wrap.querySelector(".rt-op-sec-title");
        var countInp = wrap.querySelector(".rt-op-sec-count");
        var ops = headerData && (headerData.operations || headerData.Operations) ? (headerData.operations || headerData.Operations) : [];
        var cnt = ops.length > 0 ? ops.length : 1;
        if (titleInp) titleInp.value = (headerData && (headerData.title || headerData.Title)) ? (headerData.title || headerData.Title) : "";
        if (countInp) countInp.value = String(cnt);
        var tbody = wrap.querySelector(".rt-op-sec-wc-body");
        if (tbody && ops.length) {
            ops.forEach(function (op) { rtAppendWcRow(tbody, op); });
        } else {
            rtSetWcRowCount(wrap, cnt);
        }
        if (countInp) {
            countInp.addEventListener("change", function () { rtSetWcRowCount(wrap, countInp.value); });
        }
    }

    function rtClearOpSections(rootId) {
        var root = document.getElementById(rootId);
        if (root) root.innerHTML = "";
    }

    function rtFillOpSectionsFromModel(rootId, headers) {
        rtClearOpSections(rootId);
        var list = headers || [];
        if (!list.length) return;
        list.forEach(function (h) { rtAddOpSection(rootId, h); });
    }

    function rtCollectOperationHeaders(rootId) {
        var root = document.getElementById(rootId);
        if (!root) return [];
        var out = [];
        root.querySelectorAll(".rt-op-section").forEach(function (sec) {
            var titleInp = sec.querySelector(".rt-op-sec-title");
            var tbody = sec.querySelector(".rt-op-sec-wc-body");
            var title = (titleInp && titleInp.value || "").trim();
            var hid = sec.getAttribute("data-operation-header-id");
            var opHeaderId = hid && !isNaN(parseInt(hid, 10)) && parseInt(hid, 10) > 0 ? parseInt(hid, 10) : null;
            var ops = [];
            if (tbody) {
                tbody.querySelectorAll("tr").forEach(function (tr) {
                    var wcVal = tr.querySelector(".rt-op-wc")?.value;
                    var uomVal = tr.querySelector(".rt-op-uom")?.value;
                    ops.push({
                        WorkCenterID: wcVal ? parseInt(wcVal, 10) : null,
                        Description: (tr.querySelector(".rt-op-desc")?.value || "").trim() || null,
                        MachineTime: parseFloat(tr.querySelector(".rt-op-machine")?.value) || null,
                        LaborTime: parseFloat(tr.querySelector(".rt-op-labor")?.value) || null,
                        TimeUom: (uomVal || "").trim() || null
                    });
                });
            }
            var block = { Title: title || null, Operations: ops };
            if (opHeaderId != null) block.OperationHeaderId = opHeaderId;
            out.push(block);
        });
        return out;
    }

    function rtNumFieldOk(inp) {
        if (!inp) return false;
        var raw = (inp.value || "").trim();
        if (raw === "") return false;
        return !isNaN(parseFloat(raw));
    }

    function rtValidateOpSections(rootId) {
        var bad = [];
        var root = document.getElementById(rootId);
        if (!root) return bad;
        root.querySelectorAll(".rt-op-section").forEach(function (sec) {
            var titleInp = sec.querySelector(".rt-op-sec-title");
            if (!titleInp || !(titleInp.value || "").trim()) bad.push(titleInp);
            var tbody = sec.querySelector(".rt-op-sec-wc-body");
            if (!tbody || !tbody.rows.length) {
                var c = sec.querySelector(".rt-op-sec-count");
                if (c) bad.push(c);
            } else {
            tbody.querySelectorAll("tr").forEach(function (tr) {
                var wc = tr.querySelector(".rt-op-wc");
                var desc = tr.querySelector(".rt-op-desc");
                var mach = tr.querySelector(".rt-op-machine");
                var lab = tr.querySelector(".rt-op-labor");
                var uom = tr.querySelector(".rt-op-uom");
                if (!wc || !(wc.value || "").trim()) bad.push(wc);
                if (!desc || !(desc.value || "").trim()) bad.push(desc);
                if (!rtNumFieldOk(mach)) bad.push(mach);
                if (!rtNumFieldOk(lab)) bad.push(lab);
                if (!uom || !(uom.value || "").trim()) bad.push(uom);
            });
            }
        });
        return bad;
    }

    function rtCreateFormRoot() {
        return document.querySelector("#rtPaneCreate .rt-create-form");
    }

    function rtEditFormRoot() {
        return document.querySelector("#rtEditModal .modal-body");
    }

    function rtManageOpsFormRoot() {
        return document.querySelector("#rtManageOpsModal .modal-body");
    }

    function rtListPaneRoot() {
        return document.getElementById("rtPaneList");
    }

    function rtShowInline(root, invalidEls, message) {
        if (!root) root = rtCreateFormRoot() || document.querySelector(".rt-module");
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        if (typeof window.auShowInlineValidation === "function")
            window.auShowInlineValidation(root, invalidEls || [], message);
        else alert(message || "Following Fields are Required");
    }

    function rtValidateCreateHeader() {
        var bad = [];
        var mat = document.getElementById("rtCreateMaterial");
        var pl = document.getElementById("rtCreatePlant");
        if (!(mat.value || "").trim()) bad.push(document.getElementById("rtCreateMaterialSearch") || mat);
        if (!(pl.value || "").trim()) bad.push(pl);
        return bad;
    }

    function rtValidateEditHeader() {
        var bad = [];
        var mat = document.getElementById("rtEditMaterial");
        var pl = document.getElementById("rtEditPlant");
        if (!(mat.value || "").trim()) bad.push(document.getElementById("rtEditMaterialSearch") || mat);
        if (!(pl.value || "").trim()) bad.push(pl);
        return bad;
    }

    function rtResetForm() {
        var root = rtCreateFormRoot();
        if (root && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        document.getElementById("rtCreateTitle").value = "";
        document.getElementById("rtCreateMaterial").value = "";
        var crS = document.getElementById("rtCreateMaterialSearch");
        if (crS) crS.value = "";
        rtCloseAllMatPickers();
        document.getElementById("rtCreatePlant").value = "";
        document.getElementById("rtCreateStatus").value = "1";
        document.getElementById("rtCreateValidFrom").value = "";
        rtClearOpSections("rtCreateOpsRoot");
    }

    function rtReloadToListTab() {
        var u = new URL(window.location.href);
        u.searchParams.set("tab", "list");
        window.location.assign(u.toString());
    }

    function rtSaveCreate() {
        var root = rtCreateFormRoot();
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        var bad = rtValidateCreateHeader().concat(rtValidateOpSections("rtCreateOpsRoot"));
        if (bad.length) {
            rtShowInline(root, bad);
            return;
        }
        var roots = document.getElementById("rtCreateOpsRoot");
        if (!roots || !roots.querySelector(".rt-op-section")) {
            rtShowInline(root, [], "Add at least one operation.");
            return;
        }

        var payload = {
            Title: (document.getElementById("rtCreateTitle").value || "").trim() || null,
            MaterialNumber: document.getElementById("rtCreateMaterial").value,
            PlantID: document.getElementById("rtCreatePlant").value,
            StatusID: parseInt(document.getElementById("rtCreateStatus").value) || 1,
            ValidFrom: document.getElementById("rtCreateValidFrom").value || null,
            OperationHeaders: rtCollectOperationHeaders("rtCreateOpsRoot")
        };

        fetch('@Url.Action("Create", "Routing")', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(res.message, function () { rtReloadToListTab(); });
                else { alert(res.message); rtReloadToListTab(); }
            } else {
                rtShowInline(root, [], res.message || "Save failed.");
            }
        })
        .catch(function () { rtShowInline(root, [], "Request failed."); });
    }

    function rtOpenEdit(id) {
        if (!id) return;
        fetch('@Url.Action("GetForEdit", "Routing")?id=' + encodeURIComponent(id))
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res.success) { rtShowInline(rtListPaneRoot(), [], res.message || "Could not load."); return; }
                var editRoot = rtEditFormRoot();
                if (editRoot && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(editRoot);
                var d = res.data;
                document.getElementById("rtEditID").value = d.routingID || d.RoutingID;
                document.getElementById("rtEditTitle").value = d.title || d.Title || "";
                var matNum = d.materialNumber || d.MaterialNumber || "";
                var matDesc = d.materialDescription || d.MaterialDescription || "";
                document.getElementById("rtEditMaterial").value = matNum;
                var edS = document.getElementById("rtEditMaterialSearch");
                if (edS) edS.value = matNum && matDesc ? (matNum + " — " + matDesc) : matNum;
                document.getElementById("rtEditPlant").value = d.plantID || d.PlantID || "";
                document.getElementById("rtEditStatus").value = d.statusID != null ? d.statusID : "1";
                document.getElementById("rtEditValidFrom").value = d.validFrom || d.ValidFrom || "";
                var oh = d.operationHeaders || d.OperationHeaders || [];
                rtFillOpSectionsFromModel("rtEditOpsRoot", oh);

                var modalEl = document.getElementById("rtEditModal");
                if (modalEl) {
                    if (modalEl.parentElement !== document.body)
                        document.body.appendChild(modalEl);
                    if (typeof bootstrap !== "undefined")
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            })
            .catch(function () { rtShowInline(rtListPaneRoot(), [], "Failed to load routing."); });
    }

    function rtSaveEdit() {
        var root = rtEditFormRoot();
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        var id = parseInt(document.getElementById("rtEditID").value) || 0;
        if (!id) { rtShowInline(root, [], "Invalid ID."); return; }

        var bad = rtValidateEditHeader().concat(rtValidateOpSections("rtEditOpsRoot"));
        if (bad.length) {
            rtShowInline(root, bad);
            return;
        }
        var er = document.getElementById("rtEditOpsRoot");
        if (!er || !er.querySelector(".rt-op-section")) {
            rtShowInline(root, [], "Add at least one operation.");
            return;
        }

        var payload = {
            RoutingID: id,
            Title: (document.getElementById("rtEditTitle").value || "").trim() || null,
            MaterialNumber: document.getElementById("rtEditMaterial").value,
            PlantID: document.getElementById("rtEditPlant").value || null,
            StatusID: parseInt(document.getElementById("rtEditStatus").value) || 1,
            ValidFrom: document.getElementById("rtEditValidFrom").value || null,
            OperationHeaders: rtCollectOperationHeaders("rtEditOpsRoot")
        };

        fetch('@Url.Action("Update", "Routing")', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                var modalEl = document.getElementById("rtEditModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();

                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(res.message, function () { rtReloadToListTab(); });
                else { alert(res.message); rtReloadToListTab(); }
            } else {
                rtShowInline(root, [], res.message || "Update failed.");
            }
        })
        .catch(function () { rtShowInline(root, [], "Update request failed."); });
    }

    function rtOpenManageOps(id) {
        if (!id) return;
        fetch('@Url.Action("GetForEdit", "Routing")?id=' + encodeURIComponent(id))
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res.success) { rtShowInline(rtListPaneRoot(), [], res.message || "Could not load."); return; }
                var mgrRoot = rtManageOpsFormRoot();
                if (mgrRoot && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(mgrRoot);
                var d = res.data;
                document.getElementById("rtManageOpsRoutingId").value = d.routingID || d.RoutingID;
                var oh = d.operationHeaders || d.OperationHeaders || [];
                rtFillOpSectionsFromModel("rtManageOpsRoot", oh);

                var modalEl = document.getElementById("rtManageOpsModal");
                if (modalEl) {
                    if (modalEl.parentElement !== document.body)
                        document.body.appendChild(modalEl);
                    if (typeof bootstrap !== "undefined")
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            })
            .catch(function () { rtShowInline(rtListPaneRoot(), [], "Failed to load routing."); });
    }

    function rtSaveManageOps() {
        var root = rtManageOpsFormRoot();
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        var id = parseInt(document.getElementById("rtManageOpsRoutingId").value) || 0;
        if (!id) { rtShowInline(root, [], "Invalid routing."); return; }

        var bad = rtValidateOpSections("rtManageOpsRoot");
        if (bad.length) {
            rtShowInline(root, bad);
            return;
        }
        var mr = document.getElementById("rtManageOpsRoot");
        if (!mr || !mr.querySelector(".rt-op-section")) {
            rtShowInline(root, [], "Add at least one operation.");
            return;
        }

        var payload = {
            RoutingID: id,
            OperationHeaders: rtCollectOperationHeaders("rtManageOpsRoot")
        };

        fetch('@Url.Action("UpdateOperationHeaders", "Routing")', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                var modalEl = document.getElementById("rtManageOpsModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();

                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(res.message, function () { rtReloadToListTab(); });
                else { alert(res.message); rtReloadToListTab(); }
            } else {
                rtShowInline(root, [], res.message || "Update failed.");
            }
        })
        .catch(function () { rtShowInline(root, [], "Update request failed."); });
    }

    function rtDeleteFromList(id) {
        if (!id) return;
        function doDelete() {
            fetch('@Url.Action("Delete", "Routing")?id=' + encodeURIComponent(id), { method: "POST" })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) {
                        if (typeof window.materialShowSuccessModalThen === "function")
                            window.materialShowSuccessModalThen(res.message, function () { rtReloadToListTab(); });
                        else { alert(res.message); rtReloadToListTab(); }
                    } else {
                        rtShowInline(rtListPaneRoot(), [], res.message || "Delete failed.");
                    }
                })
                .catch(function () { rtShowInline(rtListPaneRoot(), [], "Delete request failed."); });
        }
        if (typeof window.materialShowDeleteConfirmModalThen === "function")
            window.materialShowDeleteConfirmModalThen("Do you want to Delete this Routing?", doDelete);
        else if (confirm("Delete this routing?"))
            doDelete();
    }

    (function () {
        var inp = document.getElementById("rtListFilter");
        if (!inp) return;
        inp.addEventListener("input", function () {
            var q = (inp.value || "").toLowerCase().trim();
            document.querySelectorAll("#rtListTable tbody tr").forEach(function (tr) {
                var hay = (tr.getAttribute("data-rt-filter") || "").toLowerCase();
                tr.style.display = !q || hay.indexOf(q) >= 0 ? "" : "none";
            });
        });
    })();

    document.addEventListener("change", function (e) {
        var t = e.target;
        if (t && t.classList && t.classList.contains("rt-op-wc")) {
            var tr = t.closest("tr");
            if (tr) rtSyncOpRowUomFromWc(tr);
        }
    });
</script>
}
