        }
        var sqFertBuildUrl = function (q) { return sqFertSearchBase + (sqFertSearchBase.indexOf("?") >= 0 ? "&" : "?") + "q=" + encodeURIComponent(q || ""); };
        document.addEventListener("mousedown", function (e) { if (e.target.closest(".sq-fert-picker .bom-mat-picker-dropdown")) e.preventDefault(); });
        document.addEventListener("focusin", function (e) { if (!e.target.classList || !e.target.classList.contains("bom-mat-picker-search") || !e.target.closest(".sq-fert-picker")) return; sqFertFetch(e.target); });
        var _fertT = 0;
        document.addEventListener("input", function (e) { if (!e.target.classList || !e.target.classList.contains("bom-mat-picker-search") || !e.target.closest(".sq-fert-picker")) return; clearTimeout(_fertT); var inp = e.target; _fertT = setTimeout(function () { sqFertFetch(inp); }, 250); });
        function sqClose() { document.querySelectorAll(".sq-fert-picker .bom-mat-picker-dropdown.show").forEach(function (d) { d.classList.remove("show"); d.innerHTML = ""; }); }
        function sqFertFetch(searchInput) {
            var w = searchInput && searchInput.closest(".sq-fert-picker");
            if (!w) return;
            var dd = w.querySelector(".bom-mat-picker-dropdown"); if (!dd) return;
            fetch(sqFertBuildUrl(searchInput.value)).then(function (r) { return r.json(); }).then(function (d) {
                if (!d || !d.success) { dd.innerHTML = "<div class=\"bom-mat-picker-empty\">Error</div>"; dd.classList.add("show"); return; }
                var its = d.items || [];
                if (!its.length) dd.innerHTML = "<div class=\"bom-mat-picker-empty\">No matches</div>";
                else dd.innerHTML = its.map(function (it) { return "<div class=\"bom-mat-picker-item\" data-n=\"" + esc(it.n) + "\" data-d=\"" + esc(it.d) + "\"><strong>" + esc(it.n) + "</strong> <span class=\"text-muted\">" + esc(it.d) + "</span></div>"; }).join("");
                dd.classList.add("show");
            });
        }
        document.addEventListener("click", function (e) {
            var it = e.target.closest(".sq-fert-picker .bom-mat-picker-item");
            if (!it) { if (!e.target.closest(".sq-fert-picker")) sqClose(); return; }
            e.preventDefault();
            var w = it.closest(".sq-fert-picker"), dd = w.querySelector(".bom-mat-picker-dropdown");
            var hid = w.querySelector(".sq-matno"), s = w.querySelector(".bom-mat-picker-search");
            var n = it.getAttribute("data-n") || "", d0 = it.getAttribute("data-d") || "";
            if (hid) hid.value = n; if (s) s.value = n + (d0 ? " — " + d0 : "");
            if (dd) { dd.classList.remove("show"); dd.innerHTML = ""; }
            var tr = w.closest("tr.sq-item-row");
            uomFill(tr, n, d0);
        });
        function uomFill(tr, mat, descText, opts) {
            opts = opts || {};
            if (!uomBase || !tr || !mat) return;
            var uSel = tr.querySelector(".sq-uom");
            if (!uSel) return; uSel.innerHTML = "<option value=\"\">—</option>";
            var dIn = tr.querySelector(".sq-desc");
            if (dIn && (descText || "") !== "" && dIn.value === "") dIn.value = descText || "";
            fetch(uomBase + (uomBase.indexOf("?") >= 0 ? "&" : "?") + "materialNumber=" + encodeURIComponent(mat)).then(function (r) { return r.json(); }).then(function (res) {
                if (!res.success || !res.data) return;
                var d = res.data, uoms = d.uoms || d.Uoms || [];
                uoms.forEach(function (u) { var o = document.createElement("option"); o.value = u.id; o.textContent = u.code || u.Id; uSel.appendChild(o); });
                var bid = d.baseUomId != null ? d.baseUomId : d.BaseUomId;
                if (opts.savedUomId != null) {
                    uSel.value = String(opts.savedUomId);
                } else if (bid != null) uSel.value = String(bid);
                if (opts.preserveUnitPrice != null) {
                    var uu = tr.querySelector(".sq-unit");
                    if (uu) uu.value = String(opts.preserveUnitPrice);
                    recalcLine(tr);
                } else
                    fetchUnit(mat, uSel.value, tr);
            });
        }
        function fetchUnit(mat, uom, tr) {
            if (!unitCostUrl) return;
            var gEl = tr && tr.querySelector && tr.querySelector(".sq-grade");
            var g = (gEl && gEl.value) ? gEl.value : "A";
            var url = unitCostUrl + (unitCostUrl.indexOf("?") >= 0 ? "&" : "?") + "materialNumber=" + encodeURIComponent(mat) + "&uomId=" + encodeURIComponent(uom || "") + "&priceGrade=" + encodeURIComponent(g);
            fetch(url).then(function (r) { return r.json(); }).then(function (r) { if (r.success && r.stdCostPerUom != null) { var u = tr.querySelector(".sq-unit"); if (u) u.value = r.stdCostPerUom; recalcLine(tr); } });
        }
        document.getElementById("btnSqAddRow") && document.getElementById("btnSqAddRow").addEventListener("click", function () {
            var tr = parseTrFromRowHtml();
            document.getElementById("sqItemsBody").appendChild(tr);
            reindex();
            appendItemChargeTds(tr);
            reindex();
            tr.querySelector(".sq-del") && (tr.querySelector(".sq-del").value = document.getElementById("sqQd") && document.getElementById("sqQd").value || defaults.today);
            wireRow(tr);
            recalcFooter();
        });
        function loadSchema(id) {
            if (!id) {
                schemaCharges = [];
                buildChargeDropdowns();
                var b = document.getElementById("sqItemsBody");
                if (b) {
                    b.innerHTML = rowHtml().trim();
                    reindex();
                    renderItemChargeThead();
                    b.querySelectorAll("tr.sq-item-row").forEach(function (tr) {
                        tr.querySelector(".sq-del") && (tr.querySelector(".sq-del").value = document.getElementById("sqQd") && document.getElementById("sqQd").value || defaults.today);
                        appendItemChargeTds(tr);
                    });
                    reindex();
                    b.querySelectorAll("tr.sq-item-row").forEach(wireRow);
                }
                buildQuotationChargeInputs();
                recalcFooter();
                return;
            }
            if (!schemaUrl) return;
            fetch(schemaUrl + (schemaUrl.indexOf("?") >= 0 ? "&" : "?") + "id=" + encodeURIComponent(id)).then(function (r) { return r.json(); }).then(function (d) {
                schemaCharges = (d && d.charges) ? d.charges : [];
                buildChargeDropdowns();
                var b = document.getElementById("sqItemsBody");
                if (b) {
                    b.innerHTML = rowHtml().trim();
                    reindex();
                    renderItemChargeThead();
                    b.querySelectorAll("tr.sq-item-row").forEach(function (tr) {
                        tr.querySelector(".sq-del") && (tr.querySelector(".sq-del").value = document.getElementById("sqQd") && document.getElementById("sqQd").value || defaults.today);
                        appendItemChargeTds(tr);
                    });
                    reindex();
                    b.querySelectorAll("tr.sq-item-row").forEach(wireRow);
                }
                buildQuotationChargeInputs();
                recalcFooter();
            });
        }
        document.getElementById("sqSchema") && document.getElementById("sqSchema").addEventListener("change", function () { loadSchema(this.value); });
        var modal = document.getElementById("addQuotationModal");
        if (modal) modal.addEventListener("show.bs.modal", function () {
            if (_sqSkipFormReset) { _sqSkipFormReset = false; return; }
            setSqFormToCreate();
            var f = document.getElementById("sqForm"); if (f) f.reset();
            document.getElementById("sqQd") && (document.getElementById("sqQd").value = defaults.today);
            document.getElementById("sqVd") && (document.getElementById("sqVd").value = defaults.twoW);
            document.getElementById("sqPlant") && (document.getElementById("sqPlant").value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(firstPlant)));
            document.getElementById("sqDc") && (document.getElementById("sqDc").value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(firstChan?.ToString() ?? "")));
            if (document.getElementById("sqItemChargeColumnIds")) document.getElementById("sqItemChargeColumnIds").value = "";
            if (document.getElementById("sqQuotationLevelChargeIds")) document.getElementById("sqQuotationLevelChargeIds").value = "";
            if (document.getElementById("sqQuotationChargeValuesJson")) document.getElementById("sqQuotationChargeValuesJson").value = "";
            if (document.getElementById("sqSchema")) document.getElementById("sqSchema").value = "";
            fetch(nextQuotationUrl).then(function (r) { return r.json(); }).then(function (d) {
                var n = d.number || d.display;
                if (document.getElementById("sqNum")) document.getElementById("sqNum").value = n || "";
                if (document.getElementById("sqModalTitle")) document.getElementById("sqModalTitle").textContent = "New Sales Quotation — " + (n || "");
            });
            var sch = document.getElementById("sqSchema") && document.getElementById("sqSchema").value;
            if (sch) loadSchema(sch); else loadSchema("");
        });
        (function init() {
            var sqForm = document.getElementById("sqForm");
            if (sqForm) sqForm.addEventListener("submit", function () { syncAllBeforeSubmit(); });
            loadSchema("");
        })();
        document.addEventListener("click", function (e) {
            if (!e.target.classList || !e.target.classList.contains("sq-rm")) return;
            var tr = e.target.closest("tr.sq-item-row");
            var b = document.getElementById("sqItemsBody");
            if (!tr || !b) return;
            if (b.querySelectorAll("tr.sq-item-row").length <= 1) { tr.querySelectorAll("input,select").forEach(function (i) { if (i.classList && i.classList.contains("sq-matno")) i.value = ""; if (i.classList && i.classList.contains("bom-mat-picker-search")) i.value = ""; }); recalcFooter(); return; }
            tr.remove();
            reindex();
            recalcFooter();
        });
        document.getElementById("sqCustomer") && document.getElementById("sqCustomer").addEventListener("change", function () {
            var o = this.options[this.selectedIndex];
            var a = o && o.getAttribute("data-ship");
            if (a) document.getElementById("sqAddr").value = a;
        });
        function sqSyncReturnFields() {
            var q = document.getElementById("sqListQ"), st = document.getElementById("sqListStatus"), pl = document.getElementById("sqListPlant"), dc = document.getElementById("sqListDc");
            if (document.getElementById("sqReturnQ")) document.getElementById("sqReturnQ").value = q ? q.value : "";
            if (document.getElementById("sqReturnStatus")) document.getElementById("sqReturnStatus").value = st ? st.value : "All";
            if (document.getElementById("sqReturnPlantId")) document.getElementById("sqReturnPlantId").value = pl ? pl.value : "";
            if (document.getElementById("sqReturnDcId")) document.getElementById("sqReturnDcId").value = dc ? dc.value : "";
        }
        document.getElementById("addQuotationModal") && document.getElementById("addQuotationModal").addEventListener("show.bs.modal", function () { sqSyncReturnFields(); });
        var sqF = document.getElementById("sqFilterModal");
        if (sqF) sqF.addEventListener("show.bs.modal", function () {
            var st = document.getElementById("sqListStatus"), pl = document.getElementById("sqListPlant"), dc = document.getElementById("sqListDc");
            if (document.getElementById("sqModStatus")) document.getElementById("sqModStatus").value = (st && st.value) || "All";
            if (document.getElementById("sqModPlant") && pl) document.getElementById("sqModPlant").value = pl.value || "";
            if (document.getElementById("sqModDc") && dc) document.getElementById("sqModDc").value = dc.value || "";
        });
        window.sqApplyFilterModal = function () {
            if (document.getElementById("sqListStatus")) document.getElementById("sqListStatus").value = document.getElementById("sqModStatus").value || "All";
            if (document.getElementById("sqListPlant")) document.getElementById("sqListPlant").value = document.getElementById("sqModPlant").value || "";
            if (document.getElementById("sqListDc")) document.getElementById("sqListDc").value = document.getElementById("sqModDc").value || "";
            var m = document.getElementById("sqFilterModal");
            if (m && typeof bootstrap !== "undefined") { var i = bootstrap.Modal.getInstance(m); if (i) i.hide(); }
            var f = document.getElementById("sqListFilterForm");
            if (f) f.submit();
        };
        if (sqOpenEditId != null && sqOpenEditId > 0) {
            _sqSkipFormReset = true;
            fetch(quotationDataFor(sqOpenEditId)).then(function (r) { return r.json(); }).then(function (d) {
                if (!d || !d.success) { if (d && d.message) window.alert(d.message); return; }
                if (d.h && d.h.quotationNumber && document.getElementById("sqNum")) document.getElementById("sqNum").value = d.h.quotationNumber;
                applyQuotationData(d);
                var el = document.getElementById("addQuotationModal");
                if (el && typeof bootstrap !== "undefined") { bootstrap.Modal.getOrCreateInstance(el).show(); }
            }).catch(function () { window.alert("Could not load quotation for editing."); });
        }
    })();
</script>
