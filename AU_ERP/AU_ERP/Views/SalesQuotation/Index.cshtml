            document.getElementById("sqQd") && (document.getElementById("sqQd").value = defaults.today);
            document.getElementById("sqVd") && (document.getElementById("sqVd").value = defaults.twoW);
            document.getElementById("sqPlant") && (document.getElementById("sqPlant").value = "");
            document.getElementById("sqDc") && (document.getElementById("sqDc").value = "");
            if (document.getElementById("sqItemChargeColumnIds")) document.getElementById("sqItemChargeColumnIds").value = "";
            if (document.getElementById("sqQuotationLevelChargeIds")) document.getElementById("sqQuotationLevelChargeIds").value = "";
            if (document.getElementById("sqQuotationChargeValuesJson")) document.getElementById("sqQuotationChargeValuesJson").value = "";
            if (document.getElementById("sqSchema")) document.getElementById("sqSchema").value = "";
            syncHiddens();
            fetch(nextQuotationUrl).then(function (r) { return r.json(); }).then(function (d) {
                if (!d.success) {
                    var m = d.message || "Could not load next quotation number.";
                    if (typeof window.auShowInlineValidation === "function" && document.getElementById("sqForm"))
                        window.auShowInlineValidation(document.getElementById("sqForm"), [], m);
                    else alert(m);
                    if (document.getElementById("sqNum")) document.getElementById("sqNum").value = "";
                    if (document.getElementById("sqModalTitle")) document.getElementById("sqModalTitle").textContent = "New Sales Quotation";
                    return;
                }
                var n = d.number || d.display;
                if (document.getElementById("sqNum")) document.getElementById("sqNum").value = n || "";
                if (document.getElementById("sqModalTitle")) document.getElementById("sqModalTitle").textContent = "New Sales Quotation — " + (n || "");
            }).catch(function () { alert("Could not load next quotation number."); });
            if (sqEmporiumWalkIn && sqWalkInSchemaId > 0) {
                if (document.getElementById("sqPlant")) document.getElementById("sqPlant").value = "Emp101";
                if (document.getElementById("sqDc")) document.getElementById("sqDc").value = "2";
                if (document.getElementById("sqSchema")) document.getElementById("sqSchema").value = String(sqWalkInSchemaId);
                if (document.getElementById("sqCustomer")) document.getElementById("sqCustomer").value = "";
                if (document.getElementById("sqCustomerSearch")) document.getElementById("sqCustomerSearch").value = "";
                sqHideCustomerDropdown();
                sqUpdateWalkInCustomerSummary();
                syncHiddens();
                loadSchema(String(sqWalkInSchemaId));
            } else {
                var sch = document.getElementById("sqSchema") && document.getElementById("sqSchema").value;
                if (sch) loadSchema(sch); else loadSchema("");
            }
        });
        (function init() {
            var sqForm = document.getElementById("sqForm");
            if (sqForm) sqForm.addEventListener("submit", function () { syncAllBeforeSubmit(); });
            loadSchema("");
        })();
        document.addEventListener("click", function (e) {
            if (!e.target.classList || !e.target.classList.contains("sq-rm")) return;
            var tr = e.target.closest("tr.sq-item-row");
            var b = document.getElementById("sqItemsBody");
            if (!tr || !b) return;
            if (b.querySelectorAll("tr.sq-item-row").length <= 1) { tr.querySelectorAll("input,select").forEach(function (i) { if (i.classList && i.classList.contains("sq-matno")) i.value = ""; if (i.classList && i.classList.contains("bom-mat-picker-search")) i.value = ""; }); recalcFooter(); return; }
            tr.remove();
            reindex();
            recalcFooter();
        });
        function sqHideCustomerDropdown() {
            var dd = document.getElementById("sqCustomerDropdown");
            if (!dd) return;
            dd.style.display = "none";
            dd.classList.remove("show");
            dd.innerHTML = "";
            ["top", "left", "width", "maxHeight"].forEach(function (k) { dd.style.removeProperty(k); });
        }
        function sqPositionCustomerDropdown() {
            var search = document.getElementById("sqCustomerSearch");
            var dd = document.getElementById("sqCustomerDropdown");
            if (!search || !dd || dd.style.display === "none") return;
            var r = search.getBoundingClientRect();
            var gap = 4;
            var maxH = Math.max(120, Math.min(280, window.innerHeight - r.bottom - gap - 12));
            dd.style.top = (r.bottom + gap) + "px";
            dd.style.left = r.left + "px";
            dd.style.width = r.width + "px";
            dd.style.maxHeight = maxH + "px";
            dd.classList.add("show");
        }
        function sqRenderCustomerDropdown(filterText) {
            var cat = document.getElementById("sqCustomerCatalog");
            var dd = document.getElementById("sqCustomerDropdown");
            if (!cat || !dd) return;
            var q = (filterText || "").trim().toLowerCase();
            var parts = ["<div class=\"sq-customer-item px-2 py-1 border-bottom text-muted small\" role=\"option\" tabindex=\"0\" data-id=\"\">— Clear selection —</div>"];
            var nShown = 0;
            for (var i = 0; i < cat.options.length; i++) {
                var opt = cat.options[i];
                var v = (opt.value || "").trim();
                if (!v) continue;
                var t = (opt.textContent || "").trim().toLowerCase();
                var ship = ((opt.getAttribute("data-ship") || "") + "").toLowerCase();
                if (q && t.indexOf(q) < 0 && v.toLowerCase().indexOf(q) < 0 && ship.indexOf(q) < 0) continue;
                parts.push("<div class=\"sq-customer-item px-2 py-1 border-bottom small\" role=\"option\" tabindex=\"0\" data-id=\"" + esc(v) + "\">" + esc((opt.textContent || "").trim()) + "</div>");
                nShown++;
                if (nShown >= 80) break;
            }
            if (!nShown && q) dd.innerHTML = "<div class=\"px-2 py-2 text-muted small\">No matches</div>";
            else dd.innerHTML = parts.join("");
            dd.style.display = "block";
            sqPositionCustomerDropdown();
        }
        function sqSyncCustomerSearchFromValue() {
            var valEl = document.getElementById("sqCustomer");
            var search = document.getElementById("sqCustomerSearch");
            var cat = document.getElementById("sqCustomerCatalog");
            if (!valEl || !search || !cat) return;
            var v = valEl.value || "";
            if (!v) { search.value = ""; return; }
            for (var i = 0; i < cat.options.length; i++) {
                if (cat.options[i].value === v) {
                    search.value = (cat.options[i].textContent || "").trim();
                    return;
                }
            }
            search.value = v;
        }
        function sqCommitCustomerSelection(customerId) {
            var valEl = document.getElementById("sqCustomer");
            if (valEl) valEl.value = customerId || "";
            sqSyncCustomerSearchFromValue();
            sqHideCustomerDropdown();
            if (!customerId) {
                sqUpdateWalkInCustomerSummary();
                if (document.getElementById("sqPlant")) document.getElementById("sqPlant").value = "";
                if (document.getElementById("sqDc")) document.getElementById("sqDc").value = "";
                if (document.getElementById("sqSchema")) document.getElementById("sqSchema").value = "";
                loadSchema("");
                syncHiddens();
                return;
            }
            applySqCustomerCommercialProfile(customerId);
        }
        (function initSqCustomerCombo() {
            var search = document.getElementById("sqCustomerSearch");
            var dd = document.getElementById("sqCustomerDropdown");
            if (!search || !dd) return;
            var tOpen = 0;
            search.addEventListener("focus", function () { sqRenderCustomerDropdown(search.value); });
            search.addEventListener("input", function () {
                clearTimeout(tOpen);
                tOpen = setTimeout(function () { sqRenderCustomerDropdown(search.value); }, 120);
            });
            search.addEventListener("keydown", function (e) { if (e.key === "Escape") sqHideCustomerDropdown(); });
            dd.addEventListener("mousedown", function (e) { e.preventDefault(); });
            dd.addEventListener("click", function (e) {
                var item = e.target.closest(".sq-customer-item");
                if (!item) return;
                sqCommitCustomerSelection(item.getAttribute("data-id") || "");
            });
            document.addEventListener("mousedown", function (e) {
                if (!e.target.closest(".sq-customer-combo")) sqHideCustomerDropdown();
            });
            var qModal = document.getElementById("addQuotationModal");
            if (qModal) {
                function refitDd() { if (dd.style.display !== "none") sqPositionCustomerDropdown(); }
                var mb = qModal.querySelector(".modal-body");
                if (mb) mb.addEventListener("scroll", refitDd, true);
                window.addEventListener("resize", refitDd);
            }
        })();
        document.getElementById("sqOpenWalkInCustomerBtn") && document.getElementById("sqOpenWalkInCustomerBtn").addEventListener("click", function () {
            ["sqWkFirst", "sqWkLast", "sqWkAddr", "sqWkMobile"].forEach(function (wid) { var e = document.getElementById(wid); if (e) e.value = ""; });
            var wkErr = document.getElementById("sqWkErr"); if (wkErr) { wkErr.style.display = "none"; wkErr.textContent = ""; }
            var m = sqWalkInCustomerModalGet(); if (m) m.show();
        });
        document.getElementById("sqWkCreateBtn") && document.getElementById("sqWkCreateBtn").addEventListener("click", function () {
            if (!sqCreateWalkInUrl) return;
            var fn = (document.getElementById("sqWkFirst") && document.getElementById("sqWkFirst").value) || "";
            var ln = (document.getElementById("sqWkLast") && document.getElementById("sqWkLast").value) || "";
            var ad = (document.getElementById("sqWkAddr") && document.getElementById("sqWkAddr").value) || "";
            var mb = (document.getElementById("sqWkMobile") && document.getElementById("sqWkMobile").value) || "";
            var err = document.getElementById("sqWkErr");
            var tok = document.querySelector("#sqForm input[name=\"__RequestVerificationToken\"]");
            if (!tok || !tok.value) { if (err) { err.textContent = "Missing form token."; err.style.display = "inline"; } return; }
            var body = new URLSearchParams();
            body.append("__RequestVerificationToken", tok.value);
            body.append("firstName", fn);
            body.append("lastName", ln);
            body.append("address", ad);
            body.append("mobile", mb);
            fetch(sqCreateWalkInUrl, { method: "POST", body: body, headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d || !d.success) {
                        if (err) { err.textContent = (d && d.message) ? d.message : "Could not create customer."; err.style.display = "inline"; }
                        return;
                    }
                    if (err) { err.style.display = "none"; err.textContent = ""; }
                    var valEl = document.getElementById("sqCustomer");
                    var cat = document.getElementById("sqCustomerCatalog");
                    if (valEl) valEl.value = d.bpId || "";
                    if (cat && d.bpId) {
                        var exists = false;
                        for (var i = 0; i < cat.options.length; i++) { if (cat.options[i].value === d.bpId) { exists = true; break; } }
                        if (!exists) {
                            var o = document.createElement("option");
                            o.value = d.bpId;
                            o.textContent = d.displayName || d.bpId;
                            o.setAttribute("data-ship", ad);
                            cat.appendChild(o);
                        }
                    }
                    sqSyncCustomerSearchFromValue();
                    if (document.getElementById("sqAddr")) document.getElementById("sqAddr").value = ad;
                    sqUpdateWalkInCustomerSummary();
                    var wkEl = document.getElementById("sqWalkInAddCustomerModal");
                    if (wkEl && window.bootstrap) {
                        var wkInst = bootstrap.Modal.getInstance(wkEl);
                        if (wkInst) wkInst.hide();
                    }
                    applySqCustomerCommercialProfile(d.bpId);
                })
                .catch(function () { if (err) { err.textContent = "Request failed."; err.style.display = "inline"; } });
        });
        function sqSyncReturnFields() {
            var q = document.getElementById("sqListQ"), st = document.getElementById("sqListStatus"), pl = document.getElementById("sqListPlant"), dc = document.getElementById("sqListDc");
            if (document.getElementById("sqReturnQ")) document.getElementById("sqReturnQ").value = q ? q.value : "";
            if (document.getElementById("sqReturnStatus")) document.getElementById("sqReturnStatus").value = st ? st.value : "All";
            if (document.getElementById("sqReturnPlantId")) document.getElementById("sqReturnPlantId").value = pl ? pl.value : "";
            if (document.getElementById("sqReturnDcId")) document.getElementById("sqReturnDcId").value = dc ? dc.value : "";
        }
        document.getElementById("addQuotationModal") && document.getElementById("addQuotationModal").addEventListener("show.bs.modal", function () { sqSyncReturnFields(); });
        var sqF = document.getElementById("sqFilterModal");
        if (sqF) sqF.addEventListener("show.bs.modal", function () {
            var st = document.getElementById("sqListStatus"), pl = document.getElementById("sqListPlant"), dc = document.getElementById("sqListDc");
            if (document.getElementById("sqModStatus")) document.getElementById("sqModStatus").value = (st && st.value) || "All";
            if (document.getElementById("sqModPlant") && pl) document.getElementById("sqModPlant").value = pl.value || "";
            if (document.getElementById("sqModDc") && dc) document.getElementById("sqModDc").value = dc.value || "";
        });
        window.sqApplyFilterModal = function () {
            if (document.getElementById("sqListStatus")) document.getElementById("sqListStatus").value = document.getElementById("sqModStatus").value || "All";
            if (document.getElementById("sqListPlant")) document.getElementById("sqListPlant").value = document.getElementById("sqModPlant").value || "";
            if (document.getElementById("sqListDc")) document.getElementById("sqListDc").value = document.getElementById("sqModDc").value || "";
            var m = document.getElementById("sqFilterModal");
            if (m && typeof bootstrap !== "undefined") { var i = bootstrap.Modal.getInstance(m); if (i) i.hide(); }
            var f = document.getElementById("sqListFilterForm");
            if (f) f.submit();
        };
        if (sqOpenEditId != null && sqOpenEditId > 0) {
            _sqSkipFormReset = true;
            fetch(quotationDataFor(sqOpenEditId)).then(function (r) { return r.json(); }).then(function (d) {
                if (!d || !d.success) { if (d && d.message) window.alert(d.message); return; }
                if (d.h && d.h.quotationNumber && document.getElementById("sqNum")) document.getElementById("sqNum").value = d.h.quotationNumber;
                applyQuotationData(d);
                var el = document.getElementById("addQuotationModal");
                if (el && typeof bootstrap !== "undefined") { bootstrap.Modal.getOrCreateInstance(el).show(); }
            }).catch(function () { window.alert("Could not load quotation for editing."); });
        }
    })();
</script>
