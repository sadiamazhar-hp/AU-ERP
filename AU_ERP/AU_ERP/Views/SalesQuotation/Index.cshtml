                    var p = (raw !== "") ? (parseFloat(raw) || 0) : (c.defaultPercent != null ? c.defaultPercent : 0);
                    if (p === 0) return;
                    run = applyUserCharge(c, run, p);
                } else {
                    var n = (raw !== "") ? Math.abs(parseFloat(raw) || 0) : 0;
                    if (n === 0) return;
                    run = applyUserCharge(c, run, n);
