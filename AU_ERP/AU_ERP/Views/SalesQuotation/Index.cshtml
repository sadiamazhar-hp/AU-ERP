<script>
    (function () {
        (function ensureSqViewModalOnBody() {
            var el = document.getElementById("sqViewModal");
            if (!el) return;
            function move() {
                if (el.parentElement !== document.body) document.body.appendChild(el);
            }
            el.addEventListener("show.bs.modal", move);
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", move);
            else move();
        })();
        (function ensureSqEmailConfirmModalOnBody() {
            var el = document.getElementById("sqEmailConfirmModal");
            if (!el) return;
            function move() {
                if (el.parentElement !== document.body) document.body.appendChild(el);
            }
            el.addEventListener("show.bs.modal", move);
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", move);
            else move();
        })();
        (function wireSqEmailConfirmModal() {
            var modalEl = document.getElementById("sqEmailConfirmModal");
            var okBtn = document.getElementById("sqEmailConfirmModalOk");
            if (!modalEl || !okBtn || !window.bootstrap) return;
            var pendingListEmailForm = null;
            var pendingModalEmailSubmitter = null;
            var bypassModalEmail = false;
            document.querySelectorAll("form.sq-quotation-email-form").forEach(function (form) {
                form.addEventListener("submit", function (ev) {
                    ev.preventDefault();
                    pendingListEmailForm = form;
                    pendingModalEmailSubmitter = null;
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                });
            });
            modalEl.addEventListener("hidden.bs.modal", function () {
                pendingListEmailForm = null;
                pendingModalEmailSubmitter = null;
            });
            okBtn.addEventListener("click", function () {
                if (pendingListEmailForm) {
                    var f = pendingListEmailForm;
                    pendingListEmailForm = null;
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    f.submit();
                    return;
                }
                if (pendingModalEmailSubmitter) {
                    var sub = pendingModalEmailSubmitter;
                    pendingModalEmailSubmitter = null;
                    var sqForm = document.getElementById("sqForm");
                    if (sqForm && sub) {
                        bypassModalEmail = true;
                        sqForm.requestSubmit(sub);
                        bypassModalEmail = false;
                    }
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                }
            });
            var sqForm = document.getElementById("sqForm");
            if (!sqForm) return;
            sqForm.addEventListener("submit", function (ev) {
                var sub = ev.submitter;
                if (!bypassModalEmail && sub && sub.getAttribute("name") === "SubmitAction" && sub.getAttribute("value") === "email") {
                    ev.preventDefault();
                    pendingModalEmailSubmitter = sub;
                    pendingListEmailForm = null;
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });
        })();
        const sqDetailsModalUrlPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sqDetailsModalUrlPlaceholder));
        function sqDetailsModalUrl(id) { return (sqDetailsModalUrlPlaceholder || "").replace("900000001", id); }
        document.querySelectorAll(".sq-btn-view").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var id = btn.getAttribute("data-sq-id");
                if (!id) return;
                var body = document.getElementById("sqViewModalBody");
                var m = document.getElementById("sqViewModal");
                if (body) body.innerHTML = '<p class="text-secondary small mb-0">Loading…</p>';
                if (window.bootstrap) {
                    var addM = document.getElementById("addQuotationModal");
                    var fM = document.getElementById("sqFilterModal");
                    if (addM && addM.classList.contains("show")) bootstrap.Modal.getOrCreateInstance(addM).hide();
                    if (fM && fM.classList.contains("show")) bootstrap.Modal.getOrCreateInstance(fM).hide();
                }
                if (m && window.bootstrap) { bootstrap.Modal.getOrCreateInstance(m).show(); }
                fetch(sqDetailsModalUrl(id), { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.text(); })
                    .then(function (html) { if (body) body.innerHTML = html; })
                    .catch(function () { if (body) body.innerHTML = '<p class="text-danger small">Could not load details.</p>'; });
            });
        });
        const defaults = { today: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(today)), twoW: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(twoWeeks)) };
        const uomBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("MaterialUomContextForQuotation", "SalesQuotation") ?? ""));
        const unitCostUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("QuotationLineUnitCost", "SalesQuotation") ?? ""));
        const sqFertSearchBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SearchFertMaterialsForQuotation", "SalesQuotation") ?? ""));
        const nextQuotationUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("NextQuotationNumber", "SalesQuotation") ?? ""));
        const schemaUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SchemaDetails", "SalesQuotation") ?? ""));
        const sqQuotationDataBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("QuotationData", "SalesQuotation", new { id = 0 }) ?? ""));
        const sqCustomerProfileUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("CustomerCommercialProfile", "SalesQuotation") ?? ""));
        const sqEmporiumWalkIn = @(isEmporiumWalkIn ? "true" : "false");
        const sqWalkInSchemaId = @walkInSchemaId;
        const sqCreateWalkInUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("CreateWalkInCustomer", "SalesQuotation") ?? ""));
        (function ensureSqWalkInAddCustomerModalOnBody() {
            var el = document.getElementById("sqWalkInAddCustomerModal");
            if (!el) return;
            function moveToBodyEnd() {
                document.body.appendChild(el);
            }
            function bumpZ() {
                el.style.setProperty("z-index", "100070", "important");
            }
            el.addEventListener("show.bs.modal", function () {
                moveToBodyEnd();
                requestAnimationFrame(bumpZ);
            });
            el.addEventListener("shown.bs.modal", bumpZ);
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", moveToBodyEnd);
            else moveToBodyEnd();
        })();
        function sqWalkInCustomerModalGet() {
            var el = document.getElementById("sqWalkInAddCustomerModal");
            if (!el || !window.bootstrap) return null;
            return bootstrap.Modal.getOrCreateInstance(el, { backdrop: false, keyboard: true });
        }
        function sqUpdateWalkInCustomerSummary() {
            var sum = document.getElementById("sqWalkInCustomerSummary");
            if (!sum) return;
            var valEl = document.getElementById("sqCustomer");
            var cat = document.getElementById("sqCustomerCatalog");
            var id = (valEl && valEl.value) || "";
            if (!id) { sum.textContent = "No customer selected."; return; }
            var label = id;
            if (cat) {
                for (var i = 0; i < cat.options.length; i++) {
                    if (cat.options[i].value === id) { label = (cat.options[i].textContent || "").trim() || id; break; }
                }
            }
            sum.textContent = label;
        }
        const sqOpenEditId = @Html.Raw(openEditId is int oei ? oei.ToString() : "null");
        const sqUpdateUrlTpl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Update", "SalesQuotation", new { id = 0 }) ?? ""));
        const sqCreateFormAction = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Create", "SalesQuotation") ?? ""));
        let schemaCharges = [];
        let _sqSkipFormReset = false;
        function quotationDataFor(quotationId) {
            if (!sqQuotationDataBase) return "";
            if (sqQuotationDataBase.indexOf("id=0") >= 0) return sqQuotationDataBase.replace("id=0", "id=" + quotationId);
            return sqQuotationDataBase.replace(/\/0(\?|$)/, "/" + quotationId + "$1");
        }
        function setSqFormToCreate() {
            var f = document.getElementById("sqForm");
            if (f && sqCreateFormAction) { f.action = sqCreateFormAction; f.setAttribute("data-sq-form-mode", "create"); }
        }
        function setSqFormToUpdate(quotationId) {
            var f = document.getElementById("sqForm");
            if (!f) return;
            if (sqUpdateUrlTpl) f.action = sqUpdateUrlTpl.replace("Update/0", "Update/" + quotationId).replace(/\/0(\?.*)?$/, "/" + quotationId + "$1");
            f.setAttribute("data-sq-form-mode", "update");
        }
        function sqEnsureCustomerInCatalog(entry) {
            if (!entry || !entry.bpId) return;
            var cat = document.getElementById("sqCustomerCatalog");
            if (!cat) return;
            var id = String(entry.bpId || "").trim();
            if (!id) return;
            for (var i = 0; i < cat.options.length; i++) {
                if (cat.options[i].value === id) return;
            }
            var opt = document.createElement("option");
            opt.value = id;
            opt.textContent = (entry.displayName || id).trim();
            opt.setAttribute("data-ship", entry.shipTo || "");
            cat.appendChild(opt);
        }
        function applyQuotationData(d) {
            var h = d.h, items = d.items || [];
            schemaCharges = d.schemaCharges || [];
            if (d.customerCatalogEntry) sqEnsureCustomerInCatalog(d.customerCatalogEntry);
            if (h.plantId && document.getElementById("sqPlant")) document.getElementById("sqPlant").value = h.plantId;
            if (h.distributionChannelId != null && document.getElementById("sqDc")) document.getElementById("sqDc").value = String(h.distributionChannelId);
            if (document.getElementById("sqSchema")) document.getElementById("sqSchema").value = h.configurationSchemaId != null && h.configurationSchemaId !== "" ? String(h.configurationSchemaId) : "";
            if (h.quotationDate && document.getElementById("sqQd")) document.getElementById("sqQd").value = h.quotationDate;
            if (h.validityDate && document.getElementById("sqVd")) document.getElementById("sqVd").value = h.validityDate;
            if (document.getElementById("sqNum")) document.getElementById("sqNum").value = h.quotationNumber || "";
            if (document.getElementById("sqModalTitle")) document.getElementById("sqModalTitle").textContent = "Edit — " + (h.quotationNumber || "");
            if (document.getElementById("sqCustomer")) document.getElementById("sqCustomer").value = h.customerBusinessPartnerId || "";
            sqSyncCustomerSearchFromValue();
            sqUpdateWalkInCustomerSummary();
            if (document.getElementById("sqAddr")) document.getElementById("sqAddr").value = h.shipToAddress || "";
            if (document.getElementById("sqItemChargeColumnIds")) document.getElementById("sqItemChargeColumnIds").value = h.itemChargeColumnIds || "";
            if (document.getElementById("sqQuotationLevelChargeIds")) document.getElementById("sqQuotationLevelChargeIds").value = h.quotationLevelChargeIds || "";
            if (document.getElementById("sqQuotationChargeValuesJson")) document.getElementById("sqQuotationChargeValuesJson").value = h.quotationChargeValuesJson || "";
            buildChargeDropdowns();
            var itemIds = parseIds(h.itemChargeColumnIds);
            var docIds = parseIds(h.quotationLevelChargeIds);
            document.querySelectorAll("#sqItemChargeMenu .sq-m-item-chk").forEach(function (cb) {
                var cid = parseInt(cb.getAttribute("data-cid"), 10);
                cb.checked = itemIds.indexOf(cid) >= 0;
            });
            document.querySelectorAll("#sqQuotationChargeMenu .sq-m-doc-chk").forEach(function (cb) {
                var cid = parseInt(cb.getAttribute("data-cid"), 10);
                cb.checked = docIds.indexOf(cid) >= 0;
            });
            renderItemChargeThead();
            var body = document.getElementById("sqItemsBody");
            if (body) body.innerHTML = "";
            (items || []).forEach(function (it) {
                var tr = parseTrFromRowHtml();
                if (!body) return;
                body.appendChild(tr);
                reindex();
                if (it.materialNumber) {
                    if (tr.querySelector(".sq-matno")) tr.querySelector(".sq-matno").value = it.materialNumber;
                    if (tr.querySelector(".bom-mat-picker-search")) tr.querySelector(".bom-mat-picker-search").value = (it.materialNumber + (it.materialDescription ? " — " + it.materialDescription : ""));
                }
                if (tr.querySelector(".sq-desc") && it.materialDescription) tr.querySelector(".sq-desc").value = it.materialDescription;
                if (tr.querySelector(".sq-grade") && (it.salesPriceGrade != null && it.salesPriceGrade !== "")) {
                    var gsv = String(it.salesPriceGrade);
                    if (gsv.toLowerCase() === "scrap") gsv = "A";
                    tr.querySelector(".sq-grade").value = gsv;
                }
                if (tr.querySelector(".sq-qty") && it.orderQuantity != null) tr.querySelector(".sq-qty").value = String(it.orderQuantity);
                if (tr.querySelector(".sq-unit") && it.unitPrice != null) tr.querySelector(".sq-unit").value = String(it.unitPrice);
                if (tr.querySelector(".sq-del") && it.deliveryDate) tr.querySelector(".sq-del").value = it.deliveryDate;
                appendItemChargeTds(tr);
                reindex();
                var chObj = {};
                try { if (it.itemChargeValuesJson) chObj = JSON.parse(it.itemChargeValuesJson); } catch (e) { chObj = {}; }
                tr.querySelectorAll(".sq-ln-chg").forEach(function (inp) {
                    var k = String(inp.getAttribute("data-cid"));
                    if (chObj.hasOwnProperty(k) && chObj[k] != null) inp.value = String(chObj[k]);
                });
                wireRow(tr);
                if (it.materialNumber) uomFill(tr, it.materialNumber, it.materialDescription || "", { preserveUnitPrice: it.unitPrice, savedUomId: it.quantityUomId });
            });
            if (!items.length) {
                if (body) { body.innerHTML = rowHtml().trim(); reindex(); renderItemChargeThead(); body.querySelectorAll("tr.sq-item-row").forEach(function (tr) { tr.querySelector(".sq-del") && (tr.querySelector(".sq-del").value = document.getElementById("sqQd") && document.getElementById("sqQd").value || defaults.today); appendItemChargeTds(tr); }); reindex(); body.querySelectorAll("tr.sq-item-row").forEach(wireRow); }
            }
            buildQuotationChargeInputs();
            var docObj = {};
            try { if (h.quotationChargeValuesJson) docObj = JSON.parse(h.quotationChargeValuesJson); } catch (e) { docObj = {}; }
            document.querySelectorAll(".sq-doc-chg-val").forEach(function (inp) {
                var k = String(inp.getAttribute("data-cid"));
                if (docObj.hasOwnProperty(k) && docObj[k] != null) inp.value = String(docObj[k]);
            });
            reindex();
            recalcFooter();
            syncHiddens();
            if (h.id) setSqFormToUpdate(h.id);
        }
        function esc(s) { if (s == null) return ""; return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;"); }
        function chMap() { const m = {}; (schemaCharges || []).forEach(function (c) { m[c.id] = c; }); return m; }
        function parseIds(s) { if (!s) return []; return s.split(",").map(function (x) { return parseInt(x, 10); }).filter(function (n) { return n > 0; }); }
        function selectedItemChgOrder() {
            var s = new Set();
            document.querySelectorAll("#sqItemChargeMenu .sq-m-item-chk:checked").forEach(function (x) { s.add(parseInt(x.getAttribute("data-cid"), 10)); });
            return (schemaCharges || []).map(function (c) { return c.id; }).filter(function (id) { return s.has(id); });
        }
        function selectedQuotChgOrder() {
            var s = new Set();
            document.querySelectorAll("#sqQuotationChargeMenu .sq-m-doc-chk:checked").forEach(function (x) { s.add(parseInt(x.getAttribute("data-cid"), 10)); });
            return (schemaCharges || []).map(function (c) { return c.id; }).filter(function (id) { return s.has(id); });
        }
        function syncHiddens() {
            var a = selectedItemChgOrder();
            var b = selectedQuotChgOrder();
            var h1 = document.getElementById("sqItemChargeColumnIds"), h2 = document.getElementById("sqQuotationLevelChargeIds");
            if (h1) h1.value = a.join(",");
            if (h2) h2.value = b.join(",");
            var o = {};
            b.forEach(function (cid) {
                var el = document.querySelector(".sq-doc-chg-val[data-cid=\"" + cid + "\"]");
                if (el && el.value !== "") o[String(cid)] = el.value;
            });
            var hj = document.getElementById("sqQuotationChargeValuesJson");
            if (hj) hj.value = Object.keys(o).length ? JSON.stringify(o) : "";
            var plantSel = document.getElementById("sqPlant");
            var dcSel = document.getElementById("sqDc");
            var schemaSel = document.getElementById("sqSchema");
            var plantHidden = document.getElementById("sqPlantHidden");
            var dcHidden = document.getElementById("sqDcHidden");
            var schemaHidden = document.getElementById("sqSchemaHidden");
            if (plantHidden) plantHidden.value = plantSel ? (plantSel.value || "") : "";
            if (dcHidden) dcHidden.value = dcSel ? (dcSel.value || "") : "";
            if (schemaHidden) schemaHidden.value = schemaSel ? (schemaSel.value || "") : "";
        }
        function applySqCustomerCommercialProfile(customerId) {
            if (!customerId || !sqCustomerProfileUrl) return;
            fetch(sqCustomerProfileUrl + (sqCustomerProfileUrl.indexOf("?") >= 0 ? "&" : "?") + "bpId=" + encodeURIComponent(customerId))
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (!res || !res.success || !res.profile) return;
                    var p = res.profile;
                    if (document.getElementById("sqPlant") && p.plantId) document.getElementById("sqPlant").value = p.plantId;
                    if (document.getElementById("sqDc") && p.distributionChannelId != null) document.getElementById("sqDc").value = String(p.distributionChannelId);
                    if (document.getElementById("sqDc") && (!p.distributionChannelId) && p.distributionChannel) {
                        var dcSel = document.getElementById("sqDc");
                        var want = String(p.distributionChannel || "").trim().toLowerCase();
                        if (want && dcSel) {
