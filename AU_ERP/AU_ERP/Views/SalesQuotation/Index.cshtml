            return (schemaCharges || []).map(function (c) { return c.id; }).filter(function (id) { return s.has(id); });
        }
        function syncHiddens() {
            var a = selectedItemChgOrder();
            var b = selectedQuotChgOrder();
            var h1 = document.getElementById("sqItemChargeColumnIds"), h2 = document.getElementById("sqQuotationLevelChargeIds");
            if (h1) h1.value = a.join(",");
            if (h2) h2.value = b.join(",");
            var o = {};
            b.forEach(function (cid) {
                var el = document.querySelector(".sq-doc-chg-val[data-cid=\"" + cid + "\"]");
                if (el && el.value !== "") o[String(cid)] = el.value;
            });
            var hj = document.getElementById("sqQuotationChargeValuesJson");
