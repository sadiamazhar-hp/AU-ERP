@model AU_ERP.Models.ViewModels.SalesQuotationListVm
@using System.Globalization
@using AU_ERP.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sales Quotation";
    ViewBag.Title = "Sales Quotation";
    int? openEditId = ViewBag.OpenEditId as int?;
    var list = Model?.Items ?? new List<SalesQuotation>();
    var plants = ViewBag.Plants as List<PlantsSample> ?? new List<PlantsSample>();
    var chans = ViewBag.DistributionChannels as List<DistributionChannel> ?? new List<DistributionChannel>();
    var customers = ViewBag.Customers as List<BusinessPartnerMasterSample> ?? new List<BusinessPartnerMasterSample>();
    var schemas = ViewBag.ConfigurationSchemas as List<ConfigurationSchema> ?? new List<ConfigurationSchema>();
    var today = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var twoWeeks = DateTime.Today.AddDays(14).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var firstPlant = plants.FirstOrDefault()?.PlantID ?? "";
    var firstChan = chans.FirstOrDefault()?.DistributionChannelID;
    string FmtDate(DateTime d) => d.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture);
    var listQ = Model?.Q ?? "";
    var listStatus = (Model == null || string.IsNullOrWhiteSpace(Model.Status) || string.Equals(Model.Status, "All", StringComparison.OrdinalIgnoreCase)) ? "All" : Model.Status;
    var listPlantId = Model?.PlantId ?? "";
    int? listDcId = Model?.DistributionChannelId;
    var stSel = listStatus;
    var sqDetailsModalUrlPlaceholder = Url.Action("DetailsModal", "SalesQuotation", new { id = 900000001 }) ?? "";
    var walkInSchemaId = ViewBag.WalkInSchemaId as int? ?? 0;
    var isEmporiumWalkIn = ViewBag.IsEmporiumWalkInUser as bool? == true;
    var canAddWalkInCustomer = ViewBag.CanAddWalkInCustomer as bool? == true;
    var missingPlantAssignment = ViewBag.MissingPlantAssignment as bool? == true;
    var isSinglePlantLocked = ViewBag.IsSinglePlantLocked as bool? == true;
    var lockedPlantId = ViewBag.LockedPlantId as string ?? "";
    PlantsSample? SqPlantNameRow(string pid) =>
        plants.FirstOrDefault(p => string.Equals(p.PlantID, pid, StringComparison.OrdinalIgnoreCase));
}

@section Styles {
<style>
    .sq-page { color: var(--text, #32363a); }
    .sq-page .sq-hero { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
    .sq-page .sq-hero h1 { font-size: 1.35rem; font-weight: 600; color: var(--dark, #354a5e); margin: 0 0 .25rem 0; }
    .sq-page .sq-hero p { margin: 0; color: var(--subtle, #6a7c8e); font-size: .9rem; }
    .sq-btn-new { background: var(--blue, #0070f2); color: #fff; border: 1px solid var(--blue, #0070f2); border-radius: 4px; padding: .45rem 1rem; font-size: .875rem; font-weight: 500; }
    .sq-btn-new:hover { filter: brightness(1.05); color: #fff; }
    .sq-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem; max-width: 32rem; margin-bottom: 1.25rem; }
    @@media (max-width: 500px) { .sq-stats { grid-template-columns: 1fr; } }
    .sq-stat-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: .85rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,.12); border-top: 3px solid var(--blue, #0070f2); }
    .sq-stat-card .sq-stat-label { font-size: .72rem; font-weight: 600; letter-spacing: .04em; color: var(--subtle, #6a7c8e); text-transform: uppercase; }
    .sq-stat-card .sq-stat-val { font-size: 1.65rem; font-weight: 600; color: var(--dark, #354a5e); line-height: 1.2; margin-top: .2rem; }
    .sq-table-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: 1rem 1.1rem; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
    .sq-table-card .sq-table-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: .75rem; }
    .sq-table-card .sq-table-title { font-size: 1rem; font-weight: 600; color: var(--dark, #354a5e); margin: 0; }
    .sq-table-card .sq-toolbar { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
    .sq-table-card .sq-toolbar .form-control-sm { min-width: 10rem; }
    .sq-table-wrap { overflow-x: auto; }
    .sq-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .sq-table thead th { background: var(--dark, #354a5e); color: #fff; font-weight: 500; padding: .55rem .65rem; text-align: left; white-space: nowrap; }
    .sq-table tbody td { border: 1px solid #ddd; padding: .45rem .6rem; vertical-align: middle; }
    .sq-table tbody tr:nth-child(even) { background: #fafafa; }
    .sq-badge { display: inline-block; padding: .2rem .55rem; border-radius: 999px; font-size: .75rem; font-weight: 500; }
    .sq-badge-draft { background: #e2e3e5; color: #41464b; }
    .sq-badge-sent { background: #d1e7dd; color: #0f5132; }
    .sq-actions { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; }
    .sq-actions .btn { font-size: .75rem; padding: .2rem .5rem; }
</style>
}

<style>
    .bom-mat-picker { position: relative; }
    .bom-mat-picker-dropdown {
        display: none; position: absolute; left: 0; right: 0; top: 100%; margin-top: 2px;
        max-height: 220px; overflow-y: auto; z-index: 1060; background: #fff; border: 1px solid #ccc;
        border-radius: 2px; box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .bom-mat-picker-dropdown.show { display: block; }
    .bom-mat-picker-item { padding: 6px 10px; font-size: .78rem; cursor: pointer; border-bottom: 1px solid #eee; }
    .bom-mat-picker-item:hover { background: var(--sap-selected, #b3d7ff); }
    .bom-mat-picker-empty { padding: 8px 10px; font-size: .75rem; color: #666; }
    .sq-customer-combo .sq-customer-dropdown { font-size: .82rem; }
    .sq-customer-item { cursor: pointer; }
    .sq-customer-item:hover, .sq-customer-item:focus { background: var(--sap-selected, #b3d7ff); outline: none; }
    .sq-line-charges { display: flex; flex-wrap: wrap; gap: 0.35rem; max-width: 14rem; font-size: .68rem; line-height: 1.2; }
    .sq-line-charges label { margin: 0; white-space: nowrap; }
    .sq-doc-charges { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: .75rem; }
    .sq-summary { min-width: 16rem; border: 1px solid #dee2e6; border-radius: 4px; padding: 0.75rem 1rem; background: #fafafa; }
    .sq-summary .sq-grand { color: #0d6efd; font-weight: 600; border-top: 1px solid #dee2e6; margin-top: 0.35rem; padding-top: 0.35rem; }
    .sq-items-table-wrap { overflow-x: auto; min-width: 0; }
    .sq-items-table { font-size: .78rem; white-space: nowrap; }
    .sq-items-table th, .sq-items-table td { vertical-align: middle; }
    .sq-chg-menu { max-height: 240px; overflow-y: auto; }
    #addQuotationModal.sq-quotation-modal .modal-dialog {
        max-height: calc(100vh - 1rem);
        margin: 0.5rem auto;
    }
    #addQuotationModal.sq-quotation-modal .modal-content {
        max-height: calc(100vh - 1rem);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    #addQuotationModal.sq-quotation-modal .modal-body {
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        min-height: 0;
        flex: 1 1 auto;
    }
    .btn-sq-so { background: #354E68; border-color: #354E68; color: #fff; }
    .btn-sq-so:hover, .btn-sq-so:focus { background: #2a3d52; border-color: #2a3d52; color: #fff; }
</style>

<div class="sq-page">
    <div class="sq-hero">
        <div>
            <h1>Sales Quotation</h1>
            <p>Customer price offers and follow-up to sales orders.</p>
        </div>
        <button type="button" class="sq-btn-new" data-bs-toggle="modal" data-bs-target="#addQuotationModal">
            <i class="bi bi-plus-lg"></i> New Quotation
        </button>
</div>

    @if (TempData["QuotationMessage"] is string okMsg2)
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@okMsg2</div>
    }
    @if (TempData["QuotationError"] is string errMsg2)
    {
        <div class="alert alert-danger py-2 small mb-3" role="status">@errMsg2</div>
    }
    @if (missingPlantAssignment)
    {
        <div class="alert alert-warning py-2 small mb-3" role="status">
            You have Sales access but no plant is assigned to your profile. Ask an administrator to edit your user and select at least one plant for the Sales or Store department.
        </div>
    }

    <div class="sq-table-card">
        <div class="sq-table-head">
            <h2 class="sq-table-title">Quotations (@list.Count)</h2>
            <form id="sqListFilterForm" method="get" asp-controller="SalesQuotation" asp-action="Index" class="sq-toolbar">
                <input type="search" name="q" id="sqListQ" class="form-control form-control-sm" placeholder="Quotation # or customer…" value="@listQ" />
                <input type="hidden" name="status" id="sqListStatus" value="@stSel" />
                <input type="hidden" name="plantId" id="sqListPlant" value="@listPlantId" />
                <input type="hidden" name="distributionChannelId" id="sqListDc" value="@(listDcId?.ToString() ?? "")" />
                @if (openEditId is int eid)
                {
                    <input type="hidden" name="editId" value="@eid" />
                }
                <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#sqFilterModal">Filter</button>
                <a class="btn btn-sm btn-link text-secondary" asp-action="Index">Clear</a>
            </form>
        </div>
        <div class="sq-table-wrap">
            <table class="sq-table">
                <thead>
            <tr>
                <th>Quotation #</th>
                <th>Plant</th>
                <th>Distribution channel</th>
                <th>Customer (sold-to)</th>
                <th>Quotation date</th>
                <th>Status</th>
                        <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (list.Count == 0)
        {
                    <tr><td colspan="7" class="text-secondary">No quotations yet.</td></tr>
        }
        else foreach (var q in list)
        {
                    var isDraft = q.Status == SalesQuotation.StatusDraft;
                    string? linkedSoStatus = null;
                    if (Model?.LinkedSalesOrderStatusByQuotationId is { } soMap && soMap.TryGetValue(q.Id, out var lst))
                        linkedSoStatus = lst;
                    var showSoButton = linkedSoStatus == null
                        || string.Equals(linkedSoStatus, SalesOrder.StatusOpen, StringComparison.OrdinalIgnoreCase);
                    var deleteConfirm = isDraft ? "Delete this draft quotation?" : "Delete this sent quotation? This cannot be undone.";
            <tr>
                <td class="text-nowrap"><strong>@q.QuotationNumber</strong></td>
                <td>@(q.Plant?.PlantName ?? "—")</td>
                <td>@(q.DistributionChannel?.DistributionChannelName ?? "—")</td>
                <td>@(q.CustomerName ?? "—")</td>
                        <td class="text-nowrap">@FmtDate(q.QuotationDate)</td>
                        <td>
                            @if (isDraft)
                            { <span class="sq-badge sq-badge-draft">Draft</span> }
                            else
                            { <span class="sq-badge sq-badge-sent">Sent</span> }
                        </td>
                        <td>
                            <div class="sq-actions">
                                @if (isDraft)
                                {
                                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "SalesQuotation", new { editId = q.Id, q = listQ, status = listStatus, plantId = string.IsNullOrEmpty(listPlantId) ? null : listPlantId, distributionChannelId = listDcId })" title="Edit"><i class="bi bi-pencil"></i> Edit</a>
                    }
                    else
                    {
                                    <button type="button" class="btn btn-outline-secondary btn-sm sq-btn-view" data-sq-id="@q.Id" title="View"><i class="bi bi-eye"></i> View</button>
                                    @if (showSoButton)
                                    {
                                        <a class="btn btn-sq-so btn-sm" title="Create or open sales order from this quotation" href="@Url.Action("CreateFromQuotation", "SalesOrder", new { quotationId = q.Id, returnQ = listQ, returnStatus = listStatus, returnPlantId = string.IsNullOrEmpty(listPlantId) ? null : listPlantId, returnDistributionChannelId = listDcId })"><i class="bi bi-cart"></i> SO</a>
                                    }
                                }
                                <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("DownloadPdf", "SalesQuotation", new { id = q.Id })" title="Download PDF"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                                <form asp-action="EmailToCustomer" asp-controller="SalesQuotation" asp-route-id="@q.Id" method="post" class="d-inline sq-quotation-email-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnQ" value="@listQ" />
                                    <input type="hidden" name="returnStatus" value="@listStatus" />
                                    <input type="hidden" name="returnPlantId" value="@listPlantId" />
                                    <input type="hidden" name="returnDistributionChannelId" value="@(listDcId?.ToString() ?? "")" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Email quotation to customer"><i class="bi bi-envelope"></i> Email</button>
                                </form>
                                <form asp-action="Delete" asp-controller="SalesQuotation" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm('@deleteConfirm');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnQ" value="@listQ" />
                                    <input type="hidden" name="returnStatus" value="@listStatus" />
                                    <input type="hidden" name="returnPlantId" value="@listPlantId" />
                                    <input type="hidden" name="returnDistributionChannelId" value="@(listDcId?.ToString() ?? "")" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"><i class="bi bi-trash"></i> Delete</button>
                                </form>
                            </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
        </div>
    </div>
</div>

<div class="modal fade" id="sqViewModal" tabindex="-1" aria-labelledby="sqViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="sqViewModalLabel">Sales quotation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-2" id="sqViewModalBody">
                <p class="text-secondary small mb-0">Loading…</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sqFilterModal" tabindex="-1" aria-labelledby="sqFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="sqFilterModalLabel">Filter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">Status</label>
                    <select id="sqModStatus" class="form-select form-select-sm">
                        <option value="All">All</option>
                        <option value="@SalesQuotation.StatusDraft">Draft</option>
                        <option value="@SalesQuotation.StatusSent">Sent</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Plant</label>
                    @if (isSinglePlantLocked && !string.IsNullOrWhiteSpace(lockedPlantId))
                    {
                        var lockPn = SqPlantNameRow(lockedPlantId.Trim());
                        <input type="hidden" id="sqModPlant" value="@lockedPlantId.Trim()" />
                        <input type="text" class="form-control form-control-sm bg-light" readonly value="@(lockPn?.PlantName ?? lockedPlantId)" title="Assigned plant" />
                    }
                    else if (!missingPlantAssignment)
                    {
                        <select id="sqModPlant" class="form-select form-select-sm">
                            <option value="">All assigned</option>
                            @foreach (var p in plants)
                            {
                                <option value="@p.PlantID">@p.PlantName</option>
                            }
                        </select>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">No plants assigned.</p>
                    }
                </div>
                <div class="mb-2">
                    <label class="form-label small">Distribution channel</label>
                    <select id="sqModDc" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var ch in chans)
                        {
                            <option value="@ch.DistributionChannelID">@ch.DistributionChannelName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm sq-btn-new" onclick="sqApplyFilterModal()">Apply</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addQuotationModal" tabindex="-1" aria-labelledby="sqModalTitle" aria-hidden="true" data-sq-action-create="@Url.Action("Create", "SalesQuotation")" data-sq-action-update-tpl="@Url.Action("Update", "SalesQuotation", new { id = 0 })">
    <div class="modal-dialog modal-xl sq-quotation-modal">
        <div class="modal-content">
            <form asp-action="Create" asp-controller="SalesQuotation" method="post" id="sqForm" data-sq-form-mode="create" data-au-prevent-enter-submit>
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnQ" id="sqReturnQ" value="@listQ" />
                <input type="hidden" name="ReturnStatus" id="sqReturnStatus" value="@listStatus" />
                <input type="hidden" name="ReturnPlantId" id="sqReturnPlantId" value="@listPlantId" />
                <input type="hidden" name="ReturnDistributionChannelId" id="sqReturnDcId" value="@(listDcId?.ToString() ?? "")" />
                <input type="hidden" name="QuotationLevelChargeIds" id="sqQuotationLevelChargeIds" value="" />
                <input type="hidden" name="ItemChargeColumnIds" id="sqItemChargeColumnIds" value="" />
                <input type="hidden" name="QuotationChargeValuesJson" id="sqQuotationChargeValuesJson" value="" />
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="sqModalTitle">New Sales Quotation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="sqNum">Quotation number</label>
                            <input class="form-control form-control-sm" id="sqNum" readonly style="background:#f0f0f0;" autocomplete="off" />
                        </div>
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="sqPlant">Plant <span class="text-danger">*</span></label>
                            @if (isSinglePlantLocked && !string.IsNullOrWhiteSpace(lockedPlantId))
                            {
                                var createLockPn = SqPlantNameRow(lockedPlantId.Trim());
                                <input type="hidden" name="PlantId" id="sqPlantHidden" value="@lockedPlantId.Trim()" />
                                <input type="text" class="form-control form-control-sm bg-light" id="sqPlant" readonly value="@(createLockPn?.PlantName ?? lockedPlantId)" title="Assigned plant" />
                            }
                            else
                            {
                            <select class="form-select form-select-sm" id="sqPlant" required disabled>
                                <option value="">— Select —</option>
                                @foreach (var p in plants)
                                {
                                    <option value="@p.PlantID">@p.PlantName</option>
                                }
                            </select>
                            <input type="hidden" name="PlantId" id="sqPlantHidden" />
                            }
                        </div>
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="sqDc">Distribution channel <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" id="sqDc" required disabled>
                                <option value="">— Select —</option>
                                @foreach (var ch in chans)
                                {
                                    <option value="@ch.DistributionChannelID">@ch.DistributionChannelName</option>
                                }
                            </select>
                            <input type="hidden" name="DistributionChannelId" id="sqDcHidden" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small mb-0" for="sqCustomerSearch">Customer (Sold to party) <span class="text-danger">*</span></label>
                            <input type="hidden" name="CustomerBusinessPartnerId" id="sqCustomer" value="" required autocomplete="off" />
                            @if (canAddWalkInCustomer)
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2 border rounded px-2 py-2 bg-light mt-1">
                                    <span class="text-secondary small flex-grow-1" id="sqWalkInCustomerSummary" style="min-height:1.35rem;">No customer selected.</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" id="sqOpenWalkInCustomerBtn">Add customer</button>
                                </div>
                            }
                            <select id="sqCustomerCatalog" class="d-none" aria-hidden="true" tabindex="-1">
                                <option value="">— Select —</option>
                                @foreach (var c in customers)
                                {
                                    var ship = string.Join(", ", new[] { c.HouseNo, c.Street, c.City, c.PostalCode, c.Country }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                    <option value="@c.BPID" data-ship="@ship">@(c.FullName ?? c.BPID)</option>
                                }
                            </select>
                            <div class="sq-customer-combo position-relative@(canAddWalkInCustomer ? " mt-2" : " mt-1")">
                                <input type="text" class="form-control form-control-sm" id="sqCustomerSearch" placeholder="Search customer (name, ID, address)…" autocomplete="off" />
                                <div id="sqCustomerDropdown" class="sq-customer-dropdown border rounded bg-white shadow-sm" style="display: none;" role="listbox"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-0" for="sqAddr">Address (Ship to party) <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" name="ShipToAddress" id="sqAddr" type="text" maxlength="1000" autocomplete="street-address" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-6 col-md-4 col-lg-2">
                            <label class="form-label small mb-0" for="sqQd">Quotation date <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" type="date" name="QuotationDate" id="sqQd" value="@today" required />
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <label class="form-label small mb-0" for="sqVd">Validity date <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" type="date" name="ValidityDate" id="sqVd" value="@twoWeeks" required />
                        </div>
                        <div class="col-12 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="sqSchema">Configuration schema <span class="text-danger">*</span></label>
                            @if (isEmporiumWalkIn && walkInSchemaId > 0)
                            {
                                <input type="text" class="form-control form-control-sm" id="sqSchemaReadonlyLabel" readonly tabindex="-1" value="WalkIn" />
                                <select class="form-select form-select-sm d-none" id="sqSchema" required disabled aria-hidden="true">
                                    <option value="">— Select —</option>
                                    @foreach (var s in schemas)
                                    {
                                        if (s.Id == walkInSchemaId)
                                        { <option value="@s.Id" selected>@s.Title</option> }
                                        else
                                        { <option value="@s.Id">@s.Title</option> }
                                    }
                                </select>
                                <input type="hidden" name="ConfigurationSchemaId" id="sqSchemaHidden" value="@walkInSchemaId" />
                            }
                            else
                            {
                                <select class="form-select form-select-sm" id="sqSchema" required disabled>
                                    <option value="">— Select —</option>
                                    @foreach (var s in schemas)
                                    {
                                        <option value="@s.Id">@s.Title</option>
                                    }
                                </select>
                                <input type="hidden" name="ConfigurationSchemaId" id="sqSchemaHidden" />
                            }
                        </div>
                        <div class="col-12 col-lg-5" id="sqChargeSelectRow">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small mb-0" for="sqItemChgDropBtn">Item charges</label>
                                    <div class="dropdown w-100">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="sqItemChgDropBtn">Select…</button>
                                        <ul class="dropdown-menu p-2 shadow sq-chg-menu" id="sqItemChargeMenu" onclick="event.stopPropagation();"></ul>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0" for="sqDocChgDropBtn">Quotation charges</label>
                                    <div class="dropdown w-100">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="sqDocChgDropBtn">Select…</button>
                                        <ul class="dropdown-menu p-2 shadow sq-chg-menu" id="sqQuotationChargeMenu" onclick="event.stopPropagation();"></ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h6 class="border-bottom pb-1 mb-2 small">Line items</h6>
                    <div class="sq-items-table-wrap">
                        <table class="table table-sm table-bordered sq-items-table mb-2">
                            <thead class="table-light">
                                <tr id="sqItemsHeadRow">
                                    <th>#</th>
                                    <th>Item</th>
                                    <th>Description</th>
                                    <th>UOM</th>
                                    <th>Grade</th>
                                    <th>Qty</th>
                                    <th>Unit price</th>
                                    <th class="text-end">Net Price</th>
                                    <th class="text-end" id="sqThLineTotal">Line total (PKR)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="sqItemsBody"></tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="btnSqAddRow">+ Add Line</button>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <h6 class="border-bottom pb-1 mb-2 small">Quotation charge inputs</h6>
                            <div class="text-muted small" id="sqDocChargeInputsHint">Select quotation charges above to enter amounts here.</div>
                            <div class="vstack gap-2 mt-2" id="sqQuotationChargeInputs"></div>
                        </div>
                        <div class="col-lg-6 ms-lg-auto">
                            <div class="sq-summary ms-lg-auto" style="max-width:20rem">
                                <div class="d-flex justify-content-between"><span>Subtotal (PKR)</span><input type="text" class="form-control form-control-sm text-end border-0 bg-transparent p-0" id="sqSumSub" value="0.00" readonly style="max-width:8rem" aria-readonly="true" /></div>
                                <div class="d-flex justify-content-between sq-grand align-items-center pt-1"><span>Grand total (PKR)</span><input type="text" class="form-control form-control-sm text-end border-0 p-0 fw-semibold text-primary" id="sqSumGrand" value="0.00" readonly style="max-width:8rem" aria-readonly="true" /></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer flex-wrap gap-2 py-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-outline-primary btn-sm" name="SubmitAction" value="draft" formnovalidate><i class="bi bi-floppy me-1"></i>Save Draft</button>
                    <button type="submit" class="btn btn-outline-success btn-sm" name="SubmitAction" value="email"><i class="bi bi-envelope me-1"></i>Send email to customer</button>
                    <button type="submit" class="btn btn-primary btn-sm" name="SubmitAction" value="send"><i class="bi bi-send me-1"></i>Send to Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

