<div class="modal fade" id="sqEmailConfirmModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="sqEmailConfirmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered au-material-delete-confirm-dialog">
