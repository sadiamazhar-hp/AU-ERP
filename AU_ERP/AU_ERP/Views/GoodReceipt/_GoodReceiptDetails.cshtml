@model AU_ERP.Models.GoodReceiptRowVm

<div class="row g-3">
    <div class="col-md-4">
        <div class="text-muted small">Document Date</div>
        <div>@Model.DocumentDate.ToString("dd-MMM-yyyy")</div>
    </div>
    <div class="col-md-4">
        <div class="text-muted small">Document Number</div>
        <div>@(string.IsNullOrWhiteSpace(Model.DocumentNumber) ? "—" : Model.DocumentNumber)</div>
    </div>
    <div class="col-md-4">
        <div class="text-muted small">Status</div>
        <div>
            <span class="badge @(Model.IsPosted ? "bg-success" : "bg-secondary")">@(Model.IsPosted ? "Posted" : "Draft")</span>
        </div>
    </div>

    <div class="col-md-4">
        <div class="text-muted small">Production Order</div>
        <div>@(Model.ProductionNumber?.ToString() ?? Model.ProductionOrderId.ToString())</div>
    </div>
    <div class="col-md-4">
        <div class="text-muted small">Material</div>
        <div>@(Model.FinishedMaterialNumber ?? "—")</div>
    </div>
    <div class="col-md-4">
        <div class="text-muted small">Description</div>
        <div>@(string.IsNullOrWhiteSpace(Model.FinishedMaterialName) ? "—" : Model.FinishedMaterialName)</div>
    </div>

    <div class="col-md-4">
        <div class="text-muted small">Batch No</div>
        <div>@(string.IsNullOrWhiteSpace(Model.BatchNo) ? "—" : Model.BatchNo)</div>
    </div>
    <div class="col-md-4">
        <div class="text-muted small">Produced Qty</div>
        <div>@Model.ProducedQty.ToString("0.####")</div>
    </div>
</div>

<hr />

<div class="row g-3">
    <div class="col-md-3">
        <div class="text-muted small">Grade A</div>
        <div>@Model.QtyFirstQuality.ToString("0.####")</div>
    </div>
    <div class="col-md-3">
        <div class="text-muted small">Grade B</div>
        <div>@Model.QtySecondQuality.ToString("0.####")</div>
    </div>
    <div class="col-md-3">
        <div class="text-muted small">Grade C</div>
        <div>@Model.QtyThirdQuality.ToString("0.####")</div>
    </div>
    <div class="col-md-3">
        <div class="text-muted small">Scrap</div>
        <div>@Model.RejectedScrapQty.ToString("0.####")</div>
    </div>
</div>

