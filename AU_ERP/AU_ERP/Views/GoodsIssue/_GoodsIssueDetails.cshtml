@model AU_ERP.Models.GoodsIssueDocument

@{
    var po = Model.ProductionOrder;
    var mat = string.IsNullOrWhiteSpace(po?.FinishedMaterial?.Description)
        ? (po?.FinishedMaterialNumber ?? "—")
        : $"{po?.FinishedMaterialNumber} — {po?.FinishedMaterial?.Description}";
    var groupedLines = (Model.Lines ?? new List<AU_ERP.Models.GoodsIssueDocumentLine>())
        .OrderBy(x => x.ProductionOrderLineId ?? int.MaxValue)
        .ThenBy(x => x.Id)
        .GroupBy(x => new
        {
            ProductionOrderLineId = x.ProductionOrderLineId,
            FertMaterialNumber = x.FertMaterialNumber ?? "",
            FertMaterialDescription = x.FertMaterialDescription ?? ""
        })
        .ToList();
}

<div class="mb-2">
    <div><strong>GI Number:</strong> @Model.DocumentNumber</div>
    <div><strong>Date:</strong> @Model.DocumentDate.ToString("dd-MMM-yyyy")</div>
    <div><strong>Status:</strong> @Model.Status</div>
    <div><strong>Dispatch:</strong> @Model.DispatchStatus@if (Model.DispatchSentAt is DateTime ds){<text> (sent @ds.ToString("dd-MMM-yyyy HH:mm"))</text>}</div>
    <div><strong>Production Order:</strong> PO-@(po != null ? po.ProductionNumber.ToString() : "—")</div>
    <div><strong>Finished Material:</strong> @mat</div>
</div>

@if (!groupedLines.Any())
{
    <div class="text-secondary">No BOM lines found.</div>
}
else
{
    foreach (var grp in groupedLines)
    {
        var fertLabel = string.IsNullOrWhiteSpace(grp.Key.FertMaterialDescription)
            ? (string.IsNullOrWhiteSpace(grp.Key.FertMaterialNumber) ? "Unmapped FERT item" : grp.Key.FertMaterialNumber)
            : $"{grp.Key.FertMaterialNumber} — {grp.Key.FertMaterialDescription}";
        <div class="border rounded p-2 mb-3">
            <div class="fw-semibold mb-2">
                FERT Line @(grp.Key.ProductionOrderLineId?.ToString() ?? "—"): @fertLabel
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Material Number</th>
                            <th>Description</th>
                            <th class="text-end">Required</th>
                            <th class="text-end">Issued</th>
                            <th class="text-end">Remaining</th>
                            <th>UOM</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in grp)
                    {
                        <tr>
                            <td>@l.MaterialNumber</td>
                            <td>@l.MaterialDescription</td>
                            <td class="text-end">@l.RequiredQty.ToString("0.####")</td>
                            <td class="text-end">@l.IssuedQty.ToString("0.####")</td>
                            <td class="text-end">@l.RemainingQty.ToString("0.####")</td>
                            <td>@(l.RequiredUom?.Code ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
