@model AU_ERP.Models.ViewModels.ReturnOrderIndexVm
@using System.Globalization
@{
    ViewData["Title"] = "Return order";
    var n = Model.Orders.Count;
}

@section Styles {
    <style>
        .ro-page { color: var(--text, #32363a); }
        .ro-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: 1rem 1.1rem; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
        .ro-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
        .ro-table thead th { background: #354a5e; color: #fff; font-weight: 500; padding: .55rem .65rem; text-align: left; }
        .ro-table tbody td { border: 1px solid #ddd; padding: .45rem .6rem; vertical-align: middle; }
        .ro-table tbody tr:nth-child(even) { background: #fafafa; }
    </style>
}

<div class="ro-page">
    <h1 class="h4 mb-3">Return order</h1>
    <p class="text-secondary small mb-3">Return orders are created from the Invoice screen when a customer returns delivered goods.</p>

    @if (TempData["RoMessage"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@ok</div>
    }
    @if (TempData["RoError"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger py-2 small mb-3" role="alert">@err</div>
    }

    <div class="ro-card">
        <h2 class="h6 mb-3">Documents (@n.ToString("N0", CultureInfo.CurrentCulture))</h2>
        <div class="table-responsive">
            <table class="ro-table">
                <thead>
                    <tr>
                        <th>Return doc no.</th>
                        <th>Date</th>
                        <th>Invoice no.</th>
                        <th>Dealer</th>
                        <th>Reason (excerpt)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (n == 0)
                    {
                        <tr><td colspan="6" class="text-secondary">No return orders yet.</td></tr>
                    }
                    else
                    {
                        foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td><strong>@o.DocumentNumber</strong></td>
                                <td>@o.DocumentDate.ToString("dd-MMM-yyyy", CultureInfo.CurrentCulture)</td>
                                <td>@o.InvoiceDocumentNumber</td>
                                <td>@(o.DealerDisplayName ?? "—")</td>
                                <td class="small text-secondary">@o.ReturnReasonSnippet</td>
                                <td><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@o.Id">View</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="mt-3"><a asp-controller="Invoice" asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to invoices</a></p>
</div>
