@model AU_ERP.Models.ViewModels.ReturnOrderIndexVm
@using System.Globalization
@{
    ViewData["Title"] = "Return order";
    var n = Model.Orders.Count;
    var withCm = Model.Orders.Count(o => o.HasCreditMemo);
}

@section Styles {
    <style>
        .ro-page { color: var(--bs-body-color, #212529); }
        .ro-hero { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
        .ro-hero h1 { font-size: 1.35rem; font-weight: 600; margin: 0 0 .25rem 0; }
        .ro-hero p { margin: 0; color: var(--bs-secondary-color, #6c757d); font-size: .9rem; max-width: 42rem; }
        .ro-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: 1rem; }
        .ro-toolbar .form-control { min-width: 12rem; max-width: 22rem; }
        .ro-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-bottom: 1.25rem; }
        @@media (max-width: 576px) { .ro-stats { grid-template-columns: 1fr; } }
        .ro-stat { background: #fff; border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .375rem; padding: .85rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); border-top: 3px solid #6f42c1; }
        .ro-stat.ro-stat-cm { border-top-color: #198754; }
        .ro-stat .label { font-size: .72rem; font-weight: 600; letter-spacing: .04em; color: var(--bs-secondary-color, #6c757d); text-transform: uppercase; }
        .ro-stat .val { font-size: 1.45rem; font-weight: 600; line-height: 1.2; margin-top: .2rem; }
        .ro-card { background: #fff; border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .375rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); overflow: hidden; }
        .ro-table { width: 100%; border-collapse: collapse; font-size: .875rem; margin: 0; }
        .ro-table thead th { background: #354a5e; color: #fff; font-weight: 500; padding: .55rem .75rem; text-align: left; white-space: nowrap; border: none; }
        .ro-table tbody td { border: 1px solid #e9ecef; padding: .5rem .75rem; vertical-align: middle; }
        .ro-table tbody tr:nth-child(even) { background: #f8f9fa; }
        .ro-actions { display: flex; flex-wrap: wrap; gap: .35rem; justify-content: flex-end; }
        #roViewModal .modal-content, #roCmModal .modal-content { box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.2); border: 1px solid rgba(0,0,0,.12); }
        #roViewModal.ro-modal-no-bd, #roCmModal.ro-modal-no-bd { z-index: 1060; }
        .ro-view-loading { padding: 2rem; text-align: center; color: #6c757d; }
    </style>
}

<div class="ro-page py-3">
    @if (TempData["RoMessage"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@ok</div>
    }
    @if (TempData["RoError"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger py-2 small mb-3" role="alert">@err</div>
    }

    <div class="ro-hero">
        <div>
            <h1>Return order</h1>
            <p>Return orders are created from the Invoice screen when a customer returns delivered goods. Search by document number, invoice, dealer, or reason.</p>
        </div>
    </div>

    <form method="get" asp-action="Index" class="ro-toolbar" role="search">
        <input type="search" name="q" class="form-control form-control-sm" placeholder="Return #, invoice, dealer, reason…" value="@Model.FilterQuery" autocomplete="off" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.FilterQuery))
        {
            <a class="btn btn-sm btn-link text-secondary" asp-action="Index">Clear</a>
        }
    </form>

    <div class="ro-stats">
        <div class="ro-stat"><div class="label">@(string.IsNullOrWhiteSpace(Model.FilterQuery) ? "Total" : "Matching")</div><div class="val">@n.ToString("N0", CultureInfo.CurrentCulture)</div></div>
        <div class="ro-stat ro-stat-cm"><div class="label">With credit memo</div><div class="val">@withCm.ToString("N0", CultureInfo.CurrentCulture)</div></div>
        <div class="ro-stat"><div class="label">No credit memo</div><div class="val">@((n - withCm).ToString("N0", CultureInfo.CurrentCulture))</div></div>
    </div>

    <div class="ro-card">
        <div class="table-responsive">
            <table class="ro-table">
                <thead>
                    <tr>
                        <th>Return doc no.</th>
                        <th>Date</th>
                        <th>Invoice no.</th>
                        <th>Dealer</th>
                        <th>Reason (excerpt)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (n == 0)
                    {
                        <tr><td colspan="6" class="text-secondary p-4 text-center">No return orders@(string.IsNullOrWhiteSpace(Model.FilterQuery) ? "" : " match your search").</td></tr>
                    }
                    else
                    {
                        foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td><strong>@o.DocumentNumber</strong></td>
                                <td class="text-nowrap">@o.DocumentDate.ToString("dd-MMM-yyyy", CultureInfo.CurrentCulture)</td>
                                <td>@o.InvoiceDocumentNumber</td>
                                <td>@(o.DealerDisplayName ?? "—")</td>
                                <td class="small text-secondary">@o.ReturnReasonSnippet</td>
                                <td class="text-end">
                                    <div class="ro-actions">
                                        <button type="button" class="btn btn-sm btn-outline-primary ro-btn-view"
                                                data-ro-read-url="@Url.Action("ReadOnlyPartial", "ReturnOrder", new { id = o.Id })"
                                                data-ro-details-url="@Url.Action("Details", "ReturnOrder", new { id = o.Id })"
                                                data-ro-doc="@o.DocumentNumber"
                                                title="View summary in a popup">View</button>
                                        @if (o.HasCreditMemo)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success ro-btn-cm"
                                                    data-ro-cm-url="@Url.Action("CreditMemoPartial", "ReturnOrder", new { id = o.Id })"
                                                    data-ro-cm-doc="@(o.CreditMemoDocumentNumber ?? "")"
                                                    title="Credit memo in a popup">Credit memo</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="No credit memo on file yet (generated when the return is saved).">Credit memo</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="mt-3 mb-0"><a asp-controller="Invoice" asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to invoices</a></p>
</div>

<div class="modal fade ro-modal-no-bd" id="roViewModal" tabindex="-1" aria-labelledby="roViewModalTitle" aria-hidden="true" data-bs-backdrop="false" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="roViewModalTitle">Return order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="roViewModalBody"><div class="ro-view-loading">Loading…</div></div>
            <div class="modal-footer py-2">
                <a class="btn btn-sm btn-outline-primary d-none" id="roViewOpenFull" href="#">Open full page</a>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade ro-modal-no-bd" id="roCmModal" tabindex="-1" aria-labelledby="roCmModalTitle" aria-hidden="true" data-bs-backdrop="false" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="roCmModalTitle">Credit memo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="roCmModalBody"><div class="ro-view-loading">Loading…</div></div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function ensureOnBody(el) {
                if (el && el.parentElement !== document.body) document.body.appendChild(el);
            }
            function stripOrphanBackdrops() {
                document.querySelectorAll('.modal-backdrop').forEach(function (b) { b.remove(); });
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('padding-right');
                document.body.style.removeProperty('overflow');
            }
            function wireModal(modalId, bodyId, titleId, fullLinkId) {
                var modalEl = document.getElementById(modalId);
                var bodyEl = document.getElementById(bodyId);
                var titleEl = titleId ? document.getElementById(titleId) : null;
                var fullLink = (fullLinkId && String(fullLinkId).length) ? document.getElementById(fullLinkId) : null;
                var inst = null;
                function getInst() {
                    if (!modalEl || !window.bootstrap) return null;
                    ensureOnBody(modalEl);
                    if (!inst) inst = new bootstrap.Modal(modalEl, { backdrop: false, keyboard: true, focus: true });
                    return inst;
                }
                if (modalEl) {
                    modalEl.addEventListener('show.bs.modal', function () {
                        ensureOnBody(modalEl);
                        stripOrphanBackdrops();
                    });
                    modalEl.addEventListener('hidden.bs.modal', stripOrphanBackdrops);
                }
                return { modalEl: modalEl, bodyEl: bodyEl, titleEl: titleEl, fullLink: fullLink, getInst: getInst };
            }

            var v = wireModal('roViewModal', 'roViewModalBody', 'roViewModalTitle', 'roViewOpenFull');
            var c = wireModal('roCmModal', 'roCmModalBody', 'roCmModalTitle', null);

            document.querySelectorAll('.ro-btn-view').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = btn.getAttribute('data-ro-read-url');
                    var detailsUrl = btn.getAttribute('data-ro-details-url');
                    var doc = btn.getAttribute('data-ro-doc') || '';
                    if (!url || !v.bodyEl) return;
                    if (v.titleEl) v.titleEl.textContent = doc ? ('View — ' + doc) : 'Return order';
                    if (v.fullLink && detailsUrl) {
                        v.fullLink.href = detailsUrl;
                        v.fullLink.classList.remove('d-none');
                    }
                    v.bodyEl.innerHTML = '<div class="ro-view-loading">Loading…</div>';
                    v.getInst().show();
                    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(function (r) {
                            if (!r.ok) return r.text().then(function (t) { throw new Error(t || r.statusText); });
                            return r.text();
                        })
                        .then(function (html) { v.bodyEl.innerHTML = html; })
                        .catch(function (e) {
                            v.bodyEl.innerHTML = '<div class="alert alert-danger py-2 mb-0 small">' +
                                (e && e.message ? e.message.replace(/</g, '&lt;') : 'Could not load return order.') + '</div>';
                        });
                });
            });

            document.querySelectorAll('.ro-btn-cm').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = btn.getAttribute('data-ro-cm-url');
                    var doc = btn.getAttribute('data-ro-cm-doc') || '';
                    if (!url || !c.bodyEl) return;
                    if (c.titleEl) c.titleEl.textContent = doc ? ('Credit memo — ' + doc) : 'Credit memo';
                    c.bodyEl.innerHTML = '<div class="ro-view-loading">Loading…</div>';
                    c.getInst().show();
                    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(function (r) {
                            if (!r.ok) return r.text().then(function (t) { throw new Error(t || r.statusText); });
                            return r.text();
                        })
                        .then(function (html) { c.bodyEl.innerHTML = html; })
                        .catch(function (e) {
                            c.bodyEl.innerHTML = '<div class="alert alert-danger py-2 mb-0 small">' +
                                (e && e.message ? e.message.replace(/</g, '&lt;') : 'Could not load credit memo.') + '</div>';
                        });
                });
            });
        })();
    </script>
}
