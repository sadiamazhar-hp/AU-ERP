@model AU_ERP.Models.ViewModels.DeliveryChallanListVm
@using System.Globalization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Delivery Challan";
    ViewBag.Title = "Delivery Challan";
    var list = Model?.Items ?? new List<AU_ERP.Models.DeliveryChallan>();
    var plants = ViewBag.Plants as List<PlantsSample> ?? new List<PlantsSample>();
    var customers = ViewBag.Customers as List<BusinessPartnerMasterSample> ?? new List<BusinessPartnerMasterSample>();
    var listQ = Model?.Q ?? "";
    var listPlant = Model?.PlantId ?? "";
    var df = Model?.DateFrom is DateTime d0 ? d0.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "";
    var dt = Model?.DateTo is DateTime d1 ? d1.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "";
    var today = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    int? fromSo = ViewBag.FromSalesOrderId as int?;
    string FmtDate(DateTime d) => d.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture);
    var prepareFromSoUrl = Url.Action("PrepareFromSalesOrder", "DeliveryChallan") ?? "";
    var searchSoForDcUrl = Url.Action("SearchSalesOrdersForChallan", "DeliveryChallan") ?? "";
    var getSoLinesForDcUrl = Url.Action("GetSalesOrderLinesForChallan", "DeliveryChallan") ?? "";
    var detailsModalUrlPlaceholder = Url.Action("DetailsModal", "DeliveryChallan", new { id = 900000001 });
    var dcModalPlants = ViewBag.DcModalPlants as List<PlantsSample> ?? plants;
    var dcPlantSingleLocked = ViewBag.DcPlantSingleLocked as bool? ?? false;
    var dcLockedPlantId = ViewBag.DcLockedPlantId as string ?? "";
    var dcDrivers = ViewBag.DcDrivers as List<Driver> ?? new List<Driver>();
    var dcVehicles = ViewBag.DcVehicles as List<Vehicle> ?? new List<Vehicle>();
    PlantsSample? DcPlantNameRow(string pid) =>
        dcModalPlants.FirstOrDefault(p => string.Equals(p.PlantID, pid, StringComparison.OrdinalIgnoreCase))
        ?? plants.FirstOrDefault(p => string.Equals(p.PlantID, pid, StringComparison.OrdinalIgnoreCase));
}

@section Styles {
<style>
    .dc-page { color: var(--text, #32363a); }
    .dc-page .dc-hero { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
    .dc-page .dc-hero h1 { font-size: 1.35rem; font-weight: 600; color: var(--dark, #354a5e); margin: 0 0 .25rem 0; }
    .dc-page .dc-hero p { margin: 0; color: var(--subtle, #6a7c8e); font-size: .9rem; }
    .dc-btn-new { background: var(--blue, #0070f2); color: #fff; border: 1px solid var(--blue, #0070f2); border-radius: 4px; padding: .45rem 1rem; font-size: .875rem; font-weight: 500; }
    .dc-btn-new:hover { filter: brightness(1.05); color: #fff; }
    .dc-table-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: 1rem 1.1rem; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
    .dc-table-card .dc-table-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: .75rem; }
    .dc-table-card .dc-table-title { font-size: 1rem; font-weight: 600; color: var(--dark, #354a5e); margin: 0; }
    .dc-table-card .dc-toolbar { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
    .dc-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .dc-table thead th { background: var(--dark, #354a5e); color: #fff; font-weight: 500; padding: .55rem .65rem; text-align: left; white-space: nowrap; }
    .dc-table tbody td { border: 1px solid #ddd; padding: .45rem .6rem; vertical-align: middle; }
    .dc-table tbody tr:nth-child(even) { background: #fafafa; }
    #addDeliveryChallanModal.dc-challan-modal .modal-dialog { max-width: 1100px; max-height: calc(100vh - 1rem); margin: 0.5rem auto; }
    /* Do not clip absolute dropdowns in line pickers; scroll only the table area */
    #addDeliveryChallanModal.dc-challan-modal .modal-content { max-height: calc(100vh - 1rem); display: flex; flex-direction: column; overflow: visible; }
    #addDeliveryChallanModal.dc-challan-modal .modal-body { overflow: visible; min-height: 0; flex: 1 1 auto; }
    #addDeliveryChallanModal .dc-items-table-wrap { max-height: min(52vh, 24rem); overflow: auto; -webkit-overflow-scrolling: touch; }
    /* View modal z-index: site.css (#dcViewModal) — also reparent node to body in script to avoid backdrop stacking. */
    .dc-items-table { font-size: .75rem; }
    .dc-items-table th, .dc-items-table td { vertical-align: middle; }
    .dc-so-line-picker { position: relative; }
    .dc-so-line-picker .dc-dd {
        display: none;
        max-height: 200px; overflow-y: auto; background: #fff; border: 1px solid #ccc;
        border-radius: 2px; box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .dc-so-line-picker .dc-dd.show { display: block; }
    .dc-ship-to-combo { position: relative; }
    .dc-ship-to-combo .dc-dd {
        display: none;
        max-height: 200px; overflow-y: auto; background: #fff; border: 1px solid #ccc;
        border-radius: 2px; box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .dc-ship-to-combo .dc-dd.show { display: block; }
    .dc-so-item { padding: 6px 10px; font-size: .78rem; cursor: pointer; border-bottom: 1px solid #eee; }
    .dc-so-item:hover, .dc-so-item.active { background: #b3d7ff; }
    .dc-dd-empty { padding: 8px 10px; font-size: .75rem; color: #666; }
    .dc-ref-readonly { background: #f4f4f4 !important; }
    .dc-ship-to-combo .dc-dd { font-size: .82rem; }
    .dc-ship-item { padding: 6px 10px; cursor: pointer; border-bottom: 1px solid #eee; }
    .dc-ship-item:hover { background: #b3d7ff; }
    .dc-items-table-wrap.dc-items-locked tbody .form-control,
    .dc-items-table-wrap.dc-items-locked tbody .form-select { pointer-events: none; }
    #dcViewModal .modal-body { min-height: 8rem; }
    .dc-badge-completed { background: #5a6268; color: #fff; }
    .dc-badge-active { background: #f8f9fa; color: #212529; border: 1px solid #ced4da; }
</style>
}

<div class="dc-page">
    <div class="dc-hero">
        <div>
            <h1>Delivery challan</h1>
            <p>Shipments against confirmed sales orders (one challan per order).</p>
        </div>
        <button type="button" class="dc-btn-new" data-bs-toggle="modal" data-bs-target="#addDeliveryChallanModal" id="btnDcNewNoPrefill">
            <i class="bi bi-plus-lg"></i> New challan
        </button>
    </div>

    @if (TempData["DcWarning"] is string warnDc)
    {
        <div class="alert alert-warning py-2 small mb-3 border-0 shadow-sm d-flex align-items-start gap-2" role="status">
            <i class="bi bi-exclamation-triangle-fill text-warning-emphasis flex-shrink-0" style="margin-top: 0.15rem" aria-hidden="true"></i>
            <span>@warnDc</span>
        </div>
    }
    @if (TempData["DcMessage"] is string okDc)
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@okDc</div>
    }
    @if (TempData["DcError"] is string errDc)
    {
        <div class="alert alert-danger py-2 small mb-3" role="status">@errDc</div>
    }

    <div class="dc-table-card">
        <div class="dc-table-head">
            <h2 class="dc-table-title">Challans (@list.Count)</h2>
            <form id="dcListFilterForm" method="get" asp-controller="DeliveryChallan" asp-action="Index" class="dc-toolbar">
                <input type="search" name="q" id="dcListQ" class="form-control form-control-sm" placeholder="DC #, order #, customer…" value="@listQ" />
                <input type="hidden" name="plantId" id="dcListPlant" value="@listPlant" />
                <input type="hidden" name="dateFrom" id="dcListDateFrom" value="@df" />
                <input type="hidden" name="dateTo" id="dcListDateTo" value="@dt" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#dcFilterModal">Filter</button>
                <a class="btn btn-sm btn-link text-secondary" asp-action="Index">Clear</a>
            </form>
        </div>
        <div class="table-responsive">
            <table class="dc-table">
                <thead>
                    <tr>
                        <th>Challan #</th>
                        <th>Document date</th>
                        <th>Plant</th>
                        <th>Delivery type</th>
                        <th>Ship-to</th>
                        <th>Ref. sales order</th>
                        <th>Delivery</th>
                        <th>Lines</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (list.Count == 0)
                {
                    <tr><td colspan="9" class="text-secondary">No delivery challans yet.</td></tr>
                }
                else foreach (var d in list)
                {
                    var canMarkFleetDone = !d.DeliveryCompletedAt.HasValue && (d.DriverId != null || d.VehicleId != null);
                    <tr>
                        <td class="text-nowrap"><strong>@d.DeliveryChallanNumber</strong></td>
                        <td class="text-nowrap">@FmtDate(d.DocumentDate)</td>
                        <td>@(d.Plant?.PlantName ?? "—")</td>
                        <td>@d.DeliveryType</td>
                        <td>@(d.ShipToDisplayName ?? d.ShipToBusinessPartner?.FullName ?? "—")</td>
                        <td class="text-nowrap">@(d.ReferenceSalesOrderNumber ?? d.SalesOrder?.SalesOrderNumber ?? "—")</td>
                        <td class="text-nowrap">
                            @if (d.DeliveryCompletedAt.HasValue)
                            {
                                <span class="badge dc-badge-completed">Completed</span>
                            }
                            else
                            {
                                <span class="badge dc-badge-active">Active</span>
                            }
                        </td>
                        <td>@(d.Items?.Count ?? 0)</td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary dc-btn-view" data-dc-id="@d.Id" title="View">View</button>
                            @if (canMarkFleetDone)
                            {
                                <form asp-controller="DeliveryChallan" asp-action="MarkDeliveryCompleted" method="post" class="d-inline-block ms-1" onsubmit="return confirm('Mark delivery completed and free the driver / vehicle?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Releases fleet for other challans">Delivery completed</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-primary ms-1" asp-action="DownloadPdf" asp-route-id="@d.Id" title="Download PDF" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="dcViewModal" tabindex="-1" aria-labelledby="dcViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="dcViewModalLabel">Delivery challan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-2" id="dcViewModalBody">
                <p class="text-secondary small mb-0">Loading…</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dcFilterModal" tabindex="-1" aria-labelledby="dcFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="dcFilterModalLabel">Filter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-2">
                <div class="mb-2">
                    <label class="form-label small mb-0">Plant</label>
                    <select class="form-select form-select-sm" id="dcFPlant">
                        <option value="">All</option>
                        @foreach (var p in plants)
                        {
                            if (p.PlantID == listPlant)
                            { <option value="@p.PlantID" selected>@p.PlantName</option> }
                            else
                            { <option value="@p.PlantID">@p.PlantName</option> }
                        }
                    </select>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small mb-0">Document from</label>
                        <input type="date" class="form-control form-control-sm" id="dcFDateFrom" value="@df" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-0">Document to</label>
                        <input type="date" class="form-control form-control-sm" id="dcFDateTo" value="@dt" />
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-primary" id="dcFilterApply">Apply</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade dc-challan-modal" id="addDeliveryChallanModal" tabindex="-1" aria-labelledby="addDeliveryChallanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="addDeliveryChallanModalLabel">New delivery challan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="dcForm" method="post" asp-controller="DeliveryChallan" asp-action="Create" data-au-prevent-enter-submit>
                @Html.AntiForgeryToken()
                <div class="modal-body py-2">
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Plant</label>
                            @if (dcPlantSingleLocked && !string.IsNullOrWhiteSpace(dcLockedPlantId))
                            {
                                var lockPn = DcPlantNameRow(dcLockedPlantId.Trim());
                                <input type="hidden" name="PlantId" id="dcPlant" value="@dcLockedPlantId.Trim()" />
                                <input type="text" class="form-control form-control-sm bg-light" id="dcPlantReadonlyDisplay" value="@(lockPn?.PlantName ?? dcLockedPlantId)" readonly tabindex="-1" title="Assigned plant" />
                            }
                            else
                            {
                                <select class="form-select form-select-sm" name="PlantId" id="dcPlant" required>
                                    <option value="">—</option>
                                    @foreach (var p in dcModalPlants)
                                    {
                                        <option value="@p.PlantID">@p.PlantName</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Delivery type</label>
                            <select class="form-select form-select-sm" name="DeliveryType" id="dcDelType">
                                <option value="Standard" selected>Standard</option>
                                <option value="Return">Return</option>
                                <option value="Sample">Sample</option>
                                <option value="Transfer">Transfer</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Document date</label>
                            <input type="date" class="form-control form-control-sm" name="DocumentDate" id="dcDocDate" value="@today" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-12 col-lg-8">
                            <label class="form-label small mb-0">Ref. sales order <span class="text-danger">*</span></label>
                            <div class="d-flex gap-1 align-items-start flex-wrap">
                                <div class="flex-grow-1 dc-so-line-picker" id="dcHeaderSoWrap" style="min-width:12rem">
                                    <input type="text" class="form-control form-control-sm dc-so-search" id="dcHeaderSoSearch" placeholder="Search order # or customer…" autocomplete="off" />
                                    <div class="dc-dd" role="listbox"></div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" id="dcHeaderSoClear" style="display:none" title="Change sales order">Change</button>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="dcShipToSearch">Ship-to party <span class="text-danger">*</span></label>
                        <input type="hidden" name="ShipToBusinessPartnerId" id="dcShipTo" value="" />
                        <select id="dcShipToCatalog" class="d-none" aria-hidden="true" tabindex="-1">
                            <option value="">—</option>
                            @foreach (var c in customers)
                            {
                                var shipBits = string.Join(", ", new[] { c.HouseNo, c.Street, c.City, c.PostalCode, c.Country }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                <option value="@c.BPID" data-ship="@shipBits">@(c.FullName ?? c.BPID)</option>
                            }
                        </select>
                        <div class="dc-ship-to-combo position-relative">
                            <input type="text" class="form-control form-control-sm" id="dcShipToSearch" placeholder="Search name, ID, or address…" autocomplete="off" />
                            <div id="dcShipToDd" class="dc-dd" role="listbox"></div>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small mb-0">Driver</label>
                            <select class="form-select form-select-sm" name="DriverId" id="dcDriver">
                                <option value="">—</option>
                                @foreach (var dr in dcDrivers)
                                {
                                    var dn = string.Join(" ", new[] { dr.FirstName, dr.LastName }.Where(s => !string.IsNullOrWhiteSpace(s))).Trim();
                                    if (string.IsNullOrEmpty(dn)) { dn = "Driver #" + dr.Id; }
                                    <option value="@dr.Id">@dn</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-0">Vehicle</label>
                            <select class="form-select form-select-sm" name="VehicleId" id="dcVehicle">
                                <option value="">—</option>
                                @foreach (var v in dcVehicles)
                                {
                                    <option value="@v.Id">@v.NumberPlate (@v.CarType)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="text-muted small mb-2">Shows only drivers and vehicles that are <strong>Active</strong> and <strong>Available</strong>. Master data treats <strong>Busy</strong> the same way here: tied to another challan with an Open / Return-in-progress invoice, or no invoice yet, until someone records <strong>Delivery completed</strong> on that challan.</p>
                    <input type="hidden" name="SalesOrderId" id="dcSalesOrderId" value="" />
                    <input type="hidden" name="ReferenceSalesOrderNumber" id="dcRefSoNum" value="" />
                    <h6 class="border-bottom pb-1 mb-2 small">Line items</h6>
                    <p class="text-muted small mb-2" style="font-size: .75rem;">Select a <strong>sales order</strong> above. All open lines from that order load here and stay <strong>read-only</strong>. <strong>Inventory is reduced when the sales goods issue is dispatched (sent)</strong>; batch/lot text is copied from that issue onto the challan.</p>
                    <div class="table-responsive dc-items-table-wrap" id="dcItemsTableWrap">
                        <table class="table table-sm table-bordered dc-items-table mb-2">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:2rem">#</th>
                                    <th style="min-width:8rem">Material</th>
                                    <th>Description</th>
                                    <th style="min-width:3.5rem">UoM</th>
                                    <th style="min-width:4.5rem">Del. qty</th>
                                    <th>Batch / lot</th>
                                </tr>
                            </thead>
                            <tbody id="dcItemsBody">
                                <tr id="dcItemsPlaceholder">
                                    <td colspan="6" class="text-muted small py-3">Select a sales order in the header to load lines.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Create challan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        (function ensureDcViewModalOnBody() {
            var el = document.getElementById("dcViewModal");
            if (!el) return;
            function move() {
                if (el.parentElement !== document.body) document.body.appendChild(el);
            }
            el.addEventListener("show.bs.modal", move);
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", move);
            else move();
        })();

        const prepareFromSoUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prepareFromSoUrl));
        const fromSalesOrderId = @Html.Raw(fromSo.HasValue ? fromSo.Value.ToString() : "null");
        const today = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(today));
        const searchSoForDcUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(searchSoForDcUrl));
        const getSoLinesForDcUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(getSoLinesForDcUrl));
        const detailsModalUrlPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(detailsModalUrlPlaceholder));
        window.dcPlantSingleLocked = @(dcPlantSingleLocked ? "true" : "false");
        window.dcLockedPlantId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dcLockedPlantId));

        var dcSoContext = { salesOrderId: null, salesOrderNumber: "", lines: [] };

        function dcEsc(s) {
            if (s == null) return "";
            return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/\"/g, "&quot;");
        }
        function dcClearDdLayout(dd) {
            if (!dd) return;
            ["top", "left", "width", "maxHeight"].forEach(function (k) { dd.style.removeProperty(k); });
        }
        function dcPositionDd(anchorInput, dd) {
            if (!anchorInput || !dd || !dd.classList.contains("show")) return;
            var r = anchorInput.getBoundingClientRect();
            var gap = 2;
            var maxH = Math.max(80, Math.min(220, window.innerHeight - r.bottom - gap - 12));
            dd.style.top = (r.bottom + gap) + "px";
            dd.style.left = r.left + "px";
            dd.style.width = r.width + "px";
            dd.style.maxHeight = maxH + "px";
        }
        function dcCloseAllDropdowns() {
            document.querySelectorAll("#addDeliveryChallanModal .dc-dd").forEach(function (d) {
                dcClearDdLayout(d);
                d.classList.remove("show");
                d.innerHTML = "";
            });
        }
        function dcRefitOpenDropdowns() {
            document.querySelectorAll("#addDeliveryChallanModal .dc-so-line-picker .dc-dd.show").forEach(function (dd) {
                var w = dd.closest(".dc-so-line-picker");
                var inp = w && w.querySelector(".dc-so-search");
                dcPositionDd(inp, dd);
            });
            var shipDd = document.getElementById("dcShipToDd");
            var shipInp = document.getElementById("dcShipToSearch");
            if (shipDd && shipInp && shipDd.classList.contains("show")) dcPositionDd(shipInp, shipDd);
        }

        function detailsModalUrl(id) { return detailsModalUrlPlaceholder.replace("900000001", id); }
        document.querySelectorAll(".dc-btn-view").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var id = btn.getAttribute("data-dc-id");
                if (!id) return;
                var body = document.getElementById("dcViewModalBody");
                var m = document.getElementById("dcViewModal");
                if (body) body.innerHTML = '<p class="text-secondary small mb-0">Loading…</p>';
                if (window.bootstrap) {
                    var addM = document.getElementById("addDeliveryChallanModal");
                    var fM = document.getElementById("dcFilterModal");
                    if (addM && addM.classList.contains("show")) bootstrap.Modal.getOrCreateInstance(addM).hide();
                    if (fM && fM.classList.contains("show")) bootstrap.Modal.getOrCreateInstance(fM).hide();
                }
                if (m && window.bootstrap) {
                    var vm = window.bootstrap.Modal.getOrCreateInstance(m);
                    vm.show();
                }
                fetch(detailsModalUrl(id), { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.text(); })
                    .then(function (html) { if (body) body.innerHTML = html; })
                    .catch(function () { if (body) body.innerHTML = '<p class="text-danger small">Could not load details.</p>'; });
            });
        });

        function reindex() {
            var body = document.getElementById("dcItemsBody");
            if (!body) return;
            var rows = body.querySelectorAll("tr.dc-item-row");
            rows.forEach(function (tr, i) {
                tr.setAttribute("data-idx", String(i));
                tr.querySelectorAll("[name*=\"Items[\"]").forEach(function (el) {
                    var n = el.name;
                    if (!n || n.indexOf("Items[") < 0) return;
                    var rest = n.split("].");
                    if (rest.length < 2) return;
                    el.name = "Items[" + i + "]." + rest[1];
                });
                var li = tr.querySelector(".dc-line-idx");
                if (li) li.textContent = String(i + 1);
            });
        }

        function syncRefReadonly() {
            var n = (dcSoContext.salesOrderNumber || "").trim();
            var h = document.getElementById("dcRefSoNum");
            if (h) h.value = n;
            document.querySelectorAll("tr.dc-item-row .dc-refso").forEach(function (el) { el.value = n; });
        }

        document.addEventListener("mousedown", function (e) {
            if (e.target.closest("#addDeliveryChallanModal .dc-dd")) e.preventDefault();
        });
        (function wireDcChallanDropdowns() {
            var modal = document.getElementById("addDeliveryChallanModal");
            if (!modal) return;
            function refit() { dcRefitOpenDropdowns(); }
            modal.addEventListener("shown.bs.modal", refit);
            var mb = modal.querySelector(".modal-body");
            if (mb) mb.addEventListener("scroll", refit, true);
            var tw = modal.querySelector(".dc-items-table-wrap");
            if (tw) tw.addEventListener("scroll", refit, true);
            window.addEventListener("resize", refit);
            modal.addEventListener("hidden.bs.modal", function () { dcCloseAllDropdowns(); });
        })();
        document.addEventListener("click", function (e) {
            if (!e.target.closest("#addDeliveryChallanModal")) return;
            if (e.target.closest("#addDeliveryChallanModal .dc-dd")) return;
            dcCloseAllDropdowns();
        });

        function runSoSearch(wrap, q) {
            if (!searchSoForDcUrl) return;
            var url = searchSoForDcUrl + (searchSoForDcUrl.indexOf("?") >= 0 ? "&" : "?") + "q=" + encodeURIComponent((q || "").trim());
            fetch(url).then(function (r) { return r.json(); }).then(function (j) {
                if (!j || !j.success || !wrap) return;
                var dd = wrap.querySelector(".dc-dd");
                if (!dd) return;
                var items = j.items || [];
                if (items.length === 0) {
                    dd.innerHTML = "<div class=\"dc-dd-empty\">No orders (already has a challan, not confirmed, or no match)</div>";
                    dd.classList.add("show");
                    dcPositionDd(wrap.querySelector(".dc-so-search"), dd);
                    return;
                }
                dd.innerHTML = items.map(function (it) {
                    return "<button type=\"button\" class=\"dc-so-item w-100 text-start border-0 bg-transparent\" data-id=\"" + it.id + "\">" +
                        "<span class=\"fw-semibold\">" + dcEsc(it.salesOrderNumber || "") + "</span> · " + dcEsc(it.customerName || "") + "</button>";
                }).join("");
                dd.classList.add("show");
                dcPositionDd(wrap.querySelector(".dc-so-search"), dd);
                dd.querySelectorAll(".dc-so-item").forEach(function (b) {
                    b.addEventListener("click", function () {
                        var soId = b.getAttribute("data-id");
                        if (soId) applySalesOrderPicked(parseInt(soId, 10));
                    });
                });
            });
        }

        function normalizeDcLine(x) {
            var oq = x.orderQuantity != null ? x.orderQuantity : x.deliveryQuantity;
            return {
                salesOrderItemId: x.salesOrderItemId,
                materialNumber: x.materialNumber || "",
                materialDescription: x.materialDescription || "",
                orderQuantity: oq,
                deliveryQuantity: x.deliveryQuantity != null ? x.deliveryQuantity : oq,
                quantityUomId: x.quantityUomId,
                uomCode: x.uomCode || "",
                batch: (x.batch != null ? String(x.batch) : "").trim()
            };
        }

        function renderDcReadonlyLines(lines, refSoNum) {
            var body = document.getElementById("dcItemsBody");
            var wrap = document.getElementById("dcItemsTableWrap");
            if (!body) return;
            body.innerHTML = "";
            (lines || []).forEach(function (raw, idx) {
                var li = normalizeDcLine(raw);
                var qty = li.orderQuantity != null ? li.orderQuantity : li.deliveryQuantity;
                var qtyStr = qty != null ? String(qty) : "";
                var uomId = li.quantityUomId != null ? String(li.quantityUomId) : "";
                var tr = document.createElement("tr");
                tr.className = "dc-item-row";
                tr.setAttribute("data-idx", String(idx));
                tr.innerHTML =
                    "<td class=\"text-muted dc-line-idx\">" + (idx + 1) + "</td>" +
                    "<td><span class=\"small fw-semibold text-break\">" + dcEsc(li.materialNumber) + "</span>" +
                    "<input type=\"hidden\" class=\"dc-mat\" name=\"Items[" + idx + "].MaterialNumber\" value=\"" + dcEsc(li.materialNumber) + "\" />" +
                    "<input type=\"hidden\" class=\"dc-soitem\" name=\"Items[" + idx + "].SalesOrderItemId\" value=\"" + (li.salesOrderItemId != null ? String(li.salesOrderItemId) : "") + "\" />" +
                    "<input type=\"hidden\" class=\"dc-refso\" name=\"Items[" + idx + "].ReferenceSalesOrderNumber\" value=\"" + dcEsc(refSoNum || "") + "\" />" +
                    "<input type=\"hidden\" name=\"Items[" + idx + "].QuantityUomId\" value=\"" + (uomId ? String(uomId).replace(/\"/g, "") : "") + "\" /></td>" +
                    "<td><input type=\"text\" class=\"form-control form-control-sm bg-light\" readonly tabindex=\"-1\" value=\"" + dcEsc(li.materialDescription) + "\" /></td>" +
                    "<td><span class=\"small text-nowrap\">" + dcEsc(li.uomCode || "—") + "</span></td>" +
                    "<td><input type=\"text\" class=\"form-control form-control-sm bg-light text-end\" readonly tabindex=\"-1\" name=\"Items[" + idx + "].DeliveryQuantity\" value=\"" + dcEsc(qtyStr) + "\" /></td>" +
                    "<td><span class=\"small text-muted\">" + (li.batch ? dcEsc(li.batch) : "—") + "</span></td>";
                body.appendChild(tr);
            });
            reindex();
            if (wrap) wrap.classList.add("dc-items-locked");
        }

        function dcPlaceholderOnly() {
            var body = document.getElementById("dcItemsBody");
            var wrap = document.getElementById("dcItemsTableWrap");
            if (!body) return;
            body.innerHTML = "<tr id=\"dcItemsPlaceholder\"><td colspan=\"6\" class=\"text-muted small py-3\">Select a sales order in the header to load lines.</td></tr>";
            if (wrap) wrap.classList.remove("dc-items-locked");
        }

        function setHeaderSoLocked(soNumber) {
            var inp = document.getElementById("dcHeaderSoSearch");
            var btn = document.getElementById("dcHeaderSoClear");
            if (inp) {
                inp.value = soNumber || "";
                inp.readOnly = true;
                inp.classList.add("dc-ref-readonly");
            }
            if (btn) btn.style.display = "";
        }
        function setHeaderSoEditable() {
            var inp = document.getElementById("dcHeaderSoSearch");
            var btn = document.getElementById("dcHeaderSoClear");
            if (inp) {
                inp.value = "";
                inp.readOnly = false;
                inp.classList.remove("dc-ref-readonly");
            }
            if (btn) btn.style.display = "none";
        }

        function applyDcOrderPayload(j) {
            if (!j) return;
            var lines = j.lines || [];
            if (!lines.length) {
                alert("This sales order has no lines to ship.");
                return;
            }
            dcSoContext = { salesOrderId: j.salesOrderId, salesOrderNumber: j.salesOrderNumber || "", lines: lines };
            if (!window.dcPlantSingleLocked && j.plantId && document.getElementById("dcPlant")) document.getElementById("dcPlant").value = j.plantId;
            if (j.salesOrderId) document.getElementById("dcSalesOrderId").value = String(j.salesOrderId);
            syncRefReadonly();
            if (j.shipToBusinessPartnerId) dcCommitShipTo(j.shipToBusinessPartnerId);
            setHeaderSoLocked(j.salesOrderNumber || "");
            dcCloseAllDropdowns();
            renderDcReadonlyLines(lines, j.salesOrderNumber || "");
        }

        function applySalesOrderPicked(salesOrderId) {
            if (!getSoLinesForDcUrl) return;
            var u = getSoLinesForDcUrl + (getSoLinesForDcUrl.indexOf("?") >= 0 ? "&" : "?") + "salesOrderId=" + salesOrderId;
            fetch(u).then(function (r) { return r.json(); }).then(function (j) {
                if (!j || !j.success) { alert((j && j.message) || "Could not load order lines."); return; }
                applyDcOrderPayload(j);
            });
        }

        function dcHideShipToDd() {
            var dd = document.getElementById("dcShipToDd");
            if (!dd) return;
            dcClearDdLayout(dd);
            dd.classList.remove("show");
            dd.innerHTML = "";
        }
        function dcRenderShipToDropdown(filterText) {
            var cat = document.getElementById("dcShipToCatalog");
            var dd = document.getElementById("dcShipToDd");
            var search = document.getElementById("dcShipToSearch");
            if (!cat || !dd || !search) return;
            var q = (filterText || "").trim().toLowerCase();
            var parts = ["<div class=\"dc-ship-item px-2 py-1 border-bottom text-muted small\" role=\"option\" tabindex=\"0\" data-id=\"\">— Clear selection —</div>"];
            var nShown = 0;
            for (var i = 0; i < cat.options.length; i++) {
                var opt = cat.options[i];
                var v = (opt.value || "").trim();
                if (!v) continue;
                var t = (opt.textContent || "").trim().toLowerCase();
                var ship = ((opt.getAttribute("data-ship") || "") + "").toLowerCase();
                if (q && t.indexOf(q) < 0 && v.toLowerCase().indexOf(q) < 0 && ship.indexOf(q) < 0) continue;
                parts.push("<div class=\"dc-ship-item px-2 py-1 border-bottom small\" role=\"option\" tabindex=\"0\" data-id=\"" + dcEsc(v) + "\">" + dcEsc((opt.textContent || "").trim()) + "</div>");
                nShown++;
                if (nShown >= 80) break;
            }
            if (!nShown && q) dd.innerHTML = "<div class=\"px-2 py-2 text-muted small\">No matches</div>";
            else dd.innerHTML = parts.join("");
            dd.classList.add("show");
            dcPositionDd(search, dd);
        }
        function dcSyncShipToSearchFromHidden() {
            var valEl = document.getElementById("dcShipTo");
            var search = document.getElementById("dcShipToSearch");
            var cat = document.getElementById("dcShipToCatalog");
            if (!valEl || !search || !cat) return;
            var v = (valEl.value || "").trim();
            if (!v) { search.value = ""; return; }
            for (var i = 0; i < cat.options.length; i++) {
                if (cat.options[i].value === v) {
                    search.value = (cat.options[i].textContent || "").trim();
                    return;
                }
            }
            search.value = v;
        }
        function dcCommitShipTo(customerId) {
            var valEl = document.getElementById("dcShipTo");
            if (valEl) valEl.value = customerId || "";
            dcSyncShipToSearchFromHidden();
            dcHideShipToDd();
        }
        (function initDcShipToCombo() {
            var search = document.getElementById("dcShipToSearch");
            var dd = document.getElementById("dcShipToDd");
            if (!search || !dd) return;
            var tOpen = 0;
            search.addEventListener("focus", function () { dcRenderShipToDropdown(search.value); });
            search.addEventListener("input", function () {
                clearTimeout(tOpen);
                tOpen = setTimeout(function () { dcRenderShipToDropdown(search.value); }, 120);
            });
            search.addEventListener("keydown", function (e) { if (e.key === "Escape") dcHideShipToDd(); });
            dd.addEventListener("mousedown", function (e) { e.preventDefault(); });
            dd.addEventListener("click", function (e) {
                var item = e.target.closest(".dc-ship-item");
                if (!item) return;
                dcCommitShipTo(item.getAttribute("data-id") || "");
            });
        })();

        (function initDcHeaderSoSearch() {
            var wrap = document.getElementById("dcHeaderSoWrap");
            if (!wrap) return;
            wrap.addEventListener("input", function (e) {
                var t = e.target;
                if (t.classList.contains("dc-so-search") && !t.readOnly) runSoSearch(wrap, t.value);
            });
            wrap.addEventListener("focusin", function (e) {
                var t = e.target;
                if (t.classList.contains("dc-so-search") && !t.readOnly) runSoSearch(wrap, t.value);
            });
        })();

        document.getElementById("dcHeaderSoClear") && document.getElementById("dcHeaderSoClear").addEventListener("click", function () {
            dcSoContext = { salesOrderId: null, salesOrderNumber: "", lines: [] };
            document.getElementById("dcSalesOrderId").value = "";
            document.getElementById("dcRefSoNum").value = "";
            setHeaderSoEditable();
            dcPlaceholderOnly();
            dcCloseAllDropdowns();
        });

        function clearModalForNew() {
            document.getElementById("dcForm").reset();
            if (document.getElementById("dcDocDate")) document.getElementById("dcDocDate").value = today;
            if (document.getElementById("dcDelType")) document.getElementById("dcDelType").value = "Standard";
            document.getElementById("dcSalesOrderId").value = "";
            document.getElementById("dcRefSoNum").value = "";
            dcSoContext = { salesOrderId: null, salesOrderNumber: "", lines: [] };
            setHeaderSoEditable();
            dcPlaceholderOnly();
            dcSyncShipToSearchFromHidden();
            dcHideShipToDd();
            if (document.getElementById("addDeliveryChallanModalLabel")) document.getElementById("addDeliveryChallanModalLabel").textContent = "New delivery challan";
            if (window.dcPlantSingleLocked && window.dcLockedPlantId) {
                var pLock = document.getElementById("dcPlant");
                if (pLock) pLock.value = window.dcLockedPlantId;
            }
        }

        function applyFromSoData(d) {
            clearModalForNew();
            if (!window.dcPlantSingleLocked && d.plantId && document.getElementById("dcPlant")) document.getElementById("dcPlant").value = d.plantId || "";
            if (d.deliveryType && document.getElementById("dcDelType")) document.getElementById("dcDelType").value = d.deliveryType || "Standard";
            if (d.documentDate && document.getElementById("dcDocDate")) document.getElementById("dcDocDate").value = d.documentDate;
            if (document.getElementById("addDeliveryChallanModalLabel")) document.getElementById("addDeliveryChallanModalLabel").textContent = "New challan (from " + (d.salesOrderNumber || "order") + ")";
            var lines = (d.items || []).map(normalizeDcLine);
            applyDcOrderPayload({
                salesOrderId: d.salesOrderId,
                salesOrderNumber: d.salesOrderNumber,
                plantId: d.plantId,
                shipToBusinessPartnerId: d.shipToBusinessPartnerId,
                lines: lines
            });
        }

        document.getElementById("dcFilterApply") && document.getElementById("dcFilterApply").addEventListener("click", function () {
            var fp = document.getElementById("dcFPlant");
            var fd = document.getElementById("dcFDateFrom");
            var ft = document.getElementById("dcFDateTo");
            if (document.getElementById("dcListPlant") && fp) document.getElementById("dcListPlant").value = fp.value || "";
            if (document.getElementById("dcListDateFrom") && fd) document.getElementById("dcListDateFrom").value = fd.value || "";
            if (document.getElementById("dcListDateTo") && ft) document.getElementById("dcListDateTo").value = ft.value || "";
            var modal = document.getElementById("dcFilterModal");
            if (modal && window.bootstrap) window.bootstrap.Modal.getOrCreateInstance(modal).hide();
            if (document.getElementById("dcListFilterForm")) document.getElementById("dcListFilterForm").submit();
        });
        document.getElementById("btnDcNewNoPrefill") && document.getElementById("btnDcNewNoPrefill").addEventListener("click", function () { clearModalForNew(); });
        document.getElementById("dcForm") && document.getElementById("dcForm").addEventListener("submit", function (e) {
            var soEl = document.getElementById("dcSalesOrderId");
            var shipEl = document.getElementById("dcShipTo");
            if (!soEl || !String(soEl.value || "").trim()) {
                e.preventDefault();
                alert("Select a sales order in the header.");
                return;
            }
            if (!shipEl || !String(shipEl.value || "").trim()) {
                e.preventDefault();
                alert("Select a ship-to party.");
                return;
            }
        });
        if (fromSalesOrderId && prepareFromSoUrl) {
            fetch(prepareFromSoUrl + (prepareFromSoUrl.indexOf("?") >= 0 ? "&" : "?") + "id=" + fromSalesOrderId)
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d && d.success) { var el = document.getElementById("addDeliveryChallanModal"); applyFromSoData(d); if (el && window.bootstrap) { window.bootstrap.Modal.getOrCreateInstance(el).show(); } }
                    else if (d && d.message) { alert(d.message); }
                }).catch(function () { });
        }
    })();
</script>
