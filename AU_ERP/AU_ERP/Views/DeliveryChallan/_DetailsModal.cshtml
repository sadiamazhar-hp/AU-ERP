@model AU_ERP.Models.DeliveryChallan
@using System.Globalization
@{
    var d = Model;
    var lines = d?.Items?.OrderBy(i => i.Id).ToList() ?? new List<DeliveryChallanItem>();
    string FmtDate(DateTime t) => t.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture);
    string FmtQty(decimal q) => UiNumberFormat.D2(q);
    var pdfUrl = d != null ? (Url.Action("DownloadPdf", "DeliveryChallan", new { id = d.Id }) ?? "") : "";
    string DcDriverLabel(Driver? dr)
    {
        if (dr == null) return "—";
        var n = string.Join(" ", new[] { dr.FirstName, dr.LastName }.Where(s => !string.IsNullOrWhiteSpace(s))).Trim();
        return string.IsNullOrEmpty(n) ? ("Driver #" + dr.Id) : n;
    }
    string DcVehicleLabel(Vehicle? v) => v == null ? "—" : $"{v.NumberPlate} ({v.CarType})";
}
@if (d == null)
{
    <p class="text-secondary mb-0">Not found.</p>
}
else
{
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
        <div>
            <h6 class="mb-0" style="color: var(--dark, #354a5e);">@d.DeliveryChallanNumber</h6>
            <p class="small text-muted mb-0">@FmtDate(d.DocumentDate) · @(d.Plant?.PlantName ?? "—") · @d.DeliveryType</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (!string.IsNullOrEmpty(pdfUrl))
            {
                <a class="btn btn-sm btn-primary" href="@pdfUrl" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            }
            @if (d.DeliveryCompletedAt.HasValue)
            {
                var done = d.DeliveryCompletedAt!.Value.ToString("dd-MMM-yyyy HH:mm", CultureInfo.InvariantCulture);
                <span class="badge bg-secondary text-white align-self-center" title="@done UTC">Delivered (@done&nbsp;UTC)</span>
            }
            else if (d.DriverId != null || d.VehicleId != null)
            {
                <form asp-action="MarkDeliveryCompleted" asp-controller="DeliveryChallan" method="post" class="d-inline" onsubmit="return confirm('Mark delivery completed and free this driver / vehicle?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@d.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-success">Delivery completed</button>
                </form>
            }
            else
            {
                <span class="small text-muted align-self-center">No driver / vehicle on this challan.</span>
            }
        </div>
    </div>
    <div class="row g-2 small mb-2">
        <div class="col-6">
            <div class="text-uppercase text-muted" style="font-size: .65rem; letter-spacing: .04em;">Ref. sales order</div>
            <div class="fw-semibold">@(d.ReferenceSalesOrderNumber ?? d.SalesOrder?.SalesOrderNumber ?? "—")</div>
        </div>
        <div class="col-6">
            <div class="text-uppercase text-muted" style="font-size: .65rem; letter-spacing: .04em;">Ship-to</div>
            <div class="fw-semibold">@(d.ShipToDisplayName ?? d.ShipToBusinessPartner?.FullName ?? "—")</div>
        </div>
        <div class="col-6">
            <div class="text-uppercase text-muted" style="font-size: .65rem; letter-spacing: .04em;">Driver</div>
            <div class="fw-semibold">@DcDriverLabel(d.Driver)</div>
        </div>
        <div class="col-6">
            <div class="text-uppercase text-muted" style="font-size: .65rem; letter-spacing: .04em;">Vehicle</div>
            <div class="fw-semibold">@DcVehicleLabel(d.Vehicle)</div>
        </div>
    </div>
    <div class="table-responsive" style="max-height: 55vh; overflow-y: auto;">
        <table class="table table-sm table-bordered align-middle mb-0" style="font-size: .8rem;">
            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                <tr>
                    <th style="width:2rem">#</th>
                    <th>Ref. SO</th>
                    <th>Material</th>
                    <th>Description</th>
                    <th class="text-end">Qty</th>
                    <th>UoM</th>
                    <th>Batch / lot</th>
                </tr>
            </thead>
            <tbody>
            @{ var n = 0; }
            @foreach (var li in lines)
            {
                n++;
                <tr>
                    <td class="text-muted">@n</td>
                    <td class="text-nowrap">@(li.ReferenceSalesOrderNumber ?? "—")</td>
                    <td class="text-nowrap">@li.MaterialNumber</td>
                    <td>@(li.MaterialDescription ?? "—")</td>
                    <td class="text-end">@FmtQty(li.DeliveryQuantity)</td>
                    <td>@(li.QuantityUom?.Code ?? "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(li.Batch) ? "—" : li.Batch)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
