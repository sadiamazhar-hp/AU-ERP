@model List<AU_ERP.Models.BomHeadersSample>
@using System.Text.Json
@{
    ViewData["Title"] = "Bill Of Materials";
    string BomAssemblyLabel(string? code) =>
        string.Equals(code, "FERT", StringComparison.OrdinalIgnoreCase) ? "FG"
        : string.Equals(code, "HALB", StringComparison.OrdinalIgnoreCase) ? "SFG"
        : (code ?? "—");
    var safeModel = Model ?? new List<AU_ERP.Models.BomHeadersSample>();
    var bomTabList = string.Equals(ViewContext.HttpContext?.Request.Query["tab"].ToString(), "list", StringComparison.OrdinalIgnoreCase);
    var bomLevels = ViewBag.BomLevels as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var plants = ViewBag.Plants as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var bomUoms = ViewBag.UomList as List<AU_ERP.Models.UnitOfMeasurement> ?? new List<AU_ERP.Models.UnitOfMeasurement>();
    var bomUomsJson = JsonSerializer.Serialize(bomUoms.Select(u => new { id = u.Id, code = u.Code ?? "" }));
    var nextBomCode = ViewBag.NextBomCode as string ?? "";
}

<style>
    :root {
        --sap-bg: #e5ebf1;
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
    }

    .bom-module .table-sap {
        width: 100%;
        border-collapse: collapse;
    }

    .bom-module .table-sap th {
        background: var(--sap-header-bg);
        border: 1px solid #ccc;
        padding: 6px 10px;
        font-weight: normal;
    }

    .bom-module .table-sap td {
        border: 1px solid #ccc;
        padding: 0;
        height: 32px;
    }

    .bom-module .sap-input {
        width: 100%;
        height: 100%;
        border: none;
        padding: 0 10px;
        background: var(--sap-readonly);
        outline: none;
        box-sizing: border-box;
    }

    .bom-module .table-sap th.col-no,
    .bom-module .table-sap td.col-no {
        padding-left: 14px;
        padding-right: 8px;
    }

    .bom-module .table-sap td.col-action {
        padding: 4px 8px;
        vertical-align: middle;
        text-align: center;
    }

    .bom-module-tabstrip {
        border-bottom: 1px solid var(--sap-border);
        padding: 0 0.25rem;
        background: #fff;
    }

    .bom-module-tabstrip .nav-link {
        color: var(--au-primary-dark, #388087);
        font-weight: 500;
        border: 1px solid transparent;
        border-radius: 0.35rem 0.35rem 0 0;
    }

    .bom-module-tabstrip .nav-link:hover {
        border-color: rgba(56, 128, 135, 0.25);
    }

    .bom-module-tabstrip .nav-link.active {
        color: var(--au-black, #171717);
        background: #fff;
        border-color: var(--sap-border);
        border-bottom-color: #fff;
        margin-bottom: -1px;
    }

    .bom-module-tab-content {
        border: 1px solid var(--sap-border);
        border-top: none;
        background: #fff;
    }

    .bom-create-form .v2-frame {
        border: 1px solid #c4c4c4;
        border-radius: 4px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .bom-create-form .v2-frame legend {
        font-size: .8rem;
        font-weight: 600;
        color: #388087;
        width: auto;
        padding: 0 .35rem;
        float: none;
        margin-bottom: 0;
    }

    .bom-create-form .form-label {
        font-size: .82rem;
        font-weight: 500;
        color: #555;
        margin-bottom: .2rem;
    }

    .bom-create-form .mandatory-bar {
        display: inline-block;
        width: 3px;
        height: 14px;
        background: #b00;
        margin-right: 4px;
        vertical-align: middle;
    }

    .bom-create-form .btn-save-bottom {
        display: flex;
        justify-content: flex-end;
        padding: 0.75rem 1.25rem;
        border-top: 1px solid #c4c4c4;
        background: #f3f6f8;
    }

    .bom-items-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: .5rem;
    }

    .bom-items-table th {
        background: #dee6ef;
        border: 1px solid #ccc;
        padding: 6px 10px;
        font-weight: normal;
        font-size: .82rem;
    }

    .bom-items-table td {
        border: 1px solid #ccc;
        padding: 2px 4px;
    }

    .bom-items-table .form-control-sm {
        border-radius: 2px;
    }

    .bom-mat-picker {
        position: relative;
    }

    .bom-mat-picker-dropdown {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        margin-top: 2px;
        max-height: 220px;
        overflow-y: auto;
        z-index: 1060;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 2px;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }

    .bom-mat-picker-dropdown.show {
        display: block;
    }

    .bom-mat-picker-item {
        padding: 6px 10px;
        font-size: .82rem;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }

    .bom-mat-picker-item:hover,
    .bom-mat-picker-item.active {
        background: var(--sap-selected, #b3d7ff);
    }

    .bom-mat-picker-item .bom-mat-code {
        font-weight: 600;
    }

    .bom-mat-picker-empty {
        padding: 8px 10px;
        font-size: .78rem;
        color: #666;
    }
</style>

<div class="bom-module">
    <ul class="nav nav-tabs bom-module-tabstrip" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(bomTabList ? "" : "active")" id="bomTabCreateBtn" data-bs-toggle="tab" data-bs-target="#bomPaneCreate" type="button" role="tab" aria-controls="bomPaneCreate" aria-selected="@(bomTabList ? "false" : "true")">Create</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(bomTabList ? "active" : "")" id="bomTabListBtn" data-bs-toggle="tab" data-bs-target="#bomPaneList" type="button" role="tab" aria-controls="bomPaneList" aria-selected="@(bomTabList ? "true" : "false")">List</button>
        </li>
    </ul>

    <div class="tab-content bom-module-tab-content">
        <!-- ───── CREATE TAB ───── -->
        <div class="tab-pane fade p-2 p-md-3 @(bomTabList ? "" : "show active")" id="bomPaneCreate" role="tabpanel" aria-labelledby="bomTabCreateBtn">
            <div class="bom-create-form">
                <div class="au-validation-summary mb-2" style="display:none;" role="alert"></div>
                <input type="hidden" id="bomCreateBomID" value="0" />

                <fieldset class="v2-frame">
                    <legend>Header</legend>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">BOM Code</label>
                            <input type="text" id="bomCreateCode" class="form-control form-control-sm" maxlength="20" value="@nextBomCode" readonly style="background:var(--sap-readonly);" title="Assigned automatically when you save" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label"><span class="mandatory-bar"></span> BOM Title</label>
                            <input type="text" id="bomCreateTitle" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><span class="mandatory-bar"></span> BOM Level</label>
                            <select id="bomCreateBLevel" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (bomLevels != null)
                                {
                                    foreach (var item in bomLevels)
                                    {
                                        var lvlName = (item.Text ?? "").Trim();
                                        var headerMatType = string.Equals(lvlName, "FG", StringComparison.OrdinalIgnoreCase) ? "FERT"
                                            : string.Equals(lvlName, "SFG", StringComparison.OrdinalIgnoreCase) ? "HALB"
                                            : (item.Value == "1" ? "FERT" : item.Value == "2" ? "HALB" : "");
                                        <option value="@item.Value" data-header-material-type="@headerMatType">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Plant</label>
                            <select id="bomCreatePlant" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (plants != null)
                                {
                                    foreach (var p in plants)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Base Qty</label>
                            <input type="number" id="bomCreateBaseQty" class="form-control form-control-sm" value="1" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Valid From</label>
                            <input type="date" id="bomCreateValidFrom" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            <label class="form-label"><span class="mandatory-bar"></span> Material <span class="text-muted small fw-normal">(FG → FERT, SFG → HALB per BOM level)</span></label>
                            <div class="bom-mat-picker" data-purpose="header" data-bom-level-select-id="bomCreateBLevel">
                                <input type="text" class="form-control form-control-sm bom-mat-picker-search" id="bomCreateHeaderMatSearch" placeholder="Search material number or description…" autocomplete="off" />
                                <input type="hidden" id="bomCreateHeaderMat" class="bom-mat-picker-value" value="" />
                                <div class="bom-mat-picker-dropdown" id="bomCreateHeaderMatDd"></div>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="v2-frame">
                    <legend>
                        Components
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-3" onclick="bomAddItemRow('bomCreateItemsBody')">+ Add</button>
                    </legend>
                    <table class="bom-items-table">
                        <thead>
                            <tr>
                                <th style="width:50px;">Pos</th>
                                <th>Component Material</th>
                                <th style="width:100px;">Qty</th>
                                <th style="width:80px;">UoM</th>
                                <th style="width:100px;">Scrap %</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="bomCreateItemsBody"></tbody>
                    </table>
                </fieldset>

                <div class="btn-save-bottom">
                    <button type="button" class="btn btn-sm px-4" id="bomBtnReset" style="background:#6FB3B8;color:#fff;border:1px solid #388087;" onclick="bomResetCreateForm()">Reset</button>
                    <button type="button" class="btn btn-sm px-4 ms-2" id="bomBtnSave" style="background:#388087;color:#fff;border:1px solid #388087;" onclick="bomSaveCreate()">Save</button>
                </div>
            </div>
        </div>

        <!-- ───── LIST TAB ───── -->
        <div class="tab-pane fade @(bomTabList ? "show active" : "")" id="bomPaneList" role="tabpanel" aria-labelledby="bomTabListBtn">
            <div class="au-validation-summary px-3 pt-2" style="display:none;" role="alert"></div>
            <div class="p-2 px-3">
                <input type="search" class="form-control form-control-sm" id="bomListFilter" placeholder="Filter by BOM ID, code, title, material, level…" style="max-width:22rem;" />
            </div>
            <div class="table-wrapper">
                <table class="table-sap" id="bomListTable">
                    <thead>
                        <tr>
                            <th class="col-no">No</th>
                            <th>BOM ID</th>
                            <th>BOM Code</th>
                            <th>BOM Title</th>
                            <th>Material</th>
                            <th>Assembly</th>
                            <th>Level</th>
                            <th>Plant</th>
                            <th>Base Qty</th>
                            <th style="width:72px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int bomIdx = 0; }
                        @foreach (var h in safeModel)
                        {
                            var levelName = h.BOMLevel?.LevelName ?? "";
                            var plantName = h.PlantSample?.PlantName ?? "";
                            var headerMat = h.BomMaterialNumber ?? "";
                            var asmLabel = BomAssemblyLabel(h.HeaderMaterialTypeCode);
                            <tr data-bom-filter="@($"{h.BomID} {h.BOMCode} {h.BOMTitle} {headerMat} {asmLabel} {levelName} {plantName}")" data-bom-id="@h.BomID">
                                <td class="col-no">@(bomIdx + 1)</td>
                                <td><input class="sap-input" value="@h.BomID" readonly /></td>
                                <td><input class="sap-input" value="@h.BOMCode" readonly /></td>
                                <td><input class="sap-input" value="@h.BOMTitle" readonly /></td>
                                <td><input class="sap-input" value="@headerMat" readonly /></td>
                                <td><input class="sap-input" value="@asmLabel" readonly /></td>
                                <td><input class="sap-input" value="@levelName" readonly /></td>
                                <td><input class="sap-input" value="@plantName" readonly /></td>
                                <td><input class="sap-input" value="@(h.BaseQty.HasValue ? h.BaseQty.Value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) : "")" readonly /></td>
                                <td class="col-action">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link text-secondary p-0" type="button" id="bomRowActions@(bomIdx)" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false" aria-label="Actions">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="bomRowActions@(bomIdx)">
                                            <li><button type="button" class="dropdown-item" data-bom-id="@h.BomID" onclick="bomOpenEdit(this.getAttribute('data-bom-id'))">Edit</button></li>
                                            <li><button type="button" class="dropdown-item text-danger" data-bom-id="@h.BomID" onclick="bomDeleteFromList(this.getAttribute('data-bom-id'))">Delete</button></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            bomIdx++;
                        }
                    </tbody>
                </table>
            </div>
            @if (safeModel.Count == 0)
            {
                <p class="text-secondary small mb-0 mt-2 px-3">No BOM records yet. Use the Create tab to add one.</p>
            }
        </div>
    </div>
</div>

<!-- ───── EDIT MODAL ───── -->
<div class="modal fade" id="bomEditModal" tabindex="-1" aria-labelledby="bomEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content au-create-v2-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="bomEditModalLabel">Edit Bill Of Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="au-validation-summary mb-2" style="display:none;" role="alert"></div>
                <input type="hidden" id="bomEditBomID" />

                <fieldset class="v2-frame">
                    <legend>Header</legend>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label"><span class="mandatory-bar" style="display:inline-block;width:3px;height:14px;background:#b00;margin-right:4px;vertical-align:middle;"></span> BOM Code</label>
                            <input type="text" id="bomEditCode" class="form-control form-control-sm" maxlength="20" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label"><span class="mandatory-bar" style="display:inline-block;width:3px;height:14px;background:#b00;margin-right:4px;vertical-align:middle;"></span> BOM Title</label>
                            <input type="text" id="bomEditTitle" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">BOM Level</label>
                            <select id="bomEditBLevel" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (bomLevels != null)
                                {
                                    foreach (var item in bomLevels)
                                    {
                                        var lvlNameE = (item.Text ?? "").Trim();
                                        var headerMatTypeE = string.Equals(lvlNameE, "FG", StringComparison.OrdinalIgnoreCase) ? "FERT"
                                            : string.Equals(lvlNameE, "SFG", StringComparison.OrdinalIgnoreCase) ? "HALB"
                                            : (item.Value == "1" ? "FERT" : item.Value == "2" ? "HALB" : "");
                                        <option value="@item.Value" data-header-material-type="@headerMatTypeE">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Plant</label>
                            <select id="bomEditPlant" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @if (plants != null)
                                {
                                    foreach (var p in plants)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Base Qty</label>
                            <input type="number" id="bomEditBaseQty" class="form-control form-control-sm" step="any" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Valid From</label>
                            <input type="date" id="bomEditValidFrom" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-3">
                            <label class="form-label">Assembly type</label>
                            <input type="hidden" id="bomEditHeaderMatType" value="" />
                            <input type="text" id="bomEditHeaderMatTypeReadonly" class="form-control form-control-sm" readonly style="background:var(--sap-readonly,#f4f4f4);" title="Cannot be changed after BOM is created" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Header material</label>
                            <input type="hidden" id="bomEditHeaderMat" value="" />
                            <input type="text" id="bomEditHeaderMatSearch" class="form-control form-control-sm" readonly style="background:var(--sap-readonly,#f4f4f4);" title="Cannot be changed after BOM is created" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="v2-frame">
                    <legend>
                        Components
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-3" onclick="bomAddItemRow('bomEditItemsBody')">+ Add</button>
                    </legend>
                    <table class="bom-items-table">
                        <thead>
                            <tr>
                                <th style="width:50px;">Pos</th>
                                <th>Component Material</th>
                                <th style="width:100px;">Qty</th>
                                <th style="width:80px;">UoM</th>
                                <th style="width:100px;">Scrap %</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="bomEditItemsBody"></tbody>
                    </table>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm px-4" style="background:#388087;color:#fff;border:1px solid #388087;" onclick="bomSaveEdit()">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var bomItemCounter = 0;
    var bomAllUoms = @Html.Raw(bomUomsJson);
    var bomNextCodeUrl = '@Url.Action("GetNextBomCode", "BOM")';
    var bomSearchMaterialsUrl = '@Url.Action("SearchBomMaterials", "BOM")';
    var bomPickerTimers = {};

    function escBomAttr(s) {
        if (s == null || s === undefined) return "";
        return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
    }

    function bomCloseAllMatPickers() {
        document.querySelectorAll(".bom-mat-picker-dropdown.show").forEach(function (d) {
            d.classList.remove("show");
            d.innerHTML = "";
        });
    }

    document.addEventListener("mousedown", function (e) {
        if (e.target.closest(".bom-mat-picker-dropdown"))
            e.preventDefault();
        else if (!e.target.closest(".bom-mat-picker"))
            bomCloseAllMatPickers();
    });

    function bomGetHeaderMaterialTypeFromLevelSel(sel) {
        if (!sel || !sel.value) return "";
        var opt = sel.options[sel.selectedIndex];
        return (opt && opt.getAttribute("data-header-material-type") || "").trim().toUpperCase();
    }

    function bomMatPickerBuildUrl(purpose, q, matType) {
        var url = bomSearchMaterialsUrl + "?purpose=" + encodeURIComponent(purpose) + "&q=" + encodeURIComponent(q || "");
        if (purpose === "header" && matType)
            url += "&materialType=" + encodeURIComponent(matType);
        return url;
    }

    function bomMatPickerGetHidden(wrap) {
        return wrap.querySelector("input.bom-mat-picker-value") || wrap.querySelector("input[type=hidden]");
    }

    function bomMatPickerFetch(searchInput) {
        var wrap = searchInput.closest(".bom-mat-picker");
        if (!wrap) return;
        var purpose = wrap.getAttribute("data-purpose") || "component";
        var dd = wrap.querySelector(".bom-mat-picker-dropdown");
        if (!dd) return;
        var matType = "";
        if (purpose === "header") {
            var lvlId = wrap.getAttribute("data-bom-level-select-id");
            var lvlSel = lvlId ? document.getElementById(lvlId) : null;
            matType = bomGetHeaderMaterialTypeFromLevelSel(lvlSel);
            if (!matType) {
                dd.innerHTML = '<div class="bom-mat-picker-empty">Select BOM level (FG / SFG) first.</div>';
                dd.classList.add("show");
                return;
            }
        }
        fetch(bomMatPickerBuildUrl(purpose, searchInput.value, matType))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || !data.success) {
                    dd.innerHTML = '<div class="bom-mat-picker-empty">Could not load materials.</div>';
                    dd.classList.add("show");
                    return;
                }
                var items = data.items || [];
                if (!items.length)
                    dd.innerHTML = '<div class="bom-mat-picker-empty">No matches</div>';
                else
                    dd.innerHTML = items.map(function (it) {
                        var uid = it.uomId != null && it.uomId !== undefined ? String(it.uomId) : "";
                        var bu = it.baseUom != null ? String(it.baseUom) : "";
                        return '<button type="button" class="bom-mat-picker-item list-group-item list-group-item-action py-1 px-2 text-start border-0 rounded-0" data-n="' + escBomAttr(it.n) + '" data-d="' + escBomAttr(it.d) + '" data-base-uom="' + escBomAttr(bu) + '" data-uom-id="' + escBomAttr(uid) + '">'
                            + '<span class="bom-mat-code">' + escBomAttr(it.n) + '</span>'
                            + ' <span class="text-muted small">— ' + escBomAttr(it.d) + "</span></button>";
                    }).join("");
                dd.classList.add("show");
            })
            .catch(function () {
                dd.innerHTML = '<div class="bom-mat-picker-empty">Request failed.</div>';
                dd.classList.add("show");
            });
    }

    function bomMatPickerScheduleSearch(inputEl) {
        var key = inputEl.id || ("picker-" + (inputEl.name || Math.random()));
        clearTimeout(bomPickerTimers[key]);
        bomPickerTimers[key] = setTimeout(function () { bomMatPickerFetch(inputEl); }, 250);
    }

    document.addEventListener("focusin", function (e) {
        if (!e.target.classList || !e.target.classList.contains("bom-mat-picker-search")) return;
        bomMatPickerFetch(e.target);
    });

    document.addEventListener("input", function (e) {
        if (!e.target.classList || !e.target.classList.contains("bom-mat-picker-search")) return;
        bomMatPickerScheduleSearch(e.target);
    });

    document.addEventListener("click", function (e) {
        var btn = e.target.closest(".bom-mat-picker-item");
        if (!btn) return;
        e.preventDefault();
        var wrap = btn.closest(".bom-mat-picker");
        var dd = btn.closest(".bom-mat-picker-dropdown");
        var hidden = bomMatPickerGetHidden(wrap);
        var search = wrap.querySelector(".bom-mat-picker-search");
        var n = btn.getAttribute("data-n") || "";
        var d = btn.getAttribute("data-d") || "";
        if (hidden) hidden.value = n;
        if (search) search.value = n ? (n + (d ? " — " + d : "")) : "";
        if (wrap.getAttribute("data-purpose") === "component") {
            var tr = wrap.closest("tr");
            if (tr) {
                var uid = (btn.getAttribute("data-uom-id") || "").trim();
                var bu = (btn.getAttribute("data-base-uom") || "").trim();
                var disp = tr.querySelector(".bom-comp-uom-display");
                var hidUom = tr.querySelector("input.bom-comp-uom-id");
                if (disp) disp.value = bu || (uid ? "" : "—");
                if (hidUom) hidUom.value = uid;
            }
        }
        if (dd) {
            dd.classList.remove("show");
            dd.innerHTML = "";
        }
    });

    function bomBuildCompMaterialCell(matNum, displayText) {
        var disp = displayText || "";
        var v = matNum || "";
        return '<div class="bom-mat-picker" data-purpose="component">'
            + '<input type="text" class="form-control form-control-sm bom-mat-picker-search" placeholder="Search # or description…" autocomplete="off" value="' + escBomAttr(disp) + '" />'
            + '<input type="hidden" class="bom-mat-picker-value bom-comp-mat" value="' + escBomAttr(v) + '" />'
            + '<div class="bom-mat-picker-dropdown"></div>'
            + "</div>";
    }

    function bomBuildCompUomReadonlyCell(uomId, baseUomCode) {
        var idStr = uomId != null && uomId !== "" ? String(uomId) : "";
        var disp = (baseUomCode != null && String(baseUomCode).trim()) ? String(baseUomCode).trim() : "";
        if (!disp && idStr && bomAllUoms && bomAllUoms.length) {
            var u = bomAllUoms.find(function (x) { return String(x.id) === idStr; });
            if (u && u.code) disp = String(u.code);
        }
        if (!disp) disp = "—";
        return '<input type="text" class="form-control form-control-sm bom-comp-uom-display" readonly style="background:var(--sap-readonly,#f4f4f4);" value="' + escBomAttr(disp) + '" title="Base unit from component material" />'
            + '<input type="hidden" class="bom-comp-uom-id" value="' + escBomAttr(idStr) + '" />';
    }

    function bomAddItemRow(tbodyId) {
        var tbody = document.getElementById(tbodyId);
        if (!tbody) return;
        if (tbodyId === "bomCreateItemsBody") {
            var blC = document.getElementById("bomCreateBLevel");
            var hmC = document.getElementById("bomCreateHeaderMat");
            if (!blC || !(blC.value || "").trim() || !hmC || !(hmC.value || "").trim()) {
                bomShowInline(bomCreateFormRoot(), [blC, hmC].filter(Boolean), "Select BOM level and header material before adding components.");
                return;
            }
        }
        if (tbodyId === "bomEditItemsBody") {
            var htE = document.getElementById("bomEditHeaderMatType");
            if (!htE || !(htE.value || "").trim()) {
                bomShowInline(bomEditFormRoot(), [htE], "Header assembly is missing; reopen the BOM from the list.");
                return;
            }
        }
        bomItemCounter++;
        var pos = tbody.rows.length + 1;
        var tr = document.createElement("tr");
        tr.innerHTML =
            '<td class="text-center">' + pos + '</td>' +
            "<td>" + bomBuildCompMaterialCell("", "") + "</td>" +
            '<td><input type="number" class="form-control form-control-sm bom-comp-qty" step="any" value="1" /></td>' +
            "<td>" + bomBuildCompUomReadonlyCell("", "") + "</td>" +
            '<td><input type="number" class="form-control form-control-sm bom-comp-scrap" step="any" value="0" /></td>' +
            '<td><button type="button" class="btn btn-danger btn-sm" onclick="this.closest(\'tr\').remove()">X</button></td>';
        tbody.appendChild(tr);
    }

    function bomCollectItems(tbodyId) {
        var items = [];
        var rows = document.querySelectorAll("#" + tbodyId + " tr");
        rows.forEach(function (tr) {
            var hid = tr.querySelector("input.bom-comp-mat");
            var matVal = (hid && hid.value ? hid.value : "").trim();
            if (!matVal) return;
            var uomHid = tr.querySelector("input.bom-comp-uom-id");
            var uomId = uomHid ? parseInt(uomHid.value, 10) : NaN;
            items.push({
                MaterialNumber: matVal,
                Quantity: parseFloat(tr.querySelector(".bom-comp-qty")?.value) || 0,
                UomId: isNaN(uomId) ? null : uomId,
                ScrapPercentage: parseFloat(tr.querySelector(".bom-comp-scrap")?.value) || 0
            });
        });
        return items;
    }

    function bomCreateFormRoot() {
        return document.querySelector("#bomPaneCreate .bom-create-form");
    }

    function bomEditFormRoot() {
        return document.querySelector("#bomEditModal .modal-body");
    }

    function bomListPaneRoot() {
        return document.getElementById("bomPaneList");
    }

    function bomShowInline(root, invalidEls, message) {
        if (!root) root = bomCreateFormRoot() || document.querySelector(".bom-module");
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        if (typeof window.auShowInlineValidation === "function")
            window.auShowInlineValidation(root, invalidEls || [], message);
        else alert(message || "Following Fields are Required");
    }

    function bomValidateCreateHeader() {
        var bad = [];
        var c = document.getElementById("bomCreateCode");
        var t = document.getElementById("bomCreateTitle");
        var lv = document.getElementById("bomCreateBLevel");
        var hm = document.getElementById("bomCreateHeaderMat");
        var hms = document.getElementById("bomCreateHeaderMatSearch");
        var code = (c && c.value || "").trim();
        if (code && code.length > 20) bad.push(c);
        if (!(t && (t.value || "").trim())) bad.push(t);
        if (!(lv && (lv.value || "").trim())) bad.push(lv);
        if (!bomGetHeaderMaterialTypeFromLevelSel(lv)) bad.push(lv);
        if (!(hm && (hm.value || "").trim())) bad.push(hms || hm);
        return bad;
    }

    function bomValidateEditHeader() {
        var bad = [];
        var c = document.getElementById("bomEditCode");
        var t = document.getElementById("bomEditTitle");
        var ht = document.getElementById("bomEditHeaderMatType");
        var hm = document.getElementById("bomEditHeaderMat");
        var hms = document.getElementById("bomEditHeaderMatSearch");
        var code = (c && c.value || "").trim();
        if (!code) bad.push(c);
        else if (code.length > 20) bad.push(c);
        if (!(t && (t.value || "").trim())) bad.push(t);
        if (!(ht && (ht.value || "").trim())) bad.push(document.getElementById("bomEditHeaderMatTypeReadonly") || ht);
        if (!(hm && (hm.value || "").trim())) bad.push(hms || hm);
        return bad;
    }

    function bomValidateComponentRows(tbodyId) {
        var bad = [];
        document.querySelectorAll("#" + tbodyId + " tr").forEach(function (tr) {
            var mat = tr.querySelector("input.bom-comp-mat");
            var qty = tr.querySelector(".bom-comp-qty");
            var uom = tr.querySelector("input.bom-comp-uom-id");
            var scr = tr.querySelector(".bom-comp-scrap");
            if (!mat || !qty || !uom || !scr) return;
            var mval = (mat.value || "").trim();
            var qraw = (qty.value || "").trim();
            var uval = (uom.value || "").trim();
            var sraw = (scr.value || "").trim();
            var qnum = parseFloat(qraw);
            var snum = parseFloat(sraw);
            if (!mval) {
                var searchEl = tr.querySelector(".bom-mat-picker-search");
                bad.push(searchEl || mat);
            }
            if (qraw === "" || isNaN(qnum)) bad.push(qty);
            if (!uval) bad.push(tr.querySelector(".bom-comp-uom-display") || uom);
            if (sraw === "" || isNaN(snum)) bad.push(scr);
        });
        return bad;
    }

    function bomAssemblyReadonlyLabel(code) {
        var c = (code || "").trim().toUpperCase();
        if (c === "FERT") return "FG";
        if (c === "HALB") return "SFG";
        return c || "—";
    }

    function bomResetCreateForm() {
        var root = bomCreateFormRoot();
        if (root && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        document.getElementById("bomCreateBomID").value = "0";
        document.getElementById("bomCreateTitle").value = "";
        document.getElementById("bomCreateBLevel").value = "";
        document.getElementById("bomCreatePlant").value = "";
        document.getElementById("bomCreateBaseQty").value = "1";
        document.getElementById("bomCreateValidFrom").value = "";
        var hm = document.getElementById("bomCreateHeaderMat");
        if (hm) hm.value = "";
        var hms = document.getElementById("bomCreateHeaderMatSearch");
        if (hms) hms.value = "";
        document.getElementById("bomCreateItemsBody").innerHTML = "";
        document.getElementById("bomBtnSave").textContent = "Save";
        var codeEl = document.getElementById("bomCreateCode");
        if (codeEl) codeEl.value = "";
        fetch(bomNextCodeUrl)
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (codeEl && res && res.success && res.nextBomCode)
                    codeEl.value = res.nextBomCode;
            })
            .catch(function () { /* leave empty on failure */ });
    }

    function bomReloadToListTab() {
        var u = new URL(window.location.href);
        u.searchParams.set("tab", "list");
        window.location.assign(u.toString());
    }

    function bomSaveCreate() {
        var root = bomCreateFormRoot();
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        var bad = bomValidateCreateHeader().concat(bomValidateComponentRows("bomCreateItemsBody"));
        if (bad.length) {
            bomShowInline(root, bad);
            return;
        }

        var code = (document.getElementById("bomCreateCode").value || "").trim();
        var title = (document.getElementById("bomCreateTitle").value || "").trim();
        var bLevel = document.getElementById("bomCreateBLevel").value;

        var bomId = parseInt(document.getElementById("bomCreateBomID").value) || 0;
        var isUpdate = bomId > 0;
        var url = isUpdate ? '@Url.Action("Update", "BOM")' : '@Url.Action("Create", "BOM")';

        var payload = {
            BomID: bomId,
            BOMCode: code,
            BOMTitle: title,
            BLevel: parseInt(bLevel) || null,
            Plant: document.getElementById("bomCreatePlant").value || null,
            BaseQty: parseFloat(document.getElementById("bomCreateBaseQty").value) || null,
            ValidFrom: document.getElementById("bomCreateValidFrom").value || null,
            HeaderMaterialTypeCode: bomGetHeaderMaterialTypeFromLevelSel(document.getElementById("bomCreateBLevel")) || null,
            BomMaterialNumber: (document.getElementById("bomCreateHeaderMat")?.value || "").trim() || null,
            Items: bomCollectItems("bomCreateItemsBody")
        };

        fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                var msg = res.message || (isUpdate ? "BOM Updated Successfully !" : "BOM Created Successfully !");
                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(msg, function () { bomReloadToListTab(); });
                else { alert(msg); bomReloadToListTab(); }
            } else {
                bomShowInline(root, [], res.message || "Save failed.");
            }
        })
        .catch(function () { bomShowInline(root, [], "Request failed."); });
    }

    function bomOpenEdit(bomId) {
        if (!bomId) return;
        fetch('@Url.Action("GetBomForEdit", "BOM")?id=' + encodeURIComponent(bomId))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.success) { bomShowInline(bomListPaneRoot(), [], data.message || "Could not load BOM."); return; }
                var editRoot = bomEditFormRoot();
                if (editRoot && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(editRoot);
                var b = data.bom;
                document.getElementById("bomEditBomID").value = b.bomID || b.BomID;
                document.getElementById("bomEditCode").value = b.bomCode || b.BOMCode || "";
                document.getElementById("bomEditTitle").value = b.bomTitle || b.BOMTitle || "";
                document.getElementById("bomEditBLevel").value = b.bLevel != null ? b.bLevel : (b.BLevel || "");
                document.getElementById("bomEditPlant").value = b.plant || b.Plant || "";
                document.getElementById("bomEditBaseQty").value = b.baseQty != null ? b.baseQty : (b.BaseQty || "");
                document.getElementById("bomEditValidFrom").value = b.validFrom || b.ValidFrom || "";
                var eht = document.getElementById("bomEditHeaderMatType");
                var htCode = (b.headerMaterialTypeCode || b.HeaderMaterialTypeCode || "").trim();
                if (eht) eht.value = htCode;
                var ehtr = document.getElementById("bomEditHeaderMatTypeReadonly");
                if (ehtr) ehtr.value = bomAssemblyReadonlyLabel(htCode);
                var ehm = document.getElementById("bomEditHeaderMat");
                if (ehm) ehm.value = b.bomMaterialNumber || b.BomMaterialNumber || "";
                var ehms = document.getElementById("bomEditHeaderMatSearch");
                if (ehms) ehms.value = b.headerMaterialDisplay || b.HeaderMaterialDisplay || "";

                var tbody = document.getElementById("bomEditItemsBody");
                tbody.innerHTML = "";
                var items = b.items || b.Items || [];
                items.forEach(function (item, idx) {
                    var matNum = item.materialNumber || item.MaterialNumber || "";
                    var md = item.materialDescription || item.MaterialDescription || "";
                    var disp = matNum && md ? (matNum + " — " + md) : matNum;
                    var qty = item.quantity != null ? item.quantity : (item.Quantity || "");
                    var uomId = item.uomId != null ? item.uomId : (item.UomId != null ? item.UomId : "");
                    var baseU = item.baseUnitCode || item.BaseUnitCode || "";
                    var scrap = item.scrapPercentage != null ? item.scrapPercentage : (item.ScrapPercentage || 0);
                    var tr = document.createElement("tr");
                    tr.innerHTML =
                        '<td class="text-center">' + (idx + 1) + '</td>' +
                        "<td>" + bomBuildCompMaterialCell(matNum, disp) + "</td>" +
                        '<td><input type="number" class="form-control form-control-sm bom-comp-qty" step="any" value="' + escBomAttr(qty) + '" /></td>' +
                        "<td>" + bomBuildCompUomReadonlyCell(uomId, baseU) + "</td>" +
                        '<td><input type="number" class="form-control form-control-sm bom-comp-scrap" step="any" value="' + escBomAttr(scrap) + '" /></td>' +
                        '<td><button type="button" class="btn btn-danger btn-sm" onclick="this.closest(\'tr\').remove()">X</button></td>';
                    tbody.appendChild(tr);
                });

                var modalEl = document.getElementById("bomEditModal");
                if (modalEl) {
                    if (modalEl.parentElement !== document.body)
                        document.body.appendChild(modalEl);
                    if (typeof bootstrap !== "undefined")
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            })
            .catch(function () { bomShowInline(bomListPaneRoot(), [], "Failed to load BOM data."); });
    }

    function bomSaveEdit() {
        var root = bomEditFormRoot();
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(root);
        var bomId = parseInt(document.getElementById("bomEditBomID").value) || 0;
        if (!bomId) { bomShowInline(root, [], "Invalid BOM ID."); return; }

        var bad = bomValidateEditHeader().concat(bomValidateComponentRows("bomEditItemsBody"));
        if (bad.length) {
            bomShowInline(root, bad);
            return;
        }

        var code = (document.getElementById("bomEditCode").value || "").trim();
        var title = (document.getElementById("bomEditTitle").value || "").trim();

        var payload = {
            BomID: bomId,
            BOMCode: code,
            BOMTitle: title,
            BLevel: parseInt(document.getElementById("bomEditBLevel").value) || null,
            Plant: document.getElementById("bomEditPlant").value || null,
            BaseQty: parseFloat(document.getElementById("bomEditBaseQty").value) || null,
            ValidFrom: document.getElementById("bomEditValidFrom").value || null,
            HeaderMaterialTypeCode: document.getElementById("bomEditHeaderMatType")?.value || null,
            BomMaterialNumber: (document.getElementById("bomEditHeaderMat")?.value || "").trim() || null,
            Items: bomCollectItems("bomEditItemsBody")
        };

        fetch('@Url.Action("Update", "BOM")', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                var modalEl = document.getElementById("bomEditModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();

                var msg = res.message || "BOM Updated Successfully !";
                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(msg, function () { bomReloadToListTab(); });
                else { alert(msg); bomReloadToListTab(); }
            } else {
                bomShowInline(root, [], res.message || "Update failed.");
            }
        })
        .catch(function () { bomShowInline(root, [], "Update request failed."); });
    }

    function bomDeleteFromList(bomId) {
        if (!bomId) return;
        function doDelete() {
            fetch('@Url.Action("Delete", "BOM")?id=' + encodeURIComponent(bomId), { method: "POST" })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) {
                        var msg = res.message || "BOM Deleted Successfully !";
                        if (typeof window.materialShowSuccessModalThen === "function")
                            window.materialShowSuccessModalThen(msg, function () { bomReloadToListTab(); });
                        else { alert(msg); bomReloadToListTab(); }
                    } else {
                        bomShowInline(bomListPaneRoot(), [], res.message || "Delete failed.");
                    }
                })
                .catch(function () { bomShowInline(bomListPaneRoot(), [], "Delete request failed."); });
        }
        if (typeof window.materialShowDeleteConfirmModalThen === "function")
            window.materialShowDeleteConfirmModalThen("Do you want to Delete this BOM?", doDelete);
        else if (confirm("Delete this BOM?"))
            doDelete();
    }

    (function () {
        var bl = document.getElementById("bomCreateBLevel");
        if (bl) bl.addEventListener("change", function () {
            var hm = document.getElementById("bomCreateHeaderMat");
            var hms = document.getElementById("bomCreateHeaderMatSearch");
            if (hm) hm.value = "";
            if (hms) hms.value = "";
            bomCloseAllMatPickers();
        });
    })();

    (function () {
        var inp = document.getElementById("bomListFilter");
        if (!inp) return;
        inp.addEventListener("input", function () {
            var q = (inp.value || "").toLowerCase().trim();
            document.querySelectorAll("#bomListTable tbody tr").forEach(function (tr) {
                var hay = (tr.getAttribute("data-bom-filter") || "").toLowerCase();
                tr.style.display = !q || hay.indexOf(q) >= 0 ? "" : "none";
            });
        });
    })();
</script>
}
