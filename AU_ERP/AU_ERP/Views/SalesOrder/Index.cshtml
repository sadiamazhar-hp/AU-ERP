        function soTryResolveQuotationFromTypedSearch() {
            var hid = document.getElementById("soSalesQuotationIdHidden");
            var search = document.getElementById("soSalesQuotationSearch");
            if (!hid || !search) return;
            var raw = (search.value || "").trim();
            if (!raw) {
                hid.value = "";
                return;
            }
            if (hid.value) {
                for (var z = 0; z < _soQuotationCatalog.length; z++) {
                    var q = _soQuotationCatalog[z];
                    if (String(q.id) === String(hid.value) && soQuotationDisplayLabel(q).trim() === raw)
                        return;
                }
            }
            var rawLower = raw.toLowerCase();
            var cand = [];
            for (var e = 0; e < _soQuotationCatalog.length; e++) {
                var it = _soQuotationCatalog[e];
                var num = (it.quotationNumber || "").trim().toLowerCase();
                if (num === rawLower || String(it.id) === raw)
                    cand.push(it);
            }
            if (cand.length !== 1) {
                cand = [];
                var qCompact = rawLower.replace(/\s/g, "");
                for (var f = 0; f < _soQuotationCatalog.length; f++) {
                    var it2 = _soQuotationCatalog[f];
                    var num2 = (it2.quotationNumber || "").toLowerCase();
                    var cust2 = (it2.customerName || "").toLowerCase();
                    var numCompact = num2.replace(/\s/g, "");
                    if ((qCompact.length >= 2 && numCompact.indexOf(qCompact) >= 0)
                        || (qCompact.length >= 2 && cust2.indexOf(rawLower) >= 0))
                        cand.push(it2);
                }
            }
            if (cand.length === 1)
                soCommitQuotationSelection(String(cand[0].id));
            else
                hid.value = "";
        }
