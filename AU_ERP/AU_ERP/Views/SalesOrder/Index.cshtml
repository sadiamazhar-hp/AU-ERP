            if (f && soCreateFormAction) { f.action = soCreateFormAction; f.setAttribute("data-so-form-mode", "create"); }
        }
        function setSoFormToUpdate(quotationId) {
            var f = document.getElementById("soForm");
            if (!f) return;
            if (soUpdateUrlTpl) f.action = soUpdateUrlTpl.replace("Update/0", "Update/" + quotationId).replace(/\/0(\?.*)?$/, "/" + quotationId + "$1");
            f.setAttribute("data-so-form-mode", "update");
        }
        function applyOrderData(d) {
            var h = d.h, items = d.items || [];
            schemaCharges = d.schemaCharges || [];
            if (h.plantId && document.getElementById("soPlant")) document.getElementById("soPlant").value = h.plantId;
            if (h.distributionChannelId != null && document.getElementById("soDc")) document.getElementById("soDc").value = String(h.distributionChannelId);
            if (document.getElementById("soSchema")) document.getElementById("soSchema").value = h.configurationSchemaId != null && h.configurationSchemaId !== "" ? String(h.configurationSchemaId) : "";
            if (h.orderDate && document.getElementById("soQd")) document.getElementById("soQd").value = h.orderDate;
            if (h.requestedDeliveryDate && document.getElementById("soVd")) document.getElementById("soVd").value = h.requestedDeliveryDate;
            if (document.getElementById("soNum")) document.getElementById("soNum").value = h.salesOrderNumber || "";
            if (document.getElementById("soModalTitle")) document.getElementById("soModalTitle").textContent = "Edit — " + (h.salesOrderNumber || "");
            if (document.getElementById("soCustomer")) document.getElementById("soCustomer").value = h.customerBusinessPartnerId || "";
            if (document.getElementById("soAddr")) document.getElementById("soAddr").value = h.shipToAddress || "";
            if (document.getElementById("soItemChargeColumnIds")) document.getElementById("soItemChargeColumnIds").value = h.itemChargeColumnIds || "";
            if (document.getElementById("soQuotationLevelChargeIds")) document.getElementById("soQuotationLevelChargeIds").value = h.quotationLevelChargeIds || "";
            if (document.getElementById("soQuotationChargeValuesJson")) document.getElementById("soQuotationChargeValuesJson").value = h.quotationChargeValuesJson || "";
            buildChargeDropdowns();
            var itemIds = parseIds(h.itemChargeColumnIds);
            var docIds = parseIds(h.quotationLevelChargeIds);
            document.querySelectorAll("#soItemChargeMenu .so-m-item-chk").forEach(function (cb) {
                var cid = parseInt(cb.getAttribute("data-cid"), 10);
                cb.checked = itemIds.indexOf(cid) >= 0;
            });
            document.querySelectorAll("#soQuotationChargeMenu .so-m-doc-chk").forEach(function (cb) {
                var cid = parseInt(cb.getAttribute("data-cid"), 10);
                cb.checked = docIds.indexOf(cid) >= 0;
            });
            renderItemChargeThead();
            var body = document.getElementById("soItemsBody");
            if (body) body.innerHTML = "";
            (items || []).forEach(function (it) {
                var tr = parseTrFromRowHtml();
                if (!body) return;
                body.appendChild(tr);
                reindex();
                if (it.materialNumber) {
                    if (tr.querySelector(".so-matno")) tr.querySelector(".so-matno").value = it.materialNumber;
                    if (tr.querySelector(".bom-mat-picker-search")) tr.querySelector(".bom-mat-picker-search").value = (it.materialNumber + (it.materialDescription ? " — " + it.materialDescription : ""));
                }
                if (tr.querySelector(".so-desc") && it.materialDescription) tr.querySelector(".so-desc").value = it.materialDescription;
                if (tr.querySelector(".so-grade") && (it.salesPriceGrade != null && it.salesPriceGrade !== "")) tr.querySelector(".so-grade").value = String(it.salesPriceGrade);
                if (tr.querySelector(".so-qty") && it.orderQuantity != null) tr.querySelector(".so-qty").value = String(it.orderQuantity);
                if (tr.querySelector(".so-unit") && it.unitPrice != null) tr.querySelector(".so-unit").value = String(it.unitPrice);
                if (tr.querySelector(".so-del") && it.deliveryDate) tr.querySelector(".so-del").value = it.deliveryDate;
                appendItemChargeTds(tr);
                reindex();
                var chObj = {};
                try { if (it.itemChargeValuesJson) chObj = JSON.parse(it.itemChargeValuesJson); } catch (e) { chObj = {}; }
                tr.querySelectorAll(".so-ln-chg").forEach(function (inp) {
                    var k = String(inp.getAttribute("data-cid"));
                    if (chObj.hasOwnProperty(k) && chObj[k] != null) inp.value = String(chObj[k]);
                });
                wireRow(tr);
                if (it.materialNumber) uomFill(tr, it.materialNumber, it.materialDescription || "", { preserveUnitPrice: it.unitPrice, savedUomId: it.quantityUomId });
            });
            if (!items.length) {
                if (body) { body.innerHTML = rowHtml().trim(); reindex(); renderItemChargeThead(); body.querySelectorAll("tr.so-item-row").forEach(function (tr) { tr.querySelector(".so-del") && (tr.querySelector(".so-del").value = document.getElementById("soQd") && document.getElementById("soQd").value || defaults.today); appendItemChargeTds(tr); }); reindex(); body.querySelectorAll("tr.so-item-row").forEach(wireRow); }
            }
            buildQuotationChargeInputs();
            var docObj = {};
            try { if (h.quotationChargeValuesJson) docObj = JSON.parse(h.quotationChargeValuesJson); } catch (e) { docObj = {}; }
            document.querySelectorAll(".so-doc-chg-val").forEach(function (inp) {
                var k = String(inp.getAttribute("data-cid"));
                if (docObj.hasOwnProperty(k) && docObj[k] != null) inp.value = String(docObj[k]);
            });
            reindex();
            recalcFooter();
            syncHiddens();
            if (h.id) setSoFormToUpdate(h.id);
        }
        function esc(s) { if (s == null) return ""; return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;"); }
        function chMap() { const m = {}; (schemaCharges || []).forEach(function (c) { m[c.id] = c; }); return m; }
        function parseIds(s) { if (!s) return []; return s.split(",").map(function (x) { return parseInt(x, 10); }).filter(function (n) { return n > 0; }); }
        function selectedItemChgOrder() {
            var s = new Set();
            document.querySelectorAll("#soItemChargeMenu .so-m-item-chk:checked").forEach(function (x) { s.add(parseInt(x.getAttribute("data-cid"), 10)); });
            return (schemaCharges || []).map(function (c) { return c.id; }).filter(function (id) { return s.has(id); });
        }
        function selectedQuotChgOrder() {
            var s = new Set();
            document.querySelectorAll("#soQuotationChargeMenu .so-m-doc-chk:checked").forEach(function (x) { s.add(parseInt(x.getAttribute("data-cid"), 10)); });
            return (schemaCharges || []).map(function (c) { return c.id; }).filter(function (id) { return s.has(id); });
        }
        function syncHiddens() {
            var a = selectedItemChgOrder();
            var b = selectedQuotChgOrder();
            var h1 = document.getElementById("soItemChargeColumnIds"), h2 = document.getElementById("soQuotationLevelChargeIds");
            if (h1) h1.value = a.join(",");
            if (h2) h2.value = b.join(",");
            var o = {};
            b.forEach(function (cid) {
                var el = document.querySelector(".so-doc-chg-val[data-cid=\"" + cid + "\"]");
                if (el && el.value !== "") o[String(cid)] = el.value;
            });
            var hj = document.getElementById("soQuotationChargeValuesJson");
            if (hj) hj.value = Object.keys(o).length ? JSON.stringify(o) : "";
            var plantSel = document.getElementById("soPlant");
            var dcSel = document.getElementById("soDc");
            var schemaSel = document.getElementById("soSchema");
            var plantHidden = document.getElementById("soPlantHidden");
            var dcHidden = document.getElementById("soDcHidden");
            var schemaHidden = document.getElementById("soSchemaHidden");
            if (plantHidden) plantHidden.value = plantSel ? (plantSel.value || "") : "";
            if (dcHidden) dcHidden.value = dcSel ? (dcSel.value || "") : "";
            if (schemaHidden) schemaHidden.value = schemaSel ? (schemaSel.value || "") : "";
        }
        function readLineValObj(tr) {
            var o = {};
            tr.querySelectorAll(".so-ln-chg").forEach(function (inp) {
                var id = parseInt(inp.getAttribute("data-cid"), 10);
                if (id > 0 && inp.value !== "") o[String(id)] = inp.value;
            });
            return o;
        }
        function syncLineJson(tr) {
            var h = tr.querySelector(".so-line-chg-json");
            if (h) h.value = JSON.stringify(readLineValObj(tr));
        }
        function applyUserCharge(c, running, uval) {
            if (c.valueType === "Numeric") {
                var abs = Math.abs(parseFloat(uval) || 0);
                return c.sign === "Add" ? running + abs : running - abs;
            }
            var pct = Math.max(0, parseFloat(uval) || 0);
            var delta = Math.round(running * (pct / 100) * 10000) / 10000;
            return c.sign === "Add" ? running + delta : running - delta;
        }
        function effPct(c, o, idStr) { if (o.hasOwnProperty(idStr) && o[idStr] !== "") return parseFloat(o[idStr]) || 0; if (c.defaultPercent != null) return c.defaultPercent; return 0; }
        function effNum(o, idStr) { if (o.hasOwnProperty(idStr) && o[idStr] !== "") return Math.abs(parseFloat(o[idStr]) || 0); return 0; }
        function lineAmountsV2(qty, unit, o) {
            o = o || {};
            var hasSch = (schemaCharges || []).length > 0;
            var baseLine = Math.round((qty * unit) * 10000) / 10000;
            if (!hasSch) return { sub: baseLine, tot: baseLine };
            var running = baseLine, order = selectedItemChgOrder();
            order.forEach(function (cid) {
                var c = chMap()[cid];
                if (!c) return;
                var idStr = String(cid);
                if (c.valueType === "Percentage") {
                    var p = effPct(c, o, idStr);
                    if (p === 0) return;
                    running = applyUserCharge(c, running, p);
                } else {
                    var n = effNum(o, idStr);
                    if (n === 0) return;
                    running = applyUserCharge(c, running, n);
                }
            });
            return { sub: baseLine, tot: Math.round(running * 10000) / 10000 };
        }
        function recalcLine(tr) {
            var qty = parseFloat(tr.querySelector(".so-qty") && tr.querySelector(".so-qty").value) || 0;
            var unit = parseFloat(tr.querySelector(".so-unit") && tr.querySelector(".so-unit").value) || 0;
            var o = readLineValObj(tr);
            var a = lineAmountsV2(qty, unit, o);
            var ns = tr.querySelector(".so-net"), lt = tr.querySelector(".so-line-tot");
            if (ns) ns.value = a.sub.toFixed(2);
            if (lt) lt.value = a.tot.toFixed(2);
            tr.setAttribute("data-line-sub", a.sub);
            tr.setAttribute("data-line-tot", a.tot);
            syncLineJson(tr);
            recalcFooter();
        }
        function recalcFooter() {
            var lineSum = 0;
            document.querySelectorAll("tr.so-item-row").forEach(function (tr) {
                lineSum += parseFloat(tr.getAttribute("data-line-tot") || 0) || 0;
            });
            var run = lineSum, qOrder = selectedQuotChgOrder();
            qOrder.forEach(function (cid) {
                var c = chMap()[cid], el = document.querySelector(".so-doc-chg-val[data-cid=\"" + cid + "\"]");
                if (!c) return;
                var raw = el ? el.value : "";
                if (c.valueType === "Percentage") {
                    var p = (raw !== "") ? (parseFloat(raw) || 0) : (c.defaultPercent != null ? c.defaultPercent : 0);
                    if (p === 0) return;
                    run = applyUserCharge(c, run, p);
                } else {
                    var n = (raw !== "") ? Math.abs(parseFloat(raw) || 0) : 0;
                    if (n === 0) return;
                    run = applyUserCharge(c, run, n);
                }
            });
            run = Math.round(run * 10000) / 10000;
            var elS = document.getElementById("soSumSub"), elG = document.getElementById("soSumGrand");
            if (elS) elS.value = lineSum.toFixed(2);
            if (elG) elG.value = run.toFixed(2);
            syncHiddens();
        }
        function renderItemChargeThead() {
            var row = document.getElementById("soItemsHeadRow");
            if (!row) return;
            row.querySelectorAll("th.so-dyn-chg-th").forEach(function (n) { n.remove(); });
            var before = document.getElementById("soThLineTotal");
            if (!before) return;
            selectedItemChgOrder().forEach(function (cid) {
                var c = chMap()[cid];
                if (!c) return;
                var th = document.createElement("th");
                th.className = "text-end small so-dyn-chg-th";
                var label = (c.symbol || "") + (c.description ? (" — " + c.description) : "");
                th.textContent = label + (c.valueType === "Numeric" ? " (amt)" : " (%)");
                th.title = label;
                before.parentNode.insertBefore(th, before);
            });
        }
        function appendItemChargeTds(tr) {
            tr.querySelectorAll("td.so-dyn-chg-td").forEach(function (n) { n.remove(); });
            var before = tr.querySelector(".so-td-linetot");
            if (!before) return;
            selectedItemChgOrder().forEach(function (cid) {
                var c = chMap()[cid];
                if (!c) return;
                var td = document.createElement("td");
                td.className = "so-dyn-chg-td";
                var inp = document.createElement("input");
                inp.type = "number";
                inp.className = "form-control form-control-sm so-ln-chg";
                inp.setAttribute("data-cid", String(cid));
                inp.style.maxWidth = "5.2rem";
                if (c.valueType === "Percentage" && c.defaultPercent != null) inp.placeholder = String(c.defaultPercent);
                if (c.valueType === "Numeric") inp.setAttribute("step", "0.01");
                else inp.setAttribute("step", "0.0001");
                td.appendChild(inp);
                before.parentNode.insertBefore(td, before);
            });
        }
        function buildChargeDropdowns() {
            var mItem = document.getElementById("soItemChargeMenu"), mDoc = document.getElementById("soQuotationChargeMenu");
            var row = document.getElementById("soChargeSelectRow");
            if (!mItem || !mDoc) return;
            mItem.innerHTML = ""; mDoc.innerHTML = "";
            if (!schemaCharges || !schemaCharges.length) { if (row) row.classList.add("d-none"); return; }
            if (row) row.classList.remove("d-none");
            (schemaCharges || []).forEach(function (c) {
                var li = document.createElement("li");
                li.className = "form-check";
                li.innerHTML = "<label class=\"d-flex align-items-center gap-1 small text-nowrap py-0\" title=\"" + esc((c.symbol || '') + (c.description ? (' — ' + c.description) : '')) + "\"><input type=\"checkbox\" class=\"form-check-input so-m-item-chk\" data-cid=\"" + c.id + "\" />" + esc(c.symbol || "") + (c.description ? (" <span class=\"text-muted\">" + esc(c.description) + "</span>") : "") + "</label>";
                mItem.appendChild(li);
            });
            (schemaCharges || []).forEach(function (c) {
                var li = document.createElement("li");
                li.className = "form-check";
                li.innerHTML = "<label class=\"d-flex align-items-center gap-1 small text-nowrap py-0\" title=\"" + esc((c.symbol || '') + (c.description ? (' — ' + c.description) : '')) + "\"><input type=\"checkbox\" class=\"form-check-input so-m-doc-chk\" data-cid=\"" + c.id + "\" />" + esc(c.symbol || "") + (c.description ? (" <span class=\"text-muted\">" + esc(c.description) + "</span>") : "") + "</label>";
                mDoc.appendChild(li);
            });
            mItem.querySelectorAll(".so-m-item-chk").forEach(function (cb) {
                cb.addEventListener("change", function () { renderItemChargeThead(); document.querySelectorAll("tr.so-item-row").forEach(function (tr) { appendItemChargeTds(tr); reindex(); recalcLine(tr); }); });
            });
            mDoc.querySelectorAll(".so-m-doc-chk").forEach(function (cb) {
                cb.addEventListener("change", function () { buildQuotationChargeInputs(); recalcFooter(); });
            });
