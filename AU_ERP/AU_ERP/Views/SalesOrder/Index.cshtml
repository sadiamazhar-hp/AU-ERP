@model AU_ERP.Models.ViewModels.SalesOrderListVm
@using System.Globalization
@using AU_ERP.Models
@using AU_ERP.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sales Order";
    ViewBag.Title = "Sales Order";
    int? openEditId = ViewBag.OpenEditId as int?;
    var list = Model?.Items ?? new List<SalesOrder>();
    var plants = ViewBag.Plants as List<PlantsSample> ?? new List<PlantsSample>();
    var chans = ViewBag.DistributionChannels as List<DistributionChannel> ?? new List<DistributionChannel>();
    var customers = ViewBag.Customers as List<BusinessPartnerMasterSample> ?? new List<BusinessPartnerMasterSample>();
    var schemas = ViewBag.ConfigurationSchemas as List<ConfigurationSchema> ?? new List<ConfigurationSchema>();
    var today = DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var twoWeeks = DateTime.Today.AddDays(14).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var firstPlant = plants.FirstOrDefault()?.PlantID ?? "";
    var firstChan = chans.FirstOrDefault()?.DistributionChannelID;
    string FmtDate(DateTime d) => d.ToString("dd-MMM-yyyy", CultureInfo.InvariantCulture);
    var listQ = Model?.Q ?? "";
    var listStatus = (Model == null || string.IsNullOrWhiteSpace(Model.Status) || string.Equals(Model.Status, "All", StringComparison.OrdinalIgnoreCase)) ? "All" : Model.Status;
    var listPlantId = Model?.PlantId ?? "";
    int? listDcId = Model?.DistributionChannelId;
    var stSel = listStatus;
    var soDetailsModalUrlPlaceholder = Url.Action("DetailsModal", "SalesOrder", new { id = 900000001 }) ?? "";
    var walkInSchemaId = ViewBag.WalkInSchemaId as int? ?? 0;
    var isEmporiumWalkIn = ViewBag.IsEmporiumWalkInUser as bool? == true;
    string SoBadgeClass(string? ws)
    {
        if (string.IsNullOrEmpty(ws) || string.Equals(ws, SalesOrderWorkflowStatus.Open, StringComparison.OrdinalIgnoreCase))
            return "so-badge-open";
        if (string.Equals(ws, SalesOrderWorkflowStatus.Completed, StringComparison.OrdinalIgnoreCase))
            return "so-badge-completed";
        if (string.Equals(ws, SalesOrderWorkflowStatus.PendingStock, StringComparison.OrdinalIgnoreCase))
            return "so-badge-pending-stock";
        if (string.Equals(ws, SalesOrderWorkflowStatus.PendingGoodReceive, StringComparison.OrdinalIgnoreCase))
            return "so-badge-pending-gr";
        if (string.Equals(ws, SalesOrderWorkflowStatus.PendingDc, StringComparison.OrdinalIgnoreCase))
            return "so-badge-pending-dc";
        if (string.Equals(ws, SalesOrderWorkflowStatus.DeliveryInProcess, StringComparison.OrdinalIgnoreCase))
            return "so-badge-delivery";
        if (string.Equals(ws, SalesOrderWorkflowStatus.PendingPayment, StringComparison.OrdinalIgnoreCase))
            return "so-badge-pending-pay";
        return "so-badge-confirmed";
    }
}

@section Styles {
<style>
    .so-page { color: var(--text, #32363a); }
    .so-page .so-hero { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
    .so-page .so-hero h1 { font-size: 1.35rem; font-weight: 600; color: var(--dark, #354a5e); margin: 0 0 .25rem 0; }
    .so-page .so-hero p { margin: 0; color: var(--subtle, #6a7c8e); font-size: .9rem; }
    .so-btn-new { background: var(--blue, #0070f2); color: #fff; border: 1px solid var(--blue, #0070f2); border-radius: 4px; padding: .45rem 1rem; font-size: .875rem; font-weight: 500; }
    .so-btn-new:hover { filter: brightness(1.05); color: #fff; }
    .so-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: .75rem; margin-bottom: 1.25rem; }
    .so-stat-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: .85rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,.12); border-top: 3px solid var(--blue, #0070f2); }
    .so-stat-card .so-stat-label { font-size: .72rem; font-weight: 600; letter-spacing: .04em; color: var(--subtle, #6a7c8e); text-transform: uppercase; }
    .so-stat-card .so-stat-val { font-size: 1.65rem; font-weight: 600; color: var(--dark, #354a5e); line-height: 1.2; margin-top: .2rem; }
    .so-table-card { background: #fff; border: 1px solid var(--border, #d9d9d9); border-radius: 4px; padding: 1rem 1.1rem; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
    .so-table-card .so-table-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: .75rem; }
    .so-table-card .so-table-title { font-size: 1rem; font-weight: 600; color: var(--dark, #354a5e); margin: 0; }
    .so-table-card .so-toolbar { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
    .so-table-card .so-toolbar .form-control-sm { min-width: 10rem; }
    .so-table-wrap { overflow-x: auto; }
    .so-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .so-table thead th { background: var(--dark, #354a5e); color: #fff; font-weight: 500; padding: .55rem .65rem; text-align: left; white-space: nowrap; }
    .so-table tbody td { border: 1px solid #ddd; padding: .45rem .6rem; vertical-align: middle; }
    .so-table tbody tr:nth-child(even) { background: #fafafa; }
    .so-badge { display: inline-block; padding: .2rem .55rem; border-radius: 999px; font-size: .75rem; font-weight: 500; }
    .so-badge-open { background: #e2e3e5; color: #41464b; }
    .so-badge-confirmed { background: #d1e7dd; color: #0f5132; }
    .so-badge-pending-stock { background: #f8d7da; color: #842029; }
    .so-badge-pending-gr { background: #fff3cd; color: #664d03; }
    .so-badge-pending-dc { background: #cff4fc; color: #055160; }
    .so-badge-delivery { background: #e7f1ff; color: #084298; }
    .so-badge-pending-pay { background: #ffe5d0; color: #984c0c; }
    .so-badge-completed { background: #d1e7dd; color: #0f5132; }
    .so-actions { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; }
    .so-actions .btn { font-size: .75rem; padding: .2rem .5rem; }
</style>
}

<style>
    .bom-mat-picker { position: relative; }
    .bom-mat-picker-dropdown {
        display: none; position: absolute; left: 0; right: 0; top: 100%; margin-top: 2px;
        max-height: 220px; overflow-y: auto; z-index: 1060; background: #fff; border: 1px solid #ccc;
        border-radius: 2px; box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .bom-mat-picker-dropdown.show { display: block; }
    .bom-mat-picker-item { padding: 6px 10px; font-size: .78rem; cursor: pointer; border-bottom: 1px solid #eee; }
    .bom-mat-picker-item:hover { background: var(--sap-selected, #b3d7ff); }
    .bom-mat-picker-empty { padding: 8px 10px; font-size: .75rem; color: #666; }
    .so-customer-combo .so-customer-dropdown { font-size: .82rem; }
    .so-customer-item { cursor: pointer; }
    .so-customer-item:hover, .so-customer-item:focus { background: var(--sap-selected, #b3d7ff); outline: none; }
    .so-quot-combo .so-customer-dropdown { font-size: .82rem; }
    .so-quot-combo .so-customer-dropdown { font-size: .82rem; }
    .so-line-charges { display: flex; flex-wrap: wrap; gap: 0.35rem; max-width: 14rem; font-size: .68rem; line-height: 1.2; }
    .so-line-charges label { margin: 0; white-space: nowrap; }
    .so-doc-charges { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: .75rem; }
    .so-summary { min-width: 16rem; border: 1px solid #dee2e6; border-radius: 4px; padding: 0.75rem 1rem; background: #fafafa; }
    .so-summary .so-grand { color: #0d6efd; font-weight: 600; border-top: 1px solid #dee2e6; margin-top: 0.35rem; padding-top: 0.35rem; }
    .so-items-table-wrap { overflow-x: auto; min-width: 0; }
    .so-items-table { font-size: .78rem; white-space: nowrap; }
    .so-items-table th, .so-items-table td { vertical-align: middle; }
    .so-chg-menu { max-height: 240px; overflow-y: auto; }
    #addSalesOrderModal.so-order-modal .modal-dialog {
        max-height: calc(100vh - 1rem);
        margin: 0.5rem auto;
    }
    #addSalesOrderModal.so-order-modal .modal-content {
        max-height: calc(100vh - 1rem);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    #addSalesOrderModal.so-order-modal .modal-body {
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        min-height: 0;
        flex: 1 1 auto;
    }
    .btn-so-so { background: #354E68; border-color: #354E68; color: #fff; }
    .btn-so-so:hover, .btn-so-so:focus { background: #2a3d52; border-color: #2a3d52; color: #fff; }
</style>

<div class="so-page">
    <div class="so-hero">
        <div>
            <h1>Sales Order</h1>
            <p>Customer orders, confirmed from quotation or created manually.</p>
        </div>
        <button type="button" class="so-btn-new" data-bs-toggle="modal" data-bs-target="#addSalesOrderModal">
            <i class="bi bi-plus-lg"></i> New order
        </button>
    </div>

    <div class="so-stats" role="group" aria-label="Sales order status summary">
        @{
            var statCards = new (string Label, int Count, string Value)[]
            {
                (SalesOrderWorkflowStatus.Open, Model?.CountOpen ?? 0, SalesOrderWorkflowStatus.Open),
                (SalesOrderWorkflowStatus.PendingStock, Model?.CountPendingStock ?? 0, SalesOrderWorkflowStatus.PendingStock),
                (SalesOrderWorkflowStatus.PendingGoodReceive, Model?.CountPendingGoodReceive ?? 0, SalesOrderWorkflowStatus.PendingGoodReceive),
                (SalesOrderWorkflowStatus.PendingDc, Model?.CountPendingDc ?? 0, SalesOrderWorkflowStatus.PendingDc),
                (SalesOrderWorkflowStatus.DeliveryInProcess, Model?.CountDeliveryInProcess ?? 0, SalesOrderWorkflowStatus.DeliveryInProcess),
                (SalesOrderWorkflowStatus.PendingPayment, Model?.CountPendingPayment ?? 0, SalesOrderWorkflowStatus.PendingPayment),
                (SalesOrderWorkflowStatus.Completed, Model?.CountCompleted ?? 0, SalesOrderWorkflowStatus.Completed)
            };
        }
        @foreach (var card in statCards)
        {
            <div class="so-stat-card">
                <div class="so-stat-label">@card.Label</div>
                <div class="so-stat-val">@card.Count</div>
            </div>
        }
    </div>

    @if (TempData["OrderMessage"] is string okMsg2)
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@okMsg2</div>
    }
    @if (TempData["OrderError"] is string errMsg2)
    {
        <div class="alert alert-danger py-2 small mb-3" role="status">@errMsg2</div>
    }
    @if (TempData["OrderWarning"] is string warnMsg2)
    {
        <div class="alert alert-warning py-2 small mb-3" role="status">@warnMsg2</div>
    }

    <div class="so-table-card">
        <div class="so-table-head">
            <h2 class="so-table-title">Sales orders (@list.Count)</h2>
            <form id="soListFilterForm" method="get" asp-controller="SalesOrder" asp-action="Index" class="so-toolbar">
                <input type="search" name="q" id="soListQ" class="form-control form-control-sm" placeholder="Order # or customer…" value="@listQ" />
                <input type="hidden" name="status" id="soListStatus" value="@stSel" />
                <input type="hidden" name="plantId" id="soListPlant" value="@listPlantId" />
                <input type="hidden" name="distributionChannelId" id="soListDc" value="@(listDcId?.ToString() ?? "")" />
                @if (openEditId is int eid)
                {
                    <input type="hidden" name="editId" value="@eid" />
                }
                <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#salesOrderFilterModal">Filter</button>
                <a class="btn btn-sm btn-link text-secondary" asp-action="Index">Clear</a>
            </form>
        </div>
        <div class="so-table-wrap">
            <table class="so-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Quotation</th>
                        <th>Plant</th>
                        <th>Distribution channel</th>
                        <th>Customer (sold-to)</th>
                        <th>Order date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (list.Count == 0)
                {
                    <tr><td colspan="8" class="text-secondary">No sales orders yet.</td></tr>
                }
                else foreach (var o in list)
                {
                    var isOpen = o.Status == SalesOrder.StatusOpen;
                    var deleteConfirm = "Delete this open order?";
                    var hasDc = Model?.SalesOrderIdsWithChallan?.Contains(o.Id) ?? false;
                    var giStatus = Model?.SalesOrderGiStatusById != null && Model.SalesOrderGiStatusById.TryGetValue(o.Id, out var stGi)
                        ? (stGi ?? "")
                        : "";
                    var giPending = string.Equals(giStatus, SalesGoodsIssueDocument.StatusPending, StringComparison.OrdinalIgnoreCase);
                    var giReceived = string.Equals(giStatus, SalesGoodsIssueDocument.StatusReceived, StringComparison.OrdinalIgnoreCase);
                    var giDisp = Model?.SalesOrderGiDispatchStatusById != null && Model.SalesOrderGiDispatchStatusById.TryGetValue(o.Id, out var gdsv)
                        ? (gdsv ?? "")
                        : "";
                    var giDispatchSent = string.Equals(giDisp, SalesGoodsIssueDocument.DispatchSent, StringComparison.OrdinalIgnoreCase);
                    var giDocNum = Model?.SalesOrderGiDocumentNumberById != null && Model.SalesOrderGiDocumentNumberById.TryGetValue(o.Id, out var gdnum)
                        ? gdnum
                        : null;
                    var hasGiRow = !string.IsNullOrEmpty(giDocNum) || (Model?.SalesOrderGiDocIdByOrderId?.ContainsKey(o.Id) ?? false);
                    var dcFleet = Model?.DeliveryChallanBySalesOrderId != null && Model.DeliveryChallanBySalesOrderId.TryGetValue(o.Id, out var dcAct)
                        ? dcAct
                        : null;
                    <tr>
                        <td class="text-nowrap">
                            <strong>@o.SalesOrderNumber</strong>
                            @if (!isOpen && hasGiRow && !string.IsNullOrEmpty(giDocNum))
                            {
                                <div class="small text-secondary">GI @giDocNum <span class="text-muted">(@giDisp)</span></div>
                            }
                        </td>
                        <td class="text-nowrap">@(o.SalesQuotation?.QuotationNumber ?? "—")</td>
                        <td>@(o.Plant?.PlantName ?? "—")</td>
                        <td>@(o.DistributionChannel?.DistributionChannelName ?? "—")</td>
                        <td>@(o.CustomerName ?? "—")</td>
                        <td class="text-nowrap">@FmtDate(o.OrderDate)</td>
                        <td>
                            @{
                                var wfStatus = Model?.WorkflowStatusById != null && Model.WorkflowStatusById.TryGetValue(o.Id, out var wsVal)
                                    ? wsVal
                                    : (isOpen ? SalesOrderWorkflowStatus.Open : SalesOrderWorkflowStatus.PendingStock);
                            }
                            <span class="so-badge @SoBadgeClass(wfStatus)">@wfStatus</span>
                        </td>
                        <td>
                            <div class="so-actions">
                                @if (isOpen)
                                {
                                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "SalesOrder", new { editId = o.Id, q = listQ, status = listStatus, plantId = string.IsNullOrEmpty(listPlantId) ? null : listPlantId, distributionChannelId = listDcId })" title="Edit"><i class="bi bi-pencil"></i> Edit</a>
                                }
                                @if (!isOpen)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm so-btn-view" data-so-id="@o.Id" title="View"><i class="bi bi-eye"></i> View</button>
                                }
                                @if (!isOpen)
                                {
                                    if (giReceived)
                                    {
                                        if (!hasDc)
                                        {
                                            <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Index", "DeliveryChallan", new { fromSalesOrderId = o.Id })" title="Create delivery challan from this order"><i class="bi bi-truck"></i> DC</a>
                                        }
                                        else if (dcFleet != null)
                                        {
                                            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "DeliveryChallan", new { q = dcFleet.DeliveryChallanNumber })" title="Open delivery challan @dcFleet.DeliveryChallanNumber"><i class="bi bi-truck"></i> DC</a>
                                            if (dcFleet.CanMarkDeliveryCompleted)
                                            {
                                                <form asp-controller="DeliveryChallan" asp-action="MarkDeliveryCompleted" method="post" class="d-inline" onsubmit="return confirm('Mark delivery completed and free the driver / vehicle?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@dcFleet.DeliveryChallanId" />
                                                    <input type="hidden" name="returnTo" value="salesorder" />
                                                    <input type="hidden" name="returnQ" value="@listQ" />
                                                    <input type="hidden" name="returnStatus" value="@listStatus" />
                                                    <input type="hidden" name="returnPlantId" value="@listPlantId" />
                                                    <input type="hidden" name="returnDistributionChannelId" value="@(listDcId?.ToString() ?? "")" />
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Releases fleet for other challans"><i class="bi bi-check2-circle"></i> Delivery completed</button>
                                                </form>
                                            }
                                        }
                                    }
                                    else if (giPending && giDispatchSent)
                                    {
                                        <form asp-action="GoodsReceive" asp-controller="SalesOrder" asp-route-id="@o.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnQ" value="@listQ" />
                                            <input type="hidden" name="returnStatus" value="@listStatus" />
                                            <input type="hidden" name="returnPlantId" value="@listPlantId" />
                                            <input type="hidden" name="returnDistributionChannelId" value="@(listDcId?.ToString() ?? "")" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm" title="Receive sales goods issue"><i class="bi bi-box-seam"></i> Goods Receive</button>
                                        </form>
                                    }
                                    else if (giPending && !giDispatchSent && hasGiRow)
                                    {
                                        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "StockGoodsIssue", new { salesOrderId = o.Id })" title="Send goods from Stock Goods Issue before receiving"><i class="bi bi-send"></i> Open GI</a>
                                        <button type="button" class="btn btn-outline-warning btn-sm" disabled title="Send goods from Stock Goods Issue first"><i class="bi bi-box-seam"></i> Goods Receive</button>
                                    }
                                    else
                                    {
                                        <form asp-action="CreateOrOpenGoodsIssue" asp-controller="SalesOrder" asp-route-id="@o.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnQ" value="@listQ" />
                                            <input type="hidden" name="returnStatus" value="@listStatus" />
                                            <input type="hidden" name="returnPlantId" value="@listPlantId" />
                                            <input type="hidden" name="returnDistributionChannelId" value="@(listDcId?.ToString() ?? "")" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm" title="Create sales goods issue"><i class="bi bi-box-arrow-in-right"></i> Goods Issue</button>
                                        </form>
                                    }
                                }
                                <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("DownloadPdf", "SalesOrder", new { id = o.Id })" title="Download order as PDF"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                                @if (isOpen)
                                {
                                    <form asp-action="Delete" asp-controller="SalesOrder" asp-route-id="@o.Id" method="post" class="d-inline" onsubmit="return confirm('@deleteConfirm');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnQ" value="@listQ" />
                                        <input type="hidden" name="returnStatus" value="@listStatus" />
                                        <input type="hidden" name="returnPlantId" value="@listPlantId" />
                                        <input type="hidden" name="returnDistributionChannelId" value="@(listDcId?.ToString() ?? "")" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"><i class="bi bi-trash"></i> Delete</button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Only open orders can be deleted"><i class="bi bi-trash"></i> Delete</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="salesOrderFilterModal" tabindex="-1" aria-labelledby="salesOrderFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="salesOrderFilterModalLabel">Filter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">Status</label>
                    <select id="soModStatus" class="form-select form-select-sm">
                        <option value="All">All</option>
                        <option value="@SalesOrderWorkflowStatus.Open">@SalesOrderWorkflowStatus.Open</option>
                        <option value="@SalesOrder.StatusConfirmed">Confirmed (all post-open)</option>
                        @foreach (var ws in SalesOrderWorkflowStatus.ConfirmedWorkflowStatuses)
                        {
                            <option value="@ws">@ws</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Plant</label>
                    <select id="soModPlant" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var p in plants)
                        {
                            <option value="@p.PlantID">@p.PlantName</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Distribution channel</label>
                    <select id="soModDc" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var ch in chans)
                        {
                            <option value="@ch.DistributionChannelID">@ch.DistributionChannelName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm so-btn-new" onclick="soApplyFilterModal()">Apply</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addSalesOrderModal" tabindex="-1" aria-labelledby="soModalTitle" aria-hidden="true" data-so-action-create="@Url.Action("Create", "SalesOrder")" data-so-action-update-tpl="@Url.Action("Update", "SalesOrder", new { id = 0 })">
    <div class="modal-dialog modal-xl so-order-modal">
        <div class="modal-content">
            <form asp-action="Create" asp-controller="SalesOrder" method="post" id="soForm" data-so-form-mode="create" data-au-prevent-enter-submit>
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnQ" id="soReturnQ" value="@listQ" />
                <input type="hidden" name="ReturnStatus" id="soReturnStatus" value="@listStatus" />
                <input type="hidden" name="ReturnPlantId" id="soReturnPlantId" value="@listPlantId" />
                <input type="hidden" name="ReturnDistributionChannelId" id="soReturnDcId" value="@(listDcId?.ToString() ?? "")" />
                <input type="hidden" name="QuotationLevelChargeIds" id="soQuotationLevelChargeIds" value="" />
                <input type="hidden" name="ItemChargeColumnIds" id="soItemChargeColumnIds" value="" />
                <input type="hidden" name="QuotationChargeValuesJson" id="soQuotationChargeValuesJson" value="" />
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="soModalTitle">New sales order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="soNum">Order number</label>
                            <input class="form-control form-control-sm" id="soNum" readonly style="background:#f0f0f0;" autocomplete="off" />
                        </div>
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="soPlant">Plant <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" id="soPlant" required disabled>
                                <option value="">— Select —</option>
                                @foreach (var p in plants)
                                {
                                    <option value="@p.PlantID">@p.PlantName</option>
                                }
                            </select>
                            <input type="hidden" name="PlantId" id="soPlantHidden" />
                        </div>
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="soDc">Distribution channel <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" id="soDc" required disabled>
                                <option value="">— Select —</option>
                                @foreach (var ch in chans)
                                {
                                    <option value="@ch.DistributionChannelID">@ch.DistributionChannelName</option>
                                }
                            </select>
                            <input type="hidden" name="DistributionChannelId" id="soDcHidden" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small mb-0" for="soSalesQuotationSearch">Sales quotation (optional)</label>
                            <input type="hidden" name="SalesQuotationId" id="soSalesQuotationIdHidden" value="" autocomplete="off" />
                            <div class="so-quot-combo position-relative mt-1">
                                <input type="text" class="form-control form-control-sm" id="soSalesQuotationSearch" placeholder="Type quotation # or customer — pick from list…" autocomplete="off" />
                                <div id="soQuotationDropdown" class="so-customer-dropdown border rounded bg-white shadow-sm" style="display: none;" role="listbox"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-0" for="soCustomerSearch">Customer (Sold to party) <span class="text-danger">*</span></label>
                            <input type="hidden" name="CustomerBusinessPartnerId" id="soCustomer" value="" required autocomplete="off" />
                            @if (isEmporiumWalkIn)
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2 border rounded px-2 py-2 bg-light mt-1">
                                    <span class="text-secondary small flex-grow-1" id="soWalkInCustomerSummary" style="min-height:1.35rem;">No customer selected.</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" id="soOpenWalkInCustomerBtn">Add customer</button>
                                </div>
                            }
                            <select id="soCustomerCatalog" class="d-none" aria-hidden="true" tabindex="-1">
                                <option value="">— Select —</option>
                                @foreach (var c in customers)
                                {
                                    var ship = string.Join(", ", new[] { c.HouseNo, c.Street, c.City, c.PostalCode, c.Country }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                    <option value="@c.BPID" data-ship="@ship">@(c.FullName ?? c.BPID)</option>
                                }
                            </select>
                            <div class="so-customer-combo position-relative@(isEmporiumWalkIn ? " mt-2" : " mt-1")">
                                <input type="text" class="form-control form-control-sm" id="soCustomerSearch" placeholder="Search customer (name, ID, address)…" autocomplete="off" />
                                <div id="soCustomerDropdown" class="so-customer-dropdown border rounded bg-white shadow-sm" style="display: none;" role="listbox"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-0" for="soAddr">Address (Ship to party) <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" name="ShipToAddress" id="soAddr" type="text" maxlength="1000" autocomplete="street-address" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-6 col-md-4 col-lg-2">
                            <label class="form-label small mb-0" for="soQd">Order date <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" type="date" name="OrderDate" id="soQd" value="@today" required />
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <label class="form-label small mb-0" for="soVd">Requested delivery <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" type="date" name="RequestedDeliveryDate" id="soVd" value="@twoWeeks" required />
                        </div>
                        <div class="col-12 col-md-4 col-lg-3">
                            <label class="form-label small mb-0" for="soSchema">Configuration schema <span class="text-danger">*</span></label>
                            @if (isEmporiumWalkIn && walkInSchemaId > 0)
                            {
                                <input type="text" class="form-control form-control-sm" id="soSchemaReadonlyLabel" readonly tabindex="-1" value="WalkIn" />
                                <select class="form-select form-select-sm d-none" id="soSchema" required disabled aria-hidden="true">
                                    <option value="">— Select —</option>
                                    @foreach (var s in schemas)
                                    {
                                        if (s.Id == walkInSchemaId)
                                        { <option value="@s.Id" selected>@s.Title</option> }
                                        else
                                        { <option value="@s.Id">@s.Title</option> }
                                    }
                                </select>
                                <input type="hidden" name="ConfigurationSchemaId" id="soSchemaHidden" value="@walkInSchemaId" />
                            }
                            else
                            {
                                <select class="form-select form-select-sm" id="soSchema" required disabled>
                                    <option value="">— Select —</option>
                                    @foreach (var s in schemas)
                                    {
                                        <option value="@s.Id">@s.Title</option>
                                    }
                                </select>
                                <input type="hidden" name="ConfigurationSchemaId" id="soSchemaHidden" />
                            }
                        </div>
                        <div class="col-12 col-lg-5" id="soChargeSelectRow">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small mb-0" for="soItemChgDropBtn">Item charges</label>
                                    <div class="dropdown w-100">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="soItemChgDropBtn">Select…</button>
                                        <ul class="dropdown-menu p-2 shadow so-chg-menu" id="soItemChargeMenu" onclick="event.stopPropagation();"></ul>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-0" for="soDocChgDropBtn">Order charges</label>
                                    <div class="dropdown w-100">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="soDocChgDropBtn">Select…</button>
                                        <ul class="dropdown-menu p-2 shadow so-chg-menu" id="soQuotationChargeMenu" onclick="event.stopPropagation();"></ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h6 class="border-bottom pb-1 mb-2 small">Line items</h6>
                    <div class="so-items-table-wrap">
                        <table class="table table-sm table-bordered so-items-table mb-2">
                            <thead class="table-light">
                                <tr id="soItemsHeadRow">
                                    <th>#</th>
                                    <th>Item</th>
                                    <th>Description</th>
                                    <th>UOM</th>
                                    <th>Grade</th>
                                    <th>Qty</th>
                                    <th>Unit price</th>
                                    <th class="text-end">Net Price</th>
                                    <th class="text-end" id="soThLineTotal">Line total (PKR)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="soItemsBody"></tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="btnSoAddRow">+ Add Line</button>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <h6 class="border-bottom pb-1 mb-2 small">Order charge inputs</h6>
                            <div class="text-muted small" id="soDocChargeInputsHint">Select order charges above to enter amounts here.</div>
                            <div class="vstack gap-2 mt-2" id="soQuotationChargeInputs"></div>
                        </div>
                        <div class="col-lg-6 ms-lg-auto">
                            <div class="so-summary ms-lg-auto" style="max-width:20rem">
                                <div class="d-flex justify-content-between"><span>Subtotal (PKR)</span><input type="text" class="form-control form-control-sm text-end border-0 bg-transparent p-0" id="soSumSub" value="0.00" readonly style="max-width:8rem" aria-readonly="true" /></div>
                                <div class="d-flex justify-content-between so-grand align-items-center pt-1"><span>Grand total (PKR)</span><input type="text" class="form-control form-control-sm text-end border-0 p-0 fw-semibold text-primary" id="soSumGrand" value="0.00" readonly style="max-width:8rem" aria-readonly="true" /></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer flex-wrap gap-2 py-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-outline-primary btn-sm" name="SubmitAction" value="draft" formnovalidate><i class="bi bi-floppy me-1"></i>Save (open)</button>
                    <button type="submit" class="btn btn-primary btn-sm" name="SubmitAction" value="send"><i class="bi bi-check2-circle me-1"></i>Confirm order</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (isEmporiumWalkIn)
{
    <div class="modal fade walk-in-add-customer-modal" id="soWalkInAddCustomerModal" tabindex="-1" aria-labelledby="soWalkInAddCustomerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="soWalkInAddCustomerModalLabel">Add walk-in customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0 text-secondary" for="soWkFirst">First name</label>
                            <input class="form-control form-control-sm" id="soWkFirst" maxlength="120" autocomplete="given-name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0 text-secondary" for="soWkLast">Last name</label>
                            <input class="form-control form-control-sm" id="soWkLast" maxlength="120" autocomplete="family-name" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-0 text-secondary" for="soWkAddr">Address</label>
                            <input class="form-control form-control-sm" id="soWkAddr" maxlength="2000" autocomplete="street-address" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-0 text-secondary" for="soWkMobile">Mobile number</label>
                            <input class="form-control form-control-sm" id="soWkMobile" maxlength="80" inputmode="tel" autocomplete="tel" />
                        </div>
                    </div>
                    <span class="text-danger small d-block mt-2" id="soWkErr" style="display:none;"></span>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" id="soWkCreateBtn">Create customer</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="soViewModal" tabindex="-1" aria-labelledby="soViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="soViewModalLabel">Sales order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-2" id="soViewModalBody">
                <p class="text-secondary small mb-0">Loading…</p>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        (function ensureSoViewModalOnBody() {
            var el = document.getElementById("soViewModal");
            if (!el) return;
            function move() {
                if (el.parentElement !== document.body) document.body.appendChild(el);
            }
            el.addEventListener("show.bs.modal", move);
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", move);
            else move();
        })();
        const soDetailsModalUrlPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(soDetailsModalUrlPlaceholder));
        function soDetailsModalUrl(id) { return (soDetailsModalUrlPlaceholder || "").replace("900000001", id); }
        document.querySelectorAll(".so-btn-view").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var id = btn.getAttribute("data-so-id");
                if (!id) return;
                var body = document.getElementById("soViewModalBody");
                var m = document.getElementById("soViewModal");
                if (body) body.innerHTML = '<p class="text-secondary small mb-0">Loading…</p>';
                if (window.bootstrap) {
                    var addM = document.getElementById("addSalesOrderModal");
                    var fM = document.getElementById("salesOrderFilterModal");
                    if (addM && addM.classList.contains("show")) bootstrap.Modal.getOrCreateInstance(addM).hide();
                    if (fM && fM.classList.contains("show")) bootstrap.Modal.getOrCreateInstance(fM).hide();
                }
                if (m && window.bootstrap) { bootstrap.Modal.getOrCreateInstance(m).show(); }
                fetch(soDetailsModalUrl(id), { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.text(); })
                    .then(function (html) { if (body) body.innerHTML = html; })
                    .catch(function () { if (body) body.innerHTML = '<p class="text-danger small">Could not load details.</p>'; });
            });
        });
        const defaults = { today: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(today)), twoW: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(twoWeeks)) };
        const uomBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("MaterialUomContextForSalesOrder", "SalesOrder") ?? ""));
        const unitCostUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SalesOrderLineUnitCost", "SalesOrder") ?? ""));
        const soFertSearchBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SearchFertMaterialsForSalesOrder", "SalesOrder") ?? ""));
        const nextOrderUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("NextSalesOrderNumber", "SalesOrder") ?? ""));
        const schemaUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SchemaDetails", "SalesOrder") ?? ""));
        const soOrderDataBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("OrderData", "SalesOrder", new { id = 0 }) ?? ""));
        const soCustomerProfileUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("CustomerCommercialProfile", "SalesOrder") ?? ""));
        const soEmporiumWalkIn = @(isEmporiumWalkIn ? "true" : "false");
        const soWalkInSchemaId = @walkInSchemaId;
        const soCreateWalkInUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("CreateWalkInCustomer", "SalesOrder") ?? ""));
        (function ensureSoWalkInAddCustomerModalOnBody() {
            var el = document.getElementById("soWalkInAddCustomerModal");
            if (!el) return;
            function moveToBodyEnd() {
                document.body.appendChild(el);
            }
            function bumpZ() {
                el.style.setProperty("z-index", "100070", "important");
            }
            el.addEventListener("show.bs.modal", function () {
                moveToBodyEnd();
                requestAnimationFrame(bumpZ);
            });
            el.addEventListener("shown.bs.modal", bumpZ);
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", moveToBodyEnd);
            else moveToBodyEnd();
        })();
        function soWalkInCustomerModalGet() {
            var el = document.getElementById("soWalkInAddCustomerModal");
            if (!el || !window.bootstrap) return null;
            return bootstrap.Modal.getOrCreateInstance(el, { backdrop: false, keyboard: true });
        }
        function soUpdateWalkInCustomerSummary() {
            var sum = document.getElementById("soWalkInCustomerSummary");
            if (!sum) return;
            var valEl = document.getElementById("soCustomer");
            var cat = document.getElementById("soCustomerCatalog");
            var id = (valEl && valEl.value) || "";
            if (!id) { sum.textContent = "No customer selected."; return; }
            var label = id;
            if (cat) {
                for (var i = 0; i < cat.options.length; i++) {
                    if (cat.options[i].value === id) { label = (cat.options[i].textContent || "").trim() || id; break; }
                }
            }
            sum.textContent = label;
        }
        const soQuotationListUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("AvailableSalesQuotations", "SalesOrder") ?? ""));
        const soQuotationItemsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SalesQuotationItems", "SalesOrder") ?? ""));
        const soOpenEditId = @Html.Raw(openEditId is int oei ? oei.ToString() : "null");
        const soUpdateUrlTpl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Update", "SalesOrder", new { id = 0 }) ?? ""));
        const soCreateFormAction = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Create", "SalesOrder") ?? ""));
        let schemaCharges = [];
        let _soSkipFormReset = false;
        var _soQuotationCatalog = [];
        function soQuotationDisplayLabel(q) {
            if (!q) return "";
            return (q.quotationNumber || ("SQ-" + q.id)) + (q.customerName ? (" — " + q.customerName) : "");
        }
        function orderDataFor(quotationId) {
            if (!soOrderDataBase) return "";
            if (soOrderDataBase.indexOf("id=0") >= 0) return soOrderDataBase.replace("id=0", "id=" + quotationId);
            return soOrderDataBase.replace(/\/0(\?|$)/, "/" + quotationId + "$1");
        }
        function setSoFormToCreate() {
            var f = document.getElementById("soForm");
            if (f && soCreateFormAction) { f.action = soCreateFormAction; f.setAttribute("data-so-form-mode", "create"); }
        }
        function setSoFormToUpdate(quotationId) {
            var f = document.getElementById("soForm");
            if (!f) return;
            if (soUpdateUrlTpl) f.action = soUpdateUrlTpl.replace("Update/0", "Update/" + quotationId).replace(/\/0(\?.*)?$/, "/" + quotationId + "$1");
            f.setAttribute("data-so-form-mode", "update");
        }
        function applyOrderData(d) {
            var h = d.h, items = d.items || [];
            schemaCharges = d.schemaCharges || [];
            if (h.plantId && document.getElementById("soPlant")) document.getElementById("soPlant").value = h.plantId;
            if (h.distributionChannelId != null && document.getElementById("soDc")) document.getElementById("soDc").value = String(h.distributionChannelId);
            if (document.getElementById("soSchema")) {
                if (soEmporiumWalkIn && soWalkInSchemaId > 0) document.getElementById("soSchema").value = String(soWalkInSchemaId);
                else document.getElementById("soSchema").value = h.configurationSchemaId != null && h.configurationSchemaId !== "" ? String(h.configurationSchemaId) : "";
            }
            if (h.orderDate && document.getElementById("soQd")) document.getElementById("soQd").value = h.orderDate;
            if (h.requestedDeliveryDate && document.getElementById("soVd")) document.getElementById("soVd").value = h.requestedDeliveryDate;
            if (document.getElementById("soNum")) document.getElementById("soNum").value = h.salesOrderNumber || "";
            if (document.getElementById("soModalTitle")) document.getElementById("soModalTitle").textContent = "Edit — " + (h.salesOrderNumber || "");
            if (document.getElementById("soCustomer")) document.getElementById("soCustomer").value = h.customerBusinessPartnerId || "";
            soSyncCustomerSearchFromValue();
            soUpdateWalkInCustomerSummary();
            if (document.getElementById("soAddr")) document.getElementById("soAddr").value = h.shipToAddress || "";
            if (document.getElementById("soItemChargeColumnIds")) document.getElementById("soItemChargeColumnIds").value = h.itemChargeColumnIds || "";
            if (document.getElementById("soQuotationLevelChargeIds")) document.getElementById("soQuotationLevelChargeIds").value = h.quotationLevelChargeIds || "";
            if (document.getElementById("soQuotationChargeValuesJson")) document.getElementById("soQuotationChargeValuesJson").value = h.quotationChargeValuesJson || "";
            buildChargeDropdowns();
            var itemIds = parseIds(h.itemChargeColumnIds);
            var docIds = parseIds(h.quotationLevelChargeIds);
            document.querySelectorAll("#soItemChargeMenu .so-m-item-chk").forEach(function (cb) {
                var cid = parseInt(cb.getAttribute("data-cid"), 10);
                cb.checked = itemIds.indexOf(cid) >= 0;
            });
            document.querySelectorAll("#soQuotationChargeMenu .so-m-doc-chk").forEach(function (cb) {
                var cid = parseInt(cb.getAttribute("data-cid"), 10);
                cb.checked = docIds.indexOf(cid) >= 0;
            });
            renderItemChargeThead();
            var body = document.getElementById("soItemsBody");
            if (body) body.innerHTML = "";
            (items || []).forEach(function (it) {
                var tr = parseTrFromRowHtml();
                if (!body) return;
                body.appendChild(tr);
                reindex();
                if (it.materialNumber) {
                    if (tr.querySelector(".so-matno")) tr.querySelector(".so-matno").value = it.materialNumber;
                    if (tr.querySelector(".bom-mat-picker-search")) tr.querySelector(".bom-mat-picker-search").value = (it.materialNumber + (it.materialDescription ? " — " + it.materialDescription : ""));
                }
                if (tr.querySelector(".so-desc") && it.materialDescription) tr.querySelector(".so-desc").value = it.materialDescription;
                if (tr.querySelector(".so-grade") && (it.salesPriceGrade != null && it.salesPriceGrade !== "")) {
                    var gsv = String(it.salesPriceGrade);
                    if (gsv.toLowerCase() === "scrap") gsv = "A";
                    tr.querySelector(".so-grade").value = gsv;
                }
                if (tr.querySelector(".so-qty") && it.orderQuantity != null) tr.querySelector(".so-qty").value = String(it.orderQuantity);
                if (tr.querySelector(".so-unit") && it.unitPrice != null) tr.querySelector(".so-unit").value = String(it.unitPrice);
                if (tr.querySelector(".so-del") && it.deliveryDate) tr.querySelector(".so-del").value = it.deliveryDate;
                appendItemChargeTds(tr);
                reindex();
                var chObj = {};
                try { if (it.itemChargeValuesJson) chObj = JSON.parse(it.itemChargeValuesJson); } catch (e) { chObj = {}; }
                tr.querySelectorAll(".so-ln-chg").forEach(function (inp) {
                    var k = String(inp.getAttribute("data-cid"));
                    if (chObj.hasOwnProperty(k) && chObj[k] != null) inp.value = String(chObj[k]);
                });
                wireRow(tr);
                if (it.materialNumber) uomFill(tr, it.materialNumber, it.materialDescription || "", { preserveUnitPrice: it.unitPrice, savedUomId: it.quantityUomId });
            });
            if (!items.length) {
                if (body) { body.innerHTML = rowHtml().trim(); reindex(); renderItemChargeThead(); body.querySelectorAll("tr.so-item-row").forEach(function (tr) { tr.querySelector(".so-del") && (tr.querySelector(".so-del").value = document.getElementById("soQd") && document.getElementById("soQd").value || defaults.today); appendItemChargeTds(tr); }); reindex(); body.querySelectorAll("tr.so-item-row").forEach(wireRow); }
            }
            buildQuotationChargeInputs();
            var docObj = {};
            try { if (h.quotationChargeValuesJson) docObj = JSON.parse(h.quotationChargeValuesJson); } catch (e) { docObj = {}; }
            document.querySelectorAll(".so-doc-chg-val").forEach(function (inp) {
                var k = String(inp.getAttribute("data-cid"));
                if (docObj.hasOwnProperty(k) && docObj[k] != null) inp.value = String(docObj[k]);
            });
            reindex();
            recalcFooter();
            syncHiddens();
            if (h.id) setSoFormToUpdate(h.id);
        }
        function esc(s) { if (s == null) return ""; return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;"); }
        function chMap() { const m = {}; (schemaCharges || []).forEach(function (c) { m[c.id] = c; }); return m; }
        function parseIds(s) { if (!s) return []; return s.split(",").map(function (x) { return parseInt(x, 10); }).filter(function (n) { return n > 0; }); }
        function selectedItemChgOrder() {
            var s = new Set();
