                if (d.h && d.h.salesOrderNumber && document.getElementById("soNum")) document.getElementById("soNum").value = d.h.salesOrderNumber;
                applyOrderData(d);
                soLoadQuotationOptions(soOpenEditId, d.h && d.h.salesQuotationId ? d.h.salesQuotationId : null);
                var el = document.getElementById("addSalesOrderModal");
                if (el && typeof bootstrap !== "undefined") { bootstrap.Modal.getOrCreateInstance(el).show(); }
            }).catch(function () { window.alert("Could not load sales order for editing."); });
        }
        if (!soOpenEditId) soLoadQuotationOptions(null, null);
    })();
</script>
