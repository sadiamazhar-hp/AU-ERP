        function buildQuotationChargeInputs() {
            var v = document.getElementById("soQuotationChargeInputs"), h = document.getElementById("soDocChargeInputsHint");
            if (!v) return; v.innerHTML = "";
            var order = selectedQuotChgOrder();
            if (h) h.classList.toggle("d-none", order.length > 0);
            if (!order.length) return;
            order.forEach(function (cid) {
                var c = chMap()[cid];
                if (!c) return;
                var d = document.createElement("div");
                d.className = "d-flex flex-wrap align-items-center gap-2";
                var label = esc(c.symbol) + (c.description ? (" <span class=\"text-muted\">" + esc(c.description) + "</span>") : "");
                d.innerHTML = "<label class=\"small mb-0 text-nowrap flex-shrink-0\" title=\"" + esc((c.symbol || '') + (c.description ? (' — ' + c.description) : '')) + "\">" + label + (c.valueType === "Numeric" ? " (PKR)" : " (%)") + "</label><input type=\"number\" class=\"form-control form-control-sm so-doc-chg-val\" data-cid=\"" + cid + "\" style=\"max-width:8rem\" />";
                v.appendChild(d);
