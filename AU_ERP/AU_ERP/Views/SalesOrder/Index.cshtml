                "<td class=\"text-muted so-idx\">1</td>" +
                "<td><div class=\"bom-mat-picker so-fert-picker\">" +
                "<input type=\"text\" class=\"form-control form-control-sm bom-mat-picker-search\" placeholder=\"Search #…\" autocomplete=\"off\" />" +
                "<input type=\"hidden\" class=\"form-control form-control-sm so-matno bom-mat-picker-value\" name=\"Items[0].MaterialNumber\" />" +
