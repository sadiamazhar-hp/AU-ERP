            if (!d || !d.success) return;
            var h = d.header || {};
            if (document.getElementById("soSalesQuotationIdHidden")) document.getElementById("soSalesQuotationIdHidden").value = h.id ? String(h.id) : "";
            soSyncQuotationSearchFromHidden();
            if (document.getElementById("soCustomer") && h.customerBusinessPartnerId) document.getElementById("soCustomer").value = h.customerBusinessPartnerId;
            soSyncCustomerSearchFromValue();
            soUpdateWalkInCustomerSummary();
            if (document.getElementById("soAddr")) document.getElementById("soAddr").value = h.shipToAddress || "";
            if (document.getElementById("soPlant") && h.plantId) document.getElementById("soPlant").value = h.plantId;
            if (document.getElementById("soDc") && h.distributionChannelId != null) document.getElementById("soDc").value = String(h.distributionChannelId);
            var rows = d.items || [];
            var schemaFromHeader = h.configurationSchemaId != null && h.configurationSchemaId !== "" ? String(h.configurationSchemaId) : "";
            var schemaToUse = (soEmporiumWalkIn && soWalkInSchemaId > 0) ? String(soWalkInSchemaId) : schemaFromHeader;
            if (document.getElementById("soSchema") && schemaToUse) {
                document.getElementById("soSchema").value = schemaToUse;
                loadSchema(schemaToUse, function () {
                    soApplyChargesFromQuotationHeader(h);
                    soPopulateItemsFromQuotationRows(rows);
                });
            } else {
                soApplyChargesFromQuotationHeader(h);
                soPopulateItemsFromQuotationRows(rows);
            }
        }
        (function initSoQuotationCombo() {
            var search = document.getElementById("soSalesQuotationSearch");
            var dd = document.getElementById("soQuotationDropdown");
            if (!search || !dd) return;
            var tOpen = 0;
            search.addEventListener("focus", function () { soRenderQuotationDropdown(search.value); });
            search.addEventListener("input", function () {
                clearTimeout(tOpen);
                tOpen = setTimeout(function () { soRenderQuotationDropdown(search.value); }, 120);
            });
            search.addEventListener("keydown", function (e) { if (e.key === "Escape") soHideQuotationDropdown(); });
            search.addEventListener("blur", function () {
                window.setTimeout(function () {
                    soTryResolveQuotationFromTypedSearch();
                    var hidEl = document.getElementById("soSalesQuotationIdHidden");
                    if (hidEl && hidEl.value) soSyncQuotationSearchFromHidden();
                }, 180);
            });
            dd.addEventListener("mousedown", function (e) { e.preventDefault(); });
            dd.addEventListener("click", function (e) {
                var item = e.target.closest(".so-customer-item");
                if (!item) return;
                soCommitQuotationSelection(item.getAttribute("data-id") || "");
            });
            document.addEventListener("mousedown", function (e) {
                if (!e.target.closest(".so-quot-combo")) soHideQuotationDropdown();
            });
            var soModalEl = document.getElementById("addSalesOrderModal");
            if (soModalEl) {
                function refitQuotDd() {
                    if (dd.style.display !== "none") soPositionQuotationDropdown();
                }
                var mbody = soModalEl.querySelector(".modal-body");
                if (mbody) mbody.addEventListener("scroll", refitQuotDd, true);
                window.addEventListener("resize", refitQuotDd);
            }
        })();
        function soSyncReturnFields() {
            var q = document.getElementById("soListQ"), st = document.getElementById("soListStatus"), pl = document.getElementById("soListPlant"), dc = document.getElementById("soListDc");
            if (document.getElementById("soReturnQ")) document.getElementById("soReturnQ").value = q ? q.value : "";
            if (document.getElementById("soReturnStatus")) document.getElementById("soReturnStatus").value = st ? st.value : "All";
            if (document.getElementById("soReturnPlantId")) document.getElementById("soReturnPlantId").value = pl ? pl.value : "";
            if (document.getElementById("soReturnDcId")) document.getElementById("soReturnDcId").value = dc ? dc.value : "";
        }
        document.getElementById("addSalesOrderModal") && document.getElementById("addSalesOrderModal").addEventListener("show.bs.modal", function () { soSyncReturnFields(); });
        var soF = document.getElementById("salesOrderFilterModal");
        if (soF) soF.addEventListener("show.bs.modal", function () {
            var st = document.getElementById("soListStatus"), pl = document.getElementById("soListPlant"), dc = document.getElementById("soListDc");
            if (document.getElementById("soModStatus")) document.getElementById("soModStatus").value = (st && st.value) || "All";
            if (document.getElementById("soModPlant") && pl) document.getElementById("soModPlant").value = pl.value || "";
            if (document.getElementById("soModDc") && dc) document.getElementById("soModDc").value = dc.value || "";
        });
        window.soApplyFilterModal = function () {
            if (document.getElementById("soListStatus")) document.getElementById("soListStatus").value = document.getElementById("soModStatus").value || "All";
            if (document.getElementById("soListPlant")) document.getElementById("soListPlant").value = document.getElementById("soModPlant").value || "";
            if (document.getElementById("soListDc")) document.getElementById("soListDc").value = document.getElementById("soModDc").value || "";
            var m = document.getElementById("salesOrderFilterModal");
            if (m && typeof bootstrap !== "undefined") { var i = bootstrap.Modal.getInstance(m); if (i) i.hide(); }
            var f = document.getElementById("soListFilterForm");
            if (f) f.submit();
        };
        if (soOpenEditId != null && soOpenEditId > 0) {
            _soSkipFormReset = true;
            fetch(orderDataFor(soOpenEditId)).then(function (r) { return r.json(); }).then(function (d) {
                if (!d || !d.success) { if (d && d.message) window.alert(d.message); return; }
                if (d.h && d.h.salesOrderNumber && document.getElementById("soNum")) document.getElementById("soNum").value = d.h.salesOrderNumber;
                applyOrderData(d);
                soLoadQuotationOptions(soOpenEditId, d.h && d.h.salesQuotationId ? d.h.salesQuotationId : null);
                var el = document.getElementById("addSalesOrderModal");
                if (el && typeof bootstrap !== "undefined") { bootstrap.Modal.getOrCreateInstance(el).show(); }
            }).catch(function () { window.alert("Could not load sales order for editing."); });
        }
        if (!soOpenEditId) soLoadQuotationOptions(null, null);
    })();
</script>
