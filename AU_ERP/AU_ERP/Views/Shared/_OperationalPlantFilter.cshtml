@using AU_ERP.Models
@{
    var plants = ViewBag.FilterPlants as List<PlantsSample> ?? new List<PlantsSample>();
    var missingPlantAssignment = ViewBag.MissingPlantAssignment as bool? == true;
    var isSinglePlantLocked = ViewBag.IsSinglePlantLocked as bool? == true;
    var lockedPlantId = ViewBag.LockedPlantId as string ?? "";
    var listPlantId = ViewBag.ListPlantId as string ?? "";
    var filterFormId = ViewBag.PlantFilterFormId as string ?? "operationalPlantFilterForm";
    var plantHiddenInputId = ViewBag.PlantHiddenInputId as string ?? "operationalListPlant";
    var filterModalId = ViewBag.PlantFilterModalId as string ?? "operationalPlantFilterModal";
    var filterModalPlantId = ViewBag.PlantFilterModalPlantId as string ?? "operationalModPlant";
    var deptHint = ViewBag.PlantDeptHint as string ?? "Store, Sales, or Production";
    PlantsSample? PlantNameRow(string pid) =>
        plants.FirstOrDefault(p => string.Equals(p.PlantID, pid, StringComparison.OrdinalIgnoreCase));
}

@if (missingPlantAssignment)
{
    <div class="alert alert-warning py-2 small mb-3" role="status">
        You have operational access but no plant is assigned to your profile. Ask an administrator to edit your user and select at least one plant for the @deptHint department.
    </div>
}

<input type="hidden" name="plantId" id="@plantHiddenInputId" value="@listPlantId" form="@filterFormId" />

<div class="modal fade" id="@filterModalId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">Plant filter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">Plant</label>
                    @if (isSinglePlantLocked && !string.IsNullOrWhiteSpace(lockedPlantId))
                    {
                        var lockPn = PlantNameRow(lockedPlantId.Trim());
                        <input type="hidden" id="@filterModalPlantId" value="@lockedPlantId.Trim()" />
                        <input type="text" class="form-control form-control-sm bg-light" readonly value="@(lockPn?.PlantName ?? lockedPlantId)" title="Assigned plant" />
                    }
                    else if (!missingPlantAssignment)
                    {
                        <select id="@filterModalPlantId" class="form-select form-select-sm">
                            <option value="">All assigned</option>
                            @foreach (var p in plants)
                            {
                                <option value="@p.PlantID">@p.PlantName</option>
                            }
                        </select>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">No plants assigned.</p>
                    }
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" data-operational-plant-apply="@filterFormId" data-operational-plant-hidden="@plantHiddenInputId" data-operational-plant-modal="@filterModalPlantId" data-operational-plant-modal-el="@filterModalId">Apply</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    if (window.__auOperationalPlantFilterWired) return;
    window.__auOperationalPlantFilterWired = true;
    document.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-operational-plant-apply]");
        if (!btn) return;
        var formId = btn.getAttribute("data-operational-plant-apply");
        var hiddenId = btn.getAttribute("data-operational-plant-hidden");
        var modalPlantId = btn.getAttribute("data-operational-plant-modal");
        var modalElId = btn.getAttribute("data-operational-plant-modal-el");
        var hidden = document.getElementById(hiddenId);
        var modPlant = document.getElementById(modalPlantId);
        if (hidden && modPlant) hidden.value = modPlant.value || "";
        var modalEl = document.getElementById(modalElId);
        if (modalEl && typeof bootstrap !== "undefined") {
            var inst = bootstrap.Modal.getInstance(modalEl);
            if (inst) inst.hide();
        }
        var form = document.getElementById(formId);
        if (form) form.submit();
    });
    document.addEventListener("show.bs.modal", function (e) {
        var modal = e.target;
        if (!modal || !modal.id) return;
        var applyBtn = modal.querySelector("[data-operational-plant-hidden]");
        if (!applyBtn) return;
        var hiddenId = applyBtn.getAttribute("data-operational-plant-hidden");
        var modalPlantId = applyBtn.getAttribute("data-operational-plant-modal");
        var hidden = document.getElementById(hiddenId);
        var modPlant = document.getElementById(modalPlantId);
        if (hidden && modPlant && modPlant.tagName === "SELECT") modPlant.value = hidden.value || "";
    });
})();
</script>
