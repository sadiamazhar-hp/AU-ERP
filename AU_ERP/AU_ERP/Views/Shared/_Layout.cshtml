@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var materialsListActive = string.Equals(ctrl, "Material", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "GetMaterialList", StringComparison.OrdinalIgnoreCase);
    var bpPartnersActive = string.Equals(ctrl, "BP", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "Create", StringComparison.OrdinalIgnoreCase));
    var bpTypesActive = string.Equals(ctrl, "BP", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "BPTypeSamples", StringComparison.OrdinalIgnoreCase);
    var bpGroupingsActive = string.Equals(ctrl, "BP", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "BPGroupings", StringComparison.OrdinalIgnoreCase);
    var bpTypeNumberRangesActive = string.Equals(ctrl, "BP", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "BPTypeNumberRanges", StringComparison.OrdinalIgnoreCase);
    var materialTypeActive = string.Equals(ctrl, "Material", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "MaterialType", StringComparison.OrdinalIgnoreCase);
    var numberRangesActive = string.Equals(ctrl, "Material", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "NumberRanges", StringComparison.OrdinalIgnoreCase);
    var bomActive = string.Equals(ctrl, "BOM", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var wcActive = string.Equals(ctrl, "WorkCentre", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var rtActive = string.Equals(ctrl, "Routing", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var docTypesActive = string.Equals(ctrl, "Document", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "DocumentTypes", StringComparison.OrdinalIgnoreCase);
    var docRangesActive = string.Equals(ctrl, "Document", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "DocumentRanges", StringComparison.OrdinalIgnoreCase);
    var docIntegrationActive = string.Equals(ctrl, "Document", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Integration", StringComparison.OrdinalIgnoreCase);
    var uomActive = string.Equals(ctrl, "UOM", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var unitConvCfgActive = string.Equals(ctrl, "UnitConversionConfig", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var chargesActive = string.Equals(ctrl, "Charges", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var configurationSchemaActive = string.Equals(ctrl, "Schema", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var configMaterialGroupActive = string.Equals(ctrl, "ConfigMaterialGroup", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var configPlantActive = string.Equals(ctrl, "ConfigPlant", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var driversVehiclesActive = string.Equals(ctrl, "DriversAndVehicles", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var pvActive = string.Equals(ctrl, "ProductionVersion", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var mrpActive = string.Equals(ctrl, "MRP", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var productionOrderActive = string.Equals(ctrl, "ProductionOrder", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var operationTrackingActive = string.Equals(ctrl, "OperationTracking", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "Details", StringComparison.OrdinalIgnoreCase));
    var goodReceiptActive = string.Equals(ctrl, "GoodReceipt", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "CreateOrOpen", StringComparison.OrdinalIgnoreCase));
    var stockGoodsIssueActive = string.Equals(ctrl, "StockGoodsIssue", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var stockMovementActive = string.Equals(ctrl, "StockMovement", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var stockOverviewActive = string.Equals(ctrl, "StockOverview", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var usersActive = string.Equals(ctrl, "Users", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var isAdminDept = User.HasClaim(AuClaimTypes.Department, "Admin");
    var isSalesDept = User.HasClaim(AuClaimTypes.Department, "Sales");
    var isFinanceDept = User.HasClaim(AuClaimTypes.Department, "Finance");
    var isProductionDept = User.HasClaim(AuClaimTypes.Department, "Production");
    var isStoreDept = User.HasClaim(AuClaimTypes.Department, "Store");
    var salesQuotationActive = string.Equals(ctrl, "SalesQuotation", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var salesOrderActive = string.Equals(ctrl, "SalesOrder", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var deliveryChallanActive = string.Equals(ctrl, "DeliveryChallan", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var invoiceActive = string.Equals(ctrl, "Invoice", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "Details", StringComparison.OrdinalIgnoreCase));
    var salesPaymentActive = string.Equals(ctrl, "SalesPayment", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "Edit", StringComparison.OrdinalIgnoreCase));
    var creditMemoActive = string.Equals(ctrl, "CreditMemo", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var returnOrderActive = string.Equals(ctrl, "ReturnOrder", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "Create", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "Details", StringComparison.OrdinalIgnoreCase));
    var reorderQiActive = string.Equals(ctrl, "ReorderQualityInspection", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(act, "Details", StringComparison.OrdinalIgnoreCase));
    var salesPreSalesNavActive = salesQuotationActive;
    var salesOrderFulfillmentNavActive = salesOrderActive || deliveryChallanActive || returnOrderActive || reorderQiActive || creditMemoActive;
    var dashboardActive = string.Equals(ctrl, "Dashboard", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var companyInfoActive = string.Equals(ctrl, "CompanyInfo", StringComparison.OrdinalIgnoreCase)
        && string.Equals(act, "Index", StringComparison.OrdinalIgnoreCase);
    var configMaterialNavActive = materialTypeActive || numberRangesActive || configMaterialGroupActive;
    var configBpNavActive = bpTypesActive || bpGroupingsActive || bpTypeNumberRangesActive;
    var configDocumentNavActive = docTypesActive || docRangesActive || docIntegrationActive;
    var configUomNavActive = uomActive || unitConvCfgActive;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")AU MANUFACTURERS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AU_ERP.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="au-shell-body">
        <header class="au-header">
            <div class="au-header-brand">
                <a asp-controller="Dashboard" asp-action="Index" class="au-logo-tile" aria-label="Dashboard — A&amp;U Tiles">
                    <img src="@Url.Content("~/AU_Tiles_logo 2.png")" asp-append-version="true" alt="A&amp;U Tiles" />
                </a>
                <span class="au-header-title">AU MANUFACTURERS</span>
            </div>
            <div class="au-header-spacer" aria-hidden="true"></div>
            <div class="au-header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="au-icon-btn" title="Sign out" aria-label="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                }
            </div>
        </header>

            <aside class="au-sidebar" aria-label="Main navigation">
                <a class="au-sidebar-link @(dashboardActive ? "active" : null)" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="au-sidebar-link @(companyInfoActive ? "active" : null)" asp-controller="CompanyInfo" asp-action="Index">Company info</a>
                }

                @if (isAdminDept)
                {
                    <div class="au-sidebar-section-title au-sidebar-section-title-spaced">Master data</div>
                    <a class="au-sidebar-link @(materialsListActive ? "active" : null)" asp-controller="Material" asp-action="GetMaterialList">Materials</a>
                    <a class="au-sidebar-link @(bpPartnersActive ? "active" : null)" asp-controller="BP" asp-action="Index">Business Partners</a>
                    <a class="au-sidebar-link @(driversVehiclesActive ? "active" : null)" asp-controller="DriversAndVehicles" asp-action="Index">Drivers and vehicles</a>
                    <a class="au-sidebar-link @(bomActive ? "active" : null)" asp-controller="BOM" asp-action="Index">Bill Of Materials</a>
                    <a class="au-sidebar-link @(wcActive ? "active" : null)" asp-controller="WorkCentre" asp-action="Index">Work Centres</a>
                    <a class="au-sidebar-link @(rtActive ? "active" : null)" asp-controller="Routing" asp-action="Index">Routing</a>
                    <a class="au-sidebar-link @(pvActive ? "active" : null)" asp-controller="ProductionVersion" asp-action="Index">Product Version</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="au-sidebar-section-title au-sidebar-section-title-spaced">Inventory</div>
                    <a class="au-sidebar-link @(stockOverviewActive ? "active" : null)" asp-controller="StockOverview" asp-action="Index">Stock Overview</a>
                    @if (isStoreDept || isProductionDept || isSalesDept || isAdminDept)
                    {
                        <a class="au-sidebar-link @(stockGoodsIssueActive ? "active" : null)" asp-controller="StockGoodsIssue" asp-action="Index">Stock Goods Issue</a>
                    }
                    @if (isStoreDept)
                    {
                        <a class="au-sidebar-link @(stockMovementActive ? "active" : null)" asp-controller="StockMovement" asp-action="Index">Stock Movement</a>
                    }
                }
                @if (isSalesDept || isAdminDept)
                {
                    <div class="au-sidebar-section-title au-sidebar-section-title-spaced">Sales</div>
                    <div class="au-sidebar-group">
                        <div class="au-sidebar-group-title @(salesPreSalesNavActive ? "au-sidebar-group-title--active" : null)">Pre-Sales</div>
                        <a class="au-sidebar-link au-sidebar-link--sub @(salesQuotationActive ? "active" : null)" asp-controller="SalesQuotation" asp-action="Index">Quotation</a>
                    </div>
                    <div class="au-sidebar-group">
                        <div class="au-sidebar-group-title @(salesOrderFulfillmentNavActive ? "au-sidebar-group-title--active" : null)">Order &amp; Fulfillment</div>
                        <a class="au-sidebar-link au-sidebar-link--sub @(salesOrderActive ? "active" : null)" asp-controller="SalesOrder" asp-action="Index">Sales order</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(deliveryChallanActive ? "active" : null)" asp-controller="DeliveryChallan" asp-action="Index">Delivery challan</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(returnOrderActive ? "active" : null)" asp-controller="ReturnOrder" asp-action="Index">Return order</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(reorderQiActive ? "active" : null)" asp-controller="ReorderQualityInspection" asp-action="Index">ROD Inspection</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(creditMemoActive ? "active" : null)" asp-controller="CreditMemo" asp-action="Index">Credit memo</a>
                    </div>
                }
                @if (isFinanceDept)
                {
                    <div class="au-sidebar-section-title au-sidebar-section-title-spaced">Finance</div>
                    <a class="au-sidebar-link @(invoiceActive ? "active" : null)" asp-controller="Invoice" asp-action="Index">Invoice</a>
                    <a class="au-sidebar-link @(salesPaymentActive ? "active" : null)" asp-controller="SalesPayment" asp-action="Index">Payments</a>
                }
                @if (isProductionDept)
                {
                    <div class="au-sidebar-section-title au-sidebar-section-title-spaced">Production</div>
                    <a class="au-sidebar-link @(mrpActive ? "active" : null)" asp-controller="MRP" asp-action="Index">MRP</a>
                    <a class="au-sidebar-link @(productionOrderActive ? "active" : null)" asp-controller="ProductionOrder" asp-action="Index">Production Order</a>
                    <a class="au-sidebar-link @(operationTrackingActive ? "active" : null)" asp-controller="OperationTracking" asp-action="Index">Operation Tracking</a>
                    <a class="au-sidebar-link @(goodReceiptActive ? "active" : null)" asp-controller="GoodReceipt" asp-action="Index">Quality Inspection</a>
                }

                @if (isAdminDept)
                {
                    <div class="au-sidebar-section-title au-sidebar-section-title-spaced">User</div>
                    <a class="au-sidebar-link @(usersActive ? "active" : null)" asp-controller="Users" asp-action="Index">Users</a>

                    <div class="au-sidebar-section-title au-sidebar-section-title-spaced">Configuration</div>

                    <div class="au-sidebar-group">
                        <div class="au-sidebar-group-title @(configMaterialNavActive ? "au-sidebar-group-title--active" : null)">Material</div>
                        <a class="au-sidebar-link au-sidebar-link--sub @(materialTypeActive ? "active" : null)" asp-controller="Material" asp-action="MaterialType">Types</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(numberRangesActive ? "active" : null)" asp-controller="Material" asp-action="NumberRanges">Ranges</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(configMaterialGroupActive ? "active" : null)" asp-controller="ConfigMaterialGroup" asp-action="Index">Groups</a>
                    </div>

                    <div class="au-sidebar-group">
                        <div class="au-sidebar-group-title @(configBpNavActive ? "au-sidebar-group-title--active" : null)">Business partner</div>
                        <a class="au-sidebar-link au-sidebar-link--sub @(bpTypesActive ? "active" : null)" asp-controller="BP" asp-action="BPTypeSamples">Types</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(bpTypeNumberRangesActive ? "active" : null)" asp-controller="BP" asp-action="BPTypeNumberRanges">Ranges</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(bpGroupingsActive ? "active" : null)" asp-controller="BP" asp-action="BPGroupings">Groups</a>
                    </div>

                    <div class="au-sidebar-group">
                        <div class="au-sidebar-group-title @(configDocumentNavActive ? "au-sidebar-group-title--active" : null)">Document</div>
                        <a class="au-sidebar-link au-sidebar-link--sub @(docTypesActive ? "active" : null)" asp-controller="Document" asp-action="DocumentTypes">Types</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(docRangesActive ? "active" : null)" asp-controller="Document" asp-action="DocumentRanges">Ranges</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(docIntegrationActive ? "active" : null)" asp-controller="Document" asp-action="Integration">Integration</a>
                    </div>

                    <div class="au-sidebar-group">
                        <div class="au-sidebar-group-title @(configUomNavActive ? "au-sidebar-group-title--active" : null)">UOM</div>
                        <a class="au-sidebar-link au-sidebar-link--sub @(uomActive ? "active" : null)" asp-controller="UOM" asp-action="Index">Unit of measurement</a>
                        <a class="au-sidebar-link au-sidebar-link--sub @(unitConvCfgActive ? "active" : null)" asp-controller="UnitConversionConfig" asp-action="Index">Unit conversion</a>
                    </div>

                    <a class="au-sidebar-link @(configPlantActive ? "active" : null)" asp-controller="ConfigPlant" asp-action="Index">Plants</a>
                    <a class="au-sidebar-link @(chargesActive ? "active" : null)" asp-controller="Charges" asp-action="Index">Charges</a>
                    <a class="au-sidebar-link @(configurationSchemaActive ? "active" : null)" asp-controller="Schema" asp-action="Index">Schemas</a>
                }
            </aside>

            <main class="au-main">
                <div class="au-card">
                    @RenderBody()
                </div>
            </main>

    @await Html.PartialAsync("_MaterialSuccessModal")
    @await Html.PartialAsync("_MaterialDeleteConfirmModal")
    @await Html.PartialAsync("_ErrorModal")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
