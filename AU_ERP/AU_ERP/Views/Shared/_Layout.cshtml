@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isMaterial = string.Equals(ctrl, "Material", StringComparison.OrdinalIgnoreCase);
    // Material Type / Number Ranges: use Configuration layout (gear), not tabs on this shell.
    var materialsNavActive = isMaterial;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")AU MANUFACTURERS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AU_ERP.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="au-shell-body">
    <div class="au-shell">
        <header class="au-header">
            <div class="au-header-brand">
                <a asp-controller="Home" asp-action="Index" class="au-logo-tile" aria-label="Home">A</a>
                <span class="au-header-title">AU MANUFACTURERS</span>
            </div>
            <div class="au-header-actions">
                <button type="button" class="au-icon-btn" title="Profile" aria-label="Profile">
                    <i class="bi bi-person"></i>
                </button>
                <a class="au-icon-btn" asp-controller="Material" asp-action="MaterialType" title="Configuration" aria-label="Configuration">
                    <i class="bi bi-gear"></i>
                </a>
            </div>
        </header>

        <div class="au-body-row">
            <aside class="au-sidebar" aria-label="Main navigation">
                <a class="au-sidebar-link @(materialsNavActive ? "active" : null)" asp-controller="Material" asp-action="GetMaterialList">Materials</a>
                <span class="au-sidebar-placeholder">Inventory</span>
                <span class="au-sidebar-placeholder">Sales</span>
                <span class="au-sidebar-placeholder">Purchasing</span>
                <span class="au-sidebar-placeholder">Reports</span>
            </aside>

            <main class="au-main">
                @* Materials: only material table on this shell; Material Type & Number Ranges are under Configuration (gear). *@
                @*@if (showMaterialTabs)
                {
                    <div class="au-material-tabs-wrap">
                        <nav class="au-material-tabs" aria-label="Materials">
                            <a class="au-tab @(string.Equals(act, "GetMaterialList", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-controller="Material" asp-action="GetMaterialList">Material List</a>
                            <a class="au-tab @(string.Equals(act, "MaterialType", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-controller="Material" asp-action="MaterialType">Material Type</a>
                            <a class="au-tab @(string.Equals(act, "NumberRanges", StringComparison.OrdinalIgnoreCase) ? "active" : null)" asp-controller="Material" asp-action="NumberRanges">Number Ranges</a>
                        </nav>
                    </div>
                }*@
                <div class="au-card">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
