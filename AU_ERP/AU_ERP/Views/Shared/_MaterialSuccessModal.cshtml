@* Teal success dialog for Material create / update / delete (Bootstrap modal). *@
<div class="modal fade" id="materialSuccessModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="materialSuccessModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered au-material-success-modal-dialog">
        <div class="modal-content au-material-success-modal-content shadow-none">
            <div class="au-material-success-modal-inner">
                <h2 class="au-material-success-modal-title" id="materialSuccessModalTitle">SUCCESS</h2>
                <p class="au-material-success-modal-message" id="materialSuccessModalBody"></p>
                <button type="button" class="au-material-success-modal-ok" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
