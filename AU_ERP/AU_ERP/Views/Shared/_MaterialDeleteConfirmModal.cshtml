@* WARNING / confirm delete — maroon dialog (CANCEL + OK). *@
<div class="modal fade" id="materialDeleteConfirmModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="materialDeleteConfirmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered au-material-delete-confirm-dialog">
        <div class="modal-content au-material-delete-confirm-content shadow-none">
            <div class="au-material-delete-confirm-inner">
                <h2 class="au-material-delete-confirm-title" id="materialDeleteConfirmModalTitle">WARNING</h2>
                <p class="au-material-delete-confirm-message" id="materialDeleteConfirmModalBody"></p>
                <div class="au-material-delete-confirm-actions">
                    <button type="button" class="au-material-delete-confirm-cancel" data-bs-dismiss="modal">CANCEL</button>
                    <button type="button" class="au-material-delete-confirm-ok" id="materialDeleteConfirmModalOk">OK</button>
                </div>
            </div>
        </div>
    </div>
</div>
