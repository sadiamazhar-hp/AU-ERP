@* Maroon error dialog — shared across all modules (Bootstrap modal). *@
<div class="modal fade" id="bpRangeErrorModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="bpRangeErrorModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered au-bp-error-modal-dialog">
        <div class="modal-content au-bp-error-modal-content shadow-none">
            <div class="au-bp-error-modal-inner">
                <h2 class="au-bp-error-modal-title" id="bpRangeErrorModalTitle">ERROR</h2>
                <p class="au-bp-error-modal-message" id="bpRangeErrorModalBody"></p>
                <button type="button" class="au-bp-error-modal-ok" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
