@{
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")AU MANUFACTURERS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AU_ERP.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="au-shell-body">
    <div class="au-shell">
        <header class="au-header">
            <div class="au-header-brand">
                <a asp-controller="Home" asp-action="Index" class="au-logo-tile" aria-label="Home">A</a>
                <span class="au-header-title">AU MANUFACTURERS</span>
            </div>
            <div class="au-header-actions">
                <a class="au-icon-btn" asp-controller="Material" asp-action="MaterialType" title="Configuration" aria-label="Configuration">
                    <i class="bi bi-gear"></i>
                </a>
            </div>
        </header>

        <div class="au-body-row au-configuration-body">
            <aside class="au-settings-sidebar" aria-label="Configuration">
                <a class="au-settings-back" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Back to Home
                </a>
                <div class="au-settings-sidebar-title">Configuration</div>
                <a class="au-sidebar-link @(string.Equals(act, "MaterialType", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                   asp-controller="Material" asp-action="MaterialType">Material Type</a>
                <a class="au-sidebar-link @(string.Equals(act, "NumberRanges", StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                   asp-controller="Material" asp-action="NumberRanges">Number Ranges</a>
            </aside>

            <main class="au-main au-settings-main">
                <div class="au-card">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
