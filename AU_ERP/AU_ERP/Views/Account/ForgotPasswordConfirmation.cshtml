@{
    ViewData["Title"] = "Check your email";
}

<div class="login-shell">
    <aside class="login-hero">
        <div class="login-hero-inner">
            <div class="login-brand">AU MANUFACTURERS</div>
            <h1>Almost there.</h1>
            <p class="lead">If we found your account, an email is on its way with next steps.</p>
        </div>
        <footer class="login-hero-footer">Copyright © @DateTime.UtcNow.Year AU Manufacturers. All rights reserved.</footer>
    </aside>
    <section class="login-panel">
        <div class="login-panel-inner">
            <h2>Check your email</h2>
            <p class="subtitle">If an account exists for that address, you will receive a link to set or reset your password.</p>
            <div class="login-meta" style="margin-top: 2rem;">
                <a asp-action="Login">Back to sign in</a>
            </div>
        </div>
    </section>
</div>
