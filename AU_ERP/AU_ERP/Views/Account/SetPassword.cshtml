@model SetPasswordViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Set password";
}

<div class="login-shell">
    <aside class="login-hero">
        <div class="login-hero-inner">
            <div class="login-brand">AU MANUFACTURERS</div>
            <h1>Choose a strong password.</h1>
            <p class="lead">Use at least 8 characters including upper and lower case letters, a number, and a symbol.</p>
        </div>
        <footer class="login-hero-footer">Copyright © @DateTime.UtcNow.Year AU Manufacturers. All rights reserved.</footer>
    </aside>
    <section class="login-panel">
        <div class="login-panel-inner">
            <h2>@ViewData["Title"]</h2>
            <p class="subtitle">Enter and confirm your new password below.</p>

            <form asp-action="SetPassword" method="post" class="login-form" novalidate>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Code" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="login-field">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" autocomplete="new-password" placeholder="New password" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-login-primary">Save password</button>

                <div class="login-meta">
                    <a asp-action="Login">Back to sign in</a>
                </div>
            </form>
        </div>
    </section>
</div>
