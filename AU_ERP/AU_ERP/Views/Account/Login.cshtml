@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="login-shell login-shell--animate">
    <aside class="login-hero" aria-hidden="false">
        <div class="login-hero-inner">
            <div class="login-brand">AU MANUFACTURERS</div>
            <h1>The platform where businesses buy from and sell to other businesses.</h1>
            <p class="lead">The trusted foundation for manufacturing operations and supply chain excellence.</p>
        </div>
        <footer class="login-hero-footer">Copyright © @DateTime.UtcNow.Year AU Manufacturers. All rights reserved.</footer>
    </aside>
    <section class="login-panel" aria-labelledby="login-heading">
        <div class="login-panel-inner">
            <h2 id="login-heading">Welcome back!</h2>
            <p class="subtitle">Sign in to your account to continue</p>

            @if (TempData["AccountMessage"] is string msg)
            {
                <div class="success-banner" role="status">@msg</div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="login-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="login-divider"><span>Sign in</span></div>

                <div class="login-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="email" placeholder="your email address" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <label class="login-check">
                    <input asp-for="RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
                </label>

                <button type="submit" class="btn-login-primary">Sign In</button>

                <div class="login-meta">
                    <a asp-action="ForgotPassword">Forgot password?</a>
                </div>
            </form>
        </div>
    </section>
</div>
