@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="login-shell">
    <aside class="login-hero">
        <div class="login-hero-inner">
            <div class="login-brand">AU MANUFACTURERS</div>
            <h1>Reset access securely.</h1>
            <p class="lead">Enter your email and we will send you a link to set or reset your password.</p>
        </div>
        <footer class="login-hero-footer">Copyright © @DateTime.UtcNow.Year AU Manufacturers. All rights reserved.</footer>
    </aside>
    <section class="login-panel">
        <div class="login-panel-inner">
            <h2>Forgot password?</h2>
            <p class="subtitle">We will email you a secure link if an account exists for that address.</p>

            <form asp-action="ForgotPassword" method="post" class="login-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="login-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="email" placeholder="your email address" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-login-primary">Send link</button>

                <div class="login-meta">
                    <a asp-action="Login">Back to sign in</a>
                </div>
            </form>
        </div>
    </section>
</div>
