@model List<AU_ERP.Models.ConfigurationSchema>
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Schema";
    ViewBag.Title = "Schema";
    var safeModel = Model ?? new List<AU_ERP.Models.ConfigurationSchema>();
    var allCharges = ViewBag.AllCharges as List<AU_ERP.Models.Charge> ?? new List<AU_ERP.Models.Charge>();
    var chargesJson = JsonSerializer.Serialize(
        allCharges.Select(c => new { id = c.Id, label = c.Symbol + " — " + c.Description }).ToList());
}

@if (TempData["SchemaMessage"] is string ok)
{
    <div class="alert alert-success py-2 small mb-2" role="status">@ok</div>
}
@if (TempData["SchemaError"] is string err)
{
    <div class="alert alert-danger py-2 small mb-2" role="status">@err</div>
}

<div class="sap-window au-schema-page" id="app">
    <form id="schemaForm" method="post" action="@Url.Action("Index", "Schema")">
        @Html.AntiForgeryToken()
        <div class="au-validation-summary" id="schemaValSummary" style="display:none;" role="alert"></div>

        <div class="sap-toolbar">
            <div class="d-flex">
                <button type="button" id="btnEdit" class="btn btn-sap" onclick="setMode(true)">Edit</button>
                <button type="button" id="btnNew" class="btn btn-sap" onclick="addNewRow()" disabled>New Entries</button>
                <button type="button" id="btnSave" class="btn btn-sap" onclick="handleSave()" disabled>Save</button>
                <button type="button" id="btnDelete" class="btn btn-sap text-danger" onclick="handleDelete()" disabled>Delete</button>
            </div>
        </div>

        <div class="table-container">
            <table class="table-sap">
                <thead>
                    <tr>
                        <th style="width: 35px;">Sel</th>
                        <th style="min-width: 200px;">Title</th>
                        <th style="min-width: 120px;">Schema type</th>
                        <th style="min-width: 220px;">Charges</th>
                    </tr>
                </thead>
                <tbody id="gridBody">
                    @for (int i = 0; i < safeModel.Count; i++)
                    {
                        var selectedIds = safeModel[i].SchemaCharges.Select(x => x.ChargeId).ToHashSet();
                        var symList = safeModel[i].SchemaCharges.Select(x => x.Charge?.Symbol).Where(s => !string.IsNullOrEmpty(s)).ToList()!;
                        var summary = symList.Count > 0 ? string.Join(", ", symList) : "—";
                        <tr>
                            <td class="col-sel" onclick="selectRow(this)">
                                <input type="hidden" name="[@i].Id" value="@safeModel[i].Id" class="row-id" />
                            </td>
                            <td>
                                <input name="[@i].Title" class="sap-input" value="@safeModel[i].Title" readonly maxlength="200" data-required="true" />
                            </td>
                            <td>
                                <select name="[@i].SchemaType" class="form-select form-select-sm schema-type-sel" style="width:100%;min-height:30px;border:none;border-radius:0;" disabled>
                                    @if (safeModel[i].SchemaType == AU_ERP.Models.ConfigurationSchemaType.Purchase)
                                    {
                                        <option value="0">Sales</option>
                                        <option value="1" selected>Purchase</option>
                                    }
                                    else
                                    {
                                        <option value="0" selected>Sales</option>
                                        <option value="1">Purchase</option>
                                    }
                                </select>
                            </td>
                            <td class="au-schema-charges-cell">
                                <div class="dropdown au-schema-charges-dd" data-bs-auto-close="outside">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start au-schema-dd-btn" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                        <span class="au-schema-dd-label">@summary</span>
                                        <span class="text-muted small">(@selectedIds.Count)</span>
                                    </button>
                                    <ul class="dropdown-menu p-2 shadow au-schema-charges-menu">
                                        @foreach (var c in allCharges)
                                        {
                                            var isChk = selectedIds.Contains(c.Id);
                                            <li>
                                                <div class="form-check mb-1">
                                                    <input class="form-check-input au-charge-cb" type="checkbox" name="[@i].SelectedChargeIds" value="@c.Id" id="sch_@(i)_ch_@(c.Id)" @(isChk ? "checked" : null) />
                                                    <label class="form-check-label small" for="sch_@(i)_ch_@(c.Id)">@c.Symbol — @c.Description</label>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    :root {
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
        --sap-focus: #fff9c4;
    }
    .sap-window { background: white; border: 1px solid var(--sap-border); display: flex; flex-direction: column; min-height: 420px; }
    .sap-toolbar { padding: 12px; border-bottom: 2px solid var(--sap-border); background: #fff; display: flex; justify-content: flex-end; align-items: center; }
    .btn-sap { border-radius: 2px; font-size: 12px; border: 1px solid #bbb; margin-right: 5px; background: #fdfdfd; cursor: pointer; }
    .btn-sap:disabled { opacity: 0.4; cursor: default; }
    .au-schema-page .table-container { overflow: visible; }
    .table-container { overflow-y: auto; flex-grow: 1; }
    .table-sap { width: 100%; border-collapse: collapse; }
    .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; text-align: left; }
    .table-sap td { border: 1px solid #ccc; padding: 0; height: 30px; vertical-align: middle; }
    .sap-input { width: 100%; height: 100%; min-height: 30px; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    .edit-mode .sap-input:not([readonly]) { background: #fff; }
    .edit-mode .sap-input:focus { background: var(--sap-focus); outline: 1px solid orange; }
    .col-sel { width: 35px; background: #f0f0f0; cursor: pointer; }
    .row-selected { background-color: var(--sap-selected) !important; }
    .row-selected .sap-input { background-color: transparent !important; }
    .au-schema-charges-menu { min-width: 16rem; max-width: 22rem; max-height: 240px; overflow-y: auto; z-index: 100300; }
    .au-schema-charges-cell { padding: 4px 8px !important; }
    .au-schema-dd-btn:disabled, .au-schema-page:not(.edit-mode) .au-schema-charges-dd .dropdown-toggle { pointer-events: none; opacity: 0.9; }
    .au-charge-cb:disabled { pointer-events: none; }
    .au-schema-page:not(.edit-mode) .schema-type-sel { background: var(--sap-readonly); pointer-events: none; }
    .edit-mode .schema-type-sel:not(:disabled) { background: #fff; }
</style>
<script>
    const allCharges = @Html.Raw(chargesJson);
    let isEditMode = false;
    let selectedRow = null;
    let rowCount = @(safeModel.Count);

    function setMode(edit) {
        isEditMode = edit;
        document.getElementById('app').classList.toggle('edit-mode', edit);
        document.querySelectorAll('.sap-input').forEach(function (input) {
            input.readOnly = !edit;
        });
        document.getElementById('btnEdit').disabled = edit;
        document.getElementById('btnNew').disabled = !edit;
        document.getElementById('btnSave').disabled = !edit;
        document.querySelectorAll('.au-charge-cb').forEach(function (cb) { cb.disabled = !edit; });
        document.querySelectorAll('.au-schema-dd-btn').forEach(function (b) { b.disabled = !edit; });
        document.querySelectorAll('.schema-type-sel').forEach(function (s) { s.disabled = !edit; });
        var f = document.getElementById('schemaForm');
        if (f && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(f);
    }

    function updateRowChargeLabel(tr) {
        const cbs = tr.querySelectorAll('.au-charge-cb');
        const labels = [];
        cbs.forEach(function (cb) {
            if (cb.checked) {
                const id = parseInt(cb.value, 10);
                const c = (allCharges || []).find(function (x) { return x.id === id; });
                if (c) {
                    const sym = (c.label || '').split('—')[0].trim();
                    if (sym) labels.push(sym);
                }
            }
        });
        const span = tr.querySelector('.au-schema-dd-label');
        if (span) {
            span.textContent = labels.length ? labels.join(', ') : '—';
            const meta = tr.querySelector('.au-schema-dd-btn .text-muted');
            if (meta) meta.textContent = '(' + labels.length + ')';
        }
    }

    function onChargeCbChange() {
        const tr = this.closest('tr');
        if (tr) updateRowChargeLabel(tr);
    }

    function addNewRow() {
        const body = document.getElementById('gridBody');
        const tr = document.createElement('tr');
        const idx = rowCount;
        const checks = (allCharges || []).map(function (c) {
            return '<li><div class="form-check mb-1">' +
                '<input class="form-check-input au-charge-cb" type="checkbox" name="[' + idx + '].SelectedChargeIds" value="' + c.id + '" id="sch_n_' + idx + '_ch_' + c.id + '" />' +
                '<label class="form-check-label small" for="sch_n_' + idx + '_ch_' + c.id + '">' + escapeHtml(c.label) + '</label></div></li>';
        }).join('');
        tr.innerHTML =
            '<td class="col-sel" onclick="selectRow(this)"><input type="hidden" name="[' + idx + '].Id" value="0" class="row-id" /></td>' +
            '<td><input name="[' + idx + '].Title" class="sap-input" maxlength="200" data-required="true" /></td>' +
            '<td><select name="[' + idx + '].SchemaType" class="form-select form-select-sm schema-type-sel" style="width:100%;min-height:30px;border:none;border-radius:0;" disabled><option value="0" selected>Sales</option><option value="1">Purchase</option></select></td>' +
            '<td class="au-schema-charges-cell"><div class="dropdown au-schema-charges-dd" data-bs-auto-close="outside">' +
            '<button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start au-schema-dd-btn" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">' +
            '<span class="au-schema-dd-label">—</span> <span class="text-muted small">(0)</span></button>' +
            '<ul class="dropdown-menu p-2 shadow au-schema-charges-menu">' + checks + '</ul></div></td>';
        body.appendChild(tr);
        tr.querySelectorAll('.au-charge-cb').forEach(function (cb) {
            cb.addEventListener('change', onChargeCbChange);
            if (!isEditMode) cb.disabled = true;
        });
        if (isEditMode) {
            tr.querySelectorAll('.au-schema-dd-btn').forEach(function (b) { b.disabled = false; });
            tr.querySelectorAll('.schema-type-sel').forEach(function (s) { s.disabled = false; });
        } else {
            tr.querySelectorAll('.au-schema-dd-btn').forEach(function (b) { b.disabled = true; });
            tr.querySelectorAll('.schema-type-sel').forEach(function (s) { s.disabled = true; });
        }
        rowCount++;
        tr.querySelector('input[data-required]') && tr.querySelector('input[data-required]').focus();
    }

    function escapeHtml(s) {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function selectRow(cell) {
        if (!isEditMode) return;
        if (selectedRow) selectedRow.classList.remove('row-selected');
        selectedRow = cell.parentElement;
        selectedRow.classList.add('row-selected');
        document.getElementById('btnDelete').disabled = false;
    }

    function collectInvalidRows() {
        const bad = [];
        document.querySelectorAll('#gridBody tr').forEach(function (tr) {
            tr.querySelectorAll('.sap-input[data-required]').forEach(function (inp) {
                if (!inp.value || !inp.value.trim()) bad.push(inp);
            });
        });
        return bad;
    }

    function handleSave() {
        const form = document.getElementById('schemaForm');
        if (typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(form);
        const bad = collectInvalidRows();
        if (bad.length) {
            if (typeof window.auShowInlineValidation === "function") window.auShowInlineValidation(form, bad);
            return;
        }
        document.querySelectorAll('.sap-input').forEach(i => { if (i.readOnly !== undefined) i.readOnly = false; });
        const fd = new FormData(form);
        fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (data.success) { location.reload(); }
                else if (typeof window.auShowInlineValidation === "function") window.auShowInlineValidation(form, [], data.message || 'Save failed');
                else alert(data.message || 'Save failed');
            })
            .catch(() => {
                if (typeof window.auShowInlineValidation === "function") window.auShowInlineValidation(form, [], 'Request failed');
                else alert('Request failed');
            });
    }

    function handleDelete() {
        if (!selectedRow) return;
        const idInput = selectedRow.querySelector('.row-id');
        const id = idInput ? idInput.value : '';
        function doDelete() {
            if (id && id !== '0') {
                fetch('@Url.Action("DeleteSchema", "Schema")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(id)
                })
                .then(r => r.json())
                .then(response => {
                    if (response.success) {
                        selectedRow.remove(); selectedRow = null;
                        document.getElementById('btnDelete').disabled = true;
                        reIndexAllRows();
                        if (typeof window.materialShowSuccessModal === 'function')
                            window.materialShowSuccessModal(response.message || 'Deleted !');
                    } else if (typeof window.auShowInlineValidation === "function")
                        window.auShowInlineValidation(document.getElementById('schemaForm'), [], response.message || 'Delete failed');
                    else alert(response.message || 'Delete failed');
                })
                .catch(() => {
                    if (typeof window.auShowInlineValidation === "function")
                        window.auShowInlineValidation(document.getElementById('schemaForm'), [], 'Delete request failed');
                    else alert('Delete request failed');
                });
            } else {
                selectedRow.remove(); selectedRow = null;
                reIndexAllRows();
            }
        }
        if (typeof window.materialShowDeleteConfirmModalThen === 'function')
            window.materialShowDeleteConfirmModalThen('Do you want to delete this schema?', doDelete);
        else if (confirm('Delete this entry?')) doDelete();
    }

    function reIndexAllRows() {
        const rows = document.querySelectorAll('#gridBody tr');
        rows.forEach(function (row, index) {
            row.querySelectorAll('[name]').forEach(function (el) {
                const name = el.name;
                if (name.includes('.')) {
                    const property = name.split('.').slice(1).join('.');
                    el.name = `[${index}].${property}`;
                }
            });
        });
        rowCount = rows.length;
    }

    (function init() {
        document.querySelectorAll('.au-charge-cb').forEach(function (cb) {
            cb.addEventListener('change', onChargeCbChange);
            cb.disabled = true;
        });
        document.querySelectorAll('.au-schema-dd-btn').forEach(function (b) { b.disabled = true; });
        document.querySelectorAll('.schema-type-sel').forEach(function (s) { s.disabled = true; });
    })();
</script>
