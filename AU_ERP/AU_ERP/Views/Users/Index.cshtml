@model UsersIndexPageModel
@using AU_ERP.Models
@{
    ViewData["Title"] = "Users";
    var deptList = ViewBag.Departments as IEnumerable<Department>;
    var storeDeptId = ViewBag.StoreDepartmentId is int sdi ? sdi : 0;
    var salesDeptId = ViewBag.SalesDepartmentId is int sldi ? sldi : 0;
    var plantsForUsers = ViewBag.Plants as IEnumerable<PlantsSample>;
}

@if (TempData["UserMessage"] is string um)
{
    <div class="alert alert-success mb-3" role="status">@um</div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h4 mb-0">Users</h1>
        <p class="text-muted small mb-0">Invite users by email and assign departments.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
        Add user
    </button>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Departments</th>
                <th>Password</th>
                <th class="text-end" style="min-width: 5rem;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.FirstName @u.LastName</td>
                    <td>@u.Email</td>
                    <td>@string.Join(", ", u.Departments)</td>
                    <td>
                        @if (u.PasswordSetupCompleted)
                        {
                            <span class="sq-badge sq-badge-sent">Set</span>
                        }
                        else
                        {
                            <span class="sq-badge sq-badge-draft">Unset</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "Users", new { editId = u.Id })">Edit</a>
                    </td>
                </tr>
            }
            @if (!Model.Users.Any())
            {
                <tr>
                    <td colspan="5" class="text-muted">No users yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" method="post" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="createUserModalLabel">Add user</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CreateForm.FirstName" class="form-label"></label>
                        <input asp-for="CreateForm.FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="CreateForm.FirstName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateForm.LastName" class="form-label"></label>
                        <input asp-for="CreateForm.LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="CreateForm.LastName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateForm.Email" class="form-label"></label>
                        <input asp-for="CreateForm.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="CreateForm.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-1">
                        <div class="form-label">Departments</div>
                        <div class="border rounded p-2 bg-body-secondary" style="max-height: 12rem; overflow-y: auto;">
                            @{
                                var depts = (deptList ?? Array.Empty<Department>()).OrderBy(d => d.Name).ToList();
                                var selected = Model.CreateForm.DepartmentIds ?? Array.Empty<int>();
                            }
                            @foreach (var d in depts)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="CreateForm.DepartmentIds" value="@d.Id" id="createUserDept_@d.Id" checked="@(selected.Contains(d.Id))" />
                                    <label class="form-check-label" for="createUserDept_@d.Id">@d.Name <span class="text-muted">(@d.Code)</span></label>
                                </div>
                            }
                        </div>
                        <div class="form-text">Select at least one department.</div>
                        <span asp-validation-for="CreateForm.DepartmentIds" class="text-danger small"></span>
                    </div>
                    @{
                        var hasPlantsCreate = (Model.CreateForm.DepartmentIds ?? Array.Empty<int>()).Contains(storeDeptId)
                            || (salesDeptId > 0 && (Model.CreateForm.DepartmentIds ?? Array.Empty<int>()).Contains(salesDeptId));
                        var selectedStorePlantsCreate = Model.CreateForm.StorePlantIds ?? Array.Empty<string>();
                    }
                    <div class="mb-3" id="createStorePlantRow" style="display:@(hasPlantsCreate ? "block" : "none");">
                        <div class="form-label">Assigned plants</div>
                        <div class="form-text mb-1">Required when Store or Sales department is selected.</div>
                        <div class="border rounded p-2 bg-body-secondary" style="max-height: 10rem; overflow-y: auto;">
                            @foreach (var p in (plantsForUsers ?? Enumerable.Empty<PlantsSample>()).OrderBy(x => x.PlantName))
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="CreateForm.StorePlantIds" value="@p.PlantID" id="createUserPlant_@p.PlantID" checked="@(selectedStorePlantsCreate.Contains(p.PlantID))" />
                                    <label class="form-check-label" for="createUserPlant_@p.PlantID">@p.PlantID — @p.PlantName</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="CreateForm.StorePlantIds" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit user modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Edit" method="post" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Edit user</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>
                    <input type="hidden" asp-for="EditForm.UserId" />

                    <div class="mb-3">
                        <label asp-for="EditForm.FirstName" class="form-label"></label>
                        <input asp-for="EditForm.FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="EditForm.FirstName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditForm.LastName" class="form-label"></label>
                        <input asp-for="EditForm.LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="EditForm.LastName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditForm.Email" class="form-label"></label>
                        <input asp-for="EditForm.Email" class="form-control" readonly />
                        <div class="form-text">Sign-in email cannot be changed here.</div>
                    </div>
                    <div class="mb-1">
                        <div class="form-label">Departments</div>
                        <div class="border rounded p-2 bg-body-secondary" style="max-height: 12rem; overflow-y: auto;">
                            @{
                                var deptsE = (deptList ?? Array.Empty<Department>()).OrderBy(d => d.Name).ToList();
                                var selectedE = Model.EditForm.DepartmentIds ?? Array.Empty<int>();
                                var seededUid = ViewBag.SeededAdminUserId as string;
                                var isSeededUserEdit = !string.IsNullOrEmpty(seededUid) && string.Equals(Model.EditForm.UserId, seededUid, StringComparison.Ordinal);
                                var adminDeptE = deptsE.FirstOrDefault(d => d.Code == "Admin");
                            }
                            @foreach (var d in deptsE)
                            {
                                if (isSeededUserEdit && adminDeptE != null && d.Id == adminDeptE.Id)
                                {
                                    <input type="hidden" name="EditForm.DepartmentIds" value="@d.Id" />
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="editUserDept_admin_ro" checked disabled />
                                        <label class="form-check-label" for="editUserDept_admin_ro">@d.Name <span class="text-muted">(@d.Code)</span> <span class="badge bg-secondary">read-only</span></label>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="EditForm.DepartmentIds" value="@d.Id" id="editUserDept_@d.Id" checked="@(selectedE.Contains(d.Id))" />
                                        <label class="form-check-label" for="editUserDept_@d.Id">@d.Name <span class="text-muted">(@d.Code)</span></label>
                                    </div>
                                }
                            }
                        </div>
                        <div class="form-text">Select at least one department.</div>
                        <span asp-validation-for="EditForm.DepartmentIds" class="text-danger small"></span>
                    </div>
                    @{
                        var hasPlantsEdit = (Model.EditForm.DepartmentIds ?? Array.Empty<int>()).Contains(storeDeptId)
                            || (salesDeptId > 0 && (Model.EditForm.DepartmentIds ?? Array.Empty<int>()).Contains(salesDeptId));
                        var selectedStorePlantsEdit = Model.EditForm.StorePlantIds ?? Array.Empty<string>();
                    }
                    <div class="mb-3" id="editStorePlantRow" style="display:@(hasPlantsEdit ? "block" : "none");">
                        <div class="form-label">Assigned plants</div>
                        <div class="form-text mb-1">Required when Store or Sales department is selected.</div>
                        <div class="border rounded p-2 bg-body-secondary" style="max-height: 10rem; overflow-y: auto;">
                            @foreach (var p in (plantsForUsers ?? Enumerable.Empty<PlantsSample>()).OrderBy(x => x.PlantName))
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="EditForm.StorePlantIds" value="@p.PlantID" id="editUserPlant_@p.PlantID" checked="@(selectedStorePlantsEdit.Contains(p.PlantID))" />
                                    <label class="form-check-label" for="editUserPlant_@p.PlantID">@p.PlantID — @p.PlantName</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="EditForm.StorePlantIds" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            function moveToBody(id) {
                return function () {
                    var el = document.getElementById(id);
                    if (el && el.parentElement !== document.body) document.body.appendChild(el);
                };
            }
            function toggleAssignedPlantRow(cbSelector, rowId, storeDeptIdNum, salesDeptIdNum) {
                var row = document.getElementById(rowId);
                if (!row) return;
                var any = Array.prototype.some.call(document.querySelectorAll(cbSelector), function (inp) {
                    if (!inp.checked) return false;
                    var v = String(inp.value);
                    return v === String(storeDeptIdNum) || (salesDeptIdNum > 0 && v === String(salesDeptIdNum));
                });
                row.style.display = any ? 'block' : 'none';
            }

            function wireAssignedPlantToggle(cbSel, rowId, storeDeptIdNum, salesDeptIdNum) {
                document.querySelectorAll(cbSel).forEach(function (inp) {
                    inp.addEventListener('change', function () {
                        toggleAssignedPlantRow(cbSel, rowId, storeDeptIdNum, salesDeptIdNum);
                    });
                });
                toggleAssignedPlantRow(cbSel, rowId, storeDeptIdNum, salesDeptIdNum);
            }

            function init() {
                var create = document.getElementById('createUserModal');
                if (create) {
                    create.addEventListener('show.bs.modal', moveToBody('createUserModal'));
                    moveToBody('createUserModal')();
                }
                var edit = document.getElementById('editUserModal');
                if (edit) {
                    edit.addEventListener('show.bs.modal', moveToBody('editUserModal'));
                    moveToBody('editUserModal')();
                }
                var sd = @storeDeptId;
                var sld = @salesDeptId;
                wireAssignedPlantToggle('input[name=\"CreateForm.DepartmentIds\"]', 'createStorePlantRow', sd, sld);
                wireAssignedPlantToggle('input[name=\"EditForm.DepartmentIds\"]', 'editStorePlantRow', sd, sld);
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
            else init();
        })();
    </script>
    @if (Model.OpenCreateModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var el = document.getElementById('createUserModal');
                if (el && window.bootstrap)
                    bootstrap.Modal.getOrCreateInstance(el).show();
            });
        </script>
    }
    @if (Model.OpenEditModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var el = document.getElementById('editUserModal');
                if (el && window.bootstrap)
                    bootstrap.Modal.getOrCreateInstance(el).show();
            });
        </script>
    }
}
