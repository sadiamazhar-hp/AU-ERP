@model AU_ERP.Models.BusinessPartnerMasterSample
@{
    ViewData["Title"] = "Create business partner";
}

@Html.ValidationSummary(false, "", new { @class = "text-danger small mb-2" })

<div class="bp-module">
    <div class="bp-module-header border-bottom pb-2 mb-3">
        <h1 class="h5 mb-0 fw-semibold" style="color: var(--au-primary-dark, #388087);">Create business partner</h1>
        <p class="small text-secondary mb-0">
            <a asp-action="Index">Back to Business partners</a>
        </p>
    </div>
    <div class="sap-window">
        @await Html.PartialAsync("_BPCreateForm", Model)
    </div>
</div>
