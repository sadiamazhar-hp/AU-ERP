@model List<AU_ERP.Models.BPTypeSample>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "BP Types";
    var safeModel = Model ?? new List<AU_ERP.Models.BPTypeSample>();
}

<div class="sap-window" id="app">
    <form id="bpTypesForm" method="post" action="@Url.Action("BPTypeSamples", "BP")">
        @Html.AntiForgeryToken()
        <div class="au-validation-summary" style="display:none;" role="alert"></div>

        <div class="sap-toolbar">
            <div class="d-flex">
                <button type="button" id="btnEdit" class="btn btn-sap" onclick="setMode(true)">Edit</button>
                <button type="button" id="btnNew" class="btn btn-sap" onclick="addNewRow()" disabled>New entries</button>
                <button type="button" id="btnSave" class="btn btn-sap" onclick="handleSave()" disabled>Save</button>
                <button type="button" id="btnDelete" class="btn btn-sap text-danger" onclick="handleDelete()" disabled>Delete</button>
            </div>
        </div>

        <div class="table-container">
            <table class="table-sap">
                <thead>
                    <tr>
                        <th style="width: 35px;">Sel</th>
                        <th>Type name</th>
                        <th style="width: 90px;">Active</th>
                    </tr>
                </thead>
                <tbody id="gridBody">
                    @for (int i = 0; i < safeModel.Count; i++)
                    {
                        <tr>
                            <td class="col-sel" onclick="selectRow(this)">
                                <input type="hidden" name="[@i].Id" value="@safeModel[i].Id" class="row-id" />
                            </td>
                            <td>
                                <input name="[@i].TypeName" class="sap-input" value="@safeModel[i].TypeName" readonly data-required="true" />
                            </td>
                            <td class="text-center align-middle px-2">
                                <input type="checkbox" name="[@i].IsActive" value="true" class="sap-check" disabled @(safeModel[i].IsActive != false ? "checked=\"checked\"" : null) />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    :root {
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
        --sap-focus: #fff9c4;
    }
    .sap-window { background: white; border: 1px solid var(--sap-border); display: flex; flex-direction: column; min-height: 420px; }
    .sap-toolbar { padding: 12px; border-bottom: 2px solid var(--sap-border); background: #fff; display: flex; justify-content: flex-end; align-items: center; }
    .btn-sap { border-radius: 2px; font-size: 12px; border: 1px solid #bbb; margin-right: 5px; background: #fdfdfd; cursor: pointer; }
    .btn-sap:disabled { opacity: 0.4; cursor: default; }
    .table-container { overflow-y: auto; flex-grow: 1; }
    .table-sap { width: 100%; border-collapse: collapse; }
    .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; text-align: left; }
    .table-sap td { border: 1px solid #ccc; padding: 0; height: 30px; }
    .sap-input { width: 100%; height: 100%; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    .edit-mode .sap-input:not([readonly]) { background: #fff; }
    .edit-mode .sap-input:not([readonly]):focus { background: var(--sap-focus); outline: 1px solid orange; }
    .col-sel { width: 35px; background: #f0f0f0; cursor: pointer; }
    .row-selected { background-color: var(--sap-selected) !important; }
    .row-selected .sap-input { background-color: transparent !important; }
    .sap-check:disabled { opacity: 0.5; cursor: default; }
    .row-validation-error td { background-color: #fce4e4 !important; }
    .row-validation-error .sap-input { background-color: transparent !important; }
    .row-validation-error .sap-input[data-required].sap-invalid { outline: 2px solid #c62828 !important; background: #fff0f0 !important; }
</style>
<script>
    let isEditMode = false;
    let selectedRow = null;
    let rowCount = @(safeModel.Count);

    function setMode(edit) {
        isEditMode = edit;
        document.getElementById('app').classList.toggle('edit-mode', edit);
        document.querySelectorAll('.sap-input').forEach(input => { input.readOnly = !edit; });
        document.querySelectorAll('.sap-check').forEach(c => { c.disabled = !edit; });
        document.getElementById('btnEdit').disabled = edit;
        document.getElementById('btnNew').disabled = !edit;
        document.getElementById('btnSave').disabled = !edit;
        var f = document.getElementById('bpTypesForm');
        if (f && typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(f);
    }

    function addNewRow() {
        const body = document.getElementById('gridBody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="col-sel" onclick="selectRow(this)">
                <input type="hidden" name="[${rowCount}].Id" value="0" class="row-id" />
            </td>
            <td><input name="[${rowCount}].TypeName" class="sap-input" data-required="true"></td>
            <td class="text-center align-middle px-2">
                <input type="checkbox" name="[${rowCount}].IsActive" value="true" class="sap-check" checked />
            </td>`;
        body.appendChild(tr);
        rowCount++;
        if (isEditMode) tr.querySelectorAll('.sap-check').forEach(c => { c.disabled = false; });
        tr.querySelector('input.sap-input').focus();
    }

    function selectRow(cell) {
        if (!isEditMode) return;
        if (selectedRow) selectedRow.classList.remove('row-selected');
        selectedRow = cell.parentElement;
        selectedRow.classList.add('row-selected');
        document.getElementById('btnDelete').disabled = false;
    }

    function collectInvalidBpTypesRows() {
        var bad = [];
        document.querySelectorAll('#gridBody tr').forEach(tr => {
            tr.querySelectorAll('.sap-input[data-required]').forEach(inp => {
                if (!inp.value.trim()) bad.push(inp);
            });
        });
        return bad;
    }

    function handleSave() {
        var form = document.getElementById('bpTypesForm');
        if (typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(form);
        var bad = collectInvalidBpTypesRows();
        if (bad.length) {
            if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, bad);
            return;
        }
        document.querySelectorAll('.sap-input, .sap-check').forEach(i => { i.disabled = false; i.readOnly = false; });
        var fd = new FormData(form);
        fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (data.success) { location.reload(); }
                else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], data.message || 'Save failed');
                else alert(data.message || 'Save failed');
            })
            .catch(() => {
                if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], 'Request failed');
                else alert('Request failed');
            });
    }

    function handleDelete() {
        if (!selectedRow) return;
        const hid = selectedRow.querySelector('.row-id');
        const id = hid ? parseInt(hid.value, 10) : 0;
        function doDelete() {
            if (id > 0) {
                $.post('@Url.Action("DeleteBPTypeSample", "BP")', { id: id }, function (response) {
                    if (response.success) {
                        selectedRow.remove(); selectedRow = null;
                        document.getElementById('btnDelete').disabled = true;
                        reIndexAllRows();
                        if (typeof window.materialShowSuccessModal === 'function')
                            window.materialShowSuccessModal(response.message || 'Deleted !');
                    } else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(document.getElementById('bpTypesForm'), [], response.message || 'Delete failed');
                    else alert(response.message || 'Delete failed');
                });
            } else {
                selectedRow.remove(); selectedRow = null;
                document.getElementById('btnDelete').disabled = true;
                reIndexAllRows();
            }
        }
        if (typeof window.materialShowDeleteConfirmModalThen === 'function')
            window.materialShowDeleteConfirmModalThen('Do you want to delete this BP Type?', doDelete);
        else if (confirm('Delete this entry?')) doDelete();
    }

    function reIndexAllRows() {
        const rows = document.querySelectorAll('#gridBody tr');
        rows.forEach((row, idx) => {
            row.querySelectorAll('[name]').forEach(el => {
                if (el.name.includes('.')) {
                    const property = el.name.split('.').slice(1).join('.');
                    el.name = `[${idx}].${property}`;
                }
            });
        });
        rowCount = rows.length;
    }

    document.querySelectorAll('.sap-check').forEach(function (c) { c.disabled = true; });
</script>
