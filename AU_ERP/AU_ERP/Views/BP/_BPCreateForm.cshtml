@model AU_ERP.Models.BusinessPartnerMasterSample
@using System
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var roleOptions = ViewBag.RoleOptions as List<AU_ERP.Models.BPRole> ?? new List<AU_ERP.Models.BPRole>();
    var typeOptions = ViewBag.TypeOptions as List<AU_ERP.Models.BPTypeSample> ?? new List<AU_ERP.Models.BPTypeSample>();
    var groupOptions = ViewBag.GroupOptions as List<AU_ERP.Models.BPGrouping> ?? new List<AU_ERP.Models.BPGrouping>();
    var distChannels = ViewBag.DistributionChannels as List<AU_ERP.Models.DistributionChannel> ?? new List<AU_ERP.Models.DistributionChannel>();
    var salesConfigSchemas = ViewBag.SalesConfigurationSchemas as List<AU_ERP.Models.ConfigurationSchema> ?? new List<AU_ERP.Models.ConfigurationSchema>();
    var purchaseConfigSchemas = ViewBag.PurchaseConfigurationSchemas as List<AU_ERP.Models.ConfigurationSchema> ?? new List<AU_ERP.Models.ConfigurationSchema>();
    var roleBasicId = ViewBag.RoleBasicId is int rb ? rb : 0;
    var roleCustomerId = ViewBag.RoleCustomerId is int rc ? rc : 0;
    var roleVendorId = ViewBag.RoleVendorId is int rv ? rv : 0;
    var typeCustomerId = ViewBag.TypeCustomerId is int tc ? tc : 0;
    var groupLocalId = ViewBag.GroupLocalId is int gl ? gl : 0;
    string NormCh(string? s) => (s ?? "").Replace(" ", "").Trim().ToLowerInvariant();
    string DistLabel(AU_ERP.Models.DistributionChannel ch)
    {
        var n = NormCh(ch.DistributionChannelName);
        if (n == "oncall") return "OnCall";
        if (n == "directsales") return "DirectSales";
        return ch.DistributionChannelName;
    }
}
<form asp-controller="BP" asp-action="Create" method="post" class="bp-create-form" id="bpCreateRoot" data-bp-type-committed="@(Model.BPTypeId?.ToString() ?? "")" data-initial-sales-schema="@(Model.SalesSchema ?? "")" data-role-basic-id="@roleBasicId" data-role-customer-id="@roleCustomerId" data-role-vendor-id="@roleVendorId" data-type-customer-id="@typeCustomerId" data-group-local-id="@groupLocalId">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnTo" value="@(ViewBag.FormReturnTo ?? "Index")" />
    <div class="au-validation-summary px-3 pt-2" style="display:none;" role="alert"></div>

    <div id="bpMasterLayout" class="bp-master-layout">
        <div class="p-3 border-bottom bg-white d-flex flex-wrap gap-4 align-items-center">
            <div class="bp-field-row mb-0" id="bpCreateRoleRow">
                <div class="bp-mandatory-bar"></div>
                <label class="bp-label-compact">Role</label>
                <select name="BPRoleId" class="form-select form-select-sm f-role" style="min-width:11rem;" onchange="bpHandleRoleUI(this)">
                    <option value="">-- Select BP role --</option>
                    @foreach (var r in roleOptions)
                    {
                        if (Model.BPRoleId == r.Id)
                        {
                            <option value="@r.Id" data-code="@r.RoleCode" selected>@r.RoleCode — @r.RoleName</option>
                        }
                        else
                        {
                            <option value="@r.Id" data-code="@r.RoleCode">@r.RoleCode — @r.RoleName</option>
                        }
                    }
                </select>
            </div>
            <div class="bp-field-row mb-0" id="bpCreateTypeRow">
                <div class="bp-mandatory-bar"></div>
                <label class="bp-label-compact">Type</label>
                <select class="form-select form-select-sm f-type bg-light" style="min-width:11rem;" disabled>
                    <option value="">-- Select type --</option>
                    @foreach (var t in typeOptions)
                    {
                        if (Model.BPTypeId == t.Id)
                        {
                            <option value="@t.Id" selected>@t.TypeName</option>
                        }
                        else
                        {
                            <option value="@t.Id">@t.TypeName</option>
                        }
                    }
                </select>
                <input type="hidden" name="BPTypeId" class="f-type-hidden" value="@(Model.BPTypeId?.ToString() ?? "")" />
            </div>
            <div class="bp-field-row mb-0" id="bpCreateBpidRow">
                <div class="bp-mandatory-bar"></div>
                <label class="bp-label-compact">BPID</label>
                <input asp-for="BPID" class="form-control form-control-sm f-bpid bg-light" style="min-width:12rem;" readonly autocomplete="off" placeholder="Select type for number" />
            </div>
            <div class="bp-field-row mb-0" id="bpCreateGroupRow">
                <div class="bp-mandatory-bar"></div>
                <label class="bp-label-compact">Grouping</label>
                <select name="BPGroupingId" class="form-select form-select-sm f-group" style="min-width:12rem;">
                    <option value="">-- Select grouping --</option>
                    @foreach (var g in groupOptions)
                    {
                        if (Model.BPGroupingId == g.Id)
                        {
                            <option value="@g.Id" selected>@g.GroupName</option>
                        }
                        else
                        {
                            <option value="@g.Id">@g.GroupName</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="bp-itab-bar d-flex flex-wrap border-bottom bg-light px-2">
            <button type="button" class="bp-itab-btn" onclick="bpSwitchTab(this, 'basic')">Basic info</button>
            <button type="button" class="bp-itab-btn active" onclick="bpSwitchTab(this, 'address')">Address</button>
            <button type="button" class="bp-itab-btn" onclick="bpSwitchTab(this, 'comm')">Communication</button>
            <button type="button" class="bp-itab-btn" onclick="bpSwitchTab(this, 'company')">Company code</button>
            <button type="button" class="bp-itab-btn d-none tab-sales-btn" onclick="bpSwitchTab(this, 'sales')">Sales area</button>
            <button type="button" class="bp-itab-btn d-none tab-purch-btn" onclick="bpSwitchTab(this, 'purch')">Purchasing</button>
        </div>

        <div class="bp-content-area p-3">
            <div class="tab-pane tab-basic d-none">
                <div class="bp-section-box">
                    <h3 class="bp-section-title">Basic info</h3>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>First name</label>
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control form-control-sm f-firstname" })
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Last name</label>
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control form-control-sm f-lastname" })
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>CNIC</label>
                        @Html.TextBoxFor(m => m.CNIC, new { @class = "form-control form-control-sm f-cnic", placeholder = "xxxxx-xxxxxxx-x" })
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Licence No</label>
                        @Html.TextBoxFor(m => m.LicenceNo, new { @class = "form-control form-control-sm f-licence" })
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Status</label>
                        @Html.DropDownListFor(m => m.IsActive, new SelectList(new[] { new { Value = "true", Text = "Active" }, new { Value = "false", Text = "Inactive" } }, "Value", "Text", Model.IsActive.ToString().ToLowerInvariant()), new { @class = "form-select form-select-sm f-status", style = "max-width:12rem;" })
                    </div>
                </div>
            </div>
            <div class="tab-pane tab-address">
                <div class="bp-section-box">
                    <h3 class="bp-section-title">General data</h3>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Name</label>
                        <div class="flex-grow-1">
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control form-control-sm f-name" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small d-block mt-1" })
                        </div>
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Street / House no.</label>
                        <div class="d-flex gap-2 flex-grow-1">
                            @Html.TextBoxFor(m => m.Street, new { @class = "form-control form-control-sm f-street flex-grow-1" })
                            @Html.TextBoxFor(m => m.HouseNo, new { @class = "form-control form-control-sm f-no", style = "max-width:8rem;" })
                        </div>
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>City / Postal code</label>
                        <div class="d-flex gap-2 flex-grow-1">
                            @Html.TextBoxFor(m => m.City, new { @class = "form-control form-control-sm f-city flex-grow-1" })
                            @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control form-control-sm f-zip", style = "max-width:8rem;" })
                        </div>
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Country / Region</label>
                        <div class="d-flex gap-2 flex-grow-1">
                            @Html.DropDownListFor(m => m.Country, new SelectList(new[] { "Pakistan", "USA" }), new { @class = "form-select form-select-sm f-country flex-grow-1" })
                            @Html.TextBoxFor(m => m.Region, new { @class = "form-control form-control-sm f-region flex-grow-1", placeholder = "Region" })
                        </div>
                    </div>
                    <div class="bp-field-row">
                        <label>Language</label>
                        @Html.DropDownListFor(m => m.Language, new SelectList(new[] { "English", "Urdu" }), new { @class = "form-select form-select-sm f-lang" })
                    </div>
                </div>
            </div>

            <div class="tab-pane tab-comm d-none">
                <div class="bp-section-box">
                    <h3 class="bp-section-title">Communication</h3>
                    <div class="bp-field-row"><label>Telephone</label> @Html.TextBoxFor(m => m.Telephone, new { @class = "form-control form-control-sm f-tel" })</div>
                    <div class="bp-field-row"><label>Mobile</label> @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control form-control-sm f-mob" })</div>
                    <div class="bp-field-row"><label>Email</label> @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-sm f-email", type = "email" })</div>
                </div>
            </div>

            <div class="tab-pane tab-company d-none">
                <div class="bp-section-box">
                    <h3 class="bp-section-title">Account management</h3>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Recon account</label>
                        @Html.TextBoxFor(m => m.ReconAccount, new { @class = "form-control form-control-sm f-recon", placeholder = "e.g. 140000" })
                    </div>
                </div>
                <div class="bp-section-box">
                    <h3 class="bp-section-title">Payment</h3>
                    <div class="bp-field-row">
                        <label>Payment terms</label>
                        @Html.DropDownListFor(m => m.PaymentTerms, new SelectList(new[] { "10-days", "15-days", "30-days" }), "-- Select --", new { @class = "form-select form-select-sm f-payterms" })
                    </div>
                    <div class="bp-field-row">
                        <label>Payment method</label>
                        @Html.DropDownListFor(m => m.PaymentMethods, new SelectList(new[] { "Cash", "Cheque", "Online" }), "-- Select --", new { @class = "form-select form-select-sm f-paymeth" })
                    </div>
                </div>
                <div class="bp-section-box">
                    <h3 class="bp-section-title">Bank details</h3>
                    <div class="bp-field-row"><label>Bank name</label> @Html.TextBoxFor(m => m.BankName, new { @class = "form-control form-control-sm f-bankname" })</div>
                    <div class="bp-field-row"><label>Account number</label> @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control form-control-sm f-accno" })</div>
                </div>
            </div>

            <div class="tab-pane tab-sales d-none">
                <div class="bp-section-box">
                    <h3 class="bp-section-title">Sales</h3>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Dist. channel</label>
                        <select name="DistChannel" id="bpCreateDistChannel" class="form-select form-select-sm f-dist" style="min-width:14rem;">
                            <option value="">-- Select --</option>
                            @foreach (var ch in distChannels)
                            {
                                var isSelected =
                                    string.Equals(Model.DistChannel, ch.DistributionChannelID.ToString(), StringComparison.Ordinal)
                                    || string.Equals(NormCh(Model.DistChannel), NormCh(ch.DistributionChannelName), StringComparison.Ordinal);
                                if (isSelected)
                                {
                                    <option value="@ch.DistributionChannelID" selected>@DistLabel(ch)</option>
                                }
                                else
                                {
                                    <option value="@ch.DistributionChannelID">@DistLabel(ch)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Sales schema</label>
                        <select name="SalesSchema" id="bpCreateSalesSchema" class="form-select form-select-sm f-sales-schema" style="min-width:14rem;">
                            <option value="">-- Select --</option>
                            @foreach (var s in salesConfigSchemas)
                            {
                                if (string.Equals(Model.SalesSchema, s.Id.ToString(), StringComparison.Ordinal))
                                {
                                    <option value="@s.Id" selected>@s.Title</option>
                                }
                                else
                                {
                                    <option value="@s.Id">@s.Title</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="tab-pane tab-purch d-none">
                <div class="bp-section-box">
                    <h3 class="bp-section-title">Purchasing</h3>
                    <div class="bp-field-row">
                        <div class="bp-mandatory-bar"></div>
                        <label>Purchase schema</label>
                        <select name="PurchSchema" id="bpCreatePurchSchema" class="form-select form-select-sm f-purch-schema" style="min-width:18rem;">
                            <option value="">-- Select --</option>
                            @foreach (var sch in purchaseConfigSchemas)
                            {
                                if (string.Equals(Model.PurchSchema, sch.Id.ToString(), StringComparison.Ordinal))
                                {
                                    <option value="@sch.Id" selected>@sch.Title</option>
                                }
                                else
                                {
                                    <option value="@sch.Id">@sch.Title</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="bp-field-row">
                        <label>Currency</label>
                        <input type="text" class="form-control form-control-sm" value="PKR" readonly style="max-width:10rem;background:#f4f4f4;" tabindex="-1" aria-readonly="true" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="border-top bg-white py-2 px-3 d-flex justify-content-end">
        <button type="submit" class="btn btn-sm text-white bp-btn-save">Save</button>
    </div>
</form>

<script type="text/javascript">
    function bpCreateRestoreSalesFromInitial() {
        var form = document.getElementById('bpCreateRoot');
        var initial = form && (form.getAttribute('data-initial-sales-schema') || '').trim();
        if (!initial) return;
        var sel = document.getElementById('bpCreateSalesSchema');
        if (!sel) return;
        if ([].some.call(sel.options, function (o) { return o.value === initial; })) sel.value = initial;
    }
    function bpFindItabBtn(root, slug) {
        return Array.prototype.find.call(root.querySelectorAll(".bp-itab-btn"), function (b) {
            return (b.getAttribute("onclick") || "").indexOf("'" + slug + "'") >= 0;
        });
    }

    function bpHandleRoleUI(select) {
        const root = select.closest('#bpCreateRoot');
        if (!root) return;
        const opt = select.options[select.selectedIndex];
        const roleCodeRaw = opt ? (opt.getAttribute('data-code') || '') : '';
        const roleCode = String(roleCodeRaw).trim().toUpperCase();
        const customerTypeId = parseInt(root.getAttribute('data-type-customer-id') || '0', 10) || 0;
        const localGroupId = parseInt(root.getAttribute('data-group-local-id') || '0', 10) || 0;
        const sales = root.querySelector('.tab-sales-btn');
        const purch = root.querySelector('.tab-purch-btn');
        const typeSel = root.querySelector('.f-type');
        const typeHidden = root.querySelector('.f-type-hidden');
        const groupSel = root.querySelector('.f-group');
        const typeRow = root.querySelector('#bpCreateTypeRow');
        const bpidRow = root.querySelector('#bpCreateBpidRow');
        const groupRow = root.querySelector('#bpCreateGroupRow');
        const isBasic = roleCode === 'FLCU00';
        const isCustomer = roleCode === 'FLCU01';
        const isVendor = roleCode === 'FLVN01';
        var showSales = isCustomer || isBasic;
        var showPurch = isVendor || isBasic;
        if (typeRow) typeRow.classList.toggle('d-none', isBasic);
        if (bpidRow) bpidRow.classList.toggle('d-none', isBasic);
        if (groupRow) groupRow.classList.toggle('d-none', isBasic || isVendor);
        const basicTabBtn = bpFindItabBtn(root, 'basic');
        if (basicTabBtn) basicTabBtn.classList.add('d-none');
        ['address', 'comm', 'company'].forEach(function (slug) {
            var b = bpFindItabBtn(root, slug);
            if (b) b.classList.remove('d-none');
        });
        if (sales) sales.classList.toggle('d-none', !showSales);
        if (purch) purch.classList.toggle('d-none', !showPurch);

        ['address', 'comm', 'company', 'sales', 'purch'].forEach(function (nm) {
            var pane = root.querySelector('.tab-' + nm);
            if (!pane) return;
            pane.classList.remove('d-none');
        });
        var basicPane = root.querySelector('.tab-basic');
        if (basicPane) basicPane.classList.add('d-none');

        if (isCustomer) {
            if (typeSel && customerTypeId > 0 && String(typeSel.value || '') !== String(customerTypeId)) {
                typeSel.value = String(customerTypeId);
                if (typeHidden) typeHidden.value = String(customerTypeId);
                bpFetchNextBPID(root);
            }
            if (groupSel && localGroupId > 0)
                groupSel.value = String(localGroupId);
        }

        if (isVendor && typeSel) {
            var vendorOption = Array.prototype.find.call(typeSel.options, function (o) {
                return String(o.text || '').trim().toLowerCase() === 'vendor';
            });
            if (vendorOption) {
                typeSel.value = String(vendorOption.value || '');
                if (typeHidden) typeHidden.value = String(vendorOption.value || '');
                bpFetchNextBPID(root);
            }
        }

        if (isBasic) {
            if (typeSel) typeSel.value = '';
            if (typeHidden) typeHidden.value = '';
            if (groupSel) groupSel.value = '';
            var bpid = root.querySelector('.f-bpid');
            if (bpid) bpid.value = '';
        }

        if (isVendor && groupSel)
            groupSel.value = '';

        var addrBtn = bpFindItabBtn(root, 'address');
        if (addrBtn) bpSwitchTab(addrBtn, 'address');
    }
    function bpSwitchTab(btn, tab) {
        const root = btn.closest('#bpCreateRoot');
        if (!root) return;
        root.querySelectorAll('.bp-itab-btn').forEach(b => b.classList.remove('active'));
        root.querySelectorAll('.tab-pane').forEach(p => p.classList.add('d-none'));
        btn.classList.add('active');
        const pane = root.querySelector('.tab-' + tab);
        if (pane) pane.classList.remove('d-none');
    }
    document.querySelectorAll('#bpCreateRoot .f-role').forEach(function (el) {
        bpHandleRoleUI(el);
    });
    bpCreateRestoreSalesFromInitial();

    function bpShowInlineError(root, invalidEls, message) {
        root = root || document.getElementById('bpCreateRoot');
        if (!root) return;
        if (typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(root);
        if (typeof window.auShowInlineValidation === 'function')
            window.auShowInlineValidation(root, invalidEls || [], message);
        else window.alert(message || 'Following Fields are Required');
    }

    /** Client-side required checks (mirrors mandatory fields on the form). */
    function bpValidateCreateForm(root) {
        root = root || document.getElementById('bpCreateRoot');
        if (!root) return [];
        var bad = [];
        function req(sel) {
            var el = root.querySelector(sel);
            if (!el) return;
            if (!(String(el.value || '').trim())) bad.push(el);
        }
        req('.f-role');
        var roleSel = root.querySelector('.f-role');
        var roleId = parseInt((roleSel && roleSel.value) ? roleSel.value : '0', 10) || 0;
        var basicId = parseInt(root.getAttribute('data-role-basic-id') || '0', 10) || 0;
        var vendorId = parseInt(root.getAttribute('data-role-vendor-id') || '0', 10) || 0;
        if (roleId !== basicId) {
            req('.f-type');
            req('.f-bpid');
        }
        if (roleId !== basicId && roleId !== vendorId)
            req('.f-group');
        req('.f-name');
        req('.f-street');
        req('.f-no');
        req('.f-city');
        req('.f-zip');
        req('.f-region');
        req('.f-country');
        req('.f-recon');
        var opt = roleSel && roleSel.options[roleSel.selectedIndex];
        var roleCode = opt ? String(opt.getAttribute('data-code') || '').trim().toUpperCase() : '';
        if (roleCode === 'FLCU01' || roleCode === 'FLCU00') {
            req('.f-dist');
            req('.f-sales-schema');
        }
        if (roleCode === 'FLVN01' || roleCode === 'FLCU00') {
            req('.f-purch-schema');
        }
        return bad;
    }

    function bpFetchNextBPID(root, refetchDepth) {
        if (!root) return;
        refetchDepth = refetchDepth || 0;
        const typeSel = root.querySelector('.f-type');
        const bpInput = root.querySelector('.f-bpid');
        if (!typeSel || !bpInput) return;
        const id = typeSel.value;
        if (!id) {
            bpInput.value = '';
            root.dataset.bpTypeCommitted = '';
            return;
        }
        const url = '@Url.Action("GetNextBPTypeNumber", "BP")' + '?bpTypeId=' + encodeURIComponent(id);
        function bpRangeFetchFailed(message) {
            bpInput.value = '';
            bpShowInlineError(root, typeSel ? [typeSel] : [], message);
            const committed = root.dataset.bpTypeCommitted || '';
            if (id !== committed) {
                typeSel.value = committed;
                if (committed && refetchDepth < 1)
                    bpFetchNextBPID(root, refetchDepth + 1);
            }
        }
        fetch(url)
            .then(function (r) { return r.json(); })
            .then(function (response) {
                if (response.success) {
                    bpInput.value = response.nextBPID;
                    root.dataset.bpTypeCommitted = String(id);
                } else {
                    bpRangeFetchFailed(response.message || 'No number range available for this type.');
                }
            })
            .catch(function () {
                bpRangeFetchFailed('Could not load the next BPID. Check your connection and try again.');
            });
    }
    document.querySelectorAll('#bpCreateRoot .f-type').forEach(function (el) {
        var root = el.closest('#bpCreateRoot');
        var hidden = root && root.querySelector('.f-type-hidden');
        if (hidden) hidden.value = el.value || '';
        if (el.value)
            bpFetchNextBPID(root);
    });
</script>
