@model List<AU_ERP.Models.BPTypeNumberRanges>
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "BP Ranges";
    var typeList = ViewBag.TypeList as List<SelectListItem> ?? new List<SelectListItem>();
    var safeModel = Model ?? new List<AU_ERP.Models.BPTypeNumberRanges>();
    var typeOptsJson = JsonSerializer.Serialize(typeList.Select(t => new { value = t.Value ?? "", text = t.Text ?? "" }));
    var existingBPTypeIdsJson = JsonSerializer.Serialize(safeModel.Where(r => r.BPTypeId != null && r.BPTypeId > 0).Select(r => r.BPTypeId.ToString()).Distinct());
}

<div class="sap-window" id="app">
    <form id="bpTypeNrForm" method="post" action="@Url.Action("BPTypeNumberRanges", "BP")">
        @Html.AntiForgeryToken()
        <div class="au-validation-summary" style="display:none;" role="alert"></div>

        <div class="sap-toolbar">
            <div class="d-flex">
                <button type="button" id="btnEdit" class="btn btn-sap" onclick="setMode(true)">Edit</button>
                <button type="button" id="btnNew" class="btn btn-sap" onclick="addNewRow()" disabled>New entries</button>
                <button type="button" id="btnSave" class="btn btn-sap" onclick="handleSave()" disabled>Save</button>
                <button type="button" id="btnDelete" class="btn btn-sap text-danger" onclick="handleDelete()" disabled>Delete</button>
            </div>
        </div>

        <div class="table-container">
            <table class="table-sap">
                <thead>
                    <tr>
                        <th style="width: 35px;">Sel</th>
                        <th style="width: 220px;">BP type</th>
                        <th style="width: 120px;">Prefix</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Current</th>
                    </tr>
                </thead>
                <tbody id="gridBody">
                    @for (int i = 0; i < safeModel.Count; i++)
                    {
                        <tr>
                            <td class="col-sel" onclick="selectRow(this)">
                                <input type="hidden" name="[@i].RangeID" value="@safeModel[i].RangeID" class="row-id" />
                            </td>
                            <td>
                                <select name="[@i].BPTypeId" class="sap-input" disabled data-required="true">
                                    <option value="">Select type</option>
                                    @foreach (var opt in typeList)
                                    {
                                        var sel = safeModel[i].BPTypeId is int tid && opt.Value == tid.ToString();
                                        if (sel)
                                        {
                                            <option value="@opt.Value" selected>@opt.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Value">@opt.Text</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input name="[@i].Prefix" class="sap-input" value="@safeModel[i].Prefix" readonly /></td>
                            <td><input name="[@i].StartNumber" class="sap-input sap-range-input" value="@safeModel[i].StartNumber" readonly maxlength="10" data-required="true" /></td>
                            <td><input name="[@i].EndNumber" class="sap-input sap-range-input" value="@safeModel[i].EndNumber" readonly maxlength="10" data-required="true" /></td>
                            <td><input name="[@i].CurrentNumber" class="sap-input sap-always-readonly" value="@safeModel[i].CurrentNumber" readonly /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    :root {
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
        --sap-focus: #fff9c4;
    }
    .sap-window { background: white; border: 1px solid var(--sap-border); display: flex; flex-direction: column; min-height: 420px; }
    .sap-toolbar { padding: 12px; border-bottom: 2px solid var(--sap-border); background: #fff; display: flex; justify-content: flex-end; align-items: center; }
    .btn-sap { border-radius: 2px; font-size: 12px; border: 1px solid #bbb; margin-right: 5px; background: #fdfdfd; cursor: pointer; }
    .btn-sap:disabled { opacity: 0.4; cursor: default; }
    .table-container { overflow-y: auto; flex-grow: 1; }
    .table-sap { width: 100%; border-collapse: collapse; }
    .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; text-align: left; }
    .table-sap td { border: 1px solid #ccc; padding: 0; height: 30px; }
    .sap-input { width: 100%; height: 100%; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    .edit-mode .sap-input:not([readonly]):not([disabled]) { background: #fff; }
    .edit-mode .sap-input:not([readonly]):not([disabled]):focus { background: var(--sap-focus); outline: 1px solid orange; }
    .sap-always-readonly { background: var(--sap-readonly) !important; }
    .col-sel { width: 35px; background: #f0f0f0; cursor: pointer; }
    .row-selected { background-color: var(--sap-selected) !important; }
    .row-selected .sap-input { background-color: transparent !important; }
    .row-validation-error td { background-color: #fce4e4 !important; }
    .row-validation-error .sap-input { background-color: transparent !important; }
    .row-validation-error .sap-input[data-required].sap-invalid,
    .row-validation-error select[data-required].sap-invalid { outline: 2px solid #c62828 !important; background: #fff0f0 !important; }
</style>
<script>
    let isEditMode = false;
    let selectedRow = null;
    let rowCount = @(safeModel.Count);

    const typeOptionsList = @Html.Raw(typeOptsJson);
    function buildTypeSelectOptionsHtml() {
        let html = '<option value="">Select type</option>';
        typeOptionsList.forEach(function (o) {
            const v = String(o.value ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
            const t = String(o.text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;');
            html += '<option value="' + v + '">' + t + '</option>';
        });
        return html;
    }

    function setMode(edit) {
        isEditMode = edit;
        document.getElementById('app').classList.toggle('edit-mode', edit);
        document.querySelectorAll('.sap-input').forEach(input => {
            if (input.classList.contains('sap-always-readonly')) return;
            if (input.tagName === 'SELECT') input.disabled = !edit;
            else input.readOnly = !edit;
        });
        document.getElementById('btnEdit').disabled = edit;
        document.getElementById('btnNew').disabled = !edit;
        document.getElementById('btnSave').disabled = !edit;
        var f = document.getElementById('bpTypeNrForm');
        if (f && typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(f);
    }

    function enforceDigitLimit(input) {
        input.addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
        });
    }
    document.querySelectorAll('.sap-range-input').forEach(enforceDigitLimit);

    function addNewRow() {
        const body = document.getElementById('gridBody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="col-sel" onclick="selectRow(this)">
                <input type="hidden" name="[${rowCount}].RangeID" value="0" class="row-id" />
            </td>
            <td><select name="[${rowCount}].BPTypeId" class="sap-input" data-required="true">${buildTypeSelectOptionsHtml()}</select></td>
            <td><input name="[${rowCount}].Prefix" class="sap-input" /></td>
            <td><input name="[${rowCount}].StartNumber" class="sap-input sap-range-input" maxlength="10" data-required="true"></td>
            <td><input name="[${rowCount}].EndNumber" class="sap-input sap-range-input" maxlength="10" data-required="true"></td>
            <td><input name="[${rowCount}].CurrentNumber" class="sap-input sap-always-readonly" readonly></td>`;
        body.appendChild(tr);
        rowCount++;

        tr.querySelectorAll('.sap-range-input').forEach(enforceDigitLimit);

        var startInp = tr.querySelector('[name$=".StartNumber"]');
        var curInp = tr.querySelector('[name$=".CurrentNumber"]');
        if (startInp && curInp) {
            startInp.addEventListener('input', function () {
                var v = parseInt(startInp.value, 10);
                curInp.value = isNaN(v) ? '' : (v + 1);
            });
        }

        if (isEditMode) {
            tr.querySelectorAll('select.sap-input').forEach(s => { s.disabled = false; });
            tr.querySelectorAll('input.sap-input:not(.sap-always-readonly)').forEach(inp => { inp.readOnly = false; });
        }
        tr.querySelector('select.sap-input')?.focus();
    }

    function selectRow(cell) {
        if (!isEditMode) return;
        if (selectedRow) selectedRow.classList.remove('row-selected');
        selectedRow = cell.parentElement;
        selectedRow.classList.add('row-selected');
        document.getElementById('btnDelete').disabled = false;
    }

    function collectInvalidBpNrRows() {
        var bad = [];
        document.querySelectorAll('#gridBody tr').forEach(tr => {
            tr.querySelectorAll('[data-required]').forEach(inp => {
                var val = inp.value ? inp.value.trim() : '';
                if (!val) bad.push(inp);
            });
        });
        return bad;
    }

    var existingBPTypeSet = new Set(@Html.Raw(existingBPTypeIdsJson));

    function checkDuplicateTypes() {
        var dupes = [];
        document.querySelectorAll('#gridBody tr').forEach(tr => {
            var rid = tr.querySelector('.row-id');
            var isNew = !rid || !rid.value || rid.value === '0';
            if (!isNew) return;
            var sel = tr.querySelector('select[name$=".BPTypeId"]');
            var code = sel ? sel.value : '';
            if (code && existingBPTypeSet.has(code)) {
                var opt = sel.options[sel.selectedIndex];
                dupes.push(opt ? opt.text : code);
            }
        });
        return dupes;
    }

    function submitSave() {
        var form = document.getElementById('bpTypeNrForm');
        document.querySelectorAll('.sap-input, select').forEach(i => { i.disabled = false; i.readOnly = false; });
        var fd = new FormData(form);
        fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (data.success) { location.reload(); }
                else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], data.message || 'Save failed');
                else alert(data.message || 'Save failed');
            })
            .catch(() => {
                if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], 'Request failed');
                else alert('Request failed');
            });
    }

    function handleSave() {
        var form = document.getElementById('bpTypeNrForm');
        if (typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(form);
        var bad = collectInvalidBpNrRows();
        if (bad.length) {
            if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, bad);
            return;
        }
        var dupes = checkDuplicateTypes();
        if (dupes.length > 0) {
            var msg = 'A range for the following type(s) already exists:\n' + dupes.join(', ') + '\n\nDo you still want to save?';
            if (typeof window.materialShowDeleteConfirmModalThen === 'function')
                window.materialShowDeleteConfirmModalThen(msg, submitSave);
            else if (confirm(msg)) submitSave();
        } else {
            submitSave();
        }
    }

    function handleDelete() {
        if (!selectedRow) return;
        const hid = selectedRow.querySelector('.row-id');
        const rangeId = hid ? parseInt(hid.value, 10) : 0;
        function doDelete() {
            if (rangeId > 0) {
                $.post('@Url.Action("DeleteBPTypeNumberRange", "BP")', { id: rangeId }, function (response) {
                    if (response.success) {
                        selectedRow.remove(); selectedRow = null;
                        document.getElementById('btnDelete').disabled = true;
                        reIndexAllRows();
                    } else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(document.getElementById('bpTypeNrForm'), [], response.message || 'Delete failed');
                    else alert(response.message || 'Delete failed');
                });
            } else {
                selectedRow.remove(); selectedRow = null;
                document.getElementById('btnDelete').disabled = true;
                reIndexAllRows();
            }
        }
        if (typeof window.materialShowDeleteConfirmModalThen === 'function')
            window.materialShowDeleteConfirmModalThen('Do you want to delete this BP range?', doDelete);
        else if (confirm('Delete this entry?')) doDelete();
    }

    function reIndexAllRows() {
        const rows = document.querySelectorAll('#gridBody tr');
        rows.forEach((row, idx) => {
            row.querySelectorAll('[name]').forEach(el => {
                if (el.name.includes('.')) {
                    const property = el.name.split('.').slice(1).join('.');
                    el.name = `[${idx}].${property}`;
                }
            });
        });
        rowCount = rows.length;
    }

    document.querySelectorAll('select.sap-input').forEach(function (s) { s.disabled = true; });
</script>
