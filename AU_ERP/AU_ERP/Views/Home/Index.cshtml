@{
    ViewData["Title"] = "Home";
    var isAdmin = User?.HasClaim(AuClaimTypes.Department, "Admin") == true;
    var isProd = User?.HasClaim(AuClaimTypes.Department, "Production") == true;
    var isAuth = User?.Identity?.IsAuthenticated == true;
}

@if (!isAuth)
{
    <div class="text-center">
        <h1 class="h3 mb-3">Welcome</h1>
        <p class="text-muted">Sign in to continue.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
    </div>
}
else if (!isAdmin && !isProd)
{
    <div>
        <h1 class="h4 mb-2">No modules available</h1>
        <p class="text-muted mb-0">Your account is not assigned to the Admin or Production department. You only have access to this page. Contact an administrator if you need access to master data, configuration, or production features.</p>
    </div>
}
else
{
    <div>
        <h1 class="h4 mb-3">Home</h1>
        <p class="text-muted">Use the sidebar to open a module. Your access depends on your department: Admin (master data, users, configuration, stock), and/or Production (MRP, production order, operation tracking).</p>
    </div>
}
