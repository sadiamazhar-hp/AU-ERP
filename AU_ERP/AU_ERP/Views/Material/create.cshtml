@model AU_ERP.Models.CreateMaterialMaster
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json

@{
    ViewData["Title"] = "SAP MM01 – Create Material";
    var uomAltOptsClassicJson = JsonSerializer.Serialize(
        (ViewBag.UomIdList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
        .Select(x => new { value = x.Value ?? "", text = x.Text ?? "" }));
    var mrpTypeItemsClassic = new List<SelectListItem>
    {
        new() { Text = "Standard", Value = "STANDARD" },
        new() { Text = "No Planning", Value = "NO_PLANNING" }
    };
    var strategyGroupItemsClassic = new List<SelectListItem>
    {
        new() { Text = "Make to Stop (MTS)", Value = "MTS" }
    };
    var plantItemsClassic = (ViewBag.PlantList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var procurementItemsClassic = (ViewBag.ProcurementTypeList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var itemCategoryItemsClassic = (ViewBag.ItemCategoryGroupList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var purchasingGroupItemsClassic = (ViewBag.PurchasingGroupSelectList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var grProcessingUomItemsClassic = (ViewBag.GrProcessingUomList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --sap-bg: #cedbe9;
            --sap-header: #a3b8cc;
            --sap-border: #8ca3ba;
            --sap-yellow: #fff9c4;
            --sap-readonly: #f4f4f4;
        }

        .sap-window {
            background: #fff;
            min-height: min(70vh, 720px);
            margin: 0;
            border: 1px solid var(--sap-border);
            display: flex;
            flex-direction: column;
        }

        .sap-header {
            background: linear-gradient(#fff,var(--sap-header));
            padding: 10px;
            font-size: 16px;
            font-weight: bold;
            border-bottom: 1px solid var(--sap-border);
        }

        .sap-menu {
            background: #eee;
            padding: 8px;
            border-bottom: 1px solid var(--sap-border);
        }

        .sap-btn {
            font-size: 13px;
            padding: 5px 12px;
            margin-right: 6px;
            border: 1px solid #ababab;
            background: #fff;
        }

        /* Top Navigation Tabs (Create/List) */
        .top-nav-bar {
            background-color: #f8f9fa;
            border-bottom: 1px solid var(--sap-border);
            padding: 5px 15px 0 15px;
        }

        /* SAP Sub-Tabs (Basic Data/Sales) */
        .nav-tabs .nav-link {
            font-size: 12px;
            padding: 6px 12px;
            background: #c8d7e6;
            color: #333;
            border: 1px solid var(--sap-border);
            margin-right: 2px;
            border-radius: 0;
        }

            .nav-tabs .nav-link.active {
                background: #fff;
                font-weight: bold;
                border-bottom-color: transparent;
            }

        .tab-content {
            overflow-y: auto;
            padding: 20px;
            flex-grow: 1;
        }

        .sap-frame {
            border: 1px solid var(--sap-border);
            padding: 20px;
            margin-bottom: 25px;
            position: relative;
            background: #fdfdfd;
        }

        .sap-frame-title {
            position: absolute;
            top: -12px;
            left: 15px;
            background: #fff;
            padding: 0 8px;
            font-weight: bold;
            color: #444;
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 2px;
            display: block;
            color: #555;
            font-size: 12px;
        }

        .form-control {
            border-radius: 0;
            height: 28px !important;
            font-size: 13px !important;
            margin-bottom: 10px;
            border: 1px solid #ccc;
        }

        .sap-readonly {
            background-color: var(--sap-readonly) !important;
            color: #666;
            cursor: not-allowed;
        }

        .req {
            border-left: 4px solid #d32f2f !important;
        }

        .status-bar {
            background: #f1f1f1;
            padding: 4px 12px;
            font-size: 12px;
            border-top: 1px solid var(--sap-border);
            min-height: 25px;
        }
    </style>
}

<div class="sap-window">
        <div class="sap-header">🖥️ SAP MM01 – Create Material</div>

        <div class="top-nav-bar">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link active" href="@Url.Action("Create", "Material")" style="border-radius: 4px 4px 0 0; font-weight: bold;">Create</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("GetMaterialList", "Material")">List</a>
                </li>
                <li class="nav-item"><a class="nav-link disabled" href="#">Update</a></li>
                <li class="nav-item"><a class="nav-link disabled" href="#">Delete</a></li>
            </ul>
        </div>

        @using (Html.BeginForm("create", "Material", FormMethod.Post, new { id = "mm01Form" }))
        {
            @Html.ValidationSummary(false, "", new { @class = "text-danger", style = "font-weight:bold; padding: 10px;" })
            <div class="au-validation-summary" style="display:none;" role="alert"></div>
            @Html.AntiForgeryToken()

            <div class="sap-menu">
                <button type="submit" class="btn sap-btn">💾 Save</button>
                <button type="button" class="btn sap-btn" onclick="checkValidations()">✔ Check</button>
            </div>

            <div class="p-3 border-bottom bg-light">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Material Number</label>
                        @Html.TextBoxFor(m => m.MaterialNumber, new { @class = "form-control sap-readonly", @readonly = "readonly", id = "txtMaterialNumber" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Industry Sector</label>
                        @Html.DropDownListFor(m => m.IndustrySectorCode,
                            ViewBag.IndustrySectors as IEnumerable<SelectListItem>,
                            "Select Sector",
                            new { @class = "form-control req" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Material Type</label>
                    @Html.DropDownListFor(m => m.MaterialTypeCode,
                                        ViewBag.MaterialTypeList as IEnumerable<SelectListItem>,
                                        "Select Type",
                                        new { @class = "form-control req", id = "matType", onchange = "onMaterialTypeChange()" })
                    </div>
                </div>
            </div>

            <ul class="nav nav-tabs px-3 pt-2" id="mmTabs">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#basic" type="button">Basic Data</button></li>
                <li class="nav-item" id="nav-sales"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#sales" type="button">Sales</button></li>
                <li class="nav-item" id="nav-purch"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#purch" type="button">Purchasing</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#mrp" type="button">MRP</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#uom" type="button">Units of Measure</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#acc" type="button">Accounting</button></li>
            </ul>

            <div class="tab-content">
                @* BASIC DATA *@
                <div class="tab-pane fade show active" id="basic">
                    <div class="sap-frame">
                        <span class="sap-frame-title">Basic Data 1 & 2</span>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Description</label>
                                @Html.EditorFor(m => m.Description, new { htmlAttributes = new { @class = "form-control req" } })
                                <label class="form-label">Base Unit</label>
                                @Html.EditorFor(m => m.BaseUnitCode, new { htmlAttributes = new { @class = "form-control req", maxlength = "3", id = "BaseUnitCode" } })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Material Group</label>
                                @{
                                    var materialGroupItems = (ViewBag.MaterialGroupList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
                                }
                                @Html.DropDownListFor(m => m.MaterialGroupCode, materialGroupItems, "-- Select --", new { @class = "form-select form-select-sm", id = "MaterialGroupCode" })
                                <label class="form-label">EAN/UPC</label>
                                @Html.EditorFor(m => m.EAN, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                </div>

                @* SALES *@
                <div class="tab-pane fade" id="sales">
                    <div class="sap-frame">
                        <span class="sap-frame-title">Sales Organization Data</span>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Delivering Plant</label>
                                @Html.DropDownListFor(m => m.DeliveringPlantCode, plantItemsClassic, "-- Select --", new { @class = "form-select form-select-sm" })
                                <label class="form-label mt-2">Grade A cost (per base UOM)</label>
                                <div class="input-group input-group-sm mb-1">
                                    @Html.EditorFor(m => m.SalesPriceGradeAPerBaseUom, new { htmlAttributes = new { @class = "form-control form-control-sm mat-sale-pkr", type = "number", min = "0", step = "0.0001" } })
                                    <span class="input-group-text text-muted" id="matSalesBaseUomLabelA">—</span>
                                    <span class="input-group-text">PKR</span>
                                </div>
                                <label class="form-label mt-1 small mb-0">Grade B cost (per base UOM)</label>
                                <div class="input-group input-group-sm mb-1">
                                    @Html.EditorFor(m => m.SalesPriceGradeBPerBaseUom, new { htmlAttributes = new { @class = "form-control form-control-sm mat-sale-pkr", type = "number", min = "0", step = "0.0001" } })
                                    <span class="input-group-text text-muted mat-sales-base-suffix">—</span>
                                    <span class="input-group-text">PKR</span>
                                </div>
                                <label class="form-label mt-1 small mb-0">Grade C cost (per base UOM)</label>
                                <div class="input-group input-group-sm mb-1">
                                    @Html.EditorFor(m => m.SalesPriceGradeCPerBaseUom, new { htmlAttributes = new { @class = "form-control form-control-sm mat-sale-pkr", type = "number", min = "0", step = "0.0001" } })
                                    <span class="input-group-text text-muted mat-sales-base-suffix">—</span>
                                    <span class="input-group-text">PKR</span>
                                </div>
                                <label class="form-label mt-1 small mb-0">Scrap cost (per base UOM)</label>
                                <div class="input-group input-group-sm mb-1">
                                    @Html.EditorFor(m => m.ScrapCostPerBaseUom, new { htmlAttributes = new { @class = "form-control form-control-sm mat-sale-pkr", type = "number", min = "0", step = "0.0001" } })
                                    <span class="input-group-text text-muted mat-sales-base-suffix">—</span>
                                    <span class="input-group-text">PKR</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Item Category Group</label>
                                @Html.DropDownListFor(m => m.ItemCategoryGroup, itemCategoryItemsClassic, "-- Select --", new { @class = "form-select form-select-sm" })
                            </div>
                        </div>
                    </div>
                </div>

                @* PURCHASING *@
                <div class="tab-pane fade" id="purch">
                    <div class="sap-frame">
                        <span class="sap-frame-title">Purchasing Data</span>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Purchasing Group</label>
                                @Html.DropDownListFor(m => m.PurchasingGroupCode, purchasingGroupItemsClassic, "-- Select --", new { @class = "form-select form-select-sm" })
                                <label class="form-label mt-2">GR Processing Time</label>
                                <div class="input-group input-group-sm">
                                    @Html.EditorFor(m => m.GrProcessingTime, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "1" } })
                                    @Html.DropDownListFor(m => m.GrProcessingUom, grProcessingUomItemsClassic, "-- UOM --", new { @class = "form-select", style = "max-width:8rem;" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Lead time</label>
                                <div class="input-group input-group-sm">
                                    @Html.TextBoxFor(m => m.LeadTimeDays, new { @class = "form-control", type = "number", min = "0", step = "1", id = "LeadTimeDaysClassic" })
                                    <span class="input-group-text">days</span>
                                </div>
                                <label class="form-label mt-2">Safety stock</label>
                                <div class="input-group input-group-sm">
                                    @Html.TextBoxFor(m => m.SafetyStock, new { @class = "form-control", type = "number", step = "0.0001", id = "SafetyStockClassic" })
                                    <span class="input-group-text" id="mrpSafetyUomClassic">—</span>
                                </div>
                                <label class="form-label mt-2">Reorder point</label>
                                <div class="input-group input-group-sm">
                                    @Html.TextBoxFor(m => m.ReorderPoint, new { @class = "form-control", type = "number", min = "0", step = "1", id = "ReorderPointClassic" })
                                    <span class="input-group-text" id="mrpReorderUomClassic">—</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* MRP *@
                <div class="tab-pane fade" id="mrp">
                    <div class="sap-frame">
                        <span class="sap-frame-title">MRP Data</span>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">MRP Type</label>
                                @Html.DropDownListFor(m => m.MrpTypeCode, mrpTypeItemsClassic, "-- Select --", new { @class = "form-select form-select-sm" })
                                <label class="form-label mt-2">Procurement Type</label>
                                @Html.DropDownListFor(m => m.ProcurementTypeCode, procurementItemsClassic, "-- Select --", new { @class = "form-select form-select-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Strategy Group</label>
                                @Html.DropDownListFor(m => m.StrategyGroup, strategyGroupItemsClassic, "-- Select --", new { @class = "form-select form-select-sm" })
                            </div>
                        </div>
                    </div>
                </div>

                @* UNITS OF MEASURE *@
                <div class="tab-pane fade" id="uom">
                    <div class="sap-frame">
                        <span class="sap-frame-title">Unit Conversions</span>
                        <table class="mat-uom-table" id="uomTable">
                            <thead>
                                <tr>
                                    <th>Alt. Unit</th>
                                    <th>Numerator</th>
                                    <th style="width:3rem;">=</th>
                                    <th>Denominator</th>
                                    <th>Base Unit</th>
                                    <th style="width:4.5rem;">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <button type="button" class="btn btn-sm btn-success mat-uom-add-row-btn" onclick="addUomRow()">+ Add Row</button>
                    </div>
                </div>

                @* ACCOUNTING *@
                <div class="tab-pane fade" id="acc">
                    <div class="sap-frame">
                        <span class="sap-frame-title">Valuation</span>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Valuation Class</label>
                                @Html.EditorFor(m => m.ValuationClassCode, new { htmlAttributes = new { @class = "form-control req" } })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="status-bar" id="statusBar">Ready</div>
        }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    let uomIndex = 0;
    const uomAltOptionListClassic = @Html.Raw(uomAltOptsClassicJson);
    function buildUomAltSelectClassic(index) {
        function esc(s) {
            if (s == null || s === undefined) return "";
            return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
        }
        var opts = '<option value="0">-- Select UOM --</option>';
        (uomAltOptionListClassic || []).forEach(function (o) {
            var v = String(o.value ?? "");
            opts += '<option value="' + esc(v) + '">' + esc(String(o.text ?? "")) + '</option>';
        });
        return '<select name="Conversions[' + index + '].AltUnitId" class="form-select form-select-sm">' + opts + '</select>';
    }

    function onMaterialTypeChange() {
        handleTabVisibility();
        fetchNextMaterialNumber();
    }

    function handleTabVisibility() {
        const type = document.getElementById("matType").value;
        const salesTab = document.getElementById("nav-sales");
        const purchTab = document.getElementById("nav-purch");

        if (!salesTab || !purchTab) return;

        salesTab.style.display = "block";
        purchTab.style.display = "block";

        if (type === "ROH" || type === "HALB" || type === "VERP") {
            salesTab.style.display = "none";
        } else if (type === "FERT") {
            purchTab.style.display = "none";
        }
    }

    function fetchNextMaterialNumber() {
        const typeCode = document.getElementById("matType").value;
        const statusBox = document.getElementById("statusBar");

        if (!typeCode) {
            document.getElementById("txtMaterialNumber").value = "";
            return;
        }

        if (statusBox) statusBox.innerText = "⏳ Fetching next material number...";

        $.ajax({
            url: '@Url.Action("GetNextMaterialNumber", "Material")',
            type: 'GET',
            data: { materialTypeCode: typeCode },
            success: function (response) {
                if (response.success) {
                    document.getElementById("txtMaterialNumber").value = response.nextNumber;
                    if (statusBox) statusBox.innerText = "✔ Material number assigned: " + response.nextNumber;
                } else {
                    document.getElementById("txtMaterialNumber").value = "";
                    if (statusBox) statusBox.innerText = "❌ Error: " + response.message;
                }
            },
            error: function () {
                if (statusBox) statusBox.innerText = "❌ Communication error with server.";
            }
        });
    }

    function addUomRow() {
        const tbody = document.querySelector("#uomTable tbody");
        const baseUomField = document.getElementById("BaseUnitCode");
        const baseUomValue = baseUomField && String(baseUomField.value || "").trim();
        if (!baseUomValue) {
            const form = document.getElementById("mm01Form");
            const msg = "Select a base unit of measure (Basic Data) before adding a conversion row.";
            if (form && typeof window.auShowInlineValidation === "function")
                window.auShowInlineValidation(form, [], msg);
            else alert(msg);
            return;
        }

        const rowId = `row_${uomIndex}`;
        const idx = uomIndex;
        const html = `
            <tr id="${rowId}">
                <td>${buildUomAltSelectClassic(idx)}</td>
                <td><input name="Conversions[${uomIndex}].Numerator" class="form-control form-control-sm" type="number" /></td>
                <td class="mat-uom-eq">=</td>
                <td><input name="Conversions[${uomIndex}].Denominator" class="form-control form-control-sm" value="1" type="number" /></td>
                <td><input class="form-control form-control-sm sap-readonly" value="${baseUomValue}" readonly /></td>
                <td class="mat-uom-action"><button type="button" class="btn btn-danger btn-sm" onclick="document.getElementById('${rowId}').remove()">X</button></td>
            </tr>`;

        tbody.insertAdjacentHTML('beforeend', html);
        uomIndex++;
        const formAfter = document.getElementById("mm01Form");
        if (formAfter && typeof window.auClearInlineValidation === "function")
            window.auClearInlineValidation(formAfter);
        document.getElementById("statusBar").innerText = "Row added to Conversion table.";
    }

    function checkValidations() {
        document.getElementById("statusBar").innerText = "✔ Validating entries...";
    }

    function syncMrpQtyFieldsClassic() {
        const baseEl = document.getElementById("BaseUnitCode");
        const code = baseEl && String(baseEl.value || "").trim();
        const has = !!code;
        const lblS = document.getElementById("mrpSafetyUomClassic");
        const lblR = document.getElementById("mrpReorderUomClassic");
        if (lblS) lblS.textContent = has ? code : "—";
        if (lblR) lblR.textContent = has ? code : "—";
        const safety = document.getElementById("SafetyStockClassic");
        const reorder = document.getElementById("ReorderPointClassic");
        if (safety) {
            safety.readOnly = !has;
            if (!has) safety.value = "";
        }
        if (reorder) {
            reorder.readOnly = !has;
            if (!has) reorder.value = "";
        }
    }

    function syncMatSalesFromBase() {
        const baseEl = document.getElementById("BaseUnitCode");
        const code = baseEl && String(baseEl.value || "").trim();
        const has = !!code;
        const dis = (code) => (has ? code : "—");
        const l1 = document.getElementById("matSalesBaseUomLabelA");
        if (l1) l1.textContent = dis(code);
        document.querySelectorAll("#sales .mat-sales-base-suffix").forEach(function (s) { s.textContent = dis(code); });
        document.querySelectorAll("#sales .mat-sale-pkr").forEach(function (el) {
            el.readOnly = !has;
            el.classList.toggle("bg-light", !has);
            if (!has) el.value = "";
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        handleTabVisibility();
        const bu = document.getElementById("BaseUnitCode");
        if (bu) {
            bu.addEventListener("input", function () { syncMrpQtyFieldsClassic(); syncMatSalesFromBase(); });
            bu.addEventListener("change", function () { syncMrpQtyFieldsClassic(); syncMatSalesFromBase(); });
        }
        syncMrpQtyFieldsClassic();
        syncMatSalesFromBase();

        // Success (Materials/Create POST redirect)
        var message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"] as string ?? ""));
        if (message && typeof window.materialShowSuccessModal === "function") {
            window.materialShowSuccessModal(message);
            const statusBar = document.getElementById("statusBar");
            if (statusBar) {
                statusBar.innerText = "✔ " + message;
                statusBar.style.color = "#3a7d81";
            }
        }
    });
    </script>
}