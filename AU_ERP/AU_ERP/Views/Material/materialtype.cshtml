@model List<AU_ERP.Models.MaterialType>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Material Types";
    ViewBag.Title = "Material Types";
    var safeModel = Model ?? new List<AU_ERP.Models.MaterialType>();
}

<div class="sap-window" id="app">
    <form id="mm01Form" method="post" action="@Url.Action("MaterialType", "Material")">
        @Html.AntiForgeryToken()
        <div class="au-validation-summary" style="display:none;" role="alert"></div>

        <div class="sap-toolbar">
            <div class="d-flex">
                <button type="button" id="btnEdit" class="btn btn-sap" onclick="setMode(true)">Edit</button>
                <button type="button" id="btnNew" class="btn btn-sap" onclick="addNewRow()" disabled>New Entries</button>
                <button type="button" id="btnSave" class="btn btn-sap" onclick="handleSave()" disabled>Save</button>
                <button type="button" id="btnDelete" class="btn btn-sap text-danger" onclick="handleDelete()" disabled>Delete</button>
            </div>
        </div>

        <div class="table-container">
            <table class="table-sap">
                <thead>
                    <tr>
                        <th style="width: 35px;">Sel</th>
                        <th style="width: 150px;">MTyp</th>
                        <th>Description</th>
                        <th style="width: 200px;">Field Ref</th>
                        <th style="width: 460px;">Enabled Tabs</th>
                    </tr>
                </thead>
                <tbody id="gridBody">
                    @for (int i = 0; i < safeModel.Count; i++)
                    {
                        <tr>
                            <td class="col-sel" onclick="selectRow(this)"></td>
                            <td>
                                <input name="[@i].MaterialTypeCode" class="sap-input" value="@safeModel[i].MaterialTypeCode" readonly maxlength="4" data-required="true" />
                            </td>
                            <td>
                                <input name="[@i].Description" class="sap-input" value="@safeModel[i].Description" readonly data-required="true" />
                            </td>
                            <td>
                                <input name="[@i].FieldReference" class="sap-input" value="@safeModel[i].FieldReference" readonly maxlength="4" />
                            </td>
                            <td class="px-2">
                                @{
                                    var enabled = new HashSet<string>(safeModel[i].EnabledTabs ?? new List<string>(), StringComparer.OrdinalIgnoreCase);
                                }
                                <label class="form-check form-check-inline m-0 me-2">
                                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[@i].EnabledTabs" value="BasicData" @(enabled.Contains("BasicData") ? "checked" : "") disabled />
                                    <span class="small">Basic Data</span>
                                </label>
                                <label class="form-check form-check-inline m-0 me-2">
                                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[@i].EnabledTabs" value="Sales" @(enabled.Contains("Sales") ? "checked" : "") disabled />
                                    <span class="small">Sales</span>
                                </label>
                                <label class="form-check form-check-inline m-0 me-2">
                                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[@i].EnabledTabs" value="Purchasing" @(enabled.Contains("Purchasing") ? "checked" : "") disabled />
                                    <span class="small">Purchasing</span>
                                </label>
                                <label class="form-check form-check-inline m-0 me-2">
                                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[@i].EnabledTabs" value="MRP" @(enabled.Contains("MRP") ? "checked" : "") disabled />
                                    <span class="small">MRP</span>
                                </label>
                                <label class="form-check form-check-inline m-0">
                                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[@i].EnabledTabs" value="Accounting" @(enabled.Contains("Accounting") ? "checked" : "") disabled />
                                    <span class="small">Accounting</span>
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    :root {
        --sap-bg: #e5ebf1;
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
        --sap-focus: #fff9c4;
    }
    .sap-window { background: white; border: 1px solid var(--sap-border); display: flex; flex-direction: column; min-height: 420px; }
    .sap-toolbar { padding: 12px; border-bottom: 2px solid var(--sap-border); background: #fff; display: flex; justify-content: flex-end; align-items: center; }
    .btn-sap { border-radius: 2px; font-size: 12px; border: 1px solid #bbb; margin-right: 5px; background: #fdfdfd; cursor: pointer; }
    .btn-sap:disabled { opacity: 0.4; cursor: default; }
    .table-container { overflow-y: auto; flex-grow: 1; }
    .table-sap { width: 100%; border-collapse: collapse; }
    .table-sap th { background: var(--sap-header-bg); border: 1px solid #ccc; padding: 6px 10px; font-weight: normal; text-align: left; }
    .table-sap td { border: 1px solid #ccc; padding: 0; height: 30px; }
    .sap-input { width: 100%; height: 100%; border: none; padding: 0 10px; background: var(--sap-readonly); outline: none; box-sizing: border-box; }
    .edit-mode .sap-input:not([readonly]) { background: #fff; }
    .edit-mode .sap-input:focus { background: var(--sap-focus); outline: 1px solid orange; }
    .col-sel { width: 35px; background: #f0f0f0; cursor: pointer; }
    .row-selected { background-color: var(--sap-selected) !important; }
    .row-selected .sap-input { background-color: transparent !important; }
    .row-validation-error td { background-color: #fce4e4 !important; }
    .row-validation-error .sap-input { background-color: transparent !important; }
    .row-validation-error .sap-input[data-required].sap-invalid { outline: 2px solid #c62828 !important; background: #fff0f0 !important; }
</style>
<script>
    let isEditMode = false;
    let selectedRow = null;
    let rowCount = @(safeModel.Count);

    function setMode(edit) {
        isEditMode = edit;
        document.getElementById('app').classList.toggle('edit-mode', edit);
        document.querySelectorAll('.sap-input').forEach(input => { input.readOnly = !edit; });
        document.querySelectorAll('.mt-enabled-tab').forEach(input => { input.disabled = !edit; });
        document.getElementById('btnEdit').disabled = edit;
        document.getElementById('btnNew').disabled = !edit;
        document.getElementById('btnSave').disabled = !edit;
        var f = document.getElementById('mm01Form');
        if (f && typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(f);
    }

    function addNewRow() {
        const body = document.getElementById('gridBody');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="col-sel" onclick="selectRow(this)"></td>
            <td><input name="[${rowCount}].MaterialTypeCode" class="sap-input" maxlength="4" data-required="true"></td>
            <td><input name="[${rowCount}].Description" class="sap-input" data-required="true"></td>
            <td><input name="[${rowCount}].FieldReference" class="sap-input" maxlength="4"></td>
            <td class="px-2">
                <label class="form-check form-check-inline m-0 me-2">
                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[${rowCount}].EnabledTabs" value="BasicData">
                    <span class="small">Basic Data</span>
                </label>
                <label class="form-check form-check-inline m-0 me-2">
                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[${rowCount}].EnabledTabs" value="Sales">
                    <span class="small">Sales</span>
                </label>
                <label class="form-check form-check-inline m-0 me-2">
                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[${rowCount}].EnabledTabs" value="Purchasing">
                    <span class="small">Purchasing</span>
                </label>
                <label class="form-check form-check-inline m-0 me-2">
                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[${rowCount}].EnabledTabs" value="MRP">
                    <span class="small">MRP</span>
                </label>
                <label class="form-check form-check-inline m-0">
                    <input type="checkbox" class="form-check-input mt-enabled-tab" name="[${rowCount}].EnabledTabs" value="Accounting">
                    <span class="small">Accounting</span>
                </label>
            </td>`;
        body.appendChild(tr);
        rowCount++;
        tr.querySelectorAll('.mt-enabled-tab').forEach(input => { input.disabled = !isEditMode; });
        tr.querySelector('input').focus();
    }

    function selectRow(cell) {
        if (!isEditMode) return;
        if (selectedRow) selectedRow.classList.remove('row-selected');
        selectedRow = cell.parentElement;
        selectedRow.classList.add('row-selected');
        document.getElementById('btnDelete').disabled = false;
    }

    function collectInvalidMaterialTypeRows() {
        var bad = [];
        document.querySelectorAll('#gridBody tr').forEach(tr => {
            tr.querySelectorAll('.sap-input[data-required]').forEach(inp => {
                if (!inp.value.trim()) bad.push(inp);
            });
            var tabChecks = tr.querySelectorAll('.mt-enabled-tab');
            if (tabChecks.length > 0 && !Array.from(tabChecks).some(chk => chk.checked)) {
                bad.push(tabChecks[0]);
            }
        });
        return bad;
    }

    function handleSave() {
        var form = document.getElementById('mm01Form');
        if (typeof window.auClearInlineValidation === 'function') window.auClearInlineValidation(form);
        var bad = collectInvalidMaterialTypeRows();
        if (bad.length) {
            if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, bad);
            return;
        }
        document.querySelectorAll('.sap-input').forEach(i => { i.readOnly = false; });
        var fd = new FormData(form);
        fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                if (data.success) { location.reload(); }
                else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], data.message || 'Save failed');
                else alert(data.message || 'Save failed');
            })
            .catch(() => {
                if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(form, [], 'Request failed');
                else alert('Request failed');
            });
    }

    function handleDelete() {
        if (!selectedRow) return;
        const mTypeCode = selectedRow.querySelector('input[name*="MaterialTypeCode"]').value;
        function doDelete() {
            if (mTypeCode) {
                $.post('/Material/DeleteMaterialType', { id: mTypeCode }, function (response) {
                    if (response.success) {
                        selectedRow.remove(); selectedRow = null;
                        document.getElementById('btnDelete').disabled = true;
                        reIndexAllRows();
                        if (typeof window.materialShowSuccessModal === 'function')
                            window.materialShowSuccessModal(response.message || 'Deleted !');
                    } else if (typeof window.auShowInlineValidation === 'function') window.auShowInlineValidation(document.getElementById('mm01Form'), [], response.message || 'Delete failed');
                    else alert(response.message || 'Delete failed');
                });
            } else {
                selectedRow.remove(); selectedRow = null; reIndexAllRows();
            }
        }
        if (typeof window.materialShowDeleteConfirmModalThen === 'function')
            window.materialShowDeleteConfirmModalThen('Do you want to delete this Material Type?', doDelete);
        else if (confirm('Delete this entry?')) doDelete();
    }

    function reIndexAllRows() {
        const rows = document.querySelectorAll('#gridBody tr');
        rows.forEach((row, index) => {
            const inputs = row.querySelectorAll('input');
            if (inputs.length >= 3) {
                inputs[0].name = `[${index}].MaterialTypeCode`;
                inputs[1].name = `[${index}].Description`;
                inputs[2].name = `[${index}].FieldReference`;
            }
            row.querySelectorAll('.mt-enabled-tab').forEach(chk => {
                chk.name = `[${index}].EnabledTabs`;
            });
        });
        rowCount = rows.length;
    }
</script>
