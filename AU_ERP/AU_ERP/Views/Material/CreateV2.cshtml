@model AU_ERP.Models.CreateMaterialMaster
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@{
    Layout = null;
    var createV2Embedded = ViewBag.CreateV2Embedded as bool? == true;
    var v2IdSuffixRaw = (ViewBag.CreateV2IdSuffix as string ?? "").Trim();
    var V2IdAffix = string.IsNullOrEmpty(v2IdSuffixRaw) ? "" : ("-" + v2IdSuffixRaw);
    var v2HandlerKey = string.IsNullOrEmpty(V2IdAffix) ? "Main" : "Modal";
    var uomAltOptsJson = JsonSerializer.Serialize(
        (ViewBag.UomIdList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
        .Select(x => new { value = x.Value ?? "", text = x.Text ?? "" }));
    var mrpTypeItemsV2 = new List<SelectListItem>
    {
        new() { Text = "Standard", Value = "STANDARD" },
        new() { Text = "No Planning", Value = "NO_PLANNING" }
    };
    var strategyGroupItemsV2 = new List<SelectListItem>
    {
        new() { Text = "Make to Stop (MTS)", Value = "MTS" }
    };
    var plantItemsV2 = (ViewBag.PlantList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var procurementItemsV2 = (ViewBag.ProcurementTypeList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var itemCategoryItemsV2 = (ViewBag.ItemCategoryGroupList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var purchasingGroupItemsV2 = (ViewBag.PurchasingGroupSelectList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
    var grProcessingUomItemsV2 = (ViewBag.GrProcessingUomList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
}
<style>
    .au-create-v2-modal .modal-header {
        border-bottom: 1px solid rgba(56, 128, 135, 0.25);
        background: var(--au-white, #f6f6f2);
    }
    .au-create-v2-modal .modal-title {
        font-weight: 600;
        color: var(--au-black, #171717);
    }
    .au-create-v2-modal .nav-tabs {
        border-bottom: 1px solid rgba(56, 128, 135, 0.35);
        flex-wrap: wrap;
        gap: 0.15rem;
    }
    .au-create-v2-modal .nav-tabs .nav-link {
        color: var(--au-primary-dark, #388087);
        border: 1px solid transparent;
        border-radius: 0.35rem 0.35rem 0 0;
    }
    .au-create-v2-modal .nav-tabs .nav-link:hover {
        border-color: rgba(56, 128, 135, 0.25);
    }
    .au-create-v2-modal .nav-tabs .nav-link.active {
        color: var(--au-black, #171717);
        font-weight: 600;
        background: #fff;
        border-color: rgba(56, 128, 135, 0.35);
        border-bottom-color: #fff;
        margin-bottom: -1px;
    }
    .au-create-v2-modal .tab-content {
        padding: 1rem 0 0;
    }
    .au-create-v2-modal .v2-frame {
        border: 1px solid rgba(56, 128, 135, 0.28);
        border-radius: 0.35rem;
        padding: 1rem;
        margin-bottom: 1rem;
        background: rgba(255, 255, 255, 0.9);
    }
    .au-create-v2-modal .v2-frame-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--au-primary-dark, #388087);
        margin-bottom: 0.75rem;
    }
    .au-create-v2-modal .form-label {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--au-black, #171717);
        margin-bottom: 0.25rem;
    }
    .au-create-v2-modal .form-control {
        font-size: 0.875rem;
        border-radius: 0.25rem;
        border-color: rgba(56, 128, 135, 0.35);
    }
    .au-create-v2-modal .sap-readonly {
        background-color: #f0f0f0 !important;
    }
    .au-create-v2-modal .req {
        border-left: 3px solid #c62828;
    }
    .au-create-v2-modal .v2-status {
        font-size: 0.75rem;
        color: var(--au-primary-dark, #388087);
        margin-top: 0.5rem;
        min-height: 1.25rem;
    }
    .au-create-v2-modal .modal-footer {
        border-top: 1px solid rgba(56, 128, 135, 0.25);
        background: var(--au-white, #f6f6f2);
    }
    .au-create-v2-embedded {
        border-radius: 0.5rem;
        max-height: min(78vh, 900px);
        display: flex;
        flex-direction: column;
    }
    .au-create-v2-embedded .modal-body {
        overflow-y: auto;
        flex: 1;
        min-height: 0;
    }
</style>

@using (Html.BeginForm("CreateV2", "Material", FormMethod.Post, new { id = "createMaterialV2Form" + V2IdAffix, @class = createV2Embedded ? "card border-0 shadow-sm au-create-v2-modal au-create-v2-embedded" : "modal-content au-create-v2-modal" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="OriginalMaterialNumber" id="@("createV2OriginalMaterialNumber" + V2IdAffix)" value="" />
    <div class="modal-header">
        <h5 class="modal-title" id="@("materialCreateV2Title" + V2IdAffix)">Create material</h5>
        @if (!createV2Embedded)
        {
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        }
    </div>
    <div class="modal-body">
        @Html.ValidationSummary(false, "", new { @class = "text-danger small mb-2" })
        <div class="au-validation-summary" id="@("v2AuVal" + V2IdAffix)" style="display:none;" role="alert"></div>

        <ul class="nav nav-tabs flex-wrap" id="@("createV2Tabs" + V2IdAffix)" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="@("v2info-tab" + V2IdAffix)" data-bs-toggle="tab" data-bs-target="#@("v2info" + V2IdAffix)" type="button" role="tab" aria-controls="@("v2info" + V2IdAffix)" aria-selected="true">Info</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="@("v2basic-tab" + V2IdAffix)" data-bs-toggle="tab" data-bs-target="#@("v2basic" + V2IdAffix)" type="button" role="tab" aria-controls="@("v2basic" + V2IdAffix)" aria-selected="false">Basic Data</button>
            </li>
            <li class="nav-item" role="presentation" id="@("nav-sales-v2" + V2IdAffix)">
                <button class="nav-link" id="@("v2sales-tab" + V2IdAffix)" data-bs-toggle="tab" data-bs-target="#@("v2sales" + V2IdAffix)" type="button" role="tab" aria-controls="@("v2sales" + V2IdAffix)" aria-selected="false">Sales</button>
            </li>
            <li class="nav-item" role="presentation" id="@("nav-purch-v2" + V2IdAffix)">
                <button class="nav-link" id="@("v2purch-tab" + V2IdAffix)" data-bs-toggle="tab" data-bs-target="#@("v2purch" + V2IdAffix)" type="button" role="tab" aria-controls="@("v2purch" + V2IdAffix)" aria-selected="false">Purchasing</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="@("v2mrp-tab" + V2IdAffix)" data-bs-toggle="tab" data-bs-target="#@("v2mrp" + V2IdAffix)" type="button" role="tab" aria-controls="@("v2mrp" + V2IdAffix)" aria-selected="false">MRP</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="@("v2uom-tab" + V2IdAffix)" data-bs-toggle="tab" data-bs-target="#@("v2uom" + V2IdAffix)" type="button" role="tab" aria-controls="@("v2uom" + V2IdAffix)" aria-selected="false">Units of Measure</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="@("v2acc-tab" + V2IdAffix)" data-bs-toggle="tab" data-bs-target="#@("v2acc" + V2IdAffix)" type="button" role="tab" aria-controls="@("v2acc" + V2IdAffix)" aria-selected="false">Accounting</button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="@("v2info" + V2IdAffix)" role="tabpanel" aria-labelledby="@("v2info-tab" + V2IdAffix)">
                <div class="row g-3 mt-1">
                    <div class="col-12">
                        <label class="form-label">Material Number</label>
                        @Html.TextBoxFor(m => m.MaterialNumber, new { @class = "form-control sap-readonly", @readonly = "readonly", id = "txtMaterialNumberV2" + V2IdAffix })
                    </div>
                    <div class="col-12">
                        <label class="form-label">Industry Sector</label>
                        @Html.DropDownListFor(m => m.IndustrySectorCode,
                            ViewBag.IndustrySectors as IEnumerable<SelectListItem>,
                            "Select Sector",
                            new { @class = "form-control req" })
                    </div>
                    <div class="col-12">
                        <label class="form-label">Material Type</label>
                        @Html.DropDownListFor(m => m.MaterialTypeCode,
                            ViewBag.MaterialTypeList as IEnumerable<SelectListItem>,
                            "Select Type",
                            new { @class = "form-control req", id = "matTypeV2" + V2IdAffix, onchange = "window.onMaterialTypeChangeV2" + v2HandlerKey + "()" })
                    </div>
                </div>
                <div class="v2-status" id="@("statusBarV2" + V2IdAffix)">Ready</div>
            </div>

            <div class="tab-pane fade" id="@("v2basic" + V2IdAffix)" role="tabpanel" aria-labelledby="@("v2basic-tab" + V2IdAffix)">
                <div class="v2-frame">
                    <div class="v2-frame-title">Basic Data 1 &amp; 2</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            @Html.EditorFor(m => m.Description, new { htmlAttributes = new { @class = "form-control req" } })
                            <label class="form-label">Base Unit</label>
                            @{
                                var uomItems = (ViewBag.UomList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
                            }
                            @Html.DropDownListFor(m => m.BaseUnitCode, uomItems, "-- Select --", new { @class = "form-select form-select-sm req", id = "BaseUnitCodeV2" + V2IdAffix })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Material Group</label>
                            @{
                                var materialGroupItemsV2 = (ViewBag.MaterialGroupList as IEnumerable<SelectListItem>) ?? new List<SelectListItem>();
                            }
                            @Html.DropDownListFor(m => m.MaterialGroupCode, materialGroupItemsV2, "-- Select --", new { @class = "form-select form-select-sm", id = "MaterialGroupCodeV2" + V2IdAffix })
                            <label class="form-label">EAN/UPC</label>
                            @Html.EditorFor(m => m.EAN, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="@("v2sales" + V2IdAffix)" role="tabpanel" aria-labelledby="@("v2sales-tab" + V2IdAffix)">
                <div class="v2-frame">
                    <div class="v2-frame-title">Sales Organization Data</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Delivering Plant</label>
                            @Html.DropDownListFor(m => m.DeliveringPlantCode, plantItemsV2, "-- Select --", new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Item Category Group</label>
                            @Html.DropDownListFor(m => m.ItemCategoryGroup, itemCategoryItemsV2, "-- Select --", new { @class = "form-select form-select-sm" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="@("v2purch" + V2IdAffix)" role="tabpanel" aria-labelledby="@("v2purch-tab" + V2IdAffix)">
                <div class="v2-frame">
                    <div class="v2-frame-title">Purchasing Data</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Purchasing Group</label>
                            @Html.DropDownListFor(m => m.PurchasingGroupCode, purchasingGroupItemsV2, "-- Select --", new { @class = "form-select form-select-sm" })
                            <label class="form-label mt-2">GR Processing Time</label>
                            <div class="input-group input-group-sm">
                                @Html.EditorFor(m => m.GrProcessingTime, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "1" } })
                                @Html.DropDownListFor(m => m.GrProcessingUom, grProcessingUomItemsV2, "-- UOM --", new { @class = "form-select", style = "max-width:8rem;" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Lead time</label>
                            <div class="input-group input-group-sm">
                                @Html.TextBoxFor(m => m.LeadTimeDays, new { @class = "form-control", type = "number", min = "0", step = "1", id = "LeadTimeDaysV2" + V2IdAffix })
                                <span class="input-group-text">days</span>
                            </div>
                            <label class="form-label mt-2">Safety stock</label>
                            <div class="input-group input-group-sm">
                                @Html.TextBoxFor(m => m.SafetyStock, new { @class = "form-control", type = "number", step = "0.0001", id = "SafetyStockV2" + V2IdAffix })
                                <span class="input-group-text" id="@("mrpSafetyUomLbl" + V2IdAffix)">—</span>
                            </div>
                            <label class="form-label mt-2">Reorder point</label>
                            <div class="input-group input-group-sm">
                                @Html.TextBoxFor(m => m.ReorderPoint, new { @class = "form-control", type = "number", min = "0", step = "1", id = "ReorderPointV2" + V2IdAffix })
                                <span class="input-group-text" id="@("mrpReorderUomLbl" + V2IdAffix)">—</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="@("v2mrp" + V2IdAffix)" role="tabpanel" aria-labelledby="@("v2mrp-tab" + V2IdAffix)">
                <div class="v2-frame">
                    <div class="v2-frame-title">MRP Data</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">MRP Type</label>
                            @Html.DropDownListFor(m => m.MrpTypeCode, mrpTypeItemsV2, "-- Select --", new { @class = "form-select form-select-sm" })
                            <label class="form-label mt-2">Procurement Type</label>
                            @Html.DropDownListFor(m => m.ProcurementTypeCode, procurementItemsV2, "-- Select --", new { @class = "form-select form-select-sm" })
                            <label class="form-label mt-2">Strategy Group</label>
                            @Html.DropDownListFor(m => m.StrategyGroup, strategyGroupItemsV2, "-- Select --", new { @class = "form-select form-select-sm" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="@("v2uom" + V2IdAffix)" role="tabpanel" aria-labelledby="@("v2uom-tab" + V2IdAffix)">
                <div class="v2-frame">
                    <div class="v2-frame-title">Unit Conversions</div>
                    <table class="mat-uom-table" id="@("uomTableV2" + V2IdAffix)">
                        <thead>
                            <tr>
                                <th>Alt. Unit</th>
                                <th>Numerator</th>
                                <th style="width:3rem;">=</th>
                                <th>Denominator</th>
                                <th>Base Unit</th>
                                <th style="width:4.5rem;">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-secondary mat-uom-add-row-btn" onclick="window['addUomRowV2@(v2HandlerKey)']()">+ Add Row</button>
                </div>
            </div>

            <div class="tab-pane fade" id="@("v2acc" + V2IdAffix)" role="tabpanel" aria-labelledby="@("v2acc-tab" + V2IdAffix)">
                <div class="v2-frame">
                    <div class="v2-frame-title">Valuation</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Valuation Class</label>
                            @Html.EditorFor(m => m.ValuationClassCode, new { htmlAttributes = new { @class = "form-control req" } })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        @if (!createV2Embedded)
        {
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        }
        <button type="button" class="btn btn-primary" id="@("btnCreateV2Save" + V2IdAffix)" style="background: var(--au-primary, #6FB3B8); border-color: var(--au-primary-dark, #388087);">Save</button>
    </div>
}

<script>
    (function () {
        var createV2Embedded = @(createV2Embedded ? "true" : "false");
        var V2_ID_AFFIX = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(V2IdAffix));
        var v2IsModalCopy = V2_ID_AFFIX !== "";
        let uomIndexV2 = 0;
        let createV2IsEdit = false;
        let createV2CommittedTypeCode = "";
        let createV2CommittedMaterialNumber = "";
        const uomAltOptionList = @Html.Raw(uomAltOptsJson);

        if (v2IsModalCopy) {
            window.setCreateV2ModalEditState = function (v) {
                createV2IsEdit = !!v;
            };
            window.setCreateV2ModalCommittedFromLoaded = function (typeCode, materialNumber) {
                createV2CommittedTypeCode = typeCode || "";
                createV2CommittedMaterialNumber = materialNumber || "";
            };
        }

        function v2id(base) {
            return base + V2_ID_AFFIX;
        }

        function handleTabVisibilityV2() {
            const typeEl = document.getElementById(v2id("matTypeV2"));
            if (!typeEl) return;
            const type = typeEl.value;
            const salesLi = document.getElementById(v2id("nav-sales-v2"));
            const purchLi = document.getElementById(v2id("nav-purch-v2"));
            if (salesLi) salesLi.style.display = "";
            if (purchLi) purchLi.style.display = "";
            if (type === "ROH" && salesLi) salesLi.style.display = "none";
            if (type === "FERT" && purchLi) purchLi.style.display = "none";
        }

        window['onMaterialTypeChangeV2@(v2HandlerKey)'] = function () {
            handleTabVisibilityV2();
            if (createV2IsEdit)
                fetchNextMaterialNumberV2ForEdit();
            else
                fetchNextMaterialNumberV2();
        };

        if (!createV2Embedded) {
            window.moveCreateV2ModalToBody = function () {
                var el = document.getElementById("materialCreateV2Modal");
                if (el && el.parentElement !== document.body)
                    document.body.appendChild(el);
            };
        }

        function fetchNextMaterialNumberV2() {
            const typeCode = document.getElementById(v2id("matTypeV2"))?.value;
            const statusBox = document.getElementById(v2id("statusBarV2"));
            const numInput = document.getElementById(v2id("txtMaterialNumberV2"));
            if (!typeCode) {
                if (numInput) numInput.value = "";
                return;
            }
            if (statusBox) statusBox.innerText = "Fetching next material number...";
            const url = '@Url.Action("GetNextMaterialNumber", "Material")' + '?materialTypeCode=' + encodeURIComponent(typeCode);
            fetch(url)
                .then(r => r.json())
                .then(function (response) {
                    if (response.success) {
                        if (numInput) numInput.value = response.nextNumber;
                        if (statusBox) statusBox.innerText = "Assigned: " + response.nextNumber;
                    } else {
                        if (numInput) numInput.value = "";
                        if (statusBox) statusBox.innerText = "Error: " + response.message;
                    }
                })
                .catch(function () {
                    if (statusBox) statusBox.innerText = "Communication error.";
                });
        }

        function fetchNextMaterialNumberV2ForEdit() {
            const matType = document.getElementById(v2id("matTypeV2"));
            const statusBox = document.getElementById(v2id("statusBarV2"));
            const numInput = document.getElementById(v2id("txtMaterialNumberV2"));
            if (!matType || !numInput) return;

            const newType = matType.value;
            const prevType = createV2CommittedTypeCode || "";
            const prevNum = createV2CommittedMaterialNumber || "";

            if (!newType) {
                matType.value = prevType;
                numInput.value = prevNum;
                if (statusBox) statusBox.innerText = "Select a material type.";
                return;
            }

            if (newType === prevType && numInput.value === prevNum)
                return;

            if (statusBox) statusBox.innerText = "Fetching next material number...";
            const url = '@Url.Action("GetNextMaterialNumber", "Material")' + "?materialTypeCode=" + encodeURIComponent(newType);
            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (response) {
                    if (response.success) {
                        numInput.value = response.nextNumber;
                        createV2CommittedTypeCode = newType;
                        createV2CommittedMaterialNumber = response.nextNumber;
                        if (statusBox) statusBox.innerText = "Assigned: " + response.nextNumber;
                    } else {
                        matType.value = prevType;
                        numInput.value = prevNum;
                        if (statusBox) statusBox.innerText = "Ready";
                        alert(response.message || "Could not assign the next material number.");
                    }
                })
                .catch(function () {
                    matType.value = prevType;
                    numInput.value = prevNum;
                    if (statusBox) statusBox.innerText = "Ready";
                    alert("Communication error while fetching the next material number.");
                });
        }

        function escapeAttr(s) {
            if (s == null || s === undefined) return "";
            return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
        }

        function buildUomAltSelectHtmlV2(index, selectedVal) {
            var sel = selectedVal != null && selectedVal !== undefined ? String(selectedVal) : "";
            var opts = '<option value="0">-- Select UOM --</option>';
            (uomAltOptionList || []).forEach(function (o) {
                var v = String(o.value ?? "");
                var isSel = v !== "" && v === sel ? " selected" : "";
                opts += '<option value="' + escapeAttr(v) + '"' + isSel + '>' + escapeAttr(String(o.text ?? "")) + '</option>';
            });
            return '<select name="Conversions[' + index + '].AltUnitId" class="form-select form-select-sm">' + opts + '</select>';
        }

        function v2CollectValidationInvalid() {
            var bad = [];
            var form = document.getElementById(v2id("createMaterialV2Form"));
            if (!form) return bad;
            function add(el) {
                if (el && bad.indexOf(el) < 0) bad.push(el);
            }
            form.querySelectorAll(".req").forEach(function (el) {
                if (!el.value || !String(el.value).trim()) add(el);
            });
            var tbody = document.querySelector("#" + v2id("uomTableV2") + " tbody");
            if (tbody) {
                tbody.querySelectorAll("tr").forEach(function (tr) {
                    var alt = tr.querySelector('select[name$=".AltUnitId"]');
                    var num = tr.querySelector('input[name$=".Numerator"]');
                    var den = tr.querySelector('input[name$=".Denominator"]');
                    if (!alt || !String(alt.value || "").trim() || alt.value === "0") add(alt);
                    if (!num || String(num.value || "").trim() === "" || isNaN(parseFloat(num.value))) add(num);
                    if (!den || String(den.value || "").trim() === "" || isNaN(parseFloat(den.value))) add(den);
                });
            }
            return bad;
        }

        function addUomRowV2WithValues(altUnit, numerator, denominator, baseUom) {
            const tbody = document.querySelector("#" + v2id("uomTableV2") + " tbody");
            if (!tbody) return;
            const existingRowCount = tbody.querySelectorAll("tr").length;
            if (uomIndexV2 < existingRowCount) uomIndexV2 = existingRowCount;
            const fromField = document.getElementById(v2id("BaseUnitCodeV2"));
            const fromFieldVal = fromField && String(fromField.value || "").trim();
            const baseUomValue = (baseUom != null && String(baseUom).trim() !== "") ? String(baseUom).trim() : (fromFieldVal || "");
            const numStr = numerator !== undefined && numerator !== null && numerator !== "" ? String(numerator) : "";
            const denStr = denominator !== undefined && denominator !== null && denominator !== "" ? String(denominator) : "1";
            const rowId = "v2row" + V2_ID_AFFIX.replace(/-/g, "_") + "_" + uomIndexV2;
            const idx = uomIndexV2;
            const html =
                '<tr id="' + rowId + '">' +
                '<td>' + buildUomAltSelectHtmlV2(idx, altUnit) + '</td>' +
                '<td><input name="Conversions[' + uomIndexV2 + '].Numerator" class="form-control form-control-sm" type="number" step="any" value="' + escapeAttr(numStr) + '" /></td>' +
                '<td class="mat-uom-eq">=</td>' +
                '<td><input name="Conversions[' + uomIndexV2 + '].Denominator" class="form-control form-control-sm" type="number" step="any" value="' + escapeAttr(denStr) + '" /></td>' +
                '<td><input class="form-control form-control-sm sap-readonly" value="' + escapeAttr(baseUomValue) + '" readonly /></td>' +
                '<td class="mat-uom-action"><button type="button" class="btn btn-danger btn-sm" onclick="document.getElementById(\'' + rowId + '\').remove()">X</button></td>' +
                '</tr>';
            tbody.insertAdjacentHTML("beforeend", html);
            uomIndexV2++;
        }

        function syncMrpQtyFieldsV2() {
            const baseEl = document.getElementById(v2id("BaseUnitCodeV2"));
            const code = baseEl && String(baseEl.value || "").trim();
            const has = !!code;
            const opt = baseEl && baseEl.options && baseEl.selectedIndex >= 0 ? baseEl.options[baseEl.selectedIndex] : null;
            const uomText = has && opt ? String(opt.text || "").trim() : "—";
            const lblS = document.getElementById(v2id("mrpSafetyUomLbl"));
            const lblR = document.getElementById(v2id("mrpReorderUomLbl"));
            if (lblS) lblS.textContent = has ? uomText : "—";
            if (lblR) lblR.textContent = has ? uomText : "—";
            const safety = document.getElementById(v2id("SafetyStockV2"));
            const reorder = document.getElementById(v2id("ReorderPointV2"));
            if (safety) {
                safety.readOnly = !has;
                if (!has) safety.value = "";
            }
            if (reorder) {
                reorder.readOnly = !has;
                if (!has) reorder.value = "";
            }
        }

        window['addUomRowV2@(v2HandlerKey)'] = function () {
            const tbody = document.querySelector("#" + v2id("uomTableV2") + " tbody");
            if (!tbody) return;
            const baseUomField = document.getElementById(v2id("BaseUnitCodeV2"));
            const baseUomValue = baseUomField && String(baseUomField.value || "").trim();
            if (!baseUomValue) {
                const form = document.getElementById(v2id("createMaterialV2Form"));
                const msg = "Select a base unit of measure (Basic Data) before adding a conversion row.";
                if (form && typeof window.auShowInlineValidation === "function")
                    window.auShowInlineValidation(form, [], msg);
                return;
            }
            addUomRowV2WithValues("", "", "1", baseUomValue);
            const formAfter = document.getElementById(v2id("createMaterialV2Form"));
            if (formAfter && typeof window.auClearInlineValidation === "function")
                window.auClearInlineValidation(formAfter);
            const sb = document.getElementById(v2id("statusBarV2"));
            if (sb) sb.innerText = "Row added to conversion table.";
        };

        function applyCreateV2EditData(m, conversions) {
            const form = document.getElementById(v2id("createMaterialV2Form"));
            if (!form || !m) return;
            function pick(obj, camel, pascal) {
                if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
                if (obj[pascal] !== undefined && obj[pascal] !== null) return obj[pascal];
                return "";
            }
            function setVal(name, value) {
                const el = form.querySelector('[name="' + name + '"]');
                if (!el) return;
                el.value = value != null && value !== undefined ? value : "";
            }
            setVal("MaterialNumber", pick(m, "materialNumber", "MaterialNumber"));
            setVal("IndustrySectorCode", pick(m, "industrySectorCode", "IndustrySectorCode"));
            setVal("MaterialTypeCode", pick(m, "materialTypeCode", "MaterialTypeCode"));
            setVal("Description", pick(m, "description", "Description"));
            setVal("BaseUnitCode", pick(m, "baseUnitCode", "BaseUnitCode"));
            setVal("MaterialGroupCode", pick(m, "materialGroupCode", "MaterialGroupCode"));
            setVal("EAN", pick(m, "ean", "EAN"));
            setVal("DeliveringPlantCode", pick(m, "deliveringPlantCode", "DeliveringPlantCode"));
            setVal("ItemCategoryGroup", pick(m, "itemCategoryGroup", "ItemCategoryGroup"));
            setVal("PurchasingGroupCode", pick(m, "purchasingGroupCode", "PurchasingGroupCode"));
            var gr = pick(m, "grProcessingTime", "GrProcessingTime");
            setVal("GrProcessingTime", gr !== "" && gr != null ? gr : "");
            setVal("GrProcessingUom", pick(m, "grProcessingUom", "GrProcessingUom"));
            setVal("MrpTypeCode", pick(m, "mrpTypeCode", "MrpTypeCode"));
            setVal("ProcurementTypeCode", pick(m, "procurementTypeCode", "ProcurementTypeCode"));
            setVal("StrategyGroup", pick(m, "strategyGroup", "StrategyGroup"));
            var lt = pick(m, "leadTimeDays", "LeadTimeDays");
            setVal("LeadTimeDays", lt !== "" && lt != null ? lt : "");
            var ss = pick(m, "safetyStock", "SafetyStock");
            setVal("SafetyStock", ss !== "" && ss != null ? ss : "");
            var rp = pick(m, "reorderPoint", "ReorderPoint");
            setVal("ReorderPoint", rp !== "" && rp != null ? rp : "");
            setVal("ValuationClassCode", pick(m, "valuationClassCode", "ValuationClassCode"));

            const tbody = document.querySelector("#" + v2id("uomTableV2") + " tbody");
            if (tbody) tbody.innerHTML = "";
            uomIndexV2 = 0;
            const baseUom = pick(m, "baseUnitCode", "BaseUnitCode") || "";
            (conversions || []).forEach(function (c) {
                if (!c) return;
                var alt = c.altUnitId != null ? c.altUnitId : c.AltUnitId;
                if (alt === undefined || alt === null || alt === "" || alt === 0) return;
                var num = c.numerator != null ? c.numerator : c.Numerator;
                var den = c.denominator != null ? c.denominator : c.Denominator;
                addUomRowV2WithValues(alt, num, den, baseUom);
            });
            const sb = document.getElementById(v2id("statusBarV2"));
            if (sb) sb.innerText = "Loaded for edit.";
            syncMrpQtyFieldsV2();

            var origNum = pick(m, "materialNumber", "MaterialNumber");
            var origH = document.getElementById(v2id("createV2OriginalMaterialNumber"));
            if (origH) origH.value = origNum || "";
            createV2CommittedTypeCode = pick(m, "materialTypeCode", "MaterialTypeCode") || "";
            createV2CommittedMaterialNumber = origNum || "";
        }

        function resetThisInstance() {
            createV2IsEdit = false;
            createV2CommittedTypeCode = "";
            createV2CommittedMaterialNumber = "";
            const origH = document.getElementById(v2id("createV2OriginalMaterialNumber"));
            if (origH) origH.value = "";
            const form = document.getElementById(v2id("createMaterialV2Form"));
            if (form) form.reset();
            const tbody = document.querySelector("#" + v2id("uomTableV2") + " tbody");
            if (tbody) tbody.innerHTML = "";
            uomIndexV2 = 0;
            const num = document.getElementById(v2id("txtMaterialNumberV2"));
            if (num) num.value = "";
            const matType = document.getElementById(v2id("matTypeV2"));
            if (matType) matType.disabled = false;
            if (num) num.readOnly = true;
            const titleEl = document.getElementById(v2id("materialCreateV2Title"));
            if (titleEl) titleEl.textContent = "Create material";
            const saveBtn = document.getElementById(v2id("btnCreateV2Save"));
            if (saveBtn) saveBtn.textContent = "Save";
            const sb = document.getElementById(v2id("statusBarV2"));
            if (sb) sb.innerText = "Ready";
            var firstTabBtn = document.getElementById(v2id("v2info-tab"));
            if (firstTabBtn && typeof bootstrap !== "undefined" && bootstrap.Tab)
                bootstrap.Tab.getOrCreateInstance(firstTabBtn).show();
            handleTabVisibilityV2();
            syncMrpQtyFieldsV2();
        }

        if (createV2Embedded)
            window.resetCreateV2EmbeddedForm = resetThisInstance;

        if (v2IsModalCopy)
            window.resetCreateV2Modal = resetThisInstance;

        document.addEventListener("DOMContentLoaded", function () {
            if (!createV2Embedded && typeof window.moveCreateV2ModalToBody === "function")
                window.moveCreateV2ModalToBody();
            handleTabVisibilityV2();
            const baseUomSel = document.getElementById(v2id("BaseUnitCodeV2"));
            if (baseUomSel) {
                baseUomSel.addEventListener("change", syncMrpQtyFieldsV2);
            }
            syncMrpQtyFieldsV2();
            const saveBtn = document.getElementById(v2id("btnCreateV2Save"));
            if (saveBtn) {
                saveBtn.addEventListener("click", function () {
                    const form = document.getElementById(v2id("createMaterialV2Form"));
                    if (!form) return;
                    if (typeof window.auClearInlineValidation === "function")
                        window.auClearInlineValidation(form);
                    var bad = v2CollectValidationInvalid();
                    if (bad.length) {
                        if (typeof window.auShowInlineValidation === "function")
                            window.auShowInlineValidation(form, bad);
                        return;
                    }
                    const fd = new FormData(form);
                    const origH = document.getElementById(v2id("createV2OriginalMaterialNumber"));
                    const hasOriginal = !!(origH && origH.value);
                    const url = (createV2IsEdit || hasOriginal)
                        ? '@Url.Action("UpdateMaterialV2", "Material")'
                        : '@Url.Action("CreateV2", "Material")';
                    fetch(url, {
                        method: "POST",
                        body: fd,
                        headers: { "Accept": "application/json", "X-Requested-With": "XMLHttpRequest" }
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (data.success) {
                                var msg = data.message || (createV2IsEdit ? "Material Updated Successfully !" : "Material Added Successfully !");
                                var afterListOrReload = function () {
                                    if (typeof window.materialsReloadToListTab === "function")
                                        window.materialsReloadToListTab();
                                    else
                                        location.reload();
                                };
                                if (v2IsModalCopy) {
                                    var el = document.getElementById("materialCreateV2Modal");
                                    if (el && typeof bootstrap !== "undefined") {
                                        var m = bootstrap.Modal.getInstance(el) || bootstrap.Modal.getOrCreateInstance(el);
                                        var onCreateHidden = function () {
                                            el.removeEventListener("hidden.bs.modal", onCreateHidden);
                                            if (typeof window.materialShowSuccessModalThen === "function")
                                                window.materialShowSuccessModalThen(msg, afterListOrReload);
                                            else
                                                afterListOrReload();
                                        };
                                        el.addEventListener("hidden.bs.modal", onCreateHidden);
                                        m.hide();
                                        return;
                                    }
                                }
                                if (typeof window.materialShowSuccessModalThen === "function")
                                    window.materialShowSuccessModalThen(msg, afterListOrReload);
                                else
                                    afterListOrReload();
                            } else {
                                if (typeof window.auShowInlineValidation === "function")
                                    window.auShowInlineValidation(form, [], data.message || "Save failed.");
                                else
                                    alert(data.message || "Save failed");
                            }
                        })
                        .catch(function () {
                            if (typeof window.auShowInlineValidation === "function")
                                window.auShowInlineValidation(form, [], "Request failed.");
                            else
                                alert("Request failed");
                        });
                });
            }
            const modalEl = document.getElementById("materialCreateV2Modal");
            if (modalEl && v2IsModalCopy) {
                modalEl.addEventListener("shown.bs.modal", function () {
                    if (!createV2IsEdit && typeof window.resetCreateV2Modal === "function")
                        window.resetCreateV2Modal();
                });
                modalEl.addEventListener("hidden.bs.modal", function () {
                    createV2IsEdit = false;
                    if (typeof window.resetCreateV2Modal === "function")
                        window.resetCreateV2Modal();
                });
            }
        });

        window.auMaterialV2MrpSyncByAffix = window.auMaterialV2MrpSyncByAffix || {};
        window.auMaterialV2MrpSyncByAffix[V2_ID_AFFIX || ""] = syncMrpQtyFieldsV2;
    })();
</script>
