@model List<AU_ERP.Models.CreateMaterialMaster>
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq
@using System.Text.Json

@{
    ViewData["Title"] = "Materials";
    var mTypes = (List<SelectListItem>)ViewBag.MaterialTypes ?? new List<SelectListItem>();
    var safeModel = Model ?? new List<AU_ERP.Models.CreateMaterialMaster>();
    var materialsTabList = string.Equals(ViewContext.HttpContext?.Request.Query["tab"].ToString(), "list", StringComparison.OrdinalIgnoreCase);
    var uomAltOptsModalJson = JsonSerializer.Serialize(
        (ViewBag.UomIdList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
        .Select(x => new { value = x.Value ?? "", text = x.Text ?? "" }));
}

<style>
    :root {
        --sap-bg: #e5ebf1;
        --sap-border: #9fb2c5;
        --sap-header-bg: #dee6ef;
        --sap-readonly: #f4f4f4;
        --sap-selected: #b3d7ff;
    }

    .sap-window {
        background: white;
        border: 1px solid var(--sap-border);
        display: flex;
        flex-direction: column;
        min-height: 500px;
    }

    .sap-toolbar {
        padding: 12px;
        border-bottom: 2px solid var(--sap-border);
        background: #fff;
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }

    .sap-actions .btn-add-classic {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: #fff;
        background: var(--au-primary, #6FB3B8);
        border: 1px solid var(--au-primary-dark, #388087);
        border-radius: 0.25rem;
        text-decoration: none;
        cursor: pointer;
    }

    .sap-actions .btn-add-classic:hover {
        color: #fff;
        filter: brightness(0.95);
    }

    .btn-sap {
        border-radius: 2px;
        font-size: 12px;
        border: 1px solid #bbb;
        margin-left: 5px;
        padding: 4px 10px;
        background: linear-gradient(to bottom, #fdfdfd, #eee);
        cursor: pointer;
    }

        .btn-sap:disabled {
            opacity: 0.4;
        }

    .table-sap {
        width: 100%;
        border-collapse: collapse;
    }

        .table-sap th {
            background: var(--sap-header-bg);
            border: 1px solid #ccc;
            padding: 6px 10px;
            font-weight: normal;
        }

        .table-sap td {
            border: 1px solid #ccc;
            padding: 0;
            height: 32px;
        }

    .sap-input {
        width: 100%;
        height: 100%;
        border: none;
        padding: 0 10px;
        background: var(--sap-readonly);
        outline: none;
        box-sizing: border-box;
    }

    .edit-mode .sap-input:not([readonly]):not([disabled]) {
        background: #fff;
    }

    /* Sel column removed — keep styles commented for reference
    .col-sel {
        width: 35px;
        background: #f0f0f0;
        cursor: pointer;
    }

    .row-selected {
        background-color: var(--sap-selected) !important;
    }

    .table-sap tr.row-selected td {
        background-color: var(--sap-selected);
    }

    .table-sap tr.row-selected .sap-input,
    .table-sap tr.row-selected .sap-select {
        background-color: transparent;
    }
    */

    .table-sap th.col-no,
    .table-sap td.col-no {
        padding-left: 14px;
        padding-right: 8px;
    }

    .table-sap td.col-action {
        padding: 4px 8px;
        vertical-align: middle;
        text-align: center;
    }

    .sap-select:disabled {
        background: var(--sap-readonly);
        color: #666;
        cursor: not-allowed;
    }

    .materials-module-tabstrip {
        border-bottom: 1px solid var(--sap-border);
        padding: 0 0.25rem;
        background: #fff;
    }

    .materials-module-tabstrip .nav-link {
        color: var(--au-primary-dark, #388087);
        font-weight: 500;
        border: 1px solid transparent;
        border-radius: 0.35rem 0.35rem 0 0;
    }

    .materials-module-tabstrip .nav-link:hover {
        border-color: rgba(56, 128, 135, 0.25);
    }

    .materials-module-tabstrip .nav-link.active {
        color: var(--au-black, #171717);
        background: #fff;
        border-color: var(--sap-border);
        border-bottom-color: #fff;
        margin-bottom: -1px;
    }

    .materials-module-tab-content {
        border: 1px solid var(--sap-border);
        border-top: none;
        background: #fff;
    }
</style>

<div class="materials-module">
    <ul class="nav nav-tabs materials-module-tabstrip" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(materialsTabList ? "" : "active")" id="materialsTabCreateBtn" data-bs-toggle="tab" data-bs-target="#materialsPaneCreate" type="button" role="tab" aria-controls="materialsPaneCreate" aria-selected="@(materialsTabList ? "false" : "true")">Create</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(materialsTabList ? "active" : "")" id="materialsTabListBtn" data-bs-toggle="tab" data-bs-target="#materialsPaneList" type="button" role="tab" aria-controls="materialsPaneList" aria-selected="@(materialsTabList ? "true" : "false")">List</button>
        </li>
    </ul>
    <div class="tab-content materials-module-tab-content">
        <div class="tab-pane fade p-2 p-md-3 @(materialsTabList ? "" : "show active")" id="materialsPaneCreate" role="tabpanel" aria-labelledby="materialsTabCreateBtn">
            @await Html.PartialAsync("CreateV2", new AU_ERP.Models.CreateMaterialMaster(), new ViewDataDictionary(ViewData)
            {
                ["CreateV2Embedded"] = true,
                ["CreateV2IdSuffix"] = ""
            })
        </div>
        <div class="tab-pane fade @(materialsTabList ? "show active" : "")" id="materialsPaneList" role="tabpanel" aria-labelledby="materialsTabListBtn">
            <div class="sap-window" id="app">

                <div class="p-2 px-3">
                    <input type="search" class="form-control form-control-sm" id="MaterialListFilter" placeholder="Filter by number, description, type…" style="max-width:22rem;" />
                </div>
    <form id="materialForm" method="post" action="@Url.Action("GetMaterialList", "Material")">
        <div class="table-wrapper">

            <table class="table-sap" id="MaterialListTable">
                <thead>
                    <tr>
                        @*<th style="width:40px;">Sel</th>*@
                        <th class="col-no">No</th>
                        <th>Material Number</th>
                        <th>Description</th>
                        <th>Type Code</th>
                        <th>Base Unit</th>
                        <th style="width:72px;">Action</th>
                    </tr>
                </thead>

                <tbody id="gridBody">

                    @{
                        int i = 0;
                    }

                    @foreach (var item in safeModel)
                    {
                        <tr data-material-number="@item.MaterialNumber" data-material-filter="@($"{item.MaterialNumber} {item.Description} {item.MaterialTypeCode} {item.BaseUnitCode}")">
                            @*<td class="col-sel" onclick="selectRow(this)">
                                <input type="hidden" name="[@i].MaterialNumber"
                                       value="@item.MaterialNumber"
                                       class="row-id"/>
                            </td>*@

                            <td class="col-no">@(i + 1)</td>

                            <td>
                                <input name="[@i].MaterialNumber"
                                       class="sap-input mat-number"
                                       value="@item.MaterialNumber"
                                       readonly />
                            </td>

                            <td>
                                <input name="[@i].Description"
                                       class="sap-input"
                                       value="@item.Description"
                                       readonly />
                            </td>

                            <td class="align-middle ps-2 pe-2">
                                @*<select name="[@i].MaterialTypeCode"
                                        class="sap-input sap-select"
                                        disabled
                                        onchange="onTypeChange(this)">
                                    @foreach (var opt in mTypes)
                                    {
                                        if (opt.Value == item.MaterialTypeCode)
                                        {
                                            <option value="@opt.Value" selected>@opt.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Value">@opt.Text</option>
                                        }
                                    }
                                </select>*@
                                @(item.MaterialTypeCode ?? "—")
                                <input type="hidden" name="[@i].MaterialTypeCode" value="@item.MaterialTypeCode" />
                            </td>

                            <td>
                                <input name="[@i].BaseUnitCode"
                                       class="sap-input"
                                       value="@item.BaseUnitCode"
                                       readonly />
                            </td>
                            <td class="col-action">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-secondary p-0" type="button" id="rowActions@(i)" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false" aria-label="Actions">
                                        <i class="bi bi-three-dots-vertical fs-5"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="rowActions@(i)">
                                        <li><button type="button" class="dropdown-item" data-mat="@item.MaterialNumber" onclick="window.openMaterialEditV2(this.getAttribute('data-mat'))">Edit</button></li>
                                        <li><button type="button" class="dropdown-item text-danger" data-mat="@item.MaterialNumber" onclick="deleteMaterialFromList(this.getAttribute('data-mat'))">Delete</button></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }

                </tbody>
            </table>

        </div>

    </form>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="materialCreateV2Modal" tabindex="-1" aria-labelledby="materialCreateV2ModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        @await Html.PartialAsync("CreateV2", new AU_ERP.Models.CreateMaterialMaster(), new ViewDataDictionary(ViewData)
        {
            ["CreateV2Embedded"] = false,
            ["CreateV2IdSuffix"] = "modal"
        })
    </div>
</div>

<script>
       const uomAltOptionListModal = @Html.Raw(uomAltOptsModalJson);
       function buildUomAltSelectCellModal(idx, selectedVal) {
           function esc(s) {
               if (s == null || s === undefined) return "";
               return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
           }
           var sel = selectedVal != null && selectedVal !== undefined ? String(selectedVal) : "";
           var opts = '<option value="0">-- Select UOM --</option>';
           (uomAltOptionListModal || []).forEach(function (o) {
               var v = String(o.value ?? "");
               var isSel = v !== "" && v === sel ? " selected" : "";
               opts += '<option value="' + esc(v) + '"' + isSel + '>' + esc(String(o.text ?? "")) + '</option>';
           });
           return '<select name="Conversions[' + idx + '].AltUnitId" class="form-select form-select-sm">' + opts + '</select>';
       }
       let isEditMode = false;
    let selectedRow = null;
    let rowCount = @safeModel.Count;

    window.openMaterialEditV2 = function (materialNumber) {
        if (!materialNumber) return;
        var url = '@Url.Action("GetMaterialForEditV2", "Material")' + "?id=" + encodeURIComponent(materialNumber);
        fetch(url)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.success) {
                    alert(data.message || "Could not load material.");
                    return;
                }
                var form = document.getElementById("createMaterialV2Form-modal");
                if (!form) {
                    alert("Material editor is not available.");
                    return;
                }
                var m = data.material;
                var conversions = data.conversions || [];
                function pick(obj, camel, pascal) {
                    if (obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
                    if (obj[pascal] !== undefined && obj[pascal] !== null) return obj[pascal];
                    return "";
                }
                function setVal(name, value) {
                    var el = form.querySelector('[name="' + name + '"]');
                    if (!el) return;
                    el.value = value != null && value !== undefined ? value : "";
                }
                function escapeAttr(s) {
                    if (s == null || s === undefined) return "";
                    return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
                }
                setVal("MaterialNumber", pick(m, "materialNumber", "MaterialNumber"));
                setVal("IndustrySectorCode", pick(m, "industrySectorCode", "IndustrySectorCode"));
                setVal("MaterialTypeCode", pick(m, "materialTypeCode", "MaterialTypeCode"));
                setVal("Description", pick(m, "description", "Description"));
                setVal("BaseUnitCode", pick(m, "baseUnitCode", "BaseUnitCode"));
                setVal("MaterialGroupCode", pick(m, "materialGroupCode", "MaterialGroupCode"));
                setVal("EAN", pick(m, "ean", "EAN"));
                setVal("DeliveringPlantCode", pick(m, "deliveringPlantCode", "DeliveringPlantCode"));
                setVal("ItemCategoryGroup", pick(m, "itemCategoryGroup", "ItemCategoryGroup"));
                setVal("PurchasingGroupCode", pick(m, "purchasingGroupCode", "PurchasingGroupCode"));
                var gr = pick(m, "grProcessingTime", "GrProcessingTime");
                setVal("GrProcessingTime", gr !== "" && gr != null ? gr : "");
                setVal("MrpTypeCode", pick(m, "mrpTypeCode", "MrpTypeCode"));
                setVal("ProcurementTypeCode", pick(m, "procurementTypeCode", "ProcurementTypeCode"));
                setVal("StrategyGroup", pick(m, "strategyGroup", "StrategyGroup"));
                setVal("AvailabilityCheckCode", pick(m, "availabilityCheckCode", "AvailabilityCheckCode"));
                setVal("ValuationClassCode", pick(m, "valuationClassCode", "ValuationClassCode"));
                var tbody = document.querySelector("#uomTableV2-modal tbody");
                if (tbody) tbody.innerHTML = "";
                var uomIdx = 0;
                var baseUom = pick(m, "baseUnitCode", "BaseUnitCode") || "";
                (conversions || []).forEach(function (c) {
                    if (!c) return;
                    var alt = c.altUnitId != null ? c.altUnitId : c.AltUnitId;
                    if (alt === undefined || alt === null || alt === "" || alt === 0) return;
                    var num = c.numerator != null ? c.numerator : c.Numerator;
                    var den = c.denominator != null ? c.denominator : c.Denominator;
                    var numStr = num !== undefined && num !== null && num !== "" ? String(num) : "";
                    var denStr = den !== undefined && den !== null && den !== "" ? String(den) : "1";
                    var rowId = "v2row_modal_" + uomIdx;
                    var html =
                        '<tr id="' + rowId + '">' +
                        '<td>' + buildUomAltSelectCellModal(uomIdx, alt) + '</td>' +
                        '<td><input name="Conversions[' + uomIdx + '].Numerator" class="form-control form-control-sm" type="number" step="any" value="' + escapeAttr(numStr) + '" /></td>' +
                        '<td class="text-center align-middle">=</td>' +
                        '<td><input name="Conversions[' + uomIdx + '].Denominator" class="form-control form-control-sm" type="number" step="any" value="' + escapeAttr(denStr) + '" /></td>' +
                        '<td><input class="form-control form-control-sm sap-readonly" value="' + escapeAttr(baseUom) + '" readonly /></td>' +
                        '<td><button type="button" class="btn btn-danger btn-sm" onclick="document.getElementById(\'' + rowId + '\').remove()">X</button></td>' +
                        '</tr>';
                    if (tbody) tbody.insertAdjacentHTML("beforeend", html);
                    uomIdx++;
                });
                var origNum = pick(m, "materialNumber", "MaterialNumber");
                var origH = document.getElementById("createV2OriginalMaterialNumber-modal");
                if (origH) origH.value = origNum || "";
                if (typeof window.setCreateV2ModalCommittedFromLoaded === "function")
                    window.setCreateV2ModalCommittedFromLoaded(
                        pick(m, "materialTypeCode", "MaterialTypeCode") || "",
                        origNum || ""
                    );
                var sb = document.getElementById("statusBarV2-modal");
                if (sb) sb.innerText = "Loaded for edit.";
                var titleEl = document.getElementById("materialCreateV2Title-modal");
                if (titleEl) titleEl.textContent = "Edit material";
                var saveBtn = document.getElementById("btnCreateV2Save-modal");
                if (saveBtn) saveBtn.textContent = "Update";
                var matType = document.getElementById("matTypeV2-modal");
                if (matType) matType.disabled = false;
                var numEl = document.getElementById("txtMaterialNumberV2-modal");
                if (numEl) numEl.readOnly = true;
                var type = matType && matType.value;
                var salesLi = document.getElementById("nav-sales-v2-modal");
                var purchLi = document.getElementById("nav-purch-v2-modal");
                if (salesLi) salesLi.style.display = "";
                if (purchLi) purchLi.style.display = "";
                if (type === "ROH" && salesLi) salesLi.style.display = "none";
                if (type === "FERT" && purchLi) purchLi.style.display = "none";
                if (typeof window.setCreateV2ModalEditState === "function")
                    window.setCreateV2ModalEditState(true);
                var firstTabBtn = document.getElementById("v2info-tab-modal");
                if (firstTabBtn && typeof bootstrap !== "undefined" && bootstrap.Tab)
                    bootstrap.Tab.getOrCreateInstance(firstTabBtn).show();
                var modalEl = document.getElementById("materialCreateV2Modal");
                if (modalEl && modalEl.parentElement !== document.body)
                    document.body.appendChild(modalEl);
                if (typeof window.moveCreateV2ModalToBody === "function")
                    window.moveCreateV2ModalToBody();
                if (typeof bootstrap !== "undefined" && modalEl)
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
            })
            .catch(function () { alert("Request failed"); });
    };

           function setMode(edit) {
        isEditMode = edit;

        document.getElementById('app').classList.toggle('edit-mode', edit);

        document.querySelectorAll('.sap-input').forEach(el => {

            // Material Number ALWAYS readonly
            if (el.name && el.name.includes("MaterialNumber")) {
                el.readOnly = true;
                return;
            }

            // TEXT / INPUT fields
            if (el.tagName === "INPUT") {
                el.readOnly = !edit;
            }

            // SELECT fields (dropdowns)
            if (el.tagName === "SELECT") {
                el.disabled = !edit;
            }
        });

        var btnNew = document.getElementById('btnNew');
        if (btnNew) btnNew.disabled = !edit;
        var btnSave = document.getElementById('btnSave');
        if (btnSave) btnSave.disabled = !edit;
    }

    document.getElementById('materialForm').onsubmit = function () {
        document.querySelectorAll('.sap-input, .sap-select').forEach(el => {
            el.disabled = false;
            el.readOnly = false;
        });
        return true;
    };

    function addNewRow() {
        const body = document.getElementById("gridBody");

        const tr = document.createElement("tr");

        tr.innerHTML = `
            <td class="col-no">${rowCount + 1}</td>

            <td><input name="[${rowCount}].MaterialNumber" class="sap-input mat-number"></td>
            <td><input name="[${rowCount}].Description" class="sap-input"></td>

            <td class="align-middle ps-2 pe-2">
                —
                <input type="hidden" name="[${rowCount}].MaterialTypeCode" value="" />
            </td>

            <td><input name="[${rowCount}].BaseUnitCode" class="sap-input"></td>
            <td class="col-action">
                <div class="dropdown">
                    <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                        <i class="bi bi-three-dots-vertical fs-5"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><button type="button" class="dropdown-item" disabled>Edit</button></li>
                        <li><button type="button" class="dropdown-item text-danger" disabled>Delete</button></li>
                    </ul>
                </div>
            </td>
        `;

        body.appendChild(tr);
        rowCount++;
    }

    function selectRow(cell) {
        document.querySelectorAll("#gridBody tr").forEach(r => {
            r.classList.remove("row-selected");
        });

        selectedRow = cell.parentElement;
        selectedRow.classList.add("row-selected");

        var btnDel = document.getElementById("btnDelete");
        if (btnDel) btnDel.disabled = false;
    }

    function handleDelete() {
        if (!selectedRow) return;

        const id = selectedRow.querySelector(".row-id")?.value;

        function runDeleteRequest() {
        if (id) {
            var rowToRemove = selectedRow;
            fetch('/Material/DeleteMaterial?id=' + id, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        var msg = res.message || "Material Deleted Successfully !";
                        if (typeof window.materialShowSuccessModalThen === "function")
                            window.materialShowSuccessModalThen(msg, function () {
                                if (rowToRemove) rowToRemove.remove();
                            });
                        else if (rowToRemove) rowToRemove.remove();
                    }
                });
        } else {
            selectedRow.remove();
        }
        }

        if (typeof window.materialShowDeleteConfirmModalThen === "function")
            window.materialShowDeleteConfirmModalThen("Do you want to Delete this Material?", runDeleteRequest);
        else if (confirm("Delete this material?"))
            runDeleteRequest();
    }
        function saveAll() {

        let data = [];

        document.querySelectorAll("#gridBody tr").forEach(row => {

            let obj = {
                MaterialNumber: row.querySelector(".mat-number")?.value,
                Description: row.querySelector("[name$='.Description']")?.value,
                MaterialTypeCode: row.querySelector("[name$='.MaterialTypeCode']")?.value,
                BaseUnitCode: row.querySelector("[name$='.BaseUnitCode']")?.value
            };

            data.push(obj);
        });

        fetch('/Material/SaveMaterials', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                var msg = res.message || "Material Updated Successfully !";
                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(msg, function () {
                        if (typeof window.materialsReloadToListTab === "function")
                            window.materialsReloadToListTab();
                        else
                            location.reload();
                    });
                else if (typeof window.materialsReloadToListTab === "function")
                    window.materialsReloadToListTab();
                else
                    location.reload();
            } else {
                alert(res.message || "Save failed");
            }
        });
    }
            function fetchNextMaterialNumber(typeCode, statusBoxId, inputElement) {

        const statusBox = document.getElementById(statusBoxId);

        $.ajax({
            url: '@Url.Action("GetNextMaterialNumber", "Material")',
            type: 'GET',
            data: { materialTypeCode: typeCode },

            success: function (res) {

                if (res.success) {

                    if (inputElement) {
                        inputElement.value = res.nextNumber;
                        inputElement.readOnly = true;
                    }

                    if (statusBox)
                        statusBox.innerText = "✔ " + res.nextNumber;
                }
                else {
                    if (statusBox)
                        statusBox.innerText = "❌ " + res.message;
                }
            }
        });
    }
                function onTypeChange(selectElement) {

        const row = selectElement.closest("tr");
        const typeCode = selectElement.value;

        if (!typeCode) return;

        const materialInput = row.querySelector(".mat-number");

        if (!materialInput) return;

        fetchNextMaterialNumber(typeCode, "statusBar", materialInput);
    }

    function deleteMaterialFromList(materialNumber) {
        if (!materialNumber) return;
        function doDelete() {
            fetch('@Url.Action("DeleteMaterial", "Material")?id=' + encodeURIComponent(materialNumber), { method: "POST" })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) {
                        var msg = res.message || "Material Deleted Successfully !";
                        if (typeof window.materialShowSuccessModalThen === "function")
                            window.materialShowSuccessModalThen(msg, function () {
                                if (typeof window.materialsReloadToListTab === "function")
                                    window.materialsReloadToListTab();
                                else
                                    location.reload();
                            });
                        else if (typeof window.materialsReloadToListTab === "function")
                            window.materialsReloadToListTab();
                        else
                            location.reload();
                    } else
                        alert(res.message || "Delete failed");
                })
                .catch(function () { alert("Delete request failed"); });
        }
        if (typeof window.materialShowDeleteConfirmModalThen === "function")
            window.materialShowDeleteConfirmModalThen("Do you want to Delete this Material?", doDelete);
        else if (confirm("Delete this material?"))
            doDelete();
    }

    window.switchMaterialsModuleTab = function (which) {
        if (typeof bootstrap === "undefined") return;
        if (which === "create") {
            var b = document.getElementById("materialsTabCreateBtn");
            if (b) bootstrap.Tab.getOrCreateInstance(b).show();
        } else {
            var l = document.getElementById("materialsTabListBtn");
            if (l) bootstrap.Tab.getOrCreateInstance(l).show();
        }
    };

    window.showMaterialsCreateTab = function () {
        window.switchMaterialsModuleTab("create");
    };
     
        (function () {
            var inp = document.getElementById("MaterialListFilter");
            if (!inp) return;
            inp.addEventListener("input", function () {
                var q = (inp.value || "").toLowerCase().trim();
                document.querySelectorAll("#MaterialListTable tbody tr").forEach(function (tr) {
                    var hay = (tr.getAttribute("data-material-filter") || "").toLowerCase();
                    tr.style.display = !q || hay.indexOf(q) >= 0 ? "" : "none";
                });
            });
        })();

    document.addEventListener("DOMContentLoaded", function () {
        setMode(false);
        document.getElementById("materialsTabCreateBtn")?.addEventListener("shown.bs.tab", function () {
            if (typeof window.resetCreateV2EmbeddedForm === "function")
                window.resetCreateV2EmbeddedForm();
        });
    });
</script>