    function poDelete(id) {
        function run() {
            fetch("@Url.Action("Delete", "ProductionOrder")?id=" + encodeURIComponent(id), { method: "POST" })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) {
                        if (typeof window.materialShowSuccessModalThen === "function")
                            window.materialShowSuccessModalThen(res.message, poReload);
                        else { alert(res.message); poReload(); }
                    } else poShowInline(document.querySelector(".po-page"), res.message || "Delete failed.");
                }).catch(function () { poShowInline(document.querySelector(".po-page"), "Delete failed."); });
        }
        if (typeof window.materialShowDeleteConfirmModalThen === "function")
            window.materialShowDeleteConfirmModalThen("Delete this production order?", run);
        else if (confirm("Delete this production order?")) run();
