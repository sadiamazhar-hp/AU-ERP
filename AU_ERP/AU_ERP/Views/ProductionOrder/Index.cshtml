    function poOpenBom(id) {
        var errEl = document.getElementById("poBomError");
        var body = document.getElementById("poBomBody");
        var head = document.getElementById("poBomHeaderText");
        if (errEl) { errEl.style.display = "none"; errEl.textContent = ""; }
        if (body) body.innerHTML = "";
        if (head) head.textContent = "";
        fetch("@Url.Action("BomLines", "ProductionOrder")?id=" + encodeURIComponent(id))
            .then(function (r) { return r.json(); })
            .then(function (res) {
                var root = document.querySelector("#poBomModal .modal-content");
                if (!res.success) {
                    if (errEl) {
                        errEl.textContent = res.message || "Could not load BOM.";
                        errEl.style.display = "block";
                    }
                    if (typeof window.auShowInlineValidation === "function" && root)
                        window.auShowInlineValidation(root, [], res.message || "Could not load BOM.");
                    else if (errEl) errEl.style.display = "block";
                    var modalEl = document.getElementById("poBomModal");
                    if (modalEl && typeof bootstrap !== "undefined")
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    return;
                }
                var fm = res.finishedMaterialNumber || res.FinishedMaterialNumber || "";
                if (head) {
                    head.textContent = fm
                        ? ("Finished item: " + fm + ". Quantities are scaled from this order’s target quantity and the BOM base quantity.")
                        : "";
                }
                var lines = res.data || res.Data || [];
                if (body) {
                    if (!lines.length) {
                        body.innerHTML = '<tr><td colspan="5" class="text-secondary">No BOM lines found for this item.</td></tr>';
                    } else {
                        lines.forEach(function (row) {
                            var tr = document.createElement("tr");
                            var mn = row.materialNumber || row.MaterialNumber || "";
                            var desc = row.description || row.Description || "";
                            var mt = row.materialTypeCode || row.MaterialTypeCode || "";
                            var q = row.quantity != null ? row.quantity : row.Quantity;
                            var u = row.uomCode || row.UomCode || "—";
                            tr.innerHTML =
                                "<td><strong>" + poBomEsc(mn) + "</strong></td>" +
                                "<td>" + poBomEsc(desc) + "</td>" +
                                "<td>" + poBomEsc(mt) + "</td>" +
                                "<td>" + poBomEsc(String(q)) + "</td>" +
                                "<td>" + poBomEsc(u) + "</td>";
                            body.appendChild(tr);
                        });
                    }
                }
                var modalEl = document.getElementById("poBomModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
            })
            .catch(function () {
                if (errEl) {
                    errEl.textContent = "Request failed.";
                    errEl.style.display = "block";
                }
                var modalEl = document.getElementById("poBomModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
    }

    function poBomEsc(s) {
        if (s == null) return "";
        var d = document.createElement("div");
        d.textContent = String(s);
        return d.innerHTML;
    }

    function poNavToMrpForShortage(mat, qty, uomId, note) {
        var base = "@Url.Action("Index", "MRP")";
        var u = new URL(base, window.location.origin);
        u.searchParams.set("autoRun", "1");
        u.searchParams.set("material", (mat || "").trim());
        u.searchParams.set("qty", String(qty != null ? qty : "1"));
        u.searchParams.set("uomId", String(uomId != null ? uomId : 0));
        if (note) u.searchParams.set("note", String(note).substring(0, 500));
        window.location.href = u.pathname + u.search;
    }

    function poSaveCreate() {
        var root = poFormRoot("poCreateModal");
        poClearInline(root);
        var matNum = (document.getElementById("poCreateMaterial").value || "").trim();
        if (matNum && !poValidateUomClient(root, "poCreate")) return;
        var payload = {
            FinishedMaterialNumber: (document.getElementById("poCreateMaterial").value || "").trim(),
            TargetQuantity: parseInt(document.getElementById("poCreateQty").value, 10) || 0,
            UomId: parseInt(document.getElementById("poCreateUom").value, 10) || 0,
            PlannedStartDate: document.getElementById("poCreateStart").value || null,
            PlannedEndDate: document.getElementById("poCreateEnd").value || null,
            Priority: document.getElementById("poCreatePriority").value,
            Remarks: (document.getElementById("poCreateRemarks").value || "").trim() || null
        };
        fetch("@Url.Action("Create", "ProductionOrder")", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        }).then(function (r) { return r.json(); }).then(function (res) {
            if (res.success) {
                poHideActiveFormModalThen(function () {
                    if (typeof window.materialShowSuccessModalThen === "function")
                        window.materialShowSuccessModalThen(res.message, poReload);
                    else { alert(res.message); poReload(); }
                });
            } else if (res.mrpShortage || res.MrpShortage) {
                poNavToMrpForShortage(
                    res.mrpMaterialNumber || res.MrpMaterialNumber,
                    res.mrpTargetQuantity != null ? res.mrpTargetQuantity : res.MrpTargetQuantity,
                    res.mrpUomId != null ? res.mrpUomId : res.MrpUomId,
                    res.message || "");
            } else poShowInline(root, res.message || "Save failed.");
        }).catch(function () { poShowInline(root, "Request failed."); });
    }

    function poOpenEdit(id) {
        poEnsureLookups().then(function () {
            return fetch("@Url.Action("GetForEdit", "ProductionOrder")?id=" + encodeURIComponent(id));
        }).then(function (r) { return r.json(); }).then(function (res) {
            var root = poFormRoot("poEditModal");
            poClearInline(root);
            if (!res.success) { poShowInline(document.querySelector(".po-page"), res.message || "Load failed."); return; }
            var d = res.data;
            document.getElementById("poEditId").value = d.id || d.Id;
            var matNum = (d.finishedMaterialNumber || d.FinishedMaterialNumber || "").trim();
            var curUom = d.uomId != null ? d.uomId : d.UomId;
            document.getElementById("poEditMaterial").value = matNum;
            return poLoadMaterialUomContext("poEdit", "poEditModal", matNum, curUom).then(function () {
                document.getElementById("poEditQty").value = d.targetQuantity != null ? d.targetQuantity : d.TargetQuantity;
                document.getElementById("poEditStart").value = d.plannedStartDate || d.PlannedStartDate || "";
                document.getElementById("poEditEnd").value = d.plannedEndDate || d.PlannedEndDate || "";
                document.getElementById("poEditPriority").value = d.priority || d.Priority || "Medium";
                document.getElementById("poEditRemarks").value = d.remarks || d.Remarks || "";
                var modalEl = document.getElementById("poEditModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
        }).catch(function () { poShowInline(document.querySelector(".po-page"), "Load failed."); });
    }

    function poSaveEdit() {
        var root = poFormRoot("poEditModal");
        poClearInline(root);
        var matNum = (document.getElementById("poEditMaterial").value || "").trim();
        if (matNum && !poValidateUomClient(root, "poEdit")) return;
        var payload = {
