    var poTrackingDetailsUrl = "@Url.Action("Details", "OperationTracking")";

    function poOpSyncWastage() {
        var a = parseFloat(document.getElementById("poOpInQty").value);
        var b = parseFloat(document.getElementById("poOpOutQty").value);
        var wEl = document.getElementById("poOpWastQty");
        if (!wEl) return;
        if (isNaN(a) || isNaN(b)) { wEl.value = ""; return; }
        wEl.value = Math.max(0, a - b).toFixed(4);
    }
    (function poOpBindWastage() {
        var a = document.getElementById("poOpInQty");
        var b = document.getElementById("poOpOutQty");
        if (a) a.addEventListener("input", poOpSyncWastage);
        if (b) b.addEventListener("input", poOpSyncWastage);
    })();

    function poOpenOperationModal(productionOrderId) {
        var vRoot = document.querySelector("#poOperationModal .modal-content");
        if (vRoot && typeof window.auClearInlineValidation === "function") window.auClearInlineValidation(vRoot);
        var valEl = document.getElementById("poOperationValidation");
        if (valEl) { valEl.style.display = "none"; valEl.textContent = ""; }
        document.getElementById("poOperationPoId").value = String(productionOrderId);
        var trackBtn = document.getElementById("poOpOpenTrackingBtn");
        trackBtn.href = poTrackingDetailsUrl + "?productionOrderId=" + encodeURIComponent(productionOrderId);
        fetch("@Url.Action("GetActiveStageForUpdate", "OperationTracking")?productionOrderId=" + encodeURIComponent(productionOrderId))
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res.success) {
                    if (valEl) { valEl.style.display = "block"; valEl.textContent = res.message || "Could not load active stage."; }
                    document.getElementById("poOperationTitleText").textContent = "Operation";
                    var modalWarn = document.getElementById("poOperationModal");
                    if (modalWarn && typeof bootstrap !== "undefined")
                        bootstrap.Modal.getOrCreateInstance(modalWarn).show();
                    return;
                }
                var d = res.data;
                document.getElementById("poOperationStageId").value = d.id != null ? d.id : d.Id;
                var idx = d.stageIndex != null ? d.stageIndex : d.StageIndex;
                var title = d.stageTitle || d.StageTitle || "";
                var poNum = d.productionNumber != null ? d.productionNumber : d.ProductionNumber;
                document.getElementById("poOperationTitleText").textContent = "Update Stage " + idx + ": " + title + " (PO-" + poNum + ")";
                var defIn = d.defaultInputQuantity != null ? d.defaultInputQuantity : d.DefaultInputQuantity;
                var curIn = d.inputQuantity != null ? d.inputQuantity : d.InputQuantity;
                var curOut = d.outputQuantity != null ? d.outputQuantity : d.OutputQuantity;
                var curAct = d.actualHours != null ? d.actualHours : d.ActualHours;
                var curW = d.wastageQuantity != null ? d.wastageQuantity : d.WastageQuantity;
                document.getElementById("poOpInQty").value = (curIn != null && curIn !== "") ? curIn : (defIn != null && defIn !== "" ? defIn : "");
                document.getElementById("poOpOutQty").value = (curOut != null && curOut !== "") ? curOut : "";
                document.getElementById("poOpActHrs").value = (curAct != null && curAct !== "") ? curAct : "";
                if (curW != null && curW !== "") document.getElementById("poOpWastQty").value = curW;
                else poOpSyncWastage();
                document.getElementById("poOpOperator").value = d.workerOperator || d.WorkerOperator || "";
                document.getElementById("poOpObs").value = d.observations || d.Observations || "";
                var wr = d.wastageReason || d.WastageReason || "";
                var selW = document.getElementById("poOpWastReason");
                selW.innerHTML = '<option value="">— Optional —</option>';
                (d.wastageReasons || d.WastageReasons || []).forEach(function (x) {
                    var o = document.createElement("option");
                    o.value = x; o.textContent = x;
                    if (x === wr) o.selected = true;
                    selW.appendChild(o);
                });
                var mark = (d.stageStatus || d.StageStatus || "").toString();
                document.getElementById("poOpMarkAs").value = mark === "Completed" ? "Completed" : "InProgress";
                var modalEl = document.getElementById("poOperationModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }).catch(function () {
                if (valEl) { valEl.style.display = "block"; valEl.textContent = "Request failed."; }
                var modalEl = document.getElementById("poOperationModal");
                if (modalEl && typeof bootstrap !== "undefined")
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
    }

    function poSaveOperationStage() {
        var vRoot = document.querySelector("#poOperationModal .modal-content");
        var valEl = document.getElementById("poOperationValidation");
        if (valEl) { valEl.style.display = "none"; valEl.textContent = ""; }
        var poId = parseInt(document.getElementById("poOperationPoId").value, 10) || 0;
        var sid = parseInt(document.getElementById("poOperationStageId").value, 10) || 0;
        if (!poId || !sid) {
            if (valEl) { valEl.style.display = "block"; valEl.textContent = "No active stage to update. Use Open full tracking."; }
            return;
        }
        var wq = parseFloat(document.getElementById("poOpWastQty").value);
        var payload = {
            productionOrderId: poId,
            stageProgressId: sid,
            inputQuantity: parseFloat(document.getElementById("poOpInQty").value) || 0,
            outputQuantity: parseFloat(document.getElementById("poOpOutQty").value) || 0,
            wastageQuantity: isNaN(wq) ? null : wq,
            actualHours: parseFloat(document.getElementById("poOpActHrs").value) || 0,
            wastageReason: (document.getElementById("poOpWastReason").value || "").trim() || null,
            workerOperator: (document.getElementById("poOpOperator").value || "").trim() || null,
            markStageAs: document.getElementById("poOpMarkAs").value,
            observations: (document.getElementById("poOpObs").value || "").trim() || null
        };
        fetch("@Url.Action("UpdateStage", "OperationTracking")", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        }).then(function (r) { return r.json(); }).then(function (res) {
            if (res.success) {
                var modalEl = document.getElementById("poOperationModal");
                if (modalEl && typeof bootstrap !== "undefined") {
                    var inst = bootstrap.Modal.getInstance(modalEl);
                    if (inst) inst.hide();
                }
                if (typeof window.materialShowSuccessModalThen === "function")
                    window.materialShowSuccessModalThen(res.message || "Stage updated.", poReload);
                else { alert(res.message || "Stage updated."); poReload(); }
            } else {
                if (valEl) { valEl.style.display = "block"; valEl.textContent = res.message || "Update failed."; }
                else poShowInline(vRoot, res.message || "Update failed.");
            }
        }).catch(function () {
            if (valEl) { valEl.style.display = "block"; valEl.textContent = "Request failed."; }
        });
    }

    (function poOpenCreateFromMrpUrl() {
        try {
            var sp = new URLSearchParams(window.location.search);
            if (sp.get("autoPo") !== "1") return;
            var material = (sp.get("material") || "").trim();
            var qty = sp.get("qty") || "1";
            var uomId = parseInt(sp.get("uomId") || "0", 10) || 0;
            var remarks = sp.get("remarks") || "";
            if (history.replaceState) history.replaceState(null, document.title, window.location.pathname);
            window._poAutoFillCreate = { material: material, qty: qty, uomId: uomId, remarks: remarks };
            var el = document.getElementById("poCreateModal");
            if (el && typeof bootstrap !== "undefined")
                bootstrap.Modal.getOrCreateInstance(el).show();
        } catch (ex) { }
    })();
</script>
}
